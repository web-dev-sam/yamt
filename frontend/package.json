{
  "name": "yamt-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_CHUNK_SOURCE=fixture vite",
    "build": "vue-tsc -b && vite build",
    "lint": "oxlint --type-aware && eslint --max-warnings 0 \"src/**/*.vue\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "vue-tsc -b",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "sfc-order": "tsx scripts/check-sfc-order.ts"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "valibot": "1.5.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vue/compiler-sfc": "3.5.43",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
