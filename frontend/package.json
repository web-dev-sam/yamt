{
  "name": "yamt-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "oxlint --type-aware && eslint --max-warnings 0 \"src/**/*.vue\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "vue-tsc -b",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "sfc-order": "tsx scripts/check-sfc-order.ts",
    "unused": "knip --include exports,types"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@vueuse/core": "15.0.0",
    "valibot": "1.5.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vue/compiler-sfc": "3.5.43",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "knip": "6.40.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "knip": {
    "entry": [
      "scripts/*.ts",
      "**/*.test.ts"
    ],
    "project": [
      "src/**",
      "scripts/**"
    ],
    "ignore": [
      "src/ipc/bindings.ts"
    ]
  }
}
