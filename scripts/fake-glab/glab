#!/bin/sh
# A stand-in for glab 1.124.0 in yamt's tests and app sessions: answers `glab auth status` and `glab api` from
# the scenario folder $YAMT_FAKE_GLAB, counts posts in $YAMT_FAKE_GLAB_STATE and logs every call to
# $YAMT_FAKE_GLAB_LOG; each variable left unset is read from a glab.env beside $0 when there is one. The folder
# layout, glab.env and the log format are in tests/glab/README.md.
# What it imitates, as glab 1.124.0 printed it: `auth status` writes everything on stderr; `api` prints the body
# as GitLab sent it (no final newline), after the status line, the headers and an empty line, each ending in
# CRLF, with `--include`; on an HTTP error it also prints "glab: <message> (HTTP <code>)" on stderr and exits 1,
# and on a 3xx glab did not follow, "glab: HTTP <code>" (glab 1.126.0 `internal/commands/api/api.go`).
set -u

fail() {
	printf 'fake glab: %s\n' "$1" >&2
	exit 2
}

log() {
	if [ -n "${YAMT_FAKE_GLAB_LOG:-}" ]; then
		printf '%s\n' "$1" >>"$YAMT_FAKE_GLAB_LOG"
	fi
}

# $1 file, $2 default: the file's text, or the default when there is no file.
text_or() {
	if [ -f "$1" ]; then
		cat "$1"
	else
		printf '%s' "$2"
	fi
}

# Run through a symlink, the folder of $0 is the link's: tests place one beside their glab.env.
settings="$(dirname "$0")/glab.env"
if [ -f "$settings" ]; then
	while IFS= read -r line; do
		value=${line#*=}
		case $line in
		YAMT_FAKE_GLAB=*) : "${YAMT_FAKE_GLAB=$value}" ;;
		YAMT_FAKE_GLAB_STATE=*) : "${YAMT_FAKE_GLAB_STATE=$value}" ;;
		YAMT_FAKE_GLAB_LOG=*) : "${YAMT_FAKE_GLAB_LOG=$value}" ;;
		*) fail "unknown line in $settings: $line" ;;
		esac
	done <"$settings"
fi

scenario=${YAMT_FAKE_GLAB:-}
[ -n "$scenario" ] || fail 'YAMT_FAKE_GLAB names no scenario folder'
[ -d "$scenario" ] || fail "no scenario folder $scenario"

log "argv: $*"
log "cwd: $(pwd -P)"
log "env: NO_COLOR=${NO_COLOR-unset} GIT_TERMINAL_PROMPT=${GIT_TERMINAL_PROMPT-unset}"

# $1 a file name in the scenario, $2 and $3 suffixes: "$scenario/$1.after-post-<k>" for the largest k ≤ the posts
# counted for which "<that>$2" or "<that>$3" exists; nothing when there is none.
after_post() {
	k=$(text_or "${YAMT_FAKE_GLAB_STATE:-}" 0)
	k=${k:-0}
	while [ "$k" -gt 0 ]; do
		if [ -f "$scenario/$1.after-post-$k$2" ] || [ -f "$scenario/$1.after-post-$k$3" ]; then
			printf '%s' "$scenario/$1.after-post-$k"
			return
		fi
		k=$((k - 1))
	done
}

auth_status() {
	answers=$(after_post auth-status .out .exit)
	answers=${answers:-$scenario/auth-status}
	if [ -f "$answers.out" ]; then
		cat "$answers.out" >&2
	fi
	exit "$(text_or "$answers.exit" 0)"
}

include=no
method=
input=
endpoint=
fields=

# $1 status line: what `--include` prints before the body.
headers() {
	if [ "$include" = yes ]; then
		printf 'HTTP/2.0 %s\r\nContent-Type: application/json\r\n\r\n' "$1"
	fi
}

# $1 status line ("200 OK"), $2 the body, $3 (optional) a file holding what glab prints on stderr for an HTTP
# error instead of its own line: printed as glab prints an HTTP answer, then exits as glab does.
answer() {
	headers "$1"
	printf '%s' "$2"
	code=${1%% *}
	if [ "$code" -lt 300 ]; then
		exit 0
	fi
	if [ "$code" -lt 400 ]; then
		printf 'glab: HTTP %s\n' "$code" >&2
		exit 1
	fi
	if [ -f "${3-}" ]; then
		cat "$3" >&2
		exit 1
	fi
	message=$(printf '%s' "$2" | sed -n 's/^.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*$/\1/p')
	[ -n "$message" ] || fail 'no recorded stderr for this body'
	printf 'glab: %s (HTTP %s)\n' "$message" "$code" >&2
	exit 1
}

answer_file() {
	if [ -f "$scenario/$1" ]; then
		answer '200 OK' "$(cat "$scenario/$1")"
	fi
	answer '404 Not Found' '{"message":"404 Not Found"}'
}

# $1 a field's name: the value the call gave it (the first, when given twice), empty when not given.
field() {
	printf '%s' "$fields" | sed -n "s/^$1=//p" | head -n 1
}

# $1 the answer's path without its extension, $2 its default status line. After the k-th post the answer is
# $1.after-post-<k> instead, for the largest k whose .json exists, so a read after a write shows it; posts are never
# redirected (post calls respond).
reply() {
	posts=$(text_or "${YAMT_FAKE_GLAB_STATE:-}" 0)
	posts=${posts:-0}
	while [ "$posts" -gt 0 ]; do
		if [ -f "$1.after-post-$posts.json" ]; then
			respond "$1.after-post-$posts" "$2"
		fi
		posts=$((posts - 1))
	done
	respond "$1" "$2"
}

# $1 the answer's path without its extension, $2 its default status line: waits $1.sleep seconds, then fails before
# any HTTP answer as $1.exit and $1.err say, or answers $1.json with the status line in $1.status (or $2).
respond() {
	if [ -f "$1.sleep" ]; then
		sleep "$(cat "$1.sleep")"
	fi
	if [ -f "$1.exit" ]; then
		if [ -f "$1.err" ]; then
			cat "$1.err" >&2
		fi
		exit "$(cat "$1.exit")"
	fi
	[ -f "$1.json" ] || fail "the scenario has no answer $(basename "$1").json"
	answer "$(text_or "$1.status" "$2")" "$(cat "$1.json")" "$1.err"
}

post() {
	state=${YAMT_FAKE_GLAB_STATE:-}
	[ -n "$state" ] || fail 'YAMT_FAKE_GLAB_STATE names no file'
	count=$(text_or "$state" 0)
	number=$((count + 1))
	printf '%s\n' "$number" >"$state"
	respond "$scenario/post-$number" '201 Created'
}

# The viewer's drafts on one merge request, GET …/merge_requests/<iid>/draft_notes ("List all draft notes",
# docs.gitlab.com/api/draft_notes): draft-notes-<iid>, else draft-notes.json.
draft_notes() {
	iid=${endpoint%/draft_notes}
	iid=${iid##*/}
	if [ -f "$scenario/draft-notes-$iid.json" ]; then
		reply "$scenario/draft-notes-$iid" '200 OK'
	fi
	answer_file draft-notes.json
}

# A merge request's links lookup with a field query starting "query MergeRequestLinks": graphql-links-<iids0>, the
# field iids0=<JSON array> without its brackets, quotes and spaces, its commas as "-". Else merge requests'
# discussions with a field iids=<JSON array>: graphql-discussions-<the iids joined by "-">, with
# -after-<cursor> for a field discussionsAfter. Else the project's people with a field search=<text>:
# graphql-people-<text>. Else a merge request's description with a field query starting
# "query MergeRequestDescription" and a field iid=<n>: graphql-description-<n>. Else a merge request's details with a
# field iid=<n>; else a page of the list: the first without a field after, the n-th for after=page-<n>.
graphql() {
	case $(field query) in
	'query MergeRequestLinks'*)
		name=$(field iids0 | sed 's/[][" ]//g; s/,/-/g')
		reply "$scenario/graphql-links-$name" '200 OK'
		;;
	esac
	iids=$(field iids)
	if [ -n "$iids" ]; then
		name=$(printf '%s' "$iids" | sed 's/[][" ]//g; s/,/-/g')
		after=$(field discussionsAfter)
		if [ -n "$after" ]; then
			name="$name-after-$after"
		fi
		reply "$scenario/graphql-discussions-$name" '200 OK'
	fi
	search=$(field search)
	if [ -n "$search" ]; then
		reply "$scenario/graphql-people-$search" '200 OK'
	fi
	iid=$(field iid)
	case $(field query) in
	'query MergeRequestDescription'*) reply "$scenario/graphql-description-$iid" '200 OK' ;;
	esac
	if [ -n "$iid" ]; then
		reply "$scenario/graphql-merge-request-$iid" '200 OK'
	fi
	after=$(field after)
	case $after in
	'') page=1 ;;
	page-*) page=${after#page-} ;;
	*) fail "unknown cursor $after" ;;
	esac
	reply "$scenario/graphql-page-$page" '200 OK'
}

# $1: a file under $scenario, printed with cat (answer's printf would drop NUL bytes) after its .sleep seconds;
# "answered: <endpoint>" is logged before the answer, so a test sees which fetches overlapped. A $1.status file
# answers that status line with no body instead; no such file answers 404.
serve_file() {
	if [ -f "$1.sleep" ]; then
		sleep "$(cat "$1.sleep")"
	fi
	log "answered: $endpoint"
	if [ -f "$1.status" ]; then
		answer "$(cat "$1.status")" ''
	fi
	if [ -f "$1" ]; then
		cat "$1"
		exit 0
	fi
	answer '404 Not Found' '{"message":"404 Not Found"}'
}

# A picture asked by its full address: the file at the address's path after its host (its query dropped) under
# $scenario/pictures.
picture() {
	path=${endpoint#*://}
	path=${path#*/}
	serve_file "$scenario/pictures/${path%%\?*}"
}

# A job's log, GET projects/<project>/jobs/<n>/trace: $scenario/traces/<n>.log.
trace() {
	job=${endpoint#*/jobs/}
	serve_file "$scenario/traces/${job%/trace}.log"
}

# An upload by the uploads API, GET projects/<project>/uploads/<secret>/<file>: $scenario/uploads/<the endpoint after
# projects/>.
upload() {
	serve_file "$scenario/uploads/${endpoint#projects/}"
}

# The status line in api-status.after-post-<k>, for the largest k ≤ the posts counted with such a file: every call
# answers it, a post uncounted. GraphQL answering 401 prints GitLab's error as glab 1.126.0 did against gitlab.com
# (2026-11-04): no "(HTTP 401)". An empty file, or none, answers as usual.
api_status() {
	file=$(after_post api-status '' '')
	[ -n "$file" ] || return 0
	status=$(cat "$file")
	[ -n "$status" ] || return 0
	if [ "$endpoint" = graphql ] && [ "${status%% *}" = 401 ]; then
		headers "$status"
		printf '%s' '{"errors":[{"message":"Invalid token"}]}'
		printf 'glab: Invalid token\n' >&2
		exit 1
	fi
	answer "$status" "{\"message\":\"$status\"}"
}

api() {
	while [ $# -gt 0 ]; do
		case $1 in
		-i | --include) include=yes ;;
		-X | --method)
			method=${2-}
			shift
			;;
		--input)
			input=${2-}
			shift
			;;
		-f | --field | -F | --raw-field)
			fields="$fields${2-}
"
			shift
			;;
		-H | --header | --hostname) shift ;;
		--paginate) ;;
		-*) fail "unknown api option $1" ;;
		*) [ -n "$endpoint" ] || endpoint=$1 ;;
		esac
		shift
	done
	if [ "$input" = - ]; then
		body=$(
			cat
			printf x
		)
		log "stdin: ${body%x}"
	fi
	if [ -z "$method" ]; then
		if [ -n "$input" ] || [ -n "$fields" ]; then method=POST; else method=GET; fi
	fi
	api_status
	case "$method $endpoint" in
	# "Publish all pending draft notes" (docs.gitlab.com/api/draft_notes).
	"POST "*/draft_notes/bulk_publish) post ;;
	# "Add note to existing merge request thread" (docs.gitlab.com/api/discussions).
	"POST "*/discussions/*/notes) post ;;
	# "Resolve a merge request thread" (docs.gitlab.com/api/discussions).
	"PUT "*/discussions/*) post ;;
	# "Render an arbitrary Markdown document" (docs.gitlab.com/api/markdown): writes nothing, so not counted.
	"POST markdown") reply "$scenario/markdown" '201 Created' ;;
	"GET "*/merge_requests/*/draft_notes) draft_notes ;;
	"POST "*/draft_notes) post ;;
	"POST graphql")
		if [ "$input" = - ]; then post; else graphql; fi
		;;
	"GET "*://*) picture ;;
	"GET projects/:fullpath") answer_file project.json ;;
	"GET "*/draft_notes) answer_file draft-notes.json ;;
	"GET "*/merge_requests) answer_file merge-requests.json ;;
	"GET "*/merge_requests/*)
		if [ -f "$scenario/merge-request-${endpoint##*/}.json" ]; then
			answer_file "merge-request-${endpoint##*/}.json"
		fi
		answer_file merge-request.json
		;;
	"GET projects/"*"/jobs/"*"/trace") trace ;;
	"GET projects/"*"/uploads/"*) upload ;;
	*) answer '404 Not Found' '{"message":"404 Not Found"}' ;;
	esac
}

case ${1-} in
auth)
	[ "${2-}" = status ] || fail "unknown command: $*"
	auth_status
	;;
api)
	shift
	api "$@"
	;;
*) fail "unknown command: $*" ;;
esac
