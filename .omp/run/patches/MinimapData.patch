+// The glyph intensities and the character index below are copied from Visual Studio Code
+// (microsoft/vscode at 789f2c470d13c4760f2b5cc6a9e1919c05d04f7d,
+// src/vs/editor/browser/viewParts/minimap/minimapPreBaked.ts and minimapCharSheet.ts).
+// Copyright (c) Microsoft Corporation. All rights reserved. Licensed under the MIT License.
+
+const FIRST_CODE = 32;
+const GLYPH_COUNT = 96;
+export const GLYPH_ROWS_PER_SCALE = 2;
+const HEX_DIGITS_PER_BYTE = 2;
+const HEX = 16;
+
+export const HIDPI_SCALE = 2;
+export type Scale = 1 | typeof HIDPI_SCALE;
+
+function decoded(hex: string): Uint8ClampedArray {
+  return Uint8ClampedArray.from({ length: hex.length / HEX_DIGITS_PER_BYTE }, (_, index) =>
+    Number.parseInt(hex.slice(index * HEX_DIGITS_PER_BYTE, (index + 1) * HEX_DIGITS_PER_BYTE), HEX),
+  );
+}
+
+// Each glyph is scale wide and 2 × scale tall, its pixels row by row (minimapCharRenderer.ts renderChar).
+const INTENSITIES: Readonly<Record<Scale, Uint8ClampedArray>> = {
+  1: decoded(
+    "",
+  ),
+  2: decoded(
+    "",
+  ),
+};
+
+export function glyphs(scale: Scale): Uint8ClampedArray {
+  return INTENSITIES[scale].slice();
+}
+
+export function glyphIntensity(scale: Scale, glyph: number, pixel: number): number {
+  return INTENSITIES[scale][glyph * scale * scale * GLYPH_ROWS_PER_SCALE + pixel] ?? 0;
+}
+
+export function charIndex(code: number): number {
+  const index = code - FIRST_CODE;
+  return index < 0 || index >= GLYPH_COUNT ? (index + GLYPH_COUNT) % GLYPH_COUNT : index;
+}
