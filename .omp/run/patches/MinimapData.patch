+++ b/frontend/src/editor/internal/minimapMarks.test.ts
@@ -0,0 +1,185 @@
+import { setDiagnostics, type Diagnostic } from "@codemirror/lint";
+import { EditorState } from "@codemirror/state";
+import { expect, test } from "vitest";
+
+import type { Span } from "../../connectors";
+import { loadFixture, type Chunk } from "../../ipc";
+import type { ChunkRow } from "./geometry";
+import { minimapColumns, minimapLayout, type MinimapInput } from "./minimapLayout";
+import { changeMarks, markBoxes, problemMarks, type EdgeMark } from "./minimapMarks";
+import { PENDING, type ChunkStatus } from "./status";
+
+const LINE_PX = 20;
+const LOCAL_APPLIED = 5;
+const CONFLICT = 8;
+const DOC = Array.from({ length: 60 }, (_, index) => `line ${index + 1}`).join("\n");
+const WAVE = { first: 11, last: 40 };
+const TALL: MinimapInput = {
+  scrollTop: 72_770,
+  viewportHeight: 900,
+  paddingTop: 4,
+  paddingBottom: 4,
+  rows: 7277,
+  height: 900,
+  pixelRatio: 1,
+};
+
+function rowOf(chunk: Chunk, status: ChunkStatus): ChunkRow {
+  function span(range: { start: number; len: number }): Span {
+    return { top: range.start * LINE_PX, bottom: (range.start + range.len) * LINE_PX };
+  }
+  return {
+    chunk,
+    status,
+    left: span(chunk.local),
+    center: span(chunk.middle),
+    right: span(chunk.remote),
+  };
+}
+
+async function magicRows(): Promise<ChunkRow[]> {
+  const data = await loadFixture("vueuse-use-magic-keys.ts");
+  return data.chunks.map((chunk) => {
+    if (chunk.id === LOCAL_APPLIED) {
+      return rowOf(chunk, { local: "applied", remote: "pending" });
+    }
+    return rowOf(chunk, chunk.id === CONFLICT ? { local: "ignored", remote: "pending" } : PENDING);
+  });
+}
+
+// Lines 11-40 are collapsed into one wave line at line 11's place.
+function foldedBlockAt(state: EditorState): (pos: number) => Span {
+  return (pos) => {
+    const line = state.doc.lineAt(pos).number;
+    if (line < WAVE.first) {
+      return { top: (line - 1) * LINE_PX, bottom: line * LINE_PX };
+    }
+    if (line <= WAVE.last) {
+      return { top: (WAVE.first - 1) * LINE_PX, bottom: WAVE.first * LINE_PX };
+    }
+    const shown = line - (WAVE.last - WAVE.first);
+    return { top: (shown - 1) * LINE_PX, bottom: shown * LINE_PX };
+  };
+}
+
+function withProblems(
+  problems: readonly { from: number; to?: number; severity: Diagnostic["severity"] }[],
+): EditorState {
+  const state = EditorState.create({ doc: DOC });
+  const diagnostics = problems.map(({ from, to = from, severity }) => ({
+    from: state.doc.line(from).from,
+    to: state.doc.line(to).from + 4,
+    severity,
+    message: "problem",
+  }));
+  return state.update(setDiagnostics(state, diagnostics)).state;
+}
+
+function rows(first: number, last: number): Pick<EdgeMark, "top" | "bottom"> {
+  return { top: (first - 1) * LINE_PX, bottom: last * LINE_PX };
+}
+
+test("right edge: each change the Result tints, in its tone; resolved none", async () => {
+  const shown = await magicRows();
+  const waiting = shown.filter(({ chunk }) => chunk.id !== LOCAL_APPLIED);
+
+  expect(changeMarks(shown).map(({ kind }) => kind)).toEqual([
+    "modified",
+    "modified",
+    "modified",
+    "inserted",
+    "inserted",
+    "modified",
+    "modified",
+    "conflict",
+  ]);
+  expect(changeMarks(shown).map(({ top, bottom }) => ({ top, bottom }))).toEqual(
+    waiting.map(({ center }) => center),
+  );
+  expect(
+    changeMarks(shown.map((row) => ({ ...row, status: { local: "applied", remote: "ignored" } }))),
+  ).toEqual([]);
+});
+
+test("left edge: error and warning; info and hint none", () => {
+  const state = withProblems([
+    { from: 3, severity: "warning" },
+    { from: 5, severity: "info" },
+    { from: 7, severity: "hint" },
+    { from: 9, severity: "error" },
+  ]);
+
+  expect(problemMarks(state, foldedBlockAt(state))).toEqual([
+    { ...rows(3, 3), kind: "warning" },
+    { ...rows(9, 9), kind: "error" },
+  ]);
+});
+
+test("errors after warnings, so red is painted over yellow", () => {
+  const state = withProblems([
+    { from: 2, severity: "error" },
+    { from: 4, severity: "warning" },
+    { from: 50, severity: "error" },
+    { from: 52, severity: "warning" },
+  ]);
+
+  expect(problemMarks(state, foldedBlockAt(state)).map(({ kind }) => kind)).toEqual([
+    "warning",
+    "warning",
+    "error",
+    "error",
+  ]);
+});
+
+test("a problem in collapsed lines on its wave row", () => {
+  const state = withProblems([
+    { from: 30, severity: "error" },
+    { from: 25, to: 45, severity: "warning" },
+  ]);
+
+  expect(problemMarks(state, foldedBlockAt(state))).toEqual([
+    { ...rows(11, 16), kind: "warning" },
+    { ...rows(11, 11), kind: "error" },
+  ]);
+});
+
+test("minimum 4 CSS px, an insertion point centred, clamped", () => {
+  // The window shows rows 3,435-3,884 two device px each: row 3,500 starts at 130 px.
+  const layout = minimapLayout(TALL, null);
+  const edge = minimapColumns(1).left;
+  const marks: EdgeMark[] = [
+    { ...rows(3500, 3500), kind: "error" },
+    { top: 3499 * LINE_PX, bottom: 3499 * LINE_PX, kind: "deleted" },
+    { ...rows(3500, 3509), kind: "modified" },
+    { ...rows(3884, 3884), kind: "conflict" },
+    { ...rows(3430, 3440), kind: "warning" },
+  ];
+
+  expect(markBoxes(marks, layout, edge)).toEqual([
+    { x: 1, y: 129, width: 4, height: 4, kind: "error" },
+    { x: 1, y: 128, width: 4, height: 4, kind: "deleted" },
+    { x: 1, y: 130, width: 4, height: 20, kind: "modified" },
+    { x: 1, y: 896, width: 4, height: 4, kind: "conflict" },
+    { x: 1, y: 0, width: 4, height: 12, kind: "warning" },
+  ]);
+});
+
+test("only marks in the window; through start row and padding", () => {
+  const tall = minimapLayout(TALL, null);
+  const padded = minimapLayout(
+    { ...TALL, scrollTop: 0, rows: 30, paddingTop: 33, pixelRatio: 2 },
+    null,
+  );
+  const marks: EdgeMark[] = [
+    { ...rows(100, 100), kind: "error" },
+    { ...rows(3436, 3436), kind: "warning" },
+    { ...rows(3900, 3901), kind: "error" },
+  ];
+
+  expect(markBoxes(marks, tall, minimapColumns(1).right)).toEqual([
+    { x: 127, y: 1, width: 4, height: 4, kind: "warning" },
+  ]);
+  expect(markBoxes([{ ...rows(1, 1), kind: "inserted" }], padded, minimapColumns(2).right)).toEqual(
+    [{ x: 254, y: 2, width: 8, height: 8, kind: "inserted" }],
+  );
+});
diff --git a/frontend/src/editor/internal/minimapMarks.ts b/frontend/src/editor/internal/minimapMarks.ts
new file mode 100644
index 0000000..3c4438d
--- /dev/null
+++ b/frontend/src/editor/internal/minimapMarks.ts
@@ -0,0 +1,75 @@
+import { forEachDiagnostic, type Diagnostic } from "@codemirror/lint";
+import type { EditorState } from "@codemirror/state";
+
+import type { Span } from "../../connectors";
+import type { ChunkRow } from "./geometry";
+import { rowTop, type Box, type MinimapLayout } from "./minimapLayout";
+import { LINE_HEIGHT_PX } from "./pane";
+import { paneTone, type Tone } from "./tone";
+
+type EdgeKind = Tone | "error" | "warning";
+
+export type EdgeMark = { readonly top: number; readonly bottom: number; readonly kind: EdgeKind };
+
+type MarkBox = {
+  readonly x: number;
+  readonly y: number;
+  readonly width: number;
+  readonly height: number;
+  readonly kind: EdgeKind;
+};
+
+const MARK_WIDTH_CSS_PX = 4;
+const MARK_INSET_CSS_PX = 1;
+const MARK_MIN_HEIGHT_CSS_PX = 4;
+const HALVES = 2;
+
+const SEVERITY_EDGE: Readonly<Record<Diagnostic["severity"], "error" | "warning" | null>> = {
+  error: "error",
+  warning: "warning",
+  info: null,
+  hint: null,
+};
+
+export function changeMarks(rows: readonly ChunkRow[]): EdgeMark[] {
+  return rows.flatMap(({ chunk, status, center }) => {
+    const kind = paneTone(chunk, status, "center");
+    return kind === null ? [] : [{ top: center.top, bottom: center.bottom, kind }];
+  });
+}
+
+export function problemMarks(state: EditorState, blockAt: (pos: number) => Span): EdgeMark[] {
+  const warnings: EdgeMark[] = [];
+  const errors: EdgeMark[] = [];
+  forEachDiagnostic(state, ({ severity }, from, to) => {
+    const kind = SEVERITY_EDGE[severity];
+    if (kind !== null) {
+      (kind === "error" ? errors : warnings).push({
+        top: blockAt(from).top,
+        bottom: blockAt(to).bottom,
+        kind,
+      });
+    }
+  });
+  return [...warnings, ...errors];
+}
+
+export function markBoxes(marks: readonly EdgeMark[], layout: MinimapLayout, edge: Box): MarkBox[] {
+  const { pixelRatio, height } = layout.input;
+  const canvasHeight = Math.floor(pixelRatio * height);
+  const x = edge.x + Math.round(MARK_INSET_CSS_PX * pixelRatio);
+  const width = Math.round(MARK_WIDTH_CSS_PX * pixelRatio);
+  const minHeight = Math.round(MARK_MIN_HEIGHT_CSS_PX * pixelRatio);
+  const first = (layout.startRow - 1) * LINE_HEIGHT_PX;
+  const last = layout.endRow * LINE_HEIGHT_PX;
+  return marks
+    .filter(({ top, bottom }) => bottom >= first && top <= last)
+    .map(({ top, bottom, kind }) => {
+      const from = Math.max(0, rowTop(layout, 1 + top / LINE_HEIGHT_PX));
+      const to = Math.min(canvasHeight, rowTop(layout, 1 + bottom / LINE_HEIGHT_PX));
+      const boxHeight = Math.max(to - from, minHeight);
+      const centred = (from + to - boxHeight) / HALVES;
+      const y = Math.round(Math.min(Math.max(0, centred), canvasHeight - boxHeight));
+      return { x, y, width, height: Math.round(boxHeight), kind };
+    });
+}
diff --git a/frontend/src/editor/internal/minimapPixels.test.ts b/frontend/src/editor/internal/minimapPixels.test.ts
new file mode 100644
index 0000000..cf91bfa
--- /dev/null
+++ b/frontend/src/editor/internal/minimapPixels.test.ts
@@ -0,0 +1,143 @@
+import { expect, test } from "vitest";
+
+import { charIndex, glyphs } from "./minimapGlyphs";
+import {
+  paintRow,
+  paintWave,
+  rgbOf,
+  type CodeRow,
+  type GlyphLook,
+  type PixelRows,
+  type Rgb,
+} from "./minimapPixels";
+
+const CODE: Rgb = { r: 200, g: 201, b: 202 };
+const KEYWORD: Rgb = { r: 224, g: 152, b: 107 };
+const WAVE: Rgb = { r: 90, g: 91, b: 92 };
+const PALETTE: readonly Rgb[] = [CODE, KEYWORD];
+const DARK: GlyphLook = { scale: 1, light: false, palette: PALETTE };
+const WIDTH = 140;
+const HEIGHT = 8;
+const T = 84;
+
+// VS Code's prebaked intensities for `T` (glyph 52): 154 over 46 at scale 1, and 2 × 4 at scale 2.
+const T_SCALE_1 = [154, 46];
+const T_SCALE_2 = [201, 171, 93, 63, 93, 63, 0, 0];
+// `)` (glyph 9) at scale 1.
+const PAREN_SCALE_1 = [87, 65];
+
+function hex(...bytes: readonly number[]): string {
+  return `#${bytes.map((byte) => byte.toString(16).padStart(2, "0")).join("")}`;
+}
+
+function canvas(): PixelRows {
+  return { data: new Uint8ClampedArray(WIDTH * HEIGHT * 4), width: WIDTH };
+}
+
+function pixel(target: PixelRows, x: number, y: number): number[] {
+  const offset = (y * target.width + x) * 4;
+  return [...target.data.subarray(offset, offset + 4)];
+}
+
+function row(text: string, at: Partial<CodeRow> = {}): CodeRow {
+  return { y: 2, x: 3, text, colours: new Uint8Array(text.length).fill(1), tabSize: 4, ...at };
+}
+
+function alphas(target: PixelRows, y: number, xs: readonly number[]): number[] {
+  return xs.map((x) => pixel(target, x, y)[3] ?? -1);
+}
+
+test("rgbOf reads #rrggbb and #rrggbbaa, else null", () => {
+  expect(rgbOf(hex(18, 52, 86))).toEqual({ r: 18, g: 52, b: 86 });
+  expect(rgbOf(hex(18, 52, 86, 120))).toEqual({ r: 18, g: 52, b: 86 });
+  expect(rgbOf(` ${hex(255, 0, 171)}\n`)).toEqual({ r: 255, g: 0, b: 171 });
+  expect(rgbOf(hex(18, 52).concat("5"))).toBeNull();
+  expect(rgbOf("red")).toBeNull();
+  expect(rgbOf("")).toBeNull();
+});
+
+test("`T` at scale 1 paints VS Code's two intensities ×12/15 in the token's RGB; scale 2 paints 2×4", () => {
+  const one = canvas();
+  paintRow(one, row("T"), DARK);
+
+  expect(glyphs(1).subarray(charIndex(T) * 2, charIndex(T) * 2 + 2)).toEqual(
+    Uint8ClampedArray.from(T_SCALE_1),
+  );
+  expect(pixel(one, 3, 2)).toEqual([224, 152, 107, Math.trunc((154 * 12) / 15)]);
+  expect(pixel(one, 3, 3)).toEqual([224, 152, 107, 36]);
+  expect(pixel(one, 3, 2)[3]).toBe(123);
+  expect(pixel(one, 4, 2)).toEqual([0, 0, 0, 0]);
+  expect(pixel(one, 3, 4)).toEqual([0, 0, 0, 0]);
+
+  const two = canvas();
+  paintRow(two, row("T"), { ...DARK, scale: 2 });
+
+  expect(glyphs(2).subarray(charIndex(T) * 8, charIndex(T) * 8 + 8)).toEqual(
+    Uint8ClampedArray.from(T_SCALE_2),
+  );
+  expect([2, 3, 4, 5].flatMap((y) => alphas(two, y, [3, 4]))).toEqual(
+    T_SCALE_2.map((intensity) => Math.trunc((intensity * 12) / 15)),
+  );
+  expect([2, 3, 4, 5].flatMap((y) => alphas(two, y, [3, 4]))).toEqual([
+    160, 136, 74, 50, 74, 50, 0, 0,
+  ]);
+  expect(alphas(two, 6, [3, 4])).toEqual([0, 0]);
+});
+
+test("light uses 50/60", () => {
+  const target = canvas();
+  paintRow(target, row("T"), { ...DARK, light: true });
+
+  expect(alphas(target, 2, [3])).toEqual([Math.trunc((154 * 50) / 60)]);
+  expect([...alphas(target, 2, [3]), ...alphas(target, 3, [3])]).toEqual([128, 38]);
+});
+
+test("a tab advances to the next stop; a space paints nothing", () => {
+  const tabbed = canvas();
+  paintRow(tabbed, row("a\tT"), DARK);
+  const spaced = canvas();
+  paintRow(spaced, row(" T", { colours: Uint8Array.of(1, 0) }), DARK);
+
+  expect(alphas(tabbed, 2, [3 + 4, 3 + 5])).toEqual([123, 0]);
+  expect(pixel(spaced, 3, 2)).toEqual([0, 0, 0, 0]);
+  expect(pixel(spaced, 3, 3)).toEqual([0, 0, 0, 0]);
+  expect(pixel(spaced, 4, 2)).toEqual([200, 201, 202, 123]);
+});
+
+test("column 121 and on is cut", () => {
+  const target = canvas();
+  paintRow(target, row("T".repeat(130), { x: 0 }), DARK);
+  const tabbed = canvas();
+  paintRow(tabbed, row(`${"T".repeat(118)}\tTT`, { x: 0, tabSize: 2 }), DARK);
+
+  expect(alphas(target, 2, [119, 120, 121])).toEqual([123, 0, 0]);
+  expect(alphas(tabbed, 2, [117, 118, 119, 120])).toEqual([123, 0, 0, 0]);
+});
+
+test("outside ASCII uses VS Code's getCharIndex: wrapped into the 96 glyphs", () => {
+  const target = canvas();
+  paintRow(target, row("é"), DARK);
+
+  expect(charIndex(0xe9)).toBe(charIndex(")".charCodeAt(0)));
+  expect([charIndex(32), charIndex(126), charIndex(127), charIndex(31), charIndex(0x2028)]).toEqual(
+    [0, 94, 95, 95, (0x2028 - 32) % 96],
+  );
+  expect([...alphas(target, 2, [3]), ...alphas(target, 3, [3])]).toEqual(
+    PAREN_SCALE_1.map((intensity) => Math.trunc((intensity * 12) / 15)),
+  );
+});
+
+test("a wave row is one device px in the wave colour across the code", () => {
+  const thin = canvas();
