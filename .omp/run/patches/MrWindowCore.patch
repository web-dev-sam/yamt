+import { expect, test } from "vitest";
+
+import {
+  NARROW_FROM,
+  labelChoices,
+  narrowed,
+  personChoices,
+  type Choice,
+  type ListedRequest,
+  type Person,
+} from "../index";
+
+const SAM: Person = { username: "sam", name: "Sam Lee" };
+const ANNA: Person = { username: "anna", name: "Anna Berg" };
+const ZOE: Person = { username: "aaa", name: "Zoe Quinn" };
+
+function request(iid: number, fields: Partial<Omit<ListedRequest, "iid">> = {}): ListedRequest {
+  return {
+    iid,
+    createdAt: iid,
+    draft: false,
+    assignees: [],
+    reviewers: [],
+    labels: [],
+    ...fields,
+  };
+}
+
+const ROWS: readonly ListedRequest[] = [
+  request(1, { assignees: [ZOE, SAM], reviewers: [ANNA], labels: ["ui", "bug"] }),
+  request(2, { assignees: [ANNA], labels: ["bug"] }),
+  request(3, { assignees: [ANNA], reviewers: [SAM] }),
+  request(4),
+];
+
+function rows<V>(choices: readonly Choice<V>[]): readonly (readonly [string, number, boolean])[] {
+  return choices.map((listed) => [listed.label, listed.count, listed.checked] as const);
+}
+
+test("Assignee lists Me first, then None, then the others by name, counted over every row", () => {
+  expect(rows(personChoices(ROWS, "assignees", "sam", []))).toEqual([
+    ["Me", 1, false],
+    ["None", 1, false],
+    ["Anna Berg", 2, false],
+    ["Zoe Quinn", 1, false],
+  ]);
+});
+
+test("Reviewer counts its own field", () => {
+  expect(rows(personChoices(ROWS, "reviewers", "sam", []))).toEqual([
+    ["Me", 1, false],
+    ["None", 2, false],
+    ["Anna Berg", 1, false],
+  ]);
+});
+
+test("Me is missing while the logged-in user is unknown; that user is then listed by name", () => {
+  expect(rows(personChoices(ROWS, "assignees", null, []))).toEqual([
+    ["None", 1, false],
+    ["Anna Berg", 2, false],
+    ["Sam Lee", 1, false],
+    ["Zoe Quinn", 1, false],
+  ]);
+});
+
+test("a person value carries the username, Me and None their kinds", () => {
+  expect(personChoices(ROWS, "reviewers", "sam", []).map((listed) => listed.value)).toEqual([
+    { kind: "me" },
+    { kind: "none" },
+    { kind: "person", username: "anna" },
+  ]);
+});
+
+test("checked values show checked", () => {
+  const choices = personChoices(ROWS, "assignees", "sam", [
+    { kind: "me" },
+    { kind: "person", username: "aaa" },
+  ]);
+  expect(rows(choices)).toEqual([
+    ["Me", 1, true],
+    ["None", 1, false],
+    ["Anna Berg", 2, false],
+    ["Zoe Quinn", 1, true],
+  ]);
+});
+
+test("a checked person no longer in the list stays checked with 0, among the others by name", () => {
+  const choices = personChoices(ROWS, "assignees", "sam", [
+    { kind: "person", username: "bob" },
+    { kind: "none" },
+  ]);
+  expect(rows(choices)).toEqual([
+    ["Me", 1, false],
+    ["None", 1, true],
+    ["Anna Berg", 2, false],
+    ["bob", 0, true],
+    ["Zoe Quinn", 1, false],
+  ]);
+  expect(choices[3]?.value).toEqual({ kind: "person", username: "bob" });
+});
+
+test("a checked Me while the user is unknown stays first, checked with 0", () => {
+  expect(rows(personChoices(ROWS, "reviewers", null, [{ kind: "me" }]))).toEqual([
+    ["Me", 0, true],
+    ["None", 2, false],
+    ["Anna Berg", 1, false],
+    ["Sam Lee", 1, false],
+  ]);
+});
+
+test("a checked person who is the logged-in user stays listed, with their count", () => {
+  expect(
+    rows(personChoices(ROWS, "reviewers", "sam", [{ kind: "person", username: "sam" }])),
+  ).toEqual([
+    ["Me", 1, false],
+    ["None", 2, false],
+    ["Anna Berg", 1, false],
+    ["sam", 1, true],
+  ]);
+});
+
+test("Label lists None first, then the labels by title, counted over every row", () => {
+  expect(rows(labelChoices(ROWS, []))).toEqual([
+    ["None", 2, false],
+    ["bug", 2, false],
+    ["ui", 1, false],
+  ]);
+  expect(labelChoices(ROWS, []).map((listed) => listed.value)).toEqual([
+    { kind: "none" },
+    { kind: "label", title: "bug" },
+    { kind: "label", title: "ui" },
+  ]);
+});
+
+test("a checked label no longer in the list stays checked with 0", () => {
+  expect(
+    rows(
+      labelChoices(ROWS, [
+        { kind: "label", title: "backend" },
+        { kind: "label", title: "ui" },
+        { kind: "none" },
+      ]),
+    ),
+  ).toEqual([
+    ["None", 2, true],
+    ["backend", 0, true],
+    ["bug", 2, false],
+    ["ui", 1, true],
+  ]);
+});
+
+test("an empty list still offers None, and Me when known", () => {
+  expect(rows(personChoices([], "assignees", "sam", []))).toEqual([
+    ["Me", 0, false],
+    ["None", 0, false],
+  ]);
+  expect(rows(labelChoices([], []))).toEqual([["None", 0, false]]);
+});
+
+test("narrowed keeps the choices whose label holds the typed text, any case, trimmed", () => {
+  const choices = personChoices(ROWS, "assignees", "sam", []);
+  expect(narrowed(choices, " BER ").map((listed) => listed.label)).toEqual(["Anna Berg"]);
+  expect(narrowed(choices, "n").map((listed) => listed.label)).toEqual([
+    "None",
+    "Anna Berg",
+    "Zoe Quinn",
+  ]);
+  expect(narrowed(choices, "")).toEqual(choices);
+  expect(narrowed(choices, "xyz")).toEqual([]);
+});
+
+test("a checked None while the user is unknown does not bring Me back", () => {
+  expect(rows(personChoices(ROWS, "reviewers", null, [{ kind: "none" }]))).toEqual([
+    ["None", 2, true],
+    ["Anna Berg", 1, false],
+    ["Sam Lee", 1, false],
+  ]);
+});
+
+test("Label's None counts only the rows with no label", () => {
+  const labelled = [request(1, { labels: ["a"] }), request(2, { labels: ["b"] }), request(3)];
+  expect(labelChoices(labelled, [])[0]).toEqual({
+    value: { kind: "none" },
+    label: "None",
+    count: 1,
+    checked: false,
+  });
+});
+
+test("a checklist long enough for the narrowing box narrows to one typed label", () => {
+  const titles = Array.from({ length: NARROW_FROM + 1 }, (_unused, index) => `area-${index}`);
+  const choices = labelChoices([request(1, { labels: titles })], []);
+  expect(choices.length).toBeGreaterThan(NARROW_FROM);
+  expect(narrowed(choices, "AREA-3").map((listed) => listed.value)).toEqual([
+    { kind: "label", title: "area-3" },
+  ]);
+});
diff --git a/frontend/src/mergeRequests/internal/choices.ts b/frontend/src/mergeRequests/internal/choices.ts
new file mode 100644
index 0000000..c64fb1b
--- /dev/null
+++ b/frontend/src/mergeRequests/internal/choices.ts
@@ -0,0 +1,123 @@
+import { sameValue, type LabelValue, type ListedRequest, type PersonValue } from "./filters";
+
+export type Choice<V> = {
+  readonly value: V;
+  readonly label: string;
+  readonly count: number;
+  readonly checked: boolean;
+};
+
+export const NARROW_FROM = 8;
+
+const ME: PersonValue = { kind: "me" };
+const NO_PERSON: PersonValue = { kind: "none" };
+const NO_LABEL: LabelValue = { kind: "none" };
+
+function byLabel<V>(a: Choice<V>, b: Choice<V>): number {
+  return a.label.localeCompare(b.label, "en");
+}
+
+function choice<V extends PersonValue | LabelValue>(
+  value: V,
+  label: string,
+  count: number,
+  checked: readonly V[],
+): Choice<V> {
+  return { value, label, count, checked: checked.some((held) => sameValue(held, value)) };
+}
+
+type Seen = { readonly name: string; count: number };
+
+function peopleOf(
+  rows: readonly ListedRequest[],
+  field: "assignees" | "reviewers",
+): ReadonlyMap<string, Readonly<Seen>> {
+  const people = new Map<string, Seen>();
+  for (const row of rows) {
+    for (const { username, name } of row[field]) {
+      const seen = people.get(username);
+      if (seen === undefined) {
+        people.set(username, { name, count: 1 });
+      } else {
+        seen.count += 1;
+      }
+    }
+  }
+  return people;
+}
+
+function meChoice(
+  people: ReadonlyMap<string, Readonly<Seen>>,
+  me: string | null,
+  checked: readonly PersonValue[],
+): readonly Choice<PersonValue>[] {
+  if (me !== null) {
+    return [choice(ME, "Me", people.get(me)?.count ?? 0, checked)];
+  }
+  return checked.some((held) => held.kind === "me") ? [choice(ME, "Me", 0, checked)] : [];
+}
+
+export function personChoices(
+  rows: readonly ListedRequest[],
+  field: "assignees" | "reviewers",
+  me: string | null,
+  checked: readonly PersonValue[],
+): readonly Choice<PersonValue>[] {
+  const people = peopleOf(rows, field);
+  const none = choice(
+    NO_PERSON,
+    "None",
+    rows.filter((row) => row[field].length === 0).length,
+    checked,
+  );
+  const others = [...people]
+    .filter(([username]) => username !== me)
+    .map(([username, { name, count }]) =>
+      choice<PersonValue>({ kind: "person", username }, name, count, checked),
+    );
+  const missing = checked.flatMap((held) =>
+    held.kind === "person" && (held.username === me || !people.has(held.username))
+      ? [
+          {
+            value: held,
+            label: held.username,
+            count: people.get(held.username)?.count ?? 0,
+            checked: true,
+          },
+        ]
+      : [],
+  );
+  return [...meChoice(people, me, checked), none, ...[...others, ...missing].toSorted(byLabel)];
+}
+
+export function labelChoices(
+  rows: readonly ListedRequest[],
+  checked: readonly LabelValue[],
+): readonly Choice<LabelValue>[] {
+  const titles = new Set(rows.flatMap((row) => row.labels));
+  const none = choice(
+    NO_LABEL,
+    "None",
+    rows.filter((row) => row.labels.length === 0).length,
+    checked,
+  );
+  const found = [...titles].map((title) =>
+    choice<LabelValue>(
+      { kind: "label", title },
+      title,
+      rows.filter((row) => row.labels.includes(title)).length,
+      checked,
+    ),
+  );
+  const missing = checked.flatMap((held) =>
+    held.kind === "label" && !titles.has(held.title)
+      ? [{ value: held, label: held.title, count: 0, checked: true }]
+      : [],
+  );
+  return [none, ...[...found, ...missing].toSorted(byLabel)];
+}
+
+export function narrowed<V>(choices: readonly Choice<V>[], typed: string): readonly Choice<V>[] {
+  const needle = typed.trim().toLowerCase();
+  return choices.filter((listed) => listed.label.toLowerCase().includes(needle));
+}
