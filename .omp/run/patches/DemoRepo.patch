@@ -0,0 +1,36 @@
+export type CardId = string;
+export type ColumnId = string;
+
+export type LabelColor = "grey" | "red" | "orange" | "green" | "blue" | "purple";
+
+export type Label = {
+  name: string;
+  color: LabelColor;
+};
+
+export type Card = {
+  id: CardId;
+  title: string;
+  description: string;
+  labels: Label[];
+  assignee?: string;
+  /** A day, as `YYYY-MM-DD`. */
+  dueDate?: string;
+  createdAt: string;
+  archived: boolean;
+};
+
+export type Column = {
+  id: ColumnId;
+  name: string;
+  cardIds: CardId[];
+  /** The most cards the column takes (work in progress); none when unset. */
+  limit?: number;
+};
+
+export type Board = {
+  id: string;
+  name: string;
+  columns: Column[];
+  cards: Record<CardId, Card>;
+};
diff --git a/scripts/demo/base/src/main.ts b/scripts/demo/base/src/main.ts
new file mode 100644
index 0000000..d4167f4
--- /dev/null
+++ b/scripts/demo/base/src/main.ts
@@ -0,0 +1,26 @@
+import "./styles.css";
+
+import { loadBoard } from "./api/client";
+import { cardsIn } from "./board/board";
+import { renderCard } from "./ui/cardView";
+
+async function start(): Promise<void> {
+  const root = document.querySelector<HTMLElement>("#app");
+  if (root === null) {
+    throw new Error("index.html has no #app element");
+  }
+  const boardId = new URLSearchParams(location.search).get("board") ?? "default";
+  const board = await loadBoard(boardId);
+  document.title = `${board.name} · Taskboard`;
+
+  for (const column of board.columns) {
+    const section = document.createElement("section");
+    section.className = "column";
+    const heading = document.createElement("h2");
+    heading.textContent = column.name;
+    section.append(heading, ...cardsIn(board, column.id).map(renderCard));
+    root.append(section);
+  }
+}
+
+void start();
