index 0000000..a46769c
--- /dev/null
+++ b/frontend/src/editor/internal/wheel.test.ts
@@ -0,0 +1,74 @@
+import { expect, test } from "vitest";
+
+import type { Direction } from "./navigation";
+import { WHEEL_IDLE_MS, WHEEL_STEP_PX, wheelStep, type WheelSum } from "./wheel";
+
+const PIXEL = 0;
+const LINE = 1;
+const PAGE = 2;
+
+type Tick = { deltaY: number; at: number; deltaMode?: number; deltaX?: number };
+
+function steps(ticks: readonly Tick[]): (Direction | null)[] {
+  let sum: WheelSum = null;
+  return ticks.map(({ deltaY, at, deltaMode = PIXEL, deltaX = 0 }) => {
+    const result = wheelStep(sum, { deltaMode, deltaX, deltaY, timeStamp: at });
+    sum = result.sum;
+    return result.step;
+  });
+}
+
+test("line and page wheels step once per event", () => {
+  expect(
+    steps([
+      { deltaY: 3, at: 0, deltaMode: LINE },
+      { deltaY: 3, at: 10, deltaMode: LINE },
+      { deltaY: -1, at: 20, deltaMode: PAGE },
+    ]),
+  ).toEqual(["down", "down", "up"]);
+});
+
+test("in pixels the first event of a burst steps, the next one only after WHEEL_STEP_PX more", () => {
+  expect(
+    steps([
+      { deltaY: 4, at: 0 },
+      { deltaY: WHEEL_STEP_PX - 10, at: 16 },
+      { deltaY: 9, at: 32 },
+      { deltaY: 1, at: 48 },
+      { deltaY: 50, at: 64 },
+    ]),
+  ).toEqual(["down", null, null, "down", null]);
+});
+
+test("a direction flip and an idle gap both start a new burst that steps at once", () => {
+  expect(
+    steps([
+      { deltaY: 10, at: 0 },
+      { deltaY: -10, at: 16 },
+      { deltaY: -10, at: 32 },
+      { deltaY: -10, at: 32 + WHEEL_IDLE_MS + 1 },
+      { deltaY: -10, at: 48 + WHEEL_IDLE_MS },
+    ]),
+  ).toEqual(["down", "up", null, "up", null]);
+});
+
+test("one 500 px event gives one step, not five", () => {
+  expect(steps([{ deltaY: 500, at: 0 }])).toEqual(["down"]);
+  expect(
+    steps([
+      { deltaY: 10, at: 0 },
+      { deltaY: 500, at: 16 },
+      { deltaY: 10, at: 32 },
+    ]),
+  ).toEqual(["down", "down", null]);
+});
+
+test("events that scroll more sideways than up or down never step", () => {
+  expect(
+    steps([
+      { deltaY: 10, deltaX: 40, at: 0 },
+      { deltaY: 0, deltaX: 0, at: 16, deltaMode: LINE },
+      { deltaY: -3, deltaX: -4, at: 32, deltaMode: LINE },
+    ]),
+  ).toEqual([null, null, null]);
+});
diff --git a/frontend/src/editor/internal/wheel.ts b/frontend/src/editor/internal/wheel.ts
new file mode 100644
index 0000000..603620e
--- /dev/null
+++ b/frontend/src/editor/internal/wheel.ts
@@ -0,0 +1,36 @@
+import type { Direction } from "./navigation";
+
+export type WheelSum = {
+  readonly direction: Direction;
+  readonly px: number;
+  readonly at: number;
+} | null;
+
+type Wheel = Pick<WheelEvent, "deltaMode" | "deltaX" | "deltaY" | "timeStamp">;
+
+export const WHEEL_STEP_PX = 100;
+export const WHEEL_IDLE_MS = 250;
+
+const DOM_DELTA_PIXEL = 0;
+
+export function wheelStep(
+  sum: WheelSum,
+  { deltaMode, deltaX, deltaY, timeStamp }: Wheel,
+): { sum: WheelSum; step: Direction | null } {
+  if (deltaY === 0 || Math.abs(deltaX) > Math.abs(deltaY)) {
+    return { sum, step: null };
+  }
+  const direction = deltaY > 0 ? "down" : "up";
+  if (deltaMode !== DOM_DELTA_PIXEL) {
+    return { sum: null, step: direction };
+  }
+  const sameBurst =
+    sum !== null && sum.direction === direction && timeStamp - sum.at <= WHEEL_IDLE_MS;
+  if (!sameBurst) {
+    return { sum: { direction, px: 0, at: timeStamp }, step: direction };
+  }
+  const px = sum.px + Math.abs(deltaY);
+  return px >= WHEEL_STEP_PX
+    ? { sum: { direction, px: 0, at: timeStamp }, step: direction }
+    : { sum: { direction, px, at: timeStamp }, step: null };
+}
