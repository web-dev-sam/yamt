diff --git a/frontend/src/ipc/fixtureMergeRequestPeople.test.ts b/frontend/src/ipc/fixtureMergeRequestPeople.test.ts
new file mode 100644
index 0000000..4fbe4fd
--- /dev/null
+++ b/frontend/src/ipc/fixtureMergeRequestPeople.test.ts
@@ -0,0 +1,230 @@
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+
+import { isMergeRequestIid, type MergeRequestIid, type SourceResult } from "./domain";
+import { fixtureUploadedPicture } from "./fixtureMergeRequestData";
+import { peopleScript } from "./fixtureMergeRequestPeople";
+import type { Log } from "./log";
+import type { PeopleChange, PeopleChangeReply } from "./mergeRequestDomain";
+import type { MergeRequestSource } from "./MergeRequestSource";
+import { branded } from "./validate";
+
+type Script = Pick<MergeRequestSource, "searchPeople" | "changePeople">;
+type Lists = { readonly assignees: readonly string[]; readonly reviewers: readonly string[] };
+
+const LISTED_ROWS = 40;
+const CHANGE_MS = 1000;
+
+let lines: string[] = [];
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  lines = [];
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+function quietLog(): Log {
+  function keep(event: string, fields: Record<string, string | number | boolean> = {}): void {
+    lines.push(`${event} ${JSON.stringify(fields)}`);
+  }
+  return { debug: keep, info: keep, warn: keep, error: keep };
+}
+
+function iid(value: number): MergeRequestIid {
+  return branded(value, isMergeRequestIid, "iid");
+}
+
+function script(): Script {
+  return peopleScript(quietLog(), LISTED_ROWS);
+}
+
+async function answered<T>(asked: Promise<SourceResult<T>>, ms: number): Promise<T> {
+  await vi.advanceTimersByTimeAsync(ms);
+  const result = await asked;
+  if (!result.ok) {
+    throw new Error("the fixture failed");
+  }
+  return result.value;
+}
+
+function change(
+  group: PeopleChange["group"],
+  action: PeopleChange["action"],
+  username: string,
+): PeopleChange {
+  return { group, action, username };
+}
+
+async function changed(
+  people: Script,
+  number: number,
+  asked: PeopleChange,
+): Promise<PeopleChangeReply> {
+  return answered(people.changePeople(iid(number), asked), CHANGE_MS);
+}
+
+function lists(reply: PeopleChangeReply): Lists & { readonly kind: string } {
+  if (reply.kind !== "changed" && reply.kind !== "unchanged") {
+    throw new Error(`no lists in ${reply.kind}`);
+  }
+  return {
+    kind: reply.kind,
+    assignees: reply.people.assignees.map((person) => person.username),
+    reviewers: reply.people.reviewers.map(({ person, state }) => `${person.username}:${state}`),
+  };
+}
+
+test("a_search_matches_username_or_name_after_300_ms_and_logs_its_text", async () => {
+  const people = script();
+  let reply: unknown = null;
+  void people.searchPeople("ER").then((result) => {
+    reply = result;
+  });
+  expect(lines).toEqual([`mergeRequests.fixture_people_search {"text":"ER"}`]);
+  await vi.advanceTimersByTimeAsync(299);
+  expect(reply).toBeNull();
+  await vi.advanceTimersByTimeAsync(1);
+  expect(reply).toEqual({
+    ok: true,
+    value: {
+      kind: "found",
+      people: [
+        { username: "sam", name: "Sam Weller", picture: fixtureUploadedPicture("sam") },
+        {
+          username: "anna",
+          name: "Anna Berg",
+          picture: expect.stringMatching(/^data:image\/png/u),
+        },
+        {
+          username: "erik",
+          name: "Erik Lund",
+          picture: expect.stringMatching(/^data:image\/png/u),
+        },
+      ],
+    },
+  });
+
+  const moreau = await answered(people.searchPeople("moreau"), CHANGE_MS);
+  expect(moreau).toEqual({
+    kind: "found",
+    people: [{ username: "rita", name: "Rita Moreau", picture: null }],
+  });
+  expect(await answered(people.searchPeople("zzz"), CHANGE_MS)).toEqual({
+    kind: "found",
+    people: [],
+  });
+  const everyone = await answered(people.searchPeople(""), CHANGE_MS);
+  expect(everyone.kind === "found" && everyone.people.map((person) => person.username)).toEqual([
+    "sam",
+    "anna",
+    "ben",
+    "chiara",
+    "dmitri",
+    "erik",
+    "olga",
+    "rita",
+  ]);
+});
+
+test("adding_then_removing_follows_the_scripts_own_lists", async () => {
+  const people = script();
+  expect(lists(await changed(people, 640, change("reviewers", "add", "ben")))).toEqual({
+    kind: "changed",
+    assignees: ["sam"],
+    reviewers: ["ben:requested"],
+  });
+  expect(lists(await changed(people, 640, change("assignees", "add", "erik")))).toEqual({
+    kind: "changed",
+    assignees: ["sam", "erik"],
+    reviewers: ["ben:requested"],
+  });
+  expect(lists(await changed(people, 640, change("assignees", "add", "erik")))).toEqual({
+    kind: "changed",
+    assignees: ["sam", "erik"],
+    reviewers: ["ben:requested"],
+  });
+  expect(lists(await changed(people, 640, change("assignees", "remove", "sam")))).toEqual({
+    kind: "changed",
+    assignees: ["erik"],
+    reviewers: ["ben:requested"],
+  });
+  expect(lists(await changed(people, 640, change("reviewers", "remove", "ben")))).toEqual({
+    kind: "changed",
+    assignees: ["erik"],
+    reviewers: [],
+  });
+  expect(lists(await changed(people, 639, change("assignees", "remove", "nobody")))).toEqual({
+    kind: "unchanged",
+    assignees: ["anna"],
+    reviewers: ["dmitri:reviewed"],
+  });
+  expect(await changed(people, 1, change("assignees", "add", "ben"))).toEqual({
+    kind: "failed",
+    message: "GitLab sent no merge request !1",
+  });
+  expect(lists(await changed(script(), 640, change("assignees", "add", "ben")))).toEqual({
+    kind: "changed",
+    assignees: ["sam", "ben"],
+    reviewers: [],
+  });
+});
+
+test("olga_is_unchanged_and_rita_refused", async () => {
+  const people = script();
+  await changed(people, 640, change("assignees", "add", "ben"));
+  expect(lists(await changed(people, 640, change("assignees", "add", "olga")))).toEqual({
+    kind: "unchanged",
+    assignees: ["sam", "ben"],
+    reviewers: [],
+  });
+  expect(lists(await changed(people, 640, change("reviewers", "add", "olga")))).toEqual({
+    kind: "unchanged",
+    assignees: ["sam", "ben"],
+    reviewers: [],
+  });
+  expect(await changed(people, 640, change("reviewers", "add", "rita"))).toEqual({
+    kind: "refused",
+    message: "Cannot assign @rita to !640",
+  });
+  expect(await changed(people, 639, change("assignees", "remove", "rita"))).toEqual({
+    kind: "refused",
+    message: "Cannot assign @rita to !639",
+  });
+  expect(lists(await changed(people, 640, change("assignees", "remove", "olga")))).toEqual({
+    kind: "changed",
+    assignees: ["sam", "ben"],
+    reviewers: [],
+  });
+  expect(lists(await changed(people, 640, change("assignees", "add", "olga")))).toEqual({
+    kind: "unchanged",
+    assignees: ["sam", "ben"],
+    reviewers: [],
+  });
+});
+
+test("a_new_reviewer_is_requested", async () => {
+  const reply = await changed(script(), 639, change("reviewers", "add", "erik"));
+  expect(lists(reply)).toEqual({
+    kind: "changed",
+    assignees: ["anna"],
+    reviewers: ["dmitri:reviewed", "erik:requested"],
+  });
+  expect(reply.kind === "changed" && reply.people.reviewers[1]?.person).toEqual({
+    username: "erik",
+    name: "Erik Lund",
+    picture: expect.stringMatching(/^data:image\/png/u),
+  });
+});
+
+test("each_call_is_logged", async () => {
+  const people = script();
+  void people.changePeople(iid(638), change("reviewers", "remove", "anna"));
+  void people.searchPeople("an");
+  expect(lines).toEqual([
+    `mergeRequests.fixture_people_change {"iid":638,"group":"reviewers","action":"remove","username":"anna"}`,
+    `mergeRequests.fixture_people_search {"text":"an"}`,
+  ]);
+  await vi.advanceTimersByTimeAsync(CHANGE_MS);
+});
diff --git a/frontend/src/ipc/fixtureMergeRequestPeople.ts b/frontend/src/ipc/fixtureMergeRequestPeople.ts
new file mode 100644
index 0000000..ed87879
--- /dev/null
+++ b/frontend/src/ipc/fixtureMergeRequestPeople.ts
@@ -0,0 +1,118 @@
+import type * as Generated from "./bindings";
+import { pause } from "./fixture";
+import {
+  FREE_TIER_PERSON,
+  fixtureRows,
+  fixtureUploadedPicture,
+  PEOPLE,
+  REFUSED_PERSON,
+  SEARCH_ONLY_PEOPLE,
+} from "./fixtureMergeRequestData";
+import type { Log } from "./log";
+import { toPeopleChangeReply, toPeopleSearchReply, type PeopleChange } from "./mergeRequestDomain";
+import type { MergeRequestSource } from "./MergeRequestSource";
+
+const FIXTURE_SEARCH_MS = 300;
+const PEOPLE_CHANGE_PAUSE_MS = 1000;
+const FOUND_LIMIT = 20;
+const KNOWN_PEOPLE = [...PEOPLE, ...SEARCH_ONLY_PEOPLE];
+
+function found(text: string): Generated.Person[] {
+  const wanted = text.toLowerCase();
+  return KNOWN_PEOPLE.filter(
+    ({ username, name }) =>
+      username.toLowerCase().includes(wanted) || name.toLowerCase().includes(wanted),
+  ).slice(0, FOUND_LIMIT);
+}
+
+function listAfter<T>(
+  list: readonly T[],
+  change: PeopleChange,
+  usernameOf: (each: T) => string,
+  added: T,
+): T[] {
+  const kept = list.filter((each) => usernameOf(each) !== change.username);
+  if (change.action === "remove") {
+    return kept;
+  }
+  return kept.length < list.length ? [...list] : [...list, added];
+}
+
+function peopleAfter(
+  people: Generated.MergeRequestPeople,
+  change: PeopleChange,
+  person: Generated.Person,
+): Generated.MergeRequestPeople {
+  switch (change.group) {
+    case "assignees":
+      return {
+        ...people,
+        assignees: listAfter(people.assignees, change, (each) => each.username, person),
+      };
+    case "reviewers":
+      return {
+        ...people,
+        reviewers: listAfter(people.reviewers, change, (each) => each.person.username, {
+          person,
+          state: "requested",
+        }),
+      };
+    default: {
+      const _exhaustive: never = change.group;
+      return _exhaustive;
+    }
+  }
+}
+
+function changeReply(
+  iid: number,
+  people: Generated.MergeRequestPeople | null,
+  change: PeopleChange,
+): Generated.PeopleChangeReply {
+  if (people === null) {
+    return { kind: "failed", message: `GitLab sent no merge request !${iid}` };
+  }
+  if (change.username === REFUSED_PERSON) {
+    return { kind: "refused", message: `Cannot assign @${REFUSED_PERSON} to !${iid}` };
+  }
+  const person = KNOWN_PEOPLE.find((each) => each.username === change.username);
+  if (person === undefined || (change.action === "add" && person.username === FREE_TIER_PERSON)) {
+    return { kind: "unchanged", people };
+  }
+  return { kind: "changed", people: peopleAfter(people, change, person) };
+}
+
+/** GitLab's people search, and its changes over the listed rows' people, kept per iid until the page reloads. */
+export function peopleScript(
+  log: Log,
+  listedRows: number,
+): Pick<MergeRequestSource, "searchPeople" | "changePeople"> {
+  const changed = new Map<number, Generated.MergeRequestPeople>();
+  function peopleOf(iid: number): Generated.MergeRequestPeople | null {
+    const row = fixtureRows(0, listedRows).find((each) => each.iid === iid);
+    const listed =
+      row === undefined ? null : { assignees: row.assignees, reviewers: row.reviewers };
+    return changed.get(iid) ?? listed;
+  }
+  return {
+    async searchPeople(text) {
+      log.info("mergeRequests.fixture_people_search", { text });
+      await pause(FIXTURE_SEARCH_MS);
+      const reply = toPeopleSearchReply(
+        { kind: "found", people: found(text) },
+        fixtureUploadedPicture,
+      );
+      return { ok: true, value: reply };
+    },
+    async changePeople(iid, change) {
+      const { group, action, username } = change;
+      log.info("mergeRequests.fixture_people_change", { iid, group, action, username });
+      await pause(PEOPLE_CHANGE_PAUSE_MS);
+      const reply = changeReply(iid, peopleOf(iid), change);
+      if (reply.kind === "changed") {
+        changed.set(iid, reply.people);
+      }
+      return { ok: true, value: toPeopleChangeReply(reply, fixtureUploadedPicture) };
+    },
+  };
+}
