+     minmax(min(220px, calc((100% - 2 * 1px) / 3)), 20fr) 1px minmax(min(220px, calc((100% - 2 * 1px) / 3)), 50fr) 1px minmax(min(220px, calc((100% - 2 * 1px) / 3)), 30fr)
+     { local: 0.4, remote: 0.3 }
