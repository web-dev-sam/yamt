diff --git a/frontend/src/ui/useColumnDrag.test.ts b/frontend/src/ui/useColumnDrag.test.ts
new file mode 100644
index 0000000..a45eccd
--- /dev/null
+++ b/frontend/src/ui/useColumnDrag.test.ts
@@ -0,0 +1,290 @@
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+import { effectScope, type EffectScope } from "vue";
+
+import { COLUMN_RESIZING_CLASS, useColumnDrag, type ColumnDrag } from "./useColumnDrag";
+
+type PointerFields = { button?: number; pointerId?: number; clientX?: number };
+
+class FakeMouseEvent extends Event {
+  readonly button: number;
+  readonly clientX: number;
+  constructor(type: string, fields: PointerFields = {}) {
+    super(type, { cancelable: true });
+    this.button = fields.button ?? 0;
+    this.clientX = fields.clientX ?? 0;
+  }
+}
+
+class FakePointerEvent extends FakeMouseEvent {
+  readonly pointerId: number;
+  constructor(type: string, fields: PointerFields = {}) {
+    super(type, fields);
+    this.pointerId = fields.pointerId ?? 1;
+  }
+}
+
+class FakeElement extends EventTarget {
+  readonly captured: number[] = [];
+  setPointerCapture(pointerId: number): void {
+    this.captured.push(pointerId);
+  }
+}
+
+type Rig = {
+  readonly target: FakeElement;
+  readonly classes: Set<string>;
+  readonly moves: number[];
+  readonly presses: Event[];
+  readonly accepted: Event[];
+  readonly resets: { count: number };
+  readonly dots: { readonly value: string };
+  accepting: boolean;
+  dragging: boolean;
+};
+
+let scope: EffectScope;
+
+beforeEach(() => {
+  vi.stubGlobal("MouseEvent", FakeMouseEvent);
+  vi.stubGlobal("PointerEvent", FakePointerEvent);
+  vi.stubGlobal("Element", FakeElement);
+  scope = effectScope();
+});
+
+afterEach(() => {
+  scope.stop();
+  vi.unstubAllGlobals();
+});
+
+function rig(): Rig {
+  const target = new FakeElement();
+  const classes = new Set<string>();
+  const moves: number[] = [];
+  const presses: Event[] = [];
+  const accepted: Event[] = [];
+  const resets = { count: 0 };
+  const drag: ColumnDrag = {
+    moveBy: (dx) => {
+      moves.push(dx);
+    },
+  };
+  const state = { accepting: true, dragging: true };
+  const root = {
+    classList: {
+      add: (name: string) => {
+        classes.add(name);
+      },
+      remove: (name: string) => {
+        classes.delete(name);
+      },
+    },
+  };
+  const column = scope.run(() =>
+    useColumnDrag(
+      {
+        accepts: (event) => {
+          accepted.push(event);
+          return state.accepting;
+        },
+        press: (event) => {
+          presses.push(event);
+          return state.dragging ? drag : null;
+        },
+        reset: () => {
+          resets.count += 1;
+        },
+      },
+      root,
+    ),
+  );
+  if (column === undefined) {
+    throw new Error("no scope");
+  }
+  for (const [type, listener] of Object.entries(column.listeners)) {
+    target.addEventListener(type, listener);
+  }
+  return Object.assign(state, {
+    target,
+    classes,
+    moves,
+    presses,
+    accepted,
+    resets,
+    dots: column.dots,
+  });
+}
+
+function send(target: EventTarget, event: Event): Event {
+  target.dispatchEvent(event);
+  return event;
+}
+
+function pointer(type: string, fields: PointerFields = {}): FakePointerEvent {
+  return new FakePointerEvent(type, fields);
+}
+
+test("an accepted main-button press cancels it, captures, marks the window and drags", () => {
+  const r = rig();
+
+  const down = send(r.target, pointer("pointerdown", { pointerId: 7, clientX: 50 }));
+
+  expect(down.defaultPrevented).toBe(true);
+  expect(r.accepted).toEqual([down]);
+  expect(r.presses).toEqual([down]);
+  expect(r.target.captured).toEqual([7]);
+  expect([...r.classes]).toEqual([COLUMN_RESIZING_CLASS]);
+  expect(r.dots.value).toBe("drag");
+});
+
+test("the window's class is the one row 6 styles", () => {
+  expect(COLUMN_RESIZING_CLASS).toBe("col-resizing");
+});
+
+test("an accepted main-button mousedown is cancelled, so the keyboard stays", () => {
+  const r = rig();
+
+  expect(send(r.target, new FakeMouseEvent("mousedown")).defaultPrevented).toBe(true);
+});
+
+test("each move gets dx from the press", () => {
+  const r = rig();
+  send(r.target, pointer("pointerdown", { clientX: 50 }));
+
+  send(r.target, pointer("pointermove", { clientX: 80 }));
+  send(r.target, pointer("pointermove", { clientX: 20 }));
+
+  expect(r.moves).toEqual([30, -30]);
+});
+
+test.each(["pointerup", "pointercancel", "lostpointercapture"])(
+  "%s ends the drag and clears the window's class",
+  (type) => {
+    const r = rig();
+    send(r.target, pointer("pointerdown", { pointerId: 3, clientX: 10 }));
+
+    send(r.target, pointer(type, { pointerId: 3 }));
+    send(r.target, pointer("pointermove", { pointerId: 3, clientX: 40 }));
+
+    expect(r.classes.size).toBe(0);
+    expect(r.dots.value).toBe("hover");
+    expect(r.moves).toEqual([]);
+  },
+);
+
+test("disposing the scope mid-drag clears the window's class", () => {
+  const r = rig();
+  send(r.target, pointer("pointerdown"));
+
+  scope.stop();
+
+  expect(r.classes.size).toBe(0);
+  expect(r.dots.value).toBe("rest");
+});
+
+test("a second pointer's press, moves and release are ignored", () => {
+  const r = rig();
+  send(r.target, pointer("pointerdown", { pointerId: 1, clientX: 10 }));
+
+  const second = send(r.target, pointer("pointerdown", { pointerId: 2, clientX: 90 }));
+  send(r.target, pointer("pointermove", { pointerId: 2, clientX: 200 }));
+  send(r.target, pointer("pointerup", { pointerId: 2 }));
+  send(r.target, pointer("pointermove", { pointerId: 1, clientX: 15 }));
+
+  expect(second.defaultPrevented).toBe(false);
+  expect(r.presses).toHaveLength(1);
+  expect(r.target.captured).toEqual([1]);
+  expect(r.moves).toEqual([5]);
+  expect(r.dots.value).toBe("drag");
+});
+
+test("moves without a press do nothing", () => {
+  const r = rig();
+
+  send(r.target, pointer("pointermove", { clientX: 40 }));
+  send(r.target, pointer("pointerup"));
+
+  expect(r.moves).toEqual([]);
+  expect(r.dots.value).toBe("rest");
+});
+
+test("a rejected target does nothing and cancels nothing", () => {
+  const r = rig();
+  r.accepting = false;
+
+  const down = send(r.target, pointer("pointerdown"));
+  const mouse = send(r.target, new FakeMouseEvent("mousedown"));
+  send(r.target, pointer("pointermove", { clientX: 40 }));
+
+  expect(down.defaultPrevented).toBe(false);
+  expect(mouse.defaultPrevented).toBe(false);
+  expect(r.presses).toEqual([]);
+  expect(r.target.captured).toEqual([]);
+  expect(r.classes.size).toBe(0);
+  expect(r.moves).toEqual([]);
+  expect(r.dots.value).toBe("rest");
+});
+
+test.each([1, 2])("button %i does nothing and cancels nothing", (button) => {
+  const r = rig();
+
+  const down = send(r.target, pointer("pointerdown", { button }));
+  const mouse = send(r.target, new FakeMouseEvent("mousedown", { button }));
+
+  expect(down.defaultPrevented).toBe(false);
+  expect(mouse.defaultPrevented).toBe(false);
+  expect(r.presses).toEqual([]);
+  expect(r.classes.size).toBe(0);
+  expect(r.dots.value).toBe("rest");
+});
+
+test("a press that gives no drag does not capture or mark the window", () => {
+  const r = rig();
+  r.dragging = false;
+
+  send(r.target, pointer("pointerdown"));
+  send(r.target, pointer("pointermove", { clientX: 40 }));
+
+  expect(r.presses).toHaveLength(1);
+  expect(r.target.captured).toEqual([]);
+  expect(r.classes.size).toBe(0);
+  expect(r.dots.value).toBe("rest");
+  expect(r.moves).toEqual([]);
+});
+
+test("a double-click on an accepted target resets; on a rejected one nothing", () => {
+  const r = rig();
+
+  send(r.target, new FakeMouseEvent("dblclick"));
+  expect(r.resets.count).toBe(1);
+
+  r.accepting = false;
+  send(r.target, new FakeMouseEvent("dblclick"));
+  expect(r.resets.count).toBe(1);
+});
+
+test("hover: an accepted target brightens, a rejected one rests, leaving rests", () => {
+  const r = rig();
+
+  send(r.target, pointer("pointerover"));
+  expect(r.dots.value).toBe("hover");
+
+  r.accepting = false;
+  send(r.target, pointer("pointerover"));
+  expect(r.dots.value).toBe("rest");
+
+  r.accepting = true;
+  send(r.target, pointer("pointerover"));
+  send(r.target, pointer("pointerleave"));
+  expect(r.dots.value).toBe("rest");
+});
+
+test("hovering and leaving during a drag keep the drag's dots", () => {
+  const r = rig();
+  send(r.target, pointer("pointerdown"));
+
+  r.accepting = false;
+  send(r.target, pointer("pointerover"));
+  send(r.target, pointer("pointerleave"));
+
+  expect(r.dots.value).toBe("drag");
+});
diff --git a/frontend/src/ui/useColumnDrag.ts b/frontend/src/ui/useColumnDrag.ts
new file mode 100644
index 0000000..16a8b87
--- /dev/null
+++ b/frontend/src/ui/useColumnDrag.ts
@@ -0,0 +1,154 @@
+import { tryOnScopeDispose } from "@vueuse/core";
+import { shallowRef, type Ref, type ShallowRef } from "vue";
+
+export type DotsState = "rest" | "hover" | "drag";
+export type ColumnDrag = { moveBy(dx: number): void };
+
+export type ColumnHandle = {
+  accepts(event: PointerEvent | MouseEvent): boolean;
+  press(event: PointerEvent): ColumnDrag | null;
+  reset(): void;
+};
+
+type ClassRoot = { readonly classList: Pick<DOMTokenList, "add" | "remove"> };
+
+type ListenedEvent =
+  | "pointerdown"
+  | "pointermove"
+  | "pointerup"
+  | "pointercancel"
+  | "lostpointercapture"
+  | "pointerover"
+  | "pointerleave"
+  | "mousedown"
+  | "dblclick";
+
+export type ColumnDragHandle = {
+  readonly listeners: Readonly<Record<ListenedEvent, (event: Event) => void>>;
+  readonly dots: Readonly<Ref<DotsState>>;
+};
+
+type Dragging = {
+  readonly pointerId: number;
+  readonly pressX: number;
+  readonly drag: ColumnDrag;
+  readonly root: ClassRoot;
+};
+
+type DragState = {
+  readonly handle: ColumnHandle;
+  readonly root: ClassRoot | undefined;
+  readonly dots: ShallowRef<DotsState>;
+  dragging: Dragging | null;
+};
+
+export const COLUMN_RESIZING_CLASS = "col-resizing";
+const MAIN_BUTTON = 0;
+
+function isMainPress(state: DragState, event: MouseEvent): boolean {
+  return event.button === MAIN_BUTTON && state.handle.accepts(event);
+}
+
+function pressed(state: DragState, event: Event): void {
+  if (state.dragging !== null || !(event instanceof PointerEvent) || !isMainPress(state, event)) {
+    return;
+  }
+  event.preventDefault();
+  const drag = state.handle.press(event);
+  if (drag === null) {
+    return;
+  }
+  if (event.currentTarget instanceof Element) {
+    event.currentTarget.setPointerCapture(event.pointerId);
+  }
+  const root = state.root ?? document.documentElement;
+  root.classList.add(COLUMN_RESIZING_CLASS);
+  state.dragging = { pointerId: event.pointerId, pressX: event.clientX, drag, root };
+  state.dots.value = "drag";
+}
+
+function moved(state: DragState, event: Event): void {
+  const { dragging } = state;
+  if (
+    dragging !== null &&
+    event instanceof PointerEvent &&
+    event.pointerId === dragging.pointerId
+  ) {
+    dragging.drag.moveBy(event.clientX - dragging.pressX);
+  }
+}
+
+function stop(state: DragState, dots: DotsState): void {
+  if (state.dragging === null) {
+    return;
+  }
+  state.dragging.root.classList.remove(COLUMN_RESIZING_CLASS);
+  state.dragging = null;
+  state.dots.value = dots;
+}
+
+function ended(state: DragState, event: Event): void {
+  if (event instanceof PointerEvent && event.pointerId === state.dragging?.pointerId) {
+    stop(state, "hover");
+  }
+}
+
+function hovered(state: DragState, event: Event): void {
+  if (state.dragging === null && event instanceof MouseEvent) {
+    state.dots.value = state.handle.accepts(event) ? "hover" : "rest";
+  }
+}
+
+function left(state: DragState): void {
+  if (state.dragging === null) {
+    state.dots.value = "rest";
+  }
+}
+
+function mousePressed(state: DragState, event: Event): void {
+  if (event instanceof MouseEvent && isMainPress(state, event)) {
+    event.preventDefault();
+  }
+}
+
+function doubleClicked(state: DragState, event: Event): void {
+  if (event instanceof MouseEvent && state.handle.accepts(event)) {
+    state.handle.reset();
+  }
+}
+
+export function useColumnDrag(handle: ColumnHandle, root?: ClassRoot): ColumnDragHandle {
+  const state: DragState = { handle, root, dots: shallowRef<DotsState>("rest"), dragging: null };
+  tryOnScopeDispose(() => {
+    stop(state, "rest");
+  });
+  function end(event: Event): void {
+    ended(state, event);
+  }
+  return {
+    listeners: {
+      pointerdown: (event) => {
+        pressed(state, event);
+      },
+      pointermove: (event) => {
+        moved(state, event);
+      },
+      pointerup: end,
+      pointercancel: end,
+      lostpointercapture: end,
+      pointerover: (event) => {
+        hovered(state, event);
+      },
+      pointerleave: () => {
+        left(state);
+      },
+      mousedown: (event) => {
+        mousePressed(state, event);
+      },
+      dblclick: (event) => {
+        doubleClicked(state, event);
+      },
+    },
+    dots: state.dots,
+  };
+}
diff --git a/frontend/src/ui/usePaneDividers.test.ts b/frontend/src/ui/usePaneDividers.test.ts
