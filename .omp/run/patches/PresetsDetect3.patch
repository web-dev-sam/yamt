+test("rule 3: once Vue's plugin is installed, the next detection drops Vue and restarts TypeScript serving .vue", async () => {
+  const vueHint: InstallHint = {
+    ...INSTALL_HINT,
+    package: "@vue/typescript-plugin",
+    reason: { kind: "vue" },
