+                fs::remove_file(&worktree_file)?;
+            }
+            symlink(OsStr::from_bytes(bytes), &worktree_file)?;
+            git_ok(root, &["add", "--", file.path])?;
+        }
+        FileKind::Submodule => {
+            fs::create_dir_all(&worktree_file)?;
