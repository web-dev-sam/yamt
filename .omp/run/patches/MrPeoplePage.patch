+import { beforeAll, expect, test } from "vitest";
+
+import {
+  createFixtureCompareSource,
+  log,
+  type MergeRequestRow,
+  type PeopleChange,
+  type Person,
+} from "../ipc";
+import {
+  firstAddable,
+  groupNotices,
+  keptHighlight,
+  NO_PEOPLE_ASKS,
+  personState,
+  pickList,
+  steppedHighlight,
+  type GroupPlace,
+  type PickInput,
+  type PickLine,
+} from "./mergeRequestPeopleLines";
+import type { NotDone, PeopleSearch, RowPeopleAsks } from "./mergeRequests";
+
+const PLATFORM = "Linux x86_64";
+const SAM: Person = { username: "sam", name: "Sam Reed", picture: null };
+const ANNA: Person = { username: "anna", name: "Anna Berg", picture: "yamt-picture://anna" };
+const ERIK: Person = { username: "erik", name: "Erik Lund", picture: null };
+const CHIARA: Person = { username: "chiara", name: "Chiara Rossi", picture: null };
+
+let BASE: MergeRequestRow;
+
+beforeAll(async () => {
+  const rows: MergeRequestRow[] = [];
+  await createFixtureCompareSource(log, "?mr=list", {}).listMergeRequests(
+    (page) => {
+      rows.push(...page.rows);
+    },
+    () => undefined,
+  );
+  const first = rows[0];
+  if (first === undefined) {
+    throw new Error("the fixture lists no row");
+  }
+  BASE = first;
+});
+
+function row(people: Partial<MergeRequestRow>): MergeRequestRow {
+  return {
+    ...BASE,
+    author: ANNA,
+    assignees: [SAM],
+    reviewers: [{ person: CHIARA, state: "requested" }],
+    approvedBy: [],
+    ...people,
+  };
+}
+
+function input(edit: Partial<PickInput>): PickInput {
+  const shown = edit.row ?? row({});
+  return {
+    rows: [shown],
+    row: shown,
+    group: "assignees",
+    me: "sam",
+    search: { kind: "empty" },
+    asks: NO_PEOPLE_ASKS,
+    platform: PLATFORM,
+    ...edit,
+  };
+}
+
+function line(username: string, state: PickLine["state"]): PickLine {
+  return { username, picture: SAM, label: username, state };
+}
+
+function states(lines: readonly PickLine[]): string[] {
+  return lines.map((each) => `${each.label} ${each.username} ${each.state}`);
+}
+
+function add(username: string, group: PeopleChange["group"]): PeopleChange {
+  return { group, action: "add", username };
+}
+
+function remove(username: string, group: PeopleChange["group"]): PeopleChange {
+  return { group, action: "remove", username };
+}
+
+test("already_in_the_group_is_not_addable_and_working_shows_for_a_queued_add", () => {
+  const asks: RowPeopleAsks = {
+    queue: [add("chiara", "assignees"), add("anna", "reviewers"), remove("anna", "assignees")],
+    notDone: [],
+  };
+  const assignees = pickList(input({ asks }));
+  expect(states(assignees.lines)).toEqual([
+    "Me sam already",
+    "Anna Berg anna addable",
+    "Chiara Rossi chiara working",
+  ]);
+  expect(assignees.note).toBeNull();
+  expect(assignees.lines[0]?.picture).toBe(SAM);
+
+  const reviewers = pickList(input({ group: "reviewers", asks }));
+  expect(states(reviewers.lines)).toEqual([
+    "Me sam addable",
+    "Anna Berg anna working",
+    "Chiara Rossi chiara already",
+  ]);
+});
+
+test("the viewer on no loaded row reads Me with a picture of their username's initials", () => {
+  const list = pickList(input({ me: "olga" }));
+  expect(list.lines[0]).toEqual({
+    username: "olga",
+    picture: { username: "olga", name: "", picture: null },
+    label: "Me",
+    state: "addable",
+  });
+});
+
+test("arrows_skip_people_already_there_and_wrap", () => {
+  const lines = [
+    line("sam", "already"),
+    line("anna", "addable"),
+    line("chiara", "working"),
+    line("erik", "addable"),
+    line("olga", "addable"),
+  ];
+  expect(firstAddable(lines)).toBe(1);
+  expect(steppedHighlight(lines, 1, 1)).toBe(3);
+  expect(steppedHighlight(lines, 3, 1)).toBe(4);
+  expect(steppedHighlight(lines, 4, 1)).toBe(1);
+  expect(steppedHighlight(lines, 1, -1)).toBe(4);
+  expect(steppedHighlight(lines, 4, -1)).toBe(3);
+  expect(steppedHighlight(lines, null, 1)).toBe(1);
+  expect(steppedHighlight(lines, null, -1)).toBe(4);
+  expect(steppedHighlight(lines, 0, -1)).toBe(4);
+  const none = [line("sam", "already"), line("chiara", "working")];
+  expect(firstAddable(none)).toBeNull();
+  expect(steppedHighlight(none, null, 1)).toBeNull();
+  expect(steppedHighlight(none, null, -1)).toBeNull();
+  expect(steppedHighlight([], null, 1)).toBeNull();
+});
+
+test("the_highlight_returns_to_the_first_addable_line_when_the_list_changes", () => {
+  const before = [line("sam", "already"), line("anna", "addable"), line("erik", "addable")];
+  expect(keptHighlight(before, [...before], 2)).toBe(2);
+  expect(
+    keptHighlight(
+      before,
+      [line("sam", "already"), line("anna", "working"), line("erik", "addable")],
+      1,
+    ),
+  ).toBe(2);
+  expect(keptHighlight(before, [line("erik", "addable"), line("anna", "addable")], 1)).toBe(0);
+  expect(keptHighlight(before, before.slice(0, 2), 1)).toBe(1);
+  expect(keptHighlight(before.slice(1), [...before.slice(1), line("olga", "addable")], 1)).toBe(0);
+  expect(
+    keptHighlight(
+      before,
+      [line("sam", "already"), line("erik", "addable"), line("anna", "addable")],
+      2,
+    ),
+  ).toBe(1);
+  expect(keptHighlight(before, [line("sam", "already")], 1)).toBeNull();
+});
+
+function place(notDone: readonly NotDone[], group: PeopleChange["group"]): GroupPlace {
+  return { row: row({}), group, asks: { queue: [], notDone }, platform: PLATFORM };
+}
+
+test("a_remove_notice_sits_under_its_listed_person_else_under_the_group", () => {
+  const notDone: NotDone[] = [
+    { change: remove("chiara", "reviewers"), why: { kind: "unchanged" } },
+    {
+      change: remove("erik", "reviewers"),
+      why: { kind: "refused", reply: { kind: "refused", message: "gone" } },
+    },
+    { change: add("olga", "reviewers"), why: { kind: "unchanged" } },
+    { change: add("anna", "reviewers"), why: { kind: "unchanged" } },
+    {
+      change: add("chiara", "reviewers"),
+      why: { kind: "refused", reply: { kind: "refused", message: "twice" } },
+    },
+    {
+      change: remove("sam", "assignees"),
+      why: { kind: "failed", cause: { kind: "WorkerStopped" } },
+    },
+    { change: remove("chiara", "assignees"), why: { kind: "unchanged" } },
+  ];
+  const reviewers = place(notDone, "reviewers");
+  expect(personState(reviewers, "chiara")).toEqual({
+    removing: false,
+    notices: ["GitLab still lists Chiara Rossi as reviewer."],
+  });
+  expect(groupNotices(reviewers)).toEqual([
+    "gone",
+    "GitLab did not add @olga as reviewer (GitLab Free allows one reviewer per merge request).",
+    "GitLab did not add Anna Berg as reviewer (GitLab Free allows one reviewer per merge request).",
+    "twice",
+  ]);
+  const assignees = place(notDone, "assignees");
+  expect(personState(assignees, "sam").notices).toEqual([
+    "Could not change the merge request's people: yamt's worker stopped; try again.",
+  ]);
+  expect(groupNotices(assignees)).toEqual(["GitLab still lists Chiara Rossi as assignee."]);
+});
+
+test("a notice names a person the row does not hold, on a row without an author, by @username", () => {
+  const noAuthor: GroupPlace = {
+    row: row({ author: null }),
+    group: "assignees",
+    asks: {
+      queue: [],
+      notDone: [{ change: add("olga", "assignees"), why: { kind: "unchanged" } }],
+    },
+    platform: PLATFORM,
+  };
+  expect(groupNotices(noAuthor)).toEqual([
+    "GitLab did not add @olga as assignee (GitLab Free allows one assignee per merge request).",
+  ]);
+});
+
+test("a person's remove queued or running is working; an add of them or another group's remove is not", () => {
+  const asks: RowPeopleAsks = {
+    queue: [add("sam", "reviewers"), remove("chiara", "reviewers"), add("chiara", "assignees")],
+    notDone: [],
+  };
+  const reviewers: GroupPlace = { row: row({}), group: "reviewers", asks, platform: PLATFORM };
+  expect(personState(reviewers, "chiara")).toEqual({ removing: true, notices: [] });
+  expect(personState(reviewers, "sam").removing).toBe(false);
+  expect(personState({ ...reviewers, group: "assignees" }, "chiara").removing).toBe(false);
+});
+
+test("searching_keeps_the_last_people_and_found_nobody_is_no_one_found", () => {
+  const searching: PeopleSearch = { kind: "searching", text: "er", people: [ERIK, SAM] };
+  const kept = pickList(input({ search: searching }));
+  expect(states(kept.lines)).toEqual(["Erik Lund erik addable", "Sam Reed sam already"]);
+  expect(kept.lines[0]?.picture).toBe(ERIK);
+  expect(kept.note).toEqual({ text: "Searching…", failed: false });
+
+  const found = pickList(input({ search: { kind: "found", text: "er", people: [ERIK] } }));
+  expect(states(found.lines)).toEqual(["Erik Lund erik addable"]);
+  expect(found.note).toBeNull();
+
+  const nobody = pickList(input({ search: { kind: "found", text: "zz", people: [] } }));
+  expect(nobody).toEqual({ lines: [], note: { text: "No one found", failed: false } });
+
+  const refused = pickList(
+    input({ search: { kind: "refused", text: "er", reply: { kind: "failed", message: "boom" } } }),
+  );
+  expect(refused).toEqual({ lines: [], note: { text: "boom", failed: true } });
+  const failed = pickList(
+    input({ search: { kind: "failed", text: "er", cause: { kind: "WorkerStopped" } } }),
+  );
+  expect(failed).toEqual({
+    lines: [],
+    note: { text: "Could not search people: yamt's worker stopped; try again.", failed: true },
+  });
+});
diff --git a/frontend/src/ui/mergeRequestPeopleLines.ts b/frontend/src/ui/mergeRequestPeopleLines.ts
new file mode 100644
index 0000000..5c04631
--- /dev/null
+++ b/frontend/src/ui/mergeRequestPeopleLines.ts
@@ -0,0 +1,196 @@
+import type { MergeRequestRow, PeopleGroup, Person } from "../ipc";
+import { displayName, ME_WORD, peopleSuggestions, type Suggestion } from "../mergeRequests";
+import type { NotDone, PeopleSearch, RowPeopleAsks } from "./mergeRequests";
+import {
+  NO_ONE_FOUND,
+  peopleChangeText,
+  peopleSearchText,
+  SEARCHING_PEOPLE,
+} from "./mergeRequestsText";
+
+/** `working`: an add of this person to the group is queued or running. */
+type PickState = "addable" | "already" | "working";
+
+/** One line of the add field's list; `picture` is a person even for the viewer on no loaded row (initials). */
+export type PickLine = {
+  readonly username: string;
+  readonly picture: Person;
+  readonly label: string;
+  readonly state: PickState;
+};
+
+/** `failed`: the note says why the search found nothing (a refusal or a thrown call), shown as an error. */
+type PickNote = { readonly text: string; readonly failed: boolean };
+export type PickList = { readonly lines: readonly PickLine[]; readonly note: PickNote | null };
+
+export type PickInput = {
+  readonly rows: readonly MergeRequestRow[];
+  readonly row: MergeRequestRow;
+  readonly group: PeopleGroup;
+  readonly me: string | null;
+  readonly search: PeopleSearch;
+  readonly asks: RowPeopleAsks;
+  readonly platform: string;
+};
+
+/** One group of one row's box, with that row's asks. */
+export type GroupPlace = {
+  readonly row: MergeRequestRow;
+  readonly group: PeopleGroup;
+  readonly asks: RowPeopleAsks;
+  readonly platform: string;
+};
+
+export type PersonState = { readonly removing: boolean; readonly notices: readonly string[] };
+
+type Shown = Omit<PickLine, "state">;
+
+/** A row with no change queued and no notice. */
+export const NO_PEOPLE_ASKS: RowPeopleAsks = { queue: [], notDone: [] };
+
+function usernamesIn(row: MergeRequestRow, group: PeopleGroup): readonly string[] {
+  return group === "assignees"
+    ? row.assignees.map((person) => person.username)
+    : row.reviewers.map((reviewer) => reviewer.person.username);
+}
+
+function personShown(person: Person): Shown {
+  return { username: person.username, picture: person, label: displayName(person) };
+}
+
+function suggestionShown(suggestion: Suggestion<Person>): Shown {
+  if (suggestion.kind === "known") {
+    return personShown(suggestion.person);
+  }
+  const { username, person } = suggestion;
+  return { username, picture: person ?? { username, name: "", picture: null }, label: ME_WORD };
+}
+
+function shownOf(input: PickInput): {
+  readonly shown: readonly Shown[];
+  readonly note: PickNote | null;
+} {
+  const search = input.search;
+  switch (search.kind) {
+    case "empty":
+      return {
+        shown: peopleSuggestions(input.rows, input.row, input.group, input.me).map(suggestionShown),
+        note: null,
+      };
+    case "searching":
+      return {
+        shown: search.people.map(personShown),
+        note: { text: SEARCHING_PEOPLE, failed: false },
+      };
+    case "found":
+      return {
+        shown: search.people.map(personShown),
+        note: search.people.length === 0 ? { text: NO_ONE_FOUND, failed: false } : null,
+      };
+    case "refused":
+    case "failed":
+      return {
+        shown: [],
+        note: { text: peopleSearchText(search, input.platform), failed: true },
+      };
+    default: {
+      const _exhaustive: never = search;
+      return _exhaustive;
+    }
+  }
+}
+
+/** The add field's list for `group`: the suggestions while the field is empty, else the search's people. */
+export function pickList(input: PickInput): PickList {
+  const { shown, note } = shownOf(input);
+  const there = usernamesIn(input.row, input.group);
+  function stateOf(username: string): PickState {
+    const adding = input.asks.queue.some(
+      (change) =>
+        change.action === "add" && change.group === input.group && change.username === username,
+    );
+    if (adding) {
+      return "working";
+    }
+    return there.includes(username) ? "already" : "addable";
+  }
+  return { lines: shown.map((line) => ({ ...line, state: stateOf(line.username) })), note };
+}
+
+function addableIndexes(lines: readonly PickLine[]): readonly number[] {
+  return lines.flatMap((line, index) => (line.state === "addable" ? [index] : []));
+}
+
+export function firstAddable(lines: readonly PickLine[]): number | null {
+  return addableIndexes(lines)[0] ?? null;
+}
+
+/** The highlight moved by `step` (1 down, -1 up) over the addable lines, wrapping; null when none is addable. */
+export function steppedHighlight(
+  lines: readonly PickLine[],
+  current: number | null,
+  step: number,
+): number | null {
+  const addable = addableIndexes(lines);
+  const at = addable.findIndex((index) => index === current);
+  const next = at === -1 ? (step > 0 ? 0 : addable.length - 1) : at + step + addable.length;
+  return addable[next % addable.length] ?? null;
+}
+
+function linesKey(lines: readonly PickLine[]): string {
+  return lines.map((line) => `${line.username} ${line.state}`).join("\n");
+}
+
+/** The highlight after the list was recomputed: kept while the lines and their states are the same, else the first
+ *  addable line. */
+export function keptHighlight(
+  before: readonly PickLine[],
+  after: readonly PickLine[],
+  current: number | null,
+): number | null {
+  return linesKey(before) === linesKey(after) ? current : firstAddable(after);
+}
+
+/** How a notice names a person: their display name when the row names them anywhere, else `@username`. */
+function noticeName(row: MergeRequestRow, username: string): string {
+  const named = [
+    ...(row.author === null ? [] : [row.author]),
+    ...row.assignees,
+    ...row.reviewers.map((reviewer) => reviewer.person),
+    ...row.approvedBy,
+  ].find((person) => person.username === username);
+  return named === undefined ? `@${username}` : displayName(named);
+}
+
+/** The listed person a notice sits under: a remove's person while the group lists them, else null (the group). */
+function noticeUnder(row: MergeRequestRow, notDone: NotDone): string | null {
+  const { change } = notDone;
+  return change.action === "remove" && usernamesIn(row, change.group).includes(change.username)
+    ? change.username
+    : null;
+}
+
+function noticesWhere(place: GroupPlace, under: string | null): readonly string[] {
+  return place.asks.notDone
+    .filter(
+      (notDone) =>
+        notDone.change.group === place.group && noticeUnder(place.row, notDone) === under,
+    )
+    .map((notDone) =>
+      peopleChangeText(notDone, noticeName(place.row, notDone.change.username), place.platform),
+    );
+}
+
+export function groupNotices(place: GroupPlace): readonly string[] {
+  return noticesWhere(place, null);
+}
+
+export function personState(place: GroupPlace, username: string): PersonState {
+  return {
+    removing: place.asks.queue.some(
+      (change) =>
+        change.action === "remove" && change.group === place.group && change.username === username,
+    ),
+    notices: noticesWhere(place, username),
+  };
+}
