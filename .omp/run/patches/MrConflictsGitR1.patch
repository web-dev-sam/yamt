+}
+
+fn assert_refused_as_a_branch_name(result: yamt_gitio::Result<()>) {
+    match result {
+        Err(Error::GitFailed { stderr, .. }) => {
+            assert!(stderr.starts_with(NOT_A_BRANCH_NAME), "{stderr}");
+        }
+        other => panic!("{other:?}"),
+    }
