diff --git a/src-tauri/src/merge_requests.rs b/src-tauri/src/merge_requests.rs
new file mode 100644
index 0000000..5df370d
--- /dev/null
+++ b/src-tauri/src/merge_requests.rs
@@ -0,0 +1,143 @@
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+use tauri::ipc::Channel;
+use tauri::{App, Manager, Runtime, State, WebviewWindow};
+use yamt_merge_requests::{
+    GitLabProject, GitLabRepository, Glab, JobOpened, JobPage, ListEnd, MergeRequestIid,
+    MergeRequestPage, OpenReply, gitlab_repository, prepare_open,
+};
+
+use crate::ipc_error::{IpcError, blocking_reply};
+use crate::range::range_folder;
+use crate::range_window;
+
+const NO_PROJECT: &str = "this window's folder has no remote on a GitLab server";
+
+/// One message of a load, in order: every page, then its end. The end travels on the channel too: tauri 2.12.1
+/// delivers a channel message of 8 KiB of JSON or more by a later fetch (ipc/channel.rs
+/// `MAX_JSON_DIRECT_EXECUTE_THRESHOLD`), so a page could reach the window after the command's own answer.
+#[derive(Clone, Debug, serde::Serialize, specta::Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub(crate) enum ListMessage {
+    Page { page: MergeRequestPage },
+    End { end: ListEnd },
+}
+
+/// The window's GitLab project, found once at start, the folder pair locks live in, and every job page a list
+/// sent in this run: only those may be opened (plan §2 #128–#135); never locked together with another `Mutex`.
+pub(crate) struct MergeRequestState {
+    gitlab: Option<GitLabRepository>,
+    range_dir: PathBuf,
+    job_pages: Mutex<BTreeSet<JobPage>>,
+}
+
+/// Looks for a GitLab project in `folder`'s repository, offline, and hands it to the app.
+pub(crate) fn manage<R: Runtime>(app: &App<R>, folder: &Path, app_folder: &Path) {
+    app.manage(MergeRequestState {
+        gitlab: gitlab_repository(folder),
+        range_dir: range_folder(app_folder),
+        job_pages: Mutex::new(BTreeSet::new()),
+    });
+}
+
+fn offered(job_pages: &Mutex<BTreeSet<JobPage>>) -> MutexGuard<'_, BTreeSet<JobPage>> {
+    job_pages.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// Remembers the page's job pages as offered, then sends the page to the window.
+fn forward_page(state: &MergeRequestState, channel: &Channel<ListMessage>, page: MergeRequestPage) {
+    let mut job_pages = offered(&state.job_pages);
+    for row in &page.rows {
+        let jobs = row
+            .pipeline
+            .iter()
+            .flat_map(|pipeline| &pipeline.failed_jobs);
+        job_pages.extend(jobs.filter_map(|job| job.page.clone()));
+    }
+    drop(job_pages);
+    send(channel, ListMessage::Page { page });
+}
+
+fn send(channel: &Channel<ListMessage>, message: ListMessage) {
+    if let Err(error) = channel.send(message) {
+        tracing::warn!(%error, "a message of the merge-request list did not reach the window");
+    }
+}
+
+/// Sends every page, then the end.
+fn list(state: &MergeRequestState, glab: Option<&Glab>, channel: &Channel<ListMessage>) {
+    let end = match &state.gitlab {
+        Some(repository) => {
+            let on_page = |page| forward_page(state, channel, page);
+            yamt_merge_requests::list_merge_requests(repository, glab, &on_page)
+        }
+        None => ListEnd::Failed {
+            message: NO_PROJECT.to_owned(),
+        },
+    };
+    send(channel, ListMessage::End { end });
+}
+
+fn opened(state: &MergeRequestState, glab: Option<&Glab>, iid: MergeRequestIid) -> OpenReply {
+    let Some(repository) = &state.gitlab else {
+        return OpenReply::Failed {
+            message: NO_PROJECT.to_owned(),
+        };
+    };
+    match prepare_open(repository, glab, iid, &state.range_dir) {
+        Ok(range) => range_window::start(&range),
+        Err(reply) => reply,
+    }
+}
+
+#[tauri::command]
+#[specta::specta]
+#[expect(clippy::needless_pass_by_value, reason = "tauri passes State by value")]
+pub(crate) fn find_gitlab_project(state: State<'_, MergeRequestState>) -> GitLabProject {
+    state
+        .gitlab
+        .as_ref()
+        .map_or(GitLabProject::None, GitLabRepository::project)
+}
+
+// The state comes from the window: tauri-macros 2.7 checks an async command with a borrowed
+// argument such as `State<'_, _>` by an `unreachable!()` that clippy denies (command/wrapper.rs:222).
+#[tauri::command]
+#[specta::specta]
+pub(crate) async fn list_merge_requests<R: Runtime>(
+    window: WebviewWindow<R>,
+    messages: Channel<ListMessage>,
+) -> Result<(), IpcError> {
+    blocking_reply(move || {
+        list(&window.state(), Glab::find().as_ref(), &messages);
+        Ok(())
+    })
+    .await
+}
+
+#[tauri::command]
+#[specta::specta]
+pub(crate) async fn open_merge_request<R: Runtime>(
+    window: WebviewWindow<R>,
+    iid: MergeRequestIid,
+) -> Result<OpenReply, IpcError> {
+    blocking_reply(move || Ok(opened(&window.state(), Glab::find().as_ref(), iid))).await
+}
+
+/// Opens `page` in the browser only when a list of this window sent it: the window cannot hand any other
+/// address to the system.
+#[tauri::command]
+#[specta::specta]
+#[expect(clippy::needless_pass_by_value, reason = "tauri passes State by value")]
+pub(crate) fn open_job_page(state: State<'_, MergeRequestState>, page: JobPage) -> JobOpened {
+    if !offered(&state.job_pages).contains(&page) {
+        tracing::warn!(page = page.as_str(), "a job page no list sent");
+        return JobOpened::NotOffered;
+    }
+    yamt_merge_requests::open_job_page(&page)
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/src-tauri/src/merge_requests/tests.rs b/src-tauri/src/merge_requests/tests.rs
new file mode 100644
index 0000000..5922943
--- /dev/null
+++ b/src-tauri/src/merge_requests/tests.rs
@@ -0,0 +1,224 @@
+use std::path::PathBuf;
+use std::process::Command;
+
+use std::sync::mpsc;
+
+use serde_json::{Value, json};
+use tauri::App;
+use tauri::async_runtime::block_on;
+use tauri::ipc::InvokeResponseBody;
+use tauri::test::{MockRuntime, mock_builder, mock_context, noop_assets};
+use tauri::{WebviewUrl, WebviewWindowBuilder};
+use yamt_conflict_repo::{TempDir, git_ok};
+
+use super::*;
+use crate::commands::with_commands;
+use crate::mock_window::invoke_on;
+use crate::window::app_folder;
+
+fn in_this_repository(relative: &str) -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("..")
+        .join(relative)
+}
+
+/// A window whose merge-request state is managed for the repository in `repo`, its data folder a temp dir.
+struct MergeRequestWindow {
+    repo: TempDir,
+    _data: TempDir,
+    webview: WebviewWindow<MockRuntime>,
+    _app: App<MockRuntime>,
+}
+
+fn open_window_in(repo: TempDir) -> MergeRequestWindow {
+    let data = TempDir::new().unwrap();
+    let app = with_commands(mock_builder())
+        .build(mock_context(noop_assets()))
+        .unwrap();
+    manage(&app, repo.path(), &app_folder(data.path()));
+    let webview = WebviewWindowBuilder::new(&app, "main", WebviewUrl::default())
+        .build()
+        .unwrap();
+    MergeRequestWindow {
+        repo,
+        _data: data,
+        webview,
+        _app: app,
+    }
+}
+
+/// A window on `scripts/range-repo.sh`'s repository, whose `origin` is the fake GitLab's project.
+fn range_repo_window() -> MergeRequestWindow {
+    let repo = TempDir::new().unwrap();
+    let built = Command::new(in_this_repository("scripts/range-repo.sh"))
+        .arg(repo.path())
+        .output()
+        .unwrap();
+    assert!(built.status.success(), "{built:?}");
+    open_window_in(repo)
+}
+
+fn invoke(window: &MergeRequestWindow, cmd: &str, args: Value) -> Result<Value, Value> {
+    invoke_on(&window.webview, cmd, args)
+}
+
+#[test]
+fn a_repository_with_a_gitlab_remote_is_found_and_one_without_is_none() {
+    let found = range_repo_window();
+    let common_dir = found.repo.path().join(".git").display().to_string();
+    assert_eq!(
+        invoke(&found, "find_gitlab_project", json!({})),
+        Ok(json!({ "kind": "found", "repository": common_dir }))
+    );
+
+    let plain = TempDir::new().unwrap();
+    git_ok(plain.path(), &["init", "-q"]).unwrap();
+    let none = open_window_in(plain);
+    assert_eq!(
+        invoke(&none, "find_gitlab_project", json!({})),
+        Ok(json!({ "kind": "none" }))
+    );
+    let reply = block_on(open_merge_request(
+        none.webview.clone(),
+        MergeRequestIid(13),
+    ));
+    assert_eq!(
+        serde_json::to_value(reply.unwrap()).unwrap(),
+        json!({ "kind": "failed", "message": NO_PROJECT })
+    );
+    let ended = list(&none);
+    assert_eq!(
+        ended,
+        [json!({ "kind": "end", "end": { "kind": "failed", "message": NO_PROJECT } })]
+    );
+}
+
+/// Lists through the command; every message, in the order the window's channel got them.
+fn list(window: &MergeRequestWindow) -> Vec<Value> {
+    let (sender, received) = mpsc::channel();
+    let channel = Channel::new(move |body| {
+        let InvokeResponseBody::Json(json) = body else {
+            panic!("a message that is not JSON");
+        };
+        sender.send(serde_json::from_str(&json).unwrap()).unwrap();
+        Ok(())
+    });
+    block_on(list_merge_requests(window.webview.clone(), channel)).unwrap();
+    received.try_iter().collect()
+}
+
+#[cfg(unix)]
+mod through_glab {
+    use std::thread;
+    use std::time::{Duration, Instant};
+
+    use yamt_conflict_repo::run_ignored_in_child;
+
+    use super::*;
+
+    const FAKE_OPEN_LOG: &str = "YAMT_FAKE_OPEN_LOG";
+    const LIST_TEST: &str = "merge_requests::tests::through_glab::a_list_on_path_s_glab";
+    const JOB_TEST: &str = "merge_requests::tests::through_glab::job_pages_on_path_s_opener";
+    const LISTED_JOB: &str = "https://gitlab.example/taskboard/taskboard/-/jobs/302";
+    const UNLISTED_JOB: &str = "https://gitlab.example/taskboard/taskboard/-/jobs/999";
+    const OPEN_WAIT: Duration = Duration::from_secs(10);
+    const POLL: Duration = Duration::from_millis(10);
+
+    /// Runs `test` in a child whose PATH starts with the committed fake glab on the scenario `merge-requests`
+    /// and the fake xdg-open, their logs in a folder of this test's.
+    fn run_with_fakes(test: &str) {
+        let fake = TempDir::new().unwrap();
+        let inherited = std::env::var_os("PATH").unwrap_or_default();
+        let mut folders = vec![
+            in_this_repository("scripts/fake-glab"),
+            in_this_repository("scripts/fake-open"),
+        ];
+        folders.extend(std::env::split_paths(&inherited));
+        let path = std::env::join_paths(folders).unwrap();
+        let scenario = in_this_repository("tests/glab/merge-requests");
+
+        let ran = run_ignored_in_child(&[test], |child| {
+            child
+                .env("PATH", path)
+                .env("YAMT_FAKE_GLAB", scenario)
+                .env("YAMT_FAKE_GLAB_LOG", fake.path().join("glab.log"))
+                .env(FAKE_OPEN_LOG, fake.path().join("open.log"));
+        });
+
+        ran.unwrap_or_else(|error| panic!("{error}"));
+    }
+
+    fn iids(page: &Value) -> Vec<u64> {
+        let rows = page["rows"].as_array().unwrap();
+        rows.iter()
+            .map(|row| row["iid"].as_u64().unwrap())
+            .collect()
+    }
+
+    fn open_job(window: &MergeRequestWindow, page: &str) -> Value {
+        invoke(window, "open_job_page", json!({ "page": page })).unwrap()
+    }
+
+    fn opened_log() -> String {
+        let log = std::env::var_os(FAKE_OPEN_LOG).unwrap();
+        std::fs::read_to_string(log).unwrap_or_default()
+    }
+
+    fn wait_for_the_opener() -> String {
+        let deadline = Instant::now() + OPEN_WAIT;
+        loop {
+            let logged = opened_log();
+            if !logged.is_empty() {
+                return logged;
+            }
+            assert!(Instant::now() < deadline, "the opener never ran");
+            thread::sleep(POLL);
+        }
+    }
+
+    #[test]
+    fn every_page_then_one_end_reaches_the_window_s_channel() {
+        run_with_fakes(LIST_TEST);
+    }
+
+    #[test]
+    #[ignore = "run by every_page_then_one_end_reaches_the_window_s_channel"]
+    fn a_list_on_path_s_glab() {
+        let window = range_repo_window();
+
+        let messages = list(&window);
+
+        let kinds: Vec<&str> = messages
+            .iter()
+            .map(|message| message["kind"].as_str().unwrap())
+            .collect();
+        assert_eq!(kinds, ["page", "page", "end"]);
+        assert_eq!(messages[2]["end"], json!({ "kind": "loaded" }));
+        let sent: Vec<Vec<u64>> = messages[..2]
+            .iter()
+            .map(|message| iids(&message["page"]))
+            .collect();
+        assert_eq!(sent, [vec![13, 12, 11], vec![9, 8]]);
+        assert_eq!(messages[0]["page"]["me"], "sam");
+    }
+
+    #[test]
+    fn only_a_job_page_a_list_sent_is_handed_to_the_browser() {
+        run_with_fakes(JOB_TEST);
+    }
+
+    #[test]
+    #[ignore = "run by only_a_job_page_a_list_sent_is_handed_to_the_browser"]
+    fn job_pages_on_path_s_opener() {
+        let window = range_repo_window();
+        let not_offered = json!({ "kind": "notOffered" });
+
+        assert_eq!(open_job(&window, LISTED_JOB), not_offered);
+        list(&window);
+        assert_eq!(open_job(&window, UNLISTED_JOB), not_offered);
+        assert_eq!(opened_log(), "");
+        assert_eq!(open_job(&window, LISTED_JOB), json!({ "kind": "opened" }));
+
+        assert_eq!(wait_for_the_opener(), format!("argv: {LISTED_JOB}\n"));
+    }
+}
