index 0000000..d812a78
--- /dev/null
+++ 2/crates/cli/src/args.rs
@@ -0,0 +1,107 @@
+use std::path::PathBuf;
+
+use yamt_merge_core::Options;
+
+use crate::{Error, Result};
+
+const DEFAULT_REPO: &str = ".";
+const DEFAULT_GOLDEN_DIR: &str = "tests/golden";
+
+pub(crate) enum Command {
+    Classify {
+        sides: [PathBuf; 3],
+        options: Options,
+        json: bool,
+    },
+    Scan {
+        repo: PathBuf,
+    },
+    GoldenRun {
+        dir: PathBuf,
+    },
+    GoldenUpdate {
+        dir: PathBuf,
+    },
+    Fixture {
+        case_dir: PathBuf,
+    },
+}
+
+pub(crate) fn parse(args: &[String]) -> Result<Command> {
+    let (command, rest) = args
+        .split_first()
+        .ok_or_else(|| usage("missing command".to_owned()))?;
+    match command.as_str() {
+        "classify" => parse_classify(rest),
+        "scan" => Ok(Command::Scan {
+            repo: optional_path(rest, DEFAULT_REPO)?,
+        }),
+        "golden" => parse_golden(rest),
+        "fixture" => Ok(Command::Fixture {
+            case_dir: required_path(rest, "<case-dir>")?,
+        }),
+        other => Err(usage(format!("unknown command `{other}`"))),
+    }
+}
+
+fn parse_classify(args: &[String]) -> Result<Command> {
+    let mut paths = Vec::new();
+    let mut options = Options::default();
+    let mut json = false;
+    let mut args = args.iter();
+    while let Some(arg) = args.next() {
+        match arg.as_str() {
+            "--json" => json = true,
+            "--gap" => options.gap = parse_gap(args.next())?,
+            flag if flag.starts_with("--") => {
+                return Err(usage(format!("unknown option `{flag}`")));
+            }
+            path => paths.push(PathBuf::from(path)),
+        }
+    }
+    let sides = <[PathBuf; 3]>::try_from(paths)
+        .map_err(|_| usage("classify needs exactly <base> <local> <remote>".to_owned()))?;
+    Ok(Command::Classify {
+        sides,
+        options,
+        json,
+    })
+}
+
+fn parse_gap(value: Option<&String>) -> Result<u32> {
+    value
+        .and_then(|value| value.parse().ok())
+        .ok_or_else(|| usage("--gap needs a whole number of lines".to_owned()))
+}
+
+fn parse_golden(args: &[String]) -> Result<Command> {
+    let (action, rest) = args
+        .split_first()
+        .ok_or_else(|| usage("golden needs `run` or `update`".to_owned()))?;
+    let dir = optional_path(rest, DEFAULT_GOLDEN_DIR)?;
+    match action.as_str() {
+        "run" => Ok(Command::GoldenRun { dir }),
+        "update" => Ok(Command::GoldenUpdate { dir }),
+        other => Err(usage(format!("unknown golden action `{other}`"))),
+    }
+}
+
+fn optional_path(args: &[String], default: &str) -> Result<PathBuf> {
+    match args {
+        [] => Ok(PathBuf::from(default)),
+        [path] => Ok(PathBuf::from(path)),
+        [_, extra, ..] => Err(usage(format!("unexpected argument `{extra}`"))),
+    }
+}
+
+fn required_path(args: &[String], name: &str) -> Result<PathBuf> {
+    match args {
+        [] => Err(usage(format!("missing {name}"))),
+        [path] => Ok(PathBuf::from(path)),
+        [_, extra, ..] => Err(usage(format!("unexpected argument `{extra}`"))),
+    }
+}
+
+fn usage(problem: String) -> Error {
+    Error::Usage { problem }
+}
diff --git 1/crates/cli/src/case.rs 2/crates/cli/src/case.rs
new file mode 100644
index 0000000..30b2b71
--- /dev/null
+++ 2/crates/cli/src/case.rs
@@ -0,0 +1,98 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use crate::{Error, Result};
+
+const EXPECTED_FILE: &str = "expected.json";
+
+pub(crate) struct Case {
+    pub(crate) name: String,
+    pub(crate) dir: PathBuf,
+    pub(crate) extension: String,
+    pub(crate) base: String,
+    pub(crate) local: String,
+    pub(crate) remote: String,
+}
+
+#[derive(Default)]
+struct SideExtensions {
+    base: Option<String>,
+    local: Option<String>,
+    remote: Option<String>,
+}
+
+impl Case {
+    pub(crate) fn load(dir: &Path) -> Result<Case> {
+        let name = dir
+            .file_name()
+            .and_then(|name| name.to_str())
+            .ok_or_else(|| malformed(&dir.display().to_string(), "it has no UTF-8 directory name"))?
+            .to_owned();
+        let extension = side_extension(dir, &name)?;
+        let read_side = |side: &str| read_text(&dir.join(format!("{side}.{extension}")));
+        Ok(Case {
+            base: read_side("base")?,
+            local: read_side("local")?,
+            remote: read_side("remote")?,
+            name,
+            dir: dir.to_path_buf(),
+            extension,
+        })
+    }
+
+    pub(crate) fn expected_path(&self) -> PathBuf {
+        self.dir.join(EXPECTED_FILE)
+    }
+}
+
+fn side_extension(dir: &Path, case: &str) -> Result<String> {
+    let mut found = SideExtensions::default();
+    for entry in fs::read_dir(dir).map_err(|source| read_error(dir, source))? {
+        let file_name = entry.map_err(|source| read_error(dir, source))?.file_name();
+        let Some((side, extension)) = file_name.to_str().and_then(|name| name.split_once('.'))
+        else {
+            continue;
+        };
+        let slot = match side {
+            "base" => &mut found.base,
+            "local" => &mut found.local,
+            "remote" => &mut found.remote,
+            _ => continue,
+        };
+        if slot.replace(extension.to_owned()).is_some() {
+            return Err(malformed(case, &format!("more than one {side}.*")));
+        }
+    }
+    let base = found
+        .base
+        .ok_or_else(|| malformed(case, "missing base.*"))?;
+    let local = found
+        .local
+        .ok_or_else(|| malformed(case, "missing local.*"))?;
+    let remote = found
+        .remote
+        .ok_or_else(|| malformed(case, "missing remote.*"))?;
+    if local != base || remote != base {
+        let problem = format!("base.{base}, local.{local} and remote.{remote} differ in extension");
+        return Err(malformed(case, &problem));
+    }
+    Ok(base)
+}
+
+pub(crate) fn read_text(path: &Path) -> Result<String> {
+    fs::read_to_string(path).map_err(|source| read_error(path, source))
+}
+
+pub(crate) fn read_error(path: &Path, source: std::io::Error) -> Error {
+    Error::Read {
+        path: path.display().to_string(),
+        source,
+    }
+}
+
+fn malformed(case: &str, problem: &str) -> Error {
+    Error::MalformedCase {
+        case: case.to_owned(),
+        problem: problem.to_owned(),
+    }
+}
diff --git 1/crates/cli/src/classify.rs 2/crates/cli/src/classify.rs
new file mode 100644
index 0000000..6243eaa
--- /dev/null
+++ 2/crates/cli/src/classify.rs
@@ -0,0 +1,70 @@
+use std::path::PathBuf;
+
+use yamt_merge_core::{Chunk, ChunkKind, Options, compute_chunks};
+
+use crate::case::read_text;
+use crate::{Result, print, print_lines};
+
+pub(crate) fn classify(sides: &[PathBuf; 3], options: Options, json: bool) -> Result<()> {
+    let [base, local, remote] = sides;
+    let base = read_text(base)?;
+    let local = read_text(local)?;
+    let remote = read_text(remote)?;
+    let chunks = compute_chunks(&base, &local, &remote, &options);
+    if json {
+        print(&chunks_json(&chunks)?)
+    } else {
+        print_lines(&chunk_table(&chunks))
+    }
+}
+
+pub(crate) fn chunks_json(chunks: &[Chunk]) -> Result<String> {
+    Ok(serde_json::to_string_pretty(chunks)? + "\n")
+}
+
+fn chunk_table(chunks: &[Chunk]) -> Vec<String> {
+    let mut table = Vec::with_capacity(chunks.len() + 1);
+    for chunk in chunks {
+        table.push(format!(
+            "{} {} base[{}+{}] local[{}+{}] remote[{}+{}]",
+            chunk.id.0,
+            kind_name(chunk.kind),
+            chunk.base.start.0,
+            chunk.base.len,
+            chunk.local.start.0,
+            chunk.local.len,
+            chunk.remote.start.0,
+            chunk.remote.len,
+        ));
+    }
+    table.push(kind_summary(chunks));
+    table
+}
+
+pub(crate) fn kind_summary(chunks: &[Chunk]) -> String {
+    let mut local_only = 0;
+    let mut remote_only = 0;
+    let mut both_same = 0;
+    let mut conflict = 0;
+    for chunk in chunks {
+        match chunk.kind {
+            ChunkKind::LocalOnly => local_only += 1,
+            ChunkKind::RemoteOnly => remote_only += 1,
+            ChunkKind::BothSame => both_same += 1,
+            ChunkKind::Conflict => conflict += 1,
+        }
+    }
+    format!(
+        "total {}: LocalOnly {local_only}, RemoteOnly {remote_only}, BothSame {both_same}, Conflict {conflict}",
+        chunks.len()
+    )
+}
+
+fn kind_name(kind: ChunkKind) -> &'static str {
+    match kind {
+        ChunkKind::LocalOnly => "LocalOnly",
+        ChunkKind::RemoteOnly => "RemoteOnly",
+        ChunkKind::BothSame => "BothSame",
+        ChunkKind::Conflict => "Conflict",
+    }
+}
