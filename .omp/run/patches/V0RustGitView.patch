+    require_conflict(root, &["merge", "remote"]);
+    let merge_msg = root.join(".git/MERGE_MSG");
+    fs::set_permissions(&merge_msg, fs::Permissions::from_mode(UNREADABLE)).unwrap();
+
+    assert_eq!(remote_name_of(root), None);
+}
