+import { agentCommand } from "./internal/command";
+import { replayTurns } from "./internal/conversation";
+import { requestFailure, sourceText, type AgentFailure } from "./internal/failure";
+import { AgentProcess, type Outcome } from "./internal/process";
+import { NEW_SESSION_RESULT, PROMPT_RESULT } from "./internal/protocol";
+import {
+  agentSessionId,
+  stopEnding,
+  TurnRun,
+  type AgentSessionId,
+  type Ending,
+  type TurnEnd,
+  type TurnEvents,
+} from "./internal/session";
+import type { FileEdit, TurnView } from "./internal/turn";
+
+export type { AgentFailure } from "./internal/failure";
+export type { AgentSessionId, TurnEnd, TurnEvents } from "./internal/session";
+export type {
+  FileEdit,
+  Step,
+  StepKind,
+  StepOutput,
+  StepStatus,
+  TurnEntry,
+  TurnView,
+} from "./internal/turn";
+export { agentSessionId } from "./internal/session";
+export {
+  DEFAULT_FIRST_MESSAGE,
+  firstMessage,
+  PLACEHOLDERS,
+  unknownPlaceholders,
+  type Placeholder,
+} from "./internal/firstMessage";
+export { DEFAULT_AGENT_COMMAND } from "./internal/command";
+
+export type AskRequest = { readonly session: AgentSessionId | null; readonly text: string };
+
+export interface RunningTurn {
+  readonly ended: Promise<TurnEnd>;
+  /** Sends `session/cancel` once the prompt is out; before that, the turn ends without prompting. */
+  stop(): void;
+}
+
+export type ConversationLoad =
+  | { readonly kind: "loaded"; readonly turns: readonly TurnView[] }
+  | { readonly kind: "failed"; readonly failure: AgentFailure };
+
+export type EditDiff =
+  | { readonly kind: "differences"; readonly differences: readonly Difference[] }
+  | { readonly kind: "tooLarge"; readonly limit: number }
+  | { readonly kind: "failed"; readonly message: string };
+
+export type AgentSetup = {
+  readonly source: AgentSource;
+  readonly command: () => readonly string[];
+  readonly timers?: Timers;
+};
+
+type Asking = {
+  stopped: boolean;
+  prompted: { readonly agent: AgentProcess; readonly session: AgentSessionId } | null;
+};
+
+/** The window's one agent: the checkout made and the process started at the first ask. */
+export class AgentClient {
+  readonly #source: AgentSource;
+  readonly #command: () => readonly string[];
+  readonly #timers: Timers;
+  readonly #running = new Set<TurnRun>();
+  readonly #bySession = new Map<AgentSessionId, TurnRun>();
+  #checkout: Promise<Outcome<CheckoutFolder>> | null = null;
+  #agent: Promise<Outcome<AgentProcess>> | null = null;
+  #destroyed = false;
+
+  constructor(setup: AgentSetup) {
+    this.#source = setup.source;
+    this.#command = setup.command;
+    this.#timers = setup.timers ?? SYSTEM_TIMERS;
+  }
+
+  ask(request: AskRequest, events: TurnEvents): RunningTurn {
+    const run = new TurnRun(events, this.#timers);
+    const { session } = request;
+    if (session !== null && this.#bySession.has(session)) {
+      run.end({ kind: "failed", failure: { kind: "busy" } });
+      return { ended: run.ended, stop: () => undefined };
+    }
+    if (this.#destroyed) {
+      run.end({ kind: "stopped" });
+      return { ended: run.ended, stop: () => undefined };
+    }
+    const asking: Asking = { stopped: false, prompted: null };
+    this.#running.add(run);
+    if (session !== null) {
+      this.#bySession.set(session, run);
+    }
+    void this.#turn(run, request, asking).finally(() => this.#forget(run));
+    return {
+      ended: run.ended,
+      stop: () => {
+        asking.stopped = true;
+        asking.prompted?.agent.cancel(asking.prompted.session);
+      },
+    };
+  }
+
+  async loadConversation(session: AgentSessionId): Promise<ConversationLoad> {
+    if (this.#bySession.has(session)) {
+      return { kind: "failed", failure: { kind: "busy" } };
+    }
+    const agent = await this.#ready();
+    if (!agent.ok) {
+      return { kind: "failed", failure: agent.failure };
+    }
+    const replay = await agent.value.replay(session);
+    return replay.ok
+      ? { kind: "loaded", turns: replayTurns(replay.value) }
+      : { kind: "failed", failure: replay.failure };
+  }
+
+  async editDiff(edit: FileEdit): Promise<EditDiff> {
+    try {
+      const result = await this.#source.diffTexts(edit.oldText ?? "", edit.newText);
+      if (result.ok) {
+        return { kind: "differences", differences: result.value };
+      }
+      const { failure } = result;
+      return failure.kind === "ColumnTooLarge"
+        ? { kind: "tooLarge", limit: failure.limit }
+        : { kind: "failed", message: sourceText(failure) };
+    } catch (error) {
+      return { kind: "failed", message: String(error) };
+    }
+  }
+
+  /** Whether any turn is running. */
+  isRunning(): boolean {
+    return this.#running.size > 0;
+  }
+
+  /** Stops the process; running turns end stopped. */
+  destroy(): void {
+    this.#destroyed = true;
+    void this.#agent?.then((agent) => (agent.ok ? agent.value.stop() : undefined));
+  }
+
+  async #turn(run: TurnRun, request: AskRequest, asking: Asking): Promise<void> {
+    const agent = await this.#ready();
+    if (!agent.ok) {
+      run.end(this.#failed(agent.failure));
+      return;
+    }
+    const session = await this.#session(agent.value, request.session, run);
+    if (!session.ok) {
+      run.end(this.#failed(session.failure));
+      return;
+    }
+    const unlisten = agent.value.listen(session.value, run);
+    if (asking.stopped || this.#destroyed) {
+      unlisten();
+      run.end({ kind: "stopped" });
+      return;
+    }
+    asking.prompted = { agent: agent.value, session: session.value };
+    const prompt = [{ type: "text", text: request.text }];
+    const reply = await agent.value.request("session/prompt", { sessionId: session.value, prompt });
+    unlisten();
+    run.end(this.#promptEnding(agent.value, reply));
+  }
+
+  async #session(
+    agent: AgentProcess,
+    session: AgentSessionId | null,
+    run: TurnRun,
+  ): Promise<Outcome<AgentSessionId>> {
+    if (session !== null) {
+      const failure = await agent.load(session);
+      return failure === null ? { ok: true, value: session } : { ok: false, failure };
+    }
+    const reply = await agent.request("session/new", { cwd: agent.folder, mcpServers: [] });
+    if (reply.kind !== "result") {
+      return { ok: false, failure: requestFailure("session/new", reply, agent.exit) };
+    }
+    const parsed = parseWith(NEW_SESSION_RESULT, reply.value);
+    const created = parsed.ok ? agentSessionId(parsed.value.sessionId) : null;
+    if (created === null) {
+      const message = parsed.ok ? "an empty session id" : parsed.reason;
+      return { ok: false, failure: { kind: "refused", method: "session/new", message } };
+    }
+    agent.created(created);
+    this.#bySession.set(created, run);
+    run.session(created);
+    return { ok: true, value: created };
+  }
+
+  #promptEnding(agent: AgentProcess, reply: Reply): Ending {
+    if (reply.kind === "result") {
+      const parsed = parseWith(PROMPT_RESULT, reply.value);
+      return parsed.ok
+        ? stopEnding(parsed.value.stopReason)
+        : this.#failed({ kind: "refused", method: "session/prompt", message: parsed.reason });
+    }
+    if (reply.kind === "closed" && agent.isStopping) {
+      return { kind: "stopped" };
+    }
+    return this.#failed(requestFailure("session/prompt", reply, agent.exit));
+  }
+
+  #failed(failure: AgentFailure): Ending {
+    return this.#destroyed ? { kind: "stopped" } : { kind: "failed", failure };
+  }
+
+  #forget(run: TurnRun): void {
+    this.#running.delete(run);
+    for (const [session, each] of this.#bySession) {
+      if (each === run) {
+        this.#bySession.delete(session);
+      }
+    }
+  }
+
+  async #ready(): Promise<Outcome<AgentProcess>> {
+    const folder = await this.#folder();
+    if (!folder.ok) {
+      return folder;
+    }
+    const starting = this.#agent ?? this.#start(folder.value);
+    this.#agent = starting;
+    const started = await starting;
+    if (!started.ok && this.#agent === starting) {
+      this.#agent = null;
+      if (started.failure.kind === "checkoutFailed") {
+        this.#checkout = null;
+      }
+    }
+    return started;
+  }
+
+  async #folder(): Promise<Outcome<CheckoutFolder>> {
+    const preparing = this.#checkout ?? this.#prepare();
+    this.#checkout = preparing;
+    const prepared = await preparing;
+    if (!prepared.ok && this.#checkout === preparing) {
+      this.#checkout = null;
+    }
+    return prepared;
+  }
+
+  async #prepare(): Promise<Outcome<CheckoutFolder>> {
+    try {
+      const result = await this.#source.prepareCheckout();
+      if (!result.ok) {
+        return {
+          ok: false,
+          failure: { kind: "checkoutFailed", message: sourceText(result.failure) },
+        };
+      }
+      const ready = result.value;
+      return ready.kind === "Ready"
+        ? { ok: true, value: ready.folder }
+        : { ok: false, failure: { kind: "checkoutFailed", message: ready.message } };
+    } catch (error) {
+      return { ok: false, failure: { kind: "checkoutFailed", message: String(error) } };
+    }
+  }
+
+  #start(folder: CheckoutFolder): Promise<Outcome<AgentProcess>> {
+    const command = agentCommand(this.#command());
+    if (command === null) {
+      return Promise.resolve({ ok: false, failure: { kind: "noCommand" } });
+    }
+    const starting = AgentProcess.start({
+      source: this.#source,
+      command,
+      folder,
+      timers: this.#timers,
+      exited: () => {
+        if (this.#agent === starting) {
+          this.#agent = null;
+        }
+      },
+    });
+    return starting;
+  }
+}
diff --git a/frontend/src/agent/internal/answers.test.ts b/frontend/src/agent/internal/answers.test.ts
new file mode 100644
index 0000000..8e07a72
--- /dev/null
+++ b/frontend/src/agent/internal/answers.test.ts
@@ -0,0 +1,148 @@
+import { expect, test } from "vitest";
+
+import type { CheckoutFolder } from "../../ipc";
+import { INVALID_PARAMS, METHOD_NOT_FOUND } from "../../jsonrpc";
+import { answerRequest } from "./answers";
+
+function isFolder(path: string): path is CheckoutFolder {
+  return path.startsWith("/");
+}
+
+function folder(path: string): CheckoutFolder {
+  if (!isFolder(path)) {
+    throw new Error(path);
+  }
+  return path;
+}
+
+const CHECKOUT = folder("/data/checkout");
+
+const EVERY_OPTION = [
+  { optionId: "allow_once", name: "Allow once", kind: "allow_once" },
+  { optionId: "allow_always", name: "Always allow", kind: "allow_always" },
+  { optionId: "reject_once", name: "Reject", kind: "reject_once" },
+  { optionId: "reject_always", name: "Always reject", kind: "reject_always" },
+] as const;
+
+function permission(toolCall: object, options: readonly object[] = EVERY_OPTION): unknown {
+  return { sessionId: "s1", toolCall: { toolCallId: "call-1", ...toolCall }, options };
+}
+
+function selected(optionId: string): unknown {
+  return { outcome: { outcome: "selected", optionId } };
+}
+
+test("a command is allowed once, whatever its paths", () => {
+  const params = permission({
+    title: "rm -v /tmp/x",
+    kind: "execute",
+    locations: [{ path: "/tmp/x" }],
+  });
+  const { answer, refused } = answerRequest("session/request_permission", params, CHECKOUT);
+  expect(answer).toEqual({ kind: "result", value: selected("allow_once"), log: null });
+  expect(refused).toBeNull();
+});
+
+test("a delete inside the checkout is allowed once", () => {
+  const params = permission({ title: "Delete a.ts", locations: [{ path: "/data/checkout/a.ts" }] });
+  const { answer, refused } = answerRequest("session/request_permission", params, CHECKOUT);
+  expect(answer).toEqual({ kind: "result", value: selected("allow_once"), log: null });
+  expect(refused).toBeNull();
+});
+
+test("a move whose destination is outside is refused once and shown on its step", () => {
+  const params = permission({
+    title: "Move a.ts to /tmp/a.ts",
+    kind: "move",
+    locations: [{ path: "/data/checkout/a.ts" }, { path: "/tmp/a.ts" }],
+  });
+  const { answer, refused } = answerRequest("session/request_permission", params, CHECKOUT);
+  expect(answer).toEqual({
+    kind: "result",
+    value: selected("reject_once"),
+    log: 'Refused "Move a.ts to /tmp/a.ts"',
+  });
+  expect(refused).toEqual({
+    session: "s1",
+    refusal: { step: "call-1", title: "Move a.ts to /tmp/a.ts", paths: ["/tmp/a.ts"] },
+  });
+});
+
+test.each([
+  ["no locations", { title: "delete", kind: "delete" }],
+  ["empty locations", { title: "delete", kind: "delete", locations: [] }],
+  ["null locations and no kind", { title: "delete", kind: null, locations: null }],
+])("%s and not a command is refused", (_, toolCall) => {
+  const { answer, refused } = answerRequest(
+    "session/request_permission",
+    permission(toolCall),
+    CHECKOUT,
+  );
+  expect(answer).toMatchObject({ kind: "result", value: selected("reject_once") });
+  expect(refused?.refusal).toEqual({ step: "call-1", title: "delete", paths: [] });
+});
+
+test("a refusal without a title names the step id", () => {
+  const params = permission({ locations: [{ path: "/elsewhere" }] });
+  const { refused } = answerRequest("session/request_permission", params, CHECKOUT);
+  expect(refused?.refusal).toEqual({ step: "call-1", title: "call-1", paths: ["/elsewhere"] });
+});
+
+test("options without allow_once answer cancelled, logged", () => {
+  const options = [EVERY_OPTION[1], EVERY_OPTION[2], EVERY_OPTION[3]];
+  const params = permission({ title: "git status", kind: "execute" }, options);
+  const { answer } = answerRequest("session/request_permission", params, CHECKOUT);
+  expect(answer).toEqual({
+    kind: "result",
+    value: { outcome: { outcome: "cancelled" } },
+    log: 'No allow_once option for "git status"; answered cancelled',
+  });
+});
+
+test("options without reject_once answer cancelled and still show the refusal", () => {
+  const params = permission({ title: "Delete /tmp/x", locations: [{ path: "/tmp/x" }] }, [
+    EVERY_OPTION[0],
+    EVERY_OPTION[3],
+  ]);
+  const { answer, refused } = answerRequest("session/request_permission", params, CHECKOUT);
+  expect(answer).toMatchObject({ value: { outcome: { outcome: "cancelled" } } });
+  expect(refused?.refusal.paths).toEqual(["/tmp/x"]);
+});
+
+test("never an *_always option, even when it comes first", () => {
+  const options = [EVERY_OPTION[1], EVERY_OPTION[3], EVERY_OPTION[0], EVERY_OPTION[2]];
+  const allowed = answerRequest(
+    "session/request_permission",
+    permission({ kind: "execute" }, options),
+    CHECKOUT,
+  );
+  const refusedOne = answerRequest(
+    "session/request_permission",
+    permission({ kind: "delete" }, options),
+    CHECKOUT,
+  );
+  expect(allowed.answer).toMatchObject({ value: selected("allow_once") });
+  expect(refusedOne.answer).toMatchObject({ value: selected("reject_once") });
+});
+
+test.each(["fs/read_text_file", "terminal/create", "session/elicit"])(
+  "%s is not answered",
+  (method) => {
+    const { answer, refused } = answerRequest(method, {}, CHECKOUT);
+    expect(answer).toEqual({
+      kind: "error",
+      code: METHOD_NOT_FOUND,
+      message: `yamt does not answer ${method}`,
+      log: `yamt does not answer ${method}`,
+    });
+    expect(refused).toBeNull();
+  },
+);
+
+test("a malformed permission request is an invalid-params error", () => {
+  const { answer } = answerRequest("session/request_permission", { toolCall: {} }, CHECKOUT);
+  expect(answer).toMatchObject({ kind: "error", code: INVALID_PARAMS });
+  expect(
+    answer.kind === "error" && answer.message.startsWith("Malformed session/request_permission: "),
+  ).toBe(true);
+});
diff --git a/frontend/src/agent/internal/answers.ts b/frontend/src/agent/internal/answers.ts
new file mode 100644
index 0000000..abb633b
--- /dev/null
+++ b/frontend/src/agent/internal/answers.ts
@@ -0,0 +1,68 @@
+import type { CheckoutFolder } from "../../ipc";
+import { INVALID_PARAMS, METHOD_NOT_FOUND, parseWith, type Answer } from "../../jsonrpc";
+import { relativeInside } from "./inside";
+import { PERMISSION_REQUEST, type PermissionRequest } from "./protocol";
+import type { Refusal } from "./turn";
+
+export type Answered = {
+  readonly answer: Answer;
+  readonly refused: { readonly session: string; readonly refusal: Refusal } | null;
+};
+
+type Choice = "allow_once" | "reject_once";
+
+const PERMISSION = "session/request_permission";
+
+function outsidePaths({ toolCall }: PermissionRequest, folder: CheckoutFolder): string[] | null {
+  if (toolCall.kind === "execute") {
+    return null;
+  }
+  const paths = (toolCall.locations ?? []).map((location) => location.path);
+  const outside = paths.filter((path) => relativeInside(path, folder) === null);
+  return paths.length > 0 && outside.length === 0 ? null : outside;
+}
+
+function chosen(request: PermissionRequest, choice: Choice, title: string): Answer {
+  const option = request.options.find((each) => each.kind === choice);
+  if (option === undefined) {
+    const log = `No ${choice} option for "${title}"; answered cancelled`;
+    return { kind: "result", value: { outcome: { outcome: "cancelled" } }, log };
+  }
+  const value = { outcome: { outcome: "selected", optionId: option.optionId } };
+  return { kind: "result", value, log: choice === "allow_once" ? null : `Refused "${title}"` };
+}
+
+/**
+ * The fixed table of answers to the agent's requests: a command is allowed; any other
+ * permission only when every path lies inside the checkout; never an `*_always` option, which omp
+ * remembers for the whole session.
+ */
+export function answerRequest(method: string, params: unknown, folder: CheckoutFolder): Answered {
+  if (method !== PERMISSION) {
+    const message = `yamt does not answer ${method}`;
+    return {
+      answer: { kind: "error", code: METHOD_NOT_FOUND, message, log: message },
+      refused: null,
+    };
+  }
+  const parsed = parseWith(PERMISSION_REQUEST, params);
+  if (!parsed.ok) {
+    const message = `Malformed ${PERMISSION}: ${parsed.reason}`;
+    return {
+      answer: { kind: "error", code: INVALID_PARAMS, message, log: message },
+      refused: null,
+    };
+  }
+  const request = parsed.value;
+  const { toolCallId, title } = request.toolCall;
+  const shown = title ?? toolCallId;
+  const outside = outsidePaths(request, folder);
+  if (outside === null) {
+    return { answer: chosen(request, "allow_once", shown), refused: null };
+  }
+  const refusal: Refusal = { step: toolCallId, title: shown, paths: outside };
+  return {
+    answer: chosen(request, "reject_once", shown),
+    refused: { session: request.sessionId, refusal },
+  };
+}
