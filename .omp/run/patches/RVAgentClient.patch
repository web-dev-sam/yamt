+import { expect, test } from "vitest";
+
+import { relativeInside } from "./inside";
+
+const CHECKOUT = "/data/yamt/range/repo/pair/checkout";
+
+test.each([
+  ["a file inside", `${CHECKOUT}/src/a.ts`, "src/a.ts"],
+  ["a relative path is taken from the checkout", "src/a.ts", "src/a.ts"],
+  ["`.` segments and doubled separators are dropped", `${CHECKOUT}/./src//a.ts`, "src/a.ts"],
+  ["`..` that stays inside", `${CHECKOUT}/src/../docs/b.md`, "docs/b.md"],
+  ["a sibling folder whose name starts with the checkout's", `${CHECKOUT}2/a.ts`, null],
+  ["`..` that climbs out", `${CHECKOUT}/../checkout2/a.ts`, null],
+  ["`..` back into the checkout", `${CHECKOUT}/../checkout/a.ts`, "a.ts"],
+  ["the checkout itself", CHECKOUT, null],
+  ["the checkout with a trailing separator", `${CHECKOUT}/`, null],
+  ["a parent folder", "/data/yamt", null],
+  ["an unrelated absolute path", "/tmp/yamt-record-outside.txt", null],
+  ["a relative path climbing out", "../../outside.txt", null],
+])("%s", (_, path, expected) => {
+  expect(relativeInside(path, CHECKOUT)).toBe(expected);
+});
+
+test("a Windows drive in another case and backslashes are inside", () => {
+  const folder = "C:\\Users\\Ann\\AppData\\yamt\\checkout";
+  expect(relativeInside("c:\\users\\ann\\appdata\\YAMT\\checkout\\src\\a.ts", folder)).toBe(
+    "src/a.ts",
+  );
+  expect(relativeInside("C:/Users/Ann/AppData/yamt/checkout/b.ts", folder)).toBe("b.ts");
+});
+
+test("another drive is outside", () => {
+  expect(
+    relativeInside(
+      "D:\\Users\\Ann\\AppData\\yamt\\checkout\\a.ts",
+      "C:\\Users\\Ann\\AppData\\yamt\\checkout",
+    ),
+  ).toBeNull();
+});
+
+test("case counts outside a drive-letter folder", () => {
+  expect(relativeInside("/Data/yamt/range/repo/pair/checkout/a.ts", CHECKOUT)).toBeNull();
+  expect(relativeInside("/data/yamt/range/repo/pair/Checkout/a.ts", CHECKOUT)).toBeNull();
+});
diff --git a/frontend/src/agent/internal/inside.ts b/frontend/src/agent/internal/inside.ts
new file mode 100644
index 0000000..8e382b3
--- /dev/null
+++ b/frontend/src/agent/internal/inside.ts
@@ -0,0 +1,30 @@
+const SEPARATOR = /[\\/]/u;
+const ROOTED = /^(?:[\\/]|[A-Za-z]:)/u;
+const DRIVE = /^[A-Za-z]:$/u;
+
+function lexical(path: string): string[] {
+  const kept: string[] = [];
+  for (const segment of path.split(SEPARATOR)) {
+    if (segment === "..") {
+      kept.pop();
+    } else if (segment !== "" && segment !== ".") {
+      kept.push(segment);
+    }
+  }
+  return kept;
+}
+
+/**
+ * The path relative to the folder, `/`-separated, when it lies strictly inside it. `.` and `..` are
+ * resolved without the disk, so symlinks are not followed; a drive-letter folder compares without case.
+ */
+export function relativeInside(path: string, folder: string): string | null {
+  const base = lexical(folder);
+  const target = lexical(ROOTED.test(path) ? path : `${folder}/${path}`);
+  const foldsCase = DRIVE.test(base[0] ?? "");
+  const compared = foldsCase ? target.map((segment) => segment.toLowerCase()) : target;
+  const inside = base.every(
+    (segment, at) => (foldsCase ? segment.toLowerCase() : segment) === compared[at],
+  );
+  return inside && target.length > base.length ? target.slice(base.length).join("/") : null;
+}
diff --git a/frontend/src/agent/internal/process.ts b/frontend/src/agent/internal/process.ts
new file mode 100644
index 0000000..eb7dd84
--- /dev/null
+++ b/frontend/src/agent/internal/process.ts
@@ -0,0 +1,243 @@
+import {
+  log,
+  type AgentCommand,
+  type AgentRun,
+  type AgentSource,
+  type CheckoutFolder,
+  type HostEvent,
+} from "../../ipc";
+import { Connection, parseWith, type Answer, type Reply, type Timers } from "../../jsonrpc";
+import { answerRequest } from "./answers";
+import {
+  loadFailure,
+  requestFailure,
+  sourceText,
+  startFailure,
+  type AgentFailure,
+  type Exit,
+} from "./failure";
+import { INITIALIZE_RESULT, parseUpdate, PROTOCOL_VERSION } from "./protocol";
+import type { AgentSessionId } from "./session";
+import type { Refusal, TurnUpdate } from "./turn";
+
+export type Outcome<T> =
+  | { readonly ok: true; readonly value: T }
+  | { readonly ok: false; readonly failure: AgentFailure };
+
+export type Listener = {
+  readonly update: (update: TurnUpdate) => void;
+  readonly refuse: (refusal: Refusal) => void;
+};
+
+export type ProcessStart = {
+  readonly source: AgentSource;
+  readonly command: AgentCommand;
+  readonly folder: CheckoutFolder;
+  readonly timers: Timers;
+  readonly exited: () => void;
+};
+
+const INITIALIZE_PARAMS = {
+  protocolVersion: PROTOCOL_VERSION,
+  clientCapabilities: { fs: { readTextFile: false, writeTextFile: false }, terminal: false },
+  clientInfo: { name: "yamt" },
+};
+
+/** One `omp acp` process: its connection, the sessions it has loaded, updates routed by session. */
+export class AgentProcess {
+  readonly folder: CheckoutFolder;
+  readonly #source: AgentSource;
+  readonly #connection: Connection;
+  readonly #exited: () => void;
+  readonly #listeners = new Map<string, Listener>();
+  readonly #loads = new Map<AgentSessionId, Promise<AgentFailure | null>>();
+  #run: AgentRun | null = null;
+  #lastLog: string | null = null;
+  #exit: Exit | null = null;
+  #stopping = false;
+
+  private constructor(start: ProcessStart) {
+    this.folder = start.folder;
+    this.#source = start.source;
+    this.#exited = start.exited;
+    this.#connection = new Connection(
+      {
+        send: (text) => this.#send(text),
+        request: (method, params) => this.#answer(method, params),
+        notification: (method, params) => this.#notified(method, params),
+        log: (text) => log.info("agent.connection", { text }),
+      },
+      start.timers,
+      { cancelNotification: null },
+    );
+  }
+
+  static async start(start: ProcessStart): Promise<Outcome<AgentProcess>> {
+    const agent = new AgentProcess(start);
+    const spawned = await agent.#spawn(start.command);
+    if (!spawned.ok) {
+      return spawned;
+    }
+    agent.#run = spawned.value;
+    const failure = await agent.#initialize();
+    return failure === null ? { ok: true, value: agent } : { ok: false, failure };
+  }
+
+  get isStopping(): boolean {
+    return this.#stopping;
+  }
+
+  get exit(): Exit | null {
+    return this.#exit;
+  }
+
+  request(method: string, params: unknown): Promise<Reply> {
+    return this.#connection.requestUntilAnswered(method, params);
+  }
+
+  cancel(session: AgentSessionId): void {
+    this.#connection.notify("session/cancel", { sessionId: session });
+  }
+
+  listen(session: AgentSessionId, listener: Listener): () => void {
+    this.#listeners.set(session, listener);
+    return () => {
+      if (this.#listeners.get(session) === listener) {
+        this.#listeners.delete(session);
+      }
+    };
+  }
+
+  created(session: AgentSessionId): void {
+    this.#loads.set(session, Promise.resolve(null));
+  }
+
+  /** Loads the session once per process before a prompt; its replay goes to no one. */
+  load(session: AgentSessionId): Promise<AgentFailure | null> {
+    const known = this.#loads.get(session);
+    if (known !== undefined) {
+      return known;
+    }
+    const loading = this.#loadReply(session).then((reply) => {
+      if (reply.kind === "result") {
+        return null;
+      }
+      if (this.#loads.get(session) === loading) {
+        this.#loads.delete(session);
+      }
+      return loadFailure(reply, this.#exit);
+    });
+    this.#loads.set(session, loading);
+    return loading;
+  }
+
+  /** Loads the session and hands back its replay. */
+  async replay(session: AgentSessionId): Promise<Outcome<TurnUpdate[]>> {
+    const updates: TurnUpdate[] = [];
+    const unlisten = this.listen(session, {
+      update: (update) => updates.push(update),
+      refuse: () => undefined,
+    });
+    const reply = await this.#loadReply(session);
+    unlisten();
+    if (reply.kind !== "result") {
+      return { ok: false, failure: loadFailure(reply, this.#exit) };
+    }
+    this.created(session);
+    return { ok: true, value: updates };
+  }
+
+  async stop(): Promise<void> {
+    this.#stopping = true;
+    if (this.#run !== null && this.#exit === null) {
+      await this.#source.stopAgent(this.#run);
+    }
+  }
+
+  async #spawn(command: AgentCommand): Promise<Outcome<AgentRun>> {
+    const { program } = command;
+    try {
+      const reply = await this.#source.startAgent(command, (event) => this.#onEvent(event));
+      if (!reply.ok) {
+        const message = sourceText(reply.failure);
+        return { ok: false, failure: { kind: "spawnFailed", program, message } };
+      }
+      const started = reply.value;
+      return started.kind === "Started"
+        ? { ok: true, value: started.run }
+        : { ok: false, failure: startFailure(started) };
+    } catch (error) {
+      return { ok: false, failure: { kind: "spawnFailed", program, message: String(error) } };
+    }
+  }
+
+  #loadReply(session: AgentSessionId): Promise<Reply> {
+    return this.request("session/load", { sessionId: session, cwd: this.folder, mcpServers: [] });
+  }
+
+  async #initialize(): Promise<AgentFailure | null> {
+    const reply = await this.request("initialize", INITIALIZE_PARAMS);
+    if (reply.kind !== "result") {
+      return requestFailure("initialize", reply, this.#exit);
+    }
+    const parsed = parseWith(INITIALIZE_RESULT, reply.value);
+    if (parsed.ok && parsed.value.protocolVersion === PROTOCOL_VERSION) {
+      return null;
+    }
+    void this.stop();
+    const found = parsed.ok ? `protocol version ${parsed.value.protocolVersion}` : parsed.reason;
+    return {
+      kind: "refused",
+      method: "initialize",
+      message: `${found}; yamt speaks ${PROTOCOL_VERSION}`,
+    };
+  }
+
+  #send(text: string): void {
+    if (this.#run !== null) {
+      this.#source.sendToAgent(this.#run, text);
+    }
+  }
+
+  #answer(method: string, params: unknown): Answer {
+    const { answer, refused } = answerRequest(method, params, this.folder);
+    if (refused !== null) {
+      this.#listeners.get(refused.session)?.refuse(refused.refusal);
+    }
+    return answer;
+  }
+
+  #notified(method: string, params: unknown): void {
+    if (method !== "session/update") {
+      return;
+    }
+    const parsed = parseUpdate(params, this.folder);
+    if (!parsed.ok) {
+      log.warn("agent.update_dropped", { reason: parsed.reason });
+    } else if (parsed.value.update !== null) {
+      this.#listeners.get(parsed.value.session)?.update(parsed.value.update);
+    }
+  }
+
+  #onEvent(event: HostEvent): void {
+    switch (event.kind) {
+      case "Message":
+        this.#connection.receive(event.text);
+        return;
+      case "Log":
+        this.#lastLog = event.line;
+        log.debug("agent.stderr", { line: event.line });
+        return;
+      case "Exited":
+        this.#exit = { code: event.code, lastLog: this.#lastLog };
+        log.info("agent.exited", { code: event.code ?? "none", stopping: this.#stopping });
+        this.#connection.close();
+        this.#exited();
+        return;
+      default: {
+        const _exhaustive: never = event;
+        return _exhaustive;
+      }
+    }
+  }
+}
diff --git a/frontend/src/agent/internal/protocol.ts b/frontend/src/agent/internal/protocol.ts
new file mode 100644
index 0000000..fba6634
--- /dev/null
+++ b/frontend/src/agent/internal/protocol.ts
@@ -0,0 +1,148 @@
+import * as v from "valibot";
+
+import type { CheckoutFolder } from "../../ipc";
+import { parseWith, type Parsed } from "../../jsonrpc";
+import { relativeInside } from "./inside";
+import type { StepKind, StepOutput, StepStatus, StepUpdate, TurnUpdate } from "./turn";
+
+export const PROTOCOL_VERSION = 1;
+
+export type SessionUpdate = { readonly session: string; readonly update: TurnUpdate | null };
+
+const STEP_KINDS: Readonly<Record<string, StepKind>> = {
+  read: "read",
+  edit: "edit",
+  delete: "delete",
+  move: "move",
+  search: "search",
+  execute: "execute",
+  think: "think",
+  fetch: "fetch",
+};
+
+const STEP_STATUSES: Readonly<Record<string, StepStatus>> = {
+  pending: "pending",
+  in_progress: "running",
+  completed: "done",
+  failed: "failed",
+};
+
+const CHUNK_KINDS = {
+  agent_thought_chunk: "thought",
+  agent_message_chunk: "said",
+  user_message_chunk: "asked",
+} as const;
+
+const READ_KINDS: Readonly<Record<string, true>> = {
+  agent_thought_chunk: true,
+  agent_message_chunk: true,
+  user_message_chunk: true,
+  tool_call: true,
+  tool_call_update: true,
+};
+
+export const INITIALIZE_RESULT = v.object({ protocolVersion: v.number() });
+
+export const NEW_SESSION_RESULT = v.object({ sessionId: v.string() });
+
+export const PROMPT_RESULT = v.object({ stopReason: v.string() });
+
+const TEXT_BLOCK = v.object({ type: v.literal("text"), text: v.string() });
+
+const CONTENT = v.variant("type", [
+  v.object({ type: v.literal("content"), content: v.unknown() }),
+  v.object({
+    type: v.literal("diff"),
+    path: v.string(),
+    oldText: v.nullish(v.string()),
+    newText: v.string(),
+  }),
+]);
+
+const MAYBE_TEXT = v.nullish(v.string());
+
+const UPDATE = v.variant("sessionUpdate", [
+  v.object({
+    sessionUpdate: v.picklist(["agent_thought_chunk", "agent_message_chunk", "user_message_chunk"]),
+    content: v.unknown(),
+  }),
+  v.object({
+    sessionUpdate: v.picklist(["tool_call", "tool_call_update"]),
+    toolCallId: v.string(),
+    title: MAYBE_TEXT,
+    kind: MAYBE_TEXT,
+    status: MAYBE_TEXT,
+    content: v.nullish(v.array(v.unknown())),
+  }),
+]);
+
+const UPDATE_PARAMS = v.object({ sessionId: v.string(), update: v.unknown() });
+
+const UPDATE_KIND = v.object({ sessionUpdate: v.string() });
+
+export const PERMISSION_REQUEST = v.object({
+  sessionId: v.string(),
+  toolCall: v.object({
+    toolCallId: v.string(),
+    title: MAYBE_TEXT,
+    kind: MAYBE_TEXT,
+    locations: v.nullish(v.array(v.object({ path: v.string() }))),
+  }),
+  options: v.array(v.object({ optionId: v.string(), kind: v.string() })),
+});
+
+export type PermissionRequest = v.InferOutput<typeof PERMISSION_REQUEST>;
+
+function blockText(content: unknown): string {
+  const text = parseWith(TEXT_BLOCK, content);
+  return text.ok ? text.value.text : "";
+}
+
+function stepOutput(item: unknown, folder: CheckoutFolder): StepOutput[] {
+  const parsed = parseWith(CONTENT, item);
+  if (!parsed.ok) {
+    return [];
+  }
+  const content = parsed.value;
+  if (content.type === "content") {
+    const text = parseWith(TEXT_BLOCK, content.content);
+    return text.ok ? [{ kind: "text", text: text.value.text }] : [];
+  }
+  const path = relativeInside(content.path, folder) ?? content.path;
+  return [
+    { kind: "edit", edit: { path, oldText: content.oldText ?? null, newText: content.newText } },
+  ];
+}
+
+function toUpdate(update: v.InferOutput<typeof UPDATE>, folder: CheckoutFolder): TurnUpdate {
+  if (update.sessionUpdate === "tool_call" || update.sessionUpdate === "tool_call_update") {
+    const { toolCallId: id, title, kind, status, content } = update;
+    const step: StepUpdate = {
+      id,
+      title: title ?? null,
+      kind: kind === undefined || kind === null ? null : (STEP_KINDS[kind] ?? "other"),
+      status: status === undefined || status === null ? null : (STEP_STATUSES[status] ?? null),
+      outputs:
+        content === undefined || content === null
+          ? null
+          : content.flatMap((item) => stepOutput(item, folder)),
+    };
+    return { kind: "step", step };
+  }
+  return { kind: CHUNK_KINDS[update.sessionUpdate], text: blockText(update.content) };
+}
+
+export function parseUpdate(params: unknown, folder: CheckoutFolder): Parsed<SessionUpdate> {
+  const envelope = parseWith(UPDATE_PARAMS, params);
+  if (!envelope.ok) {
+    return envelope;
+  }
+  const { sessionId: session, update } = envelope.value;
+  const parsed = parseWith(UPDATE, update);
+  if (parsed.ok) {
+    return { ok: true, value: { session, update: toUpdate(parsed.value, folder) } };
+  }
+  const read = parseWith(UPDATE_KIND, update);
+  const isRead = read.ok && Object.hasOwn(READ_KINDS, read.value.sessionUpdate);
+  return isRead ? parsed : { ok: true, value: { session, update: null } };
+}
