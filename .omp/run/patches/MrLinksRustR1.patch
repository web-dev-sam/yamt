+#[test]
+fn a_web_url_with_an_upper_case_host_or_port_443_keeps_every_link() {
+    for web_origin in ["https://GitLab.Example", "https://gitlab.example:443"] {
+        let project = Project {
+            web_origin: Some(web_origin.to_owned()),
+            ..project()
+        };
+        let server = Server::of(&project).unwrap();
+
