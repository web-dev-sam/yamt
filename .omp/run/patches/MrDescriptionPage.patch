diff --git a/frontend/src/ui/mergeRequestDescriptionText.test.ts b/frontend/src/ui/mergeRequestDescriptionText.test.ts
new file mode 100644
index 0000000..1a814f8
--- /dev/null
+++ b/frontend/src/ui/mergeRequestDescriptionText.test.ts
@@ -0,0 +1,57 @@
+import { expect, test } from "vitest";
+
+import type { DescriptionReply } from "../ipc";
+import {
+  CLOSE_DESCRIPTION,
+  DESCRIPTION_LOADING,
+  descriptionRefusalText,
+  IMAGE_STAND_IN,
+  NO_DESCRIPTION,
+  SHOW_DESCRIPTION,
+  TASK_DONE,
+  TASK_INAPPLICABLE,
+  TASK_OPEN,
+} from "./mergeRequestDescriptionText";
+
+type Refused = Exclude<DescriptionReply, { readonly kind: "read" }>;
+
+const REFUSALS: Readonly<Record<Refused["kind"], readonly [Refused, string]>> = {
+  glabMissing: [
+    { kind: "glabMissing" },
+    "glab is not installed (not found on PATH) — install glab, then Retry.",
+  ],
+  notLoggedIn: [
+    { kind: "notLoggedIn", detail: "gitlab.example: not logged in" },
+    "glab is not logged in: gitlab.example: not logged in — run glab auth login in a terminal, then Retry.",
+  ],
+  failed: [
+    { kind: "failed", message: "glab timed out" },
+    "Could not read the description: glab timed out",
+  ],
+};
+
+test("the description panel's words", () => {
+  expect([
+    SHOW_DESCRIPTION,
+    CLOSE_DESCRIPTION,
+    DESCRIPTION_LOADING,
+    NO_DESCRIPTION,
+    TASK_DONE,
+    TASK_OPEN,
+    TASK_INAPPLICABLE,
+    IMAGE_STAND_IN,
+  ]).toEqual([
+    "Show description",
+    "Close",
+    "Loading…",
+    "No description.",
+    "Done",
+    "Not done",
+    "Not applicable",
+    "picture",
+  ]);
+});
+
+test.each(Object.values(REFUSALS))("a refused description says why: %o", (reply, words) => {
+  expect(descriptionRefusalText(reply)).toBe(words);
+});
diff --git a/frontend/src/ui/mergeRequestDescriptionText.ts b/frontend/src/ui/mergeRequestDescriptionText.ts
new file mode 100644
index 0000000..8ea3a85
--- /dev/null
+++ b/frontend/src/ui/mergeRequestDescriptionText.ts
@@ -0,0 +1,29 @@
+import type { DescriptionReply } from "../ipc";
+import { GLAB_MISSING_TEXT, glabNotLoggedInText } from "./glab";
+
+export const SHOW_DESCRIPTION = "Show description";
+export const CLOSE_DESCRIPTION = "Close";
+export const DESCRIPTION_LOADING = "Loading…";
+export const NO_DESCRIPTION = "No description.";
+export const TASK_DONE = "Done";
+export const TASK_OPEN = "Not done";
+export const TASK_INAPPLICABLE = "Not applicable";
+export const IMAGE_STAND_IN = "picture";
+
+/** One sentence; the panel puts Retry (aiText.ts RETRY) after it. */
+export function descriptionRefusalText(
+  reply: Exclude<DescriptionReply, { readonly kind: "read" }>,
+): string {
+  switch (reply.kind) {
+    case "glabMissing":
+      return `${GLAB_MISSING_TEXT} — install glab, then Retry.`;
+    case "notLoggedIn":
+      return `${glabNotLoggedInText(reply.detail)} — run glab auth login in a terminal, then Retry.`;
+    case "failed":
+      return `Could not read the description: ${reply.message}`;
+    default: {
+      const _exhaustive: never = reply;
+      return _exhaustive;
+    }
+  }
+}
