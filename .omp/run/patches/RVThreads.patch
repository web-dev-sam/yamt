--- /dev/null
+++ b/crates/review/src/thread_file.rs
@@ -0,0 +1,299 @@
+use std::collections::HashSet;
+use std::fs;
+use std::io::ErrorKind;
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Error, Message, MessageId, Result, ThreadId, ThreadLine};
+
+pub(crate) const THREADS_FILE: &str = "threads.json";
+const FORMAT: u32 = 1;
+const FIRST_THREAD: ThreadId = ThreadId(1);
+const FIRST_MESSAGE: MessageId = MessageId(1);
+const TEMP_SUFFIX: &str = ".tmp";
+
+/// `threads.json`: every thread in creation order, and the ids the next thread and message get.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct ThreadFile {
+    format: u32,
+    next_thread: ThreadId,
+    next_message: MessageId,
+    pub(crate) threads: Vec<StoredThread>,
+}
+
+/// A thread as stored: on a path, since a file id may name another file once the list changes.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct StoredThread {
+    pub(crate) id: ThreadId,
+    pub(crate) path: String,
+    pub(crate) line: ThreadLine,
+    pub(crate) session: Option<String>,
+    pub(crate) messages: Vec<Message>,
+}
+
+#[derive(Deserialize)]
+struct FormatOnly {
+    format: u32,
+}
+
+impl ThreadFile {
+    pub(crate) fn empty() -> ThreadFile {
+        ThreadFile {
+            format: FORMAT,
+            next_thread: FIRST_THREAD,
+            next_message: FIRST_MESSAGE,
+            threads: Vec::new(),
+        }
+    }
+
+    /// Refused as `Broken` at `path` when the id taken would leave none for one more thread.
+    pub(crate) fn take_thread_id(&mut self, path: &Path) -> Result<ThreadId> {
+        let id = self.next_thread;
+        self.next_thread = ThreadId(id.0.saturating_add(1));
+        self.require_room(path)?;
+        Ok(id)
+    }
+
+    /// Refused as `Broken` at `path` when the id taken would leave none for one more message.
+    pub(crate) fn take_message_id(&mut self, path: &Path) -> Result<MessageId> {
+        let id = self.next_message;
+        self.next_message = MessageId(id.0.saturating_add(1));
+        self.require_room(path)?;
+        Ok(id)
+    }
+
+    pub(crate) fn thread_mut(&mut self, thread: ThreadId) -> Option<&mut StoredThread> {
+        self.threads.iter_mut().find(|stored| stored.id == thread)
+    }
+
+    /// The message and the path of its thread.
+    pub(crate) fn message_mut(&mut self, message: MessageId) -> Option<(&str, &mut Message)> {
+        for thread in &mut self.threads {
+            if let Some(found) = thread
+                .messages
+                .iter_mut()
+                .find(|stored| stored.id == message)
+            {
+                return Some((thread.path.as_str(), found));
+            }
+        }
+        None
+    }
+
+    fn require_room(&self, path: &Path) -> Result<()> {
+        match no_room_left(self.next_thread, self.next_message) {
+            Some(message) => Err(broken(path, message)),
+            None => Ok(()),
+        }
+    }
+
+    /// What makes a parsed file unusable: no id left for a new thread or message, an id repeated or at or
+    /// above its counter, or a thread without messages.
+    fn problem(&self) -> Option<String> {
+        if let Some(message) = no_room_left(self.next_thread, self.next_message) {
+            return Some(message);
+        }
+        let mut threads = HashSet::new();
+        let mut messages = HashSet::new();
+        for thread in &self.threads {
+            if !threads.insert(thread.id) {
+                return Some(format!("the thread id {} appears twice", thread.id.0));
+            }
+            if thread.id.0 >= self.next_thread.0 {
+                return Some(format!(
+                    "the thread id {} is not below `nextThread` {}",
+                    thread.id.0, self.next_thread.0
+                ));
+            }
+            if thread.messages.is_empty() {
+                return Some(format!("the thread {} has no messages", thread.id.0));
+            }
+            for message in &thread.messages {
+                if let Some(problem) = self.message_problem(message.id, &mut messages) {
+                    return Some(problem);
+                }
+            }
+        }
+        None
+    }
+
+    fn message_problem(&self, id: MessageId, seen: &mut HashSet<MessageId>) -> Option<String> {
+        if !seen.insert(id) {
+            return Some(format!("the message id {} appears twice", id.0));
+        }
+        if id.0 >= self.next_message.0 {
+            return Some(format!(
+                "the message id {} is not below `nextMessage` {}",
+                id.0, self.next_message.0
+            ));
+        }
+        None
+    }
+}
+
+/// Why a file with these counters has no id left for a new thread or message.
+fn no_room_left(next_thread: ThreadId, next_message: MessageId) -> Option<String> {
+    if next_thread.0 == u32::MAX {
+        return Some(format!(
+            "`nextThread` {} leaves no id for a new thread",
+            u32::MAX
+        ));
+    }
+    if next_message.0 == u32::MAX {
+        return Some(format!(
+            "`nextMessage` {} leaves no id for a new message",
+            u32::MAX
+        ));
+    }
+    None
+}
+
+/// `None` when there is no `threads.json` at `path`.
+pub(crate) fn read_threads(path: &Path) -> Result<Option<ThreadFile>> {
+    match fs::read(path) {
+        Ok(bytes) => parsed(path, &bytes).map(Some),
+        Err(error) if error.kind() == ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(Error::ReadFailed {
+            path: path.to_owned(),
+            message: error.to_string(),
+        }),
+    }
+}
+
+fn parsed(path: &Path, bytes: &[u8]) -> Result<ThreadFile> {
+    let FormatOnly { format } =
+        serde_json::from_slice(bytes).map_err(|error| broken(path, error.to_string()))?;
+    if format > FORMAT {
+        return Err(Error::NewerFormat {
+            path: path.to_owned(),
+            format,
+        });
+    }
+    if format != FORMAT {
+        return Err(broken(path, format!("format {format} is not {FORMAT}")));
+    }
+    let file: ThreadFile =
+        serde_json::from_slice(bytes).map_err(|error| broken(path, error.to_string()))?;
+    match file.problem() {
+        Some(message) => Err(broken(path, message)),
+        None => Ok(file),
+    }
+}
+
+fn broken(path: &Path, message: String) -> Error {
+    Error::Broken {
+        path: path.to_owned(),
+        message,
+    }
+}
+
+/// Through a temporary file beside `path` and a rename, so a kill leaves the old or the new text.
+pub(crate) fn write_threads(path: &Path, file: &ThreadFile) -> Result<()> {
+    let write_failed = |message: String| Error::WriteFailed {
+        path: path.to_owned(),
+        message,
+    };
+    let mut text =
+        serde_json::to_string_pretty(file).map_err(|error| write_failed(error.to_string()))?;
+    text.push('\n');
+    let mut temp = path.as_os_str().to_owned();
+    temp.push(TEMP_SUFFIX);
+    let temp = PathBuf::from(temp);
+    if let Err(error) = fs::write(&temp, text).and_then(|()| fs::rename(&temp, path)) {
+        fs::remove_file(&temp).ok();
+        return Err(write_failed(error.to_string()));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn problem_of(json: &str) -> String {
+        match parsed(Path::new(THREADS_FILE), json.as_bytes()) {
+            Err(Error::Broken { message, .. }) => message,
+            other => panic!("expected Broken, got {other:?}"),
+        }
+    }
+
+    const MESSAGE_1: &str =
+        r#"{"id":1,"body":{"kind":"note","text":"a"},"written":0,"posting":{"kind":"notQueued"}}"#;
+
+    fn thread(id: u32, messages: &str) -> String {
+        format!(
+            r#"{{"id":{id},"path":"a.txt","line":{{"kind":"added","right":0}},"session":null,"messages":[{messages}]}}"#
+        )
+    }
+
+    fn file(next_thread: u32, next_message: u32, threads: &[String]) -> String {
+        format!(
+            r#"{{"format":1,"nextThread":{next_thread},"nextMessage":{next_message},"threads":[{}]}}"#,
+            threads.join(",")
+        )
+    }
+
+    #[test]
+    fn a_thread_id_at_next_thread_is_broken_so_ids_never_repeat() {
+        let message = problem_of(&file(1, 2, &[thread(1, MESSAGE_1)]));
+        assert_eq!(message, "the thread id 1 is not below `nextThread` 1");
+    }
+
+    #[test]
+    fn a_thread_id_below_next_thread_reads() {
+        let json = file(2, 2, &[thread(1, MESSAGE_1)]);
+        assert!(parsed(Path::new(THREADS_FILE), json.as_bytes()).is_ok());
+    }
+
+    #[test]
+    fn a_message_id_at_next_message_is_broken_so_ids_never_repeat() {
+        let message = problem_of(&file(2, 1, &[thread(1, MESSAGE_1)]));
+        assert_eq!(message, "the message id 1 is not below `nextMessage` 1");
+    }
+
+    #[test]
+    fn a_message_id_repeated_in_another_thread_is_broken() {
+        let message = problem_of(&file(3, 2, &[thread(1, MESSAGE_1), thread(2, MESSAGE_1)]));
+        assert_eq!(message, "the message id 1 appears twice");
+    }
+
+    #[test]
+    fn counters_at_u32_max_are_broken_so_a_new_id_never_overflows() {
+        assert_eq!(
+            problem_of(&file(u32::MAX, 1, &[])),
+            "`nextThread` 4294967295 leaves no id for a new thread"
+        );
+        assert_eq!(
+            problem_of(&file(1, u32::MAX, &[])),
+            "`nextMessage` 4294967295 leaves no id for a new message"
+        );
+    }
+
+    #[test]
+    fn format_0_is_broken_not_newer() {
+        assert_eq!(problem_of(r#"{"format":0}"#), "format 0 is not 1");
+    }
+
+    #[test]
+    fn taking_the_id_below_u32_max_is_refused_and_leaves_room_checks_to_both_counters() {
+        let path = Path::new(THREADS_FILE);
+        let mut threads = ThreadFile::empty();
+        threads.next_thread = ThreadId(u32::MAX - 1);
+        assert!(matches!(
+            threads.take_thread_id(path),
+            Err(Error::Broken { .. })
+        ));
+        let mut messages = ThreadFile::empty();
+        messages.next_message = MessageId(u32::MAX - 1);
+        assert!(matches!(
+            messages.take_message_id(path),
+            Err(Error::Broken { .. })
+        ));
+        let mut room = ThreadFile::empty();
+        room.next_thread = ThreadId(u32::MAX - 2);
+        assert_eq!(room.take_thread_id(path).unwrap(), ThreadId(u32::MAX - 2));
+        assert_eq!(room.take_message_id(path).unwrap(), FIRST_MESSAGE);
+    }
+}
diff --git a/crates/review/src/thread_store.rs b/crates/review/src/thread_store.rs
new file mode 100644
index 0000000..347c2e3
--- /dev/null
+++ b/crates/review/src/thread_store.rs
@@ -0,0 +1,283 @@
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use yamt_range::{Range, RangeFileId};
+
+use crate::thread_file::{StoredThread, THREADS_FILE, ThreadFile, read_threads, write_threads};
+use crate::{
+    Error, Message, MessageBody, MessageId, Posting, Result, Thread, ThreadAdded, ThreadId,
+    ThreadLine, ThreadList,
+};
+
+/// The threads of one pair folder; the pair lock makes its process the only writer.
+#[derive(Debug)]
+pub struct ThreadStore {
+    path: PathBuf,
+    file: ThreadFile,
+}
+
+/// A message waiting for the next send: queued, or refused and sent again.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[cfg_attr(not(test), expect(dead_code, reason = "the sender of row 16 reads it"))]
+pub(crate) struct QueuedMessage {
+    pub(crate) thread: ThreadId,
+    pub(crate) message: MessageId,
+    pub(crate) path: String,
+    pub(crate) line: ThreadLine,
+    pub(crate) text: String,
+}
+
+impl ThreadStore {
+    /// Reads `<folder>/threads.json`; a missing file is an empty store, and nothing is written.
+    pub fn open(folder: &Path) -> Result<ThreadStore> {
+        let path = folder.join(THREADS_FILE);
+        let file = read_threads(&path)?.unwrap_or_else(ThreadFile::empty);
+        Ok(ThreadStore { path, file })
+    }
+
+    /// The threads on files of `range`, in creation order; threads on other paths are kept but left out.
+    #[must_use]
+    pub fn list(&self, range: &Range) -> ThreadList {
+        let mut threads = Vec::new();
+        let mut unlisted = Vec::new();
+        for stored in &self.file.threads {
+            match file_at(range, &stored.path) {
+                Some(file) => threads.push(Thread {
+                    id: stored.id,
+                    file,
+                    line: stored.line,
+                    messages: stored.messages.clone(),
+                    session: stored.session.clone(),
+                }),
+                None => unlisted.push(stored.path.as_str()),
+            }
+        }
+        if !unlisted.is_empty() {
+            tracing::warn!(paths = ?unlisted, "review threads kept on files this range does not list");
+        }
+        ThreadList { threads }
+    }
+
+    /// A new thread on `line` of `file`, with `text` as its first message.
+    pub fn add_thread(
+        &mut self,
+        range: &Range,
+        file: RangeFileId,
+        line: ThreadLine,
+        text: &str,
+    ) -> Result<ThreadAdded> {
+        require_text(text)?;
+        let entry = range.entry(file).ok_or(Error::UnknownFile { file })?;
+        let mut next = self.file.clone();
+        let id = next.take_thread_id(&self.path)?;
+        let message = new_message(&mut next, &self.path, text)?;
+        next.threads.push(StoredThread {
+            id,
+            path: entry.path.clone(),
+            line,
+            session: None,
+            messages: vec![message],
+        });
+        self.commit(next)?;
+        Ok(ThreadAdded {
+            thread: id,
+            list: self.list(range),
+        })
+    }
+
+    /// Appends `text` to the thread as a note.
+    pub fn add_note(&mut self, range: &Range, thread: ThreadId, text: &str) -> Result<ThreadList> {
+        require_text(text)?;
+        let mut next = self.file.clone();
+        let message = new_message(&mut next, &self.path, text)?;
+        let stored = next
+            .thread_mut(thread)
+            .filter(|stored| file_at(range, &stored.path).is_some())
+            .ok_or(Error::UnknownThread { thread })?;
+        stored.messages.push(message);
+        self.commit(next)?;
+        Ok(self.list(range))
+    }
+
+    /// Queues the message for the next send with `text`, the message as edited for GitLab.
+    pub fn queue(&mut self, range: &Range, message: MessageId, text: &str) -> Result<ThreadList> {
+        require_text(text)?;
+        let queued = Posting::Queued {
+            text: text.to_owned(),
+        };
+        self.change_posting(range, message, queued)
+    }
+
+    /// Takes the message out of the queue.
+    pub fn unqueue(&mut self, range: &Range, message: MessageId) -> Result<ThreadList> {
+        self.change_posting(range, message, Posting::NotQueued)
+    }
+
+    /// Every queued or refused message, in thread order, then message order.
+    #[cfg_attr(not(test), expect(dead_code, reason = "the sender of row 16 calls it"))]
+    pub(crate) fn queued(&self) -> Vec<QueuedMessage> {
+        let mut queued = Vec::new();
+        for thread in &self.file.threads {
+            for message in &thread.messages {
+                let text = match &message.posting {
+                    Posting::Queued { text } | Posting::Refused { text, .. } => text,
+                    Posting::NotQueued | Posting::Pending { .. } => continue,
+                };
+                queued.push(QueuedMessage {
+                    thread: thread.id,
+                    message: message.id,
+                    path: thread.path.clone(),
+                    line: thread.line,
+                    text: text.clone(),
+                });
+            }
+        }
+        queued
+    }
+
+    /// Stores what a send made of the message.
+    #[cfg_attr(not(test), expect(dead_code, reason = "the sender of row 16 calls it"))]
+    pub(crate) fn record(&mut self, message: MessageId, posting: Posting) -> Result<()> {
+        let mut next = self.file.clone();
+        let (_, stored) = next
+            .message_mut(message)
+            .ok_or(Error::UnknownMessage { message })?;
+        stored.posting = posting;
+        self.commit(next)
+    }
+
+    fn change_posting(
+        &mut self,
+        range: &Range,
+        message: MessageId,
+        posting: Posting,
+    ) -> Result<ThreadList> {
+        let mut next = self.file.clone();
+        let (_, stored) = next
+            .message_mut(message)
+            .filter(|(path, _)| file_at(range, path).is_some())
+            .ok_or(Error::UnknownMessage { message })?;
+        match stored.posting {
+            Posting::Pending { .. } => return Err(Error::MessagePending { message }),
+            Posting::NotQueued | Posting::Queued { .. } | Posting::Refused { .. } => {}
+        }
+        stored.posting = posting;
+        self.commit(next)?;
+        Ok(self.list(range))
+    }
+
+    /// Writes `next` when it differs from the file in memory, then keeps it; a failed write keeps the old one.
+    fn commit(&mut self, next: ThreadFile) -> Result<()> {
+        if next != self.file {
+            write_threads(&self.path, &next)?;
+            self.file = next;
+        }
+        Ok(())
+    }
+}
+
+fn file_at(range: &Range, path: &str) -> Option<RangeFileId> {
+    range
+        .entries()
+        .iter()
+        .find(|entry| entry.path == path)
+        .map(|entry| entry.id)
+}
+
+fn require_text(text: &str) -> Result<()> {
+    if text.trim().is_empty() {
+        return Err(Error::EmptyMessage);
+    }
+    Ok(())
+}
+
+fn new_message(next: &mut ThreadFile, path: &Path, text: &str) -> Result<Message> {
+    Ok(Message {
+        id: next.take_message_id(path)?,
+        body: MessageBody::Note {
+            text: text.to_owned(),
+        },
+        written: seconds_since_1970(),
+        posting: Posting::NotQueued,
+    })
+}
+
+/// A clock set before 1970 stamps 0.
+fn seconds_since_1970() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |since| since.as_secs())
+}
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+
+    use yamt_merge_core::RightLine;
+
+    use super::*;
+
+    const STORED: &str = r#"{"format":1,"nextThread":3,"nextMessage":6,"threads":[
+        {"id":2,"path":"b.txt","line":{"kind":"added","right":4},"session":null,"messages":[
+            {"id":5,"body":{"kind":"note","text":"b"},"written":0,"posting":{"kind":"queued","text":"first"}},
+            {"id":1,"body":{"kind":"note","text":"c"},"written":0,"posting":{"kind":"refused","text":"second","reason":"400"}}]},
+        {"id":1,"path":"a.txt","line":{"kind":"added","right":4},"session":null,"messages":[
+            {"id":2,"body":{"kind":"note","text":"d"},"written":0,"posting":{"kind":"notQueued"}},
+            {"id":3,"body":{"kind":"note","text":"e"},"written":0,"posting":{"kind":"pending","text":"e","draft_note":7,"merge_request":"!1","link":"l"}},
+            {"id":4,"body":{"kind":"note","text":"f"},"written":0,"posting":{"kind":"queued","text":"third"}}]}]}"#;
+
+    fn stored_in(dir: &Path) -> ThreadStore {
+        fs::write(dir.join(THREADS_FILE), STORED).unwrap();
+        ThreadStore::open(dir).unwrap()
+    }
+
+    #[test]
+    fn queued_lists_queued_and_refused_messages_in_thread_then_message_order() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = stored_in(dir.path());
+        let queued: Vec<_> = store
+            .queued()
+            .into_iter()
+            .map(|q| (q.thread.0, q.message.0, q.path, q.line, q.text))
+            .collect();
+        let line = ThreadLine::Added {
+            right: RightLine(4),
+        };
+        let expected = vec![
+            (2, 5, "b.txt".to_owned(), line, "first".to_owned()),
+            (2, 1, "b.txt".to_owned(), line, "second".to_owned()),
+            (1, 4, "a.txt".to_owned(), line, "third".to_owned()),
+        ];
+        assert_eq!(queued, expected);
+    }
+
+    #[test]
+    fn record_writes_the_posting_and_keeps_it() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut store = stored_in(dir.path());
+        let pending = Posting::Pending {
+            text: "first".to_owned(),
+            draft_note: 9,
+            merge_request: "!1".to_owned(),
+            link: "l".to_owned(),
+        };
+        store.record(MessageId(5), pending).unwrap();
+        let reopened = ThreadStore::open(dir.path()).unwrap();
+        assert_eq!(reopened.file, store.file);
+        let ids: Vec<u32> = store.queued().iter().map(|q| q.message.0).collect();
+        assert_eq!(ids, [1, 4]);
+    }
+
+    #[test]
+    fn record_on_an_unknown_message_is_unknown_message() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut store = stored_in(dir.path());
+        let result = store.record(MessageId(42), Posting::NotQueued);
+        assert!(matches!(
+            result,
+            Err(Error::UnknownMessage {
+                message: MessageId(42)
+            })
+        ));
+    }
+}
diff --git a/crates/review/src/thread_types.rs b/crates/review/src/thread_types.rs
new file mode 100644
index 0000000..c60876a
--- /dev/null
+++ b/crates/review/src/thread_types.rs
@@ -0,0 +1,135 @@
+use serde::{Deserialize, Serialize};
+use specta::Type;
+use yamt_merge_core::{LeftLine, RightLine};
+use yamt_range::RangeFileId;
+
+/// A thread's identity; ids never repeat within a pair folder.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, Type)]
+pub struct ThreadId(pub u32);
+
+/// A message's identity; ids never repeat within a pair folder.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, Type)]
+pub struct MessageId(pub u32);
+
+/// The line a thread is on; the variant decides the column that shows it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum ThreadLine {
+    /// A left line inside a difference.
+    Removed {
+        /// The line.
+        left: LeftLine,
+    },
+    /// A right line inside a difference.
+    Added {
+        /// The line.
+        right: RightLine,
+    },
+    /// An unchanged line, shown in the left column.
+    UnchangedOnLeft {
+        /// The line in the left text.
+        left: LeftLine,
+        /// The same line in the right text.
+        right: RightLine,
+    },
+    /// An unchanged line, shown in the right column.
+    UnchangedOnRight {
+        /// The line in the left text.
+        left: LeftLine,
+        /// The same line in the right text.
+        right: RightLine,
+    },
+}
+
+/// What a message says.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum MessageBody {
+    /// Text the user wrote.
+    Note {
+        /// The text as written.
+        text: String,
+    },
+    /// An AI answer, kept in the AI's own session.
+    AiAnswer {
+        /// The answer's turn in the thread's session.
+        turn: u32,
+    },
+}
+
+/// Where a message stands on its way to GitLab.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum Posting {
+    /// Not meant for GitLab.
+    NotQueued,
+    /// Waiting for the next send.
+    Queued {
+        /// The text to post, as edited.
+        text: String,
+    },
+    /// GitLab refused it; it is sent again with the next send.
+    Refused {
+        /// The text to post, as edited.
+        text: String,
+        /// GitLab's words.
+        reason: String,
+    },
+    /// Posted as a draft note of the user's pending review.
+    Pending {
+        /// The text posted.
+        text: String,
+        /// GitLab's id of the draft note.
+        #[specta(type = u32)]
+        draft_note: u64,
+        /// The merge request's reference, "!12".
+        merge_request: String,
+        /// The merge request's Changes page.
+        link: String,
+    },
+}
+
+/// One message of a thread.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, Type)]
+pub struct Message {
+    /// The message's id.
+    pub id: MessageId,
+    /// What it says.
+    pub body: MessageBody,
+    /// When it was added, in seconds since 1970.
+    #[specta(type = u32)]
+    pub written: u64,
+    /// Where it stands on its way to GitLab.
+    pub posting: Posting,
+}
+
+/// A thread on one line of one file of the range.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct Thread {
+    /// The thread's id.
+    pub id: ThreadId,
+    /// The file it is on.
+    pub file: RangeFileId,
+    /// The line it is on.
+    pub line: ThreadLine,
+    /// Its messages in the order they were added; never empty.
+    pub messages: Vec<Message>,
+    /// The AI session the thread's answers live in.
+    pub session: Option<String>,
+}
+
+/// Every thread on a file of the range, in the order they were made.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct ThreadList {
+    /// The threads.
+    pub threads: Vec<Thread>,
+}
+
+/// A new thread's id, and the threads with it.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct ThreadAdded {
+    /// The new thread.
+    pub thread: ThreadId,
+    /// Every thread, the new one last.
+    pub list: ThreadList,
+}
diff --git a/crates/review/tests/threads.rs b/crates/review/tests/threads.rs
new file mode 100644
index 0000000..b46f2bf
--- /dev/null
+++ b/crates/review/tests/threads.rs
@@ -0,0 +1,551 @@
+#![cfg(test)]
+
+use std::fmt::Debug;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use serde_json::Value;
+use yamt_conflict_repo::{ConflictFile, FileKind, TempDir, diverged_repo};
+use yamt_merge_core::{LeftLine, RightLine};
+use yamt_range::{Range, RangeFileId, RangeSpec, Resolved};
+use yamt_review::{
+    Error, MessageBody, MessageId, Posting, Thread, ThreadAdded, ThreadId, ThreadLine, ThreadList,
+    ThreadStore,
+};
+
+const THREADS: &str = "threads.json";
+
+/// `main..local` lists a.txt (0), b.txt (1) and c.txt (2); `main..remote` lists c.txt (0) only.
+fn repo() -> TempDir {
+    let file = |path, base, local, remote| ConflictFile {
+        path,
+        kind: FileKind::Regular,
+        base,
+        local,
+        remote,
+    };
+    let a: &[u8] = b"1\n";
+    diverged_repo(&[
+        file("a.txt", Some(a), Some(b"2\n"), Some(a)),
+        file("b.txt", None, Some(b"new\n"), None),
+        file("c.txt", Some(b"x\n"), Some(b"y\n"), Some(b"z\n")),
+    ])
+    .unwrap()
+}
+
+fn range(root: &Path, text: &str) -> Range {
+    Resolved::resolve(root, &RangeSpec::parse(text).unwrap())
+        .unwrap()
+        .list()
+        .unwrap()
+}
+
+fn local_range(repo: &TempDir) -> Range {
+    range(repo.path(), "main..local")
+}
+
+fn threads_path(folder: &TempDir) -> PathBuf {
+    folder.path().join(THREADS)
+}
+
+fn stored(folder: &TempDir, json: &str) {
+    fs::write(threads_path(folder), json).unwrap();
+}
+
+fn on_disk(folder: &TempDir) -> Vec<u8> {
+    fs::read(threads_path(folder)).unwrap()
+}
+
+fn json_on_disk(folder: &TempDir) -> Value {
+    serde_json::from_slice(&on_disk(folder)).unwrap()
+}
+
+fn added_line() -> ThreadLine {
+    ThreadLine::Added {
+        right: RightLine(0),
+    }
+}
+
+fn note(text: &str) -> MessageBody {
+    MessageBody::Note {
+        text: text.to_owned(),
+    }
+}
+
+fn refusal(folder: &TempDir) -> Error {
+    match ThreadStore::open(folder.path()) {
+        Ok(_) => panic!("the store opened"),
+        Err(error) => error,
+    }
+}
+
+fn broken_message(folder: &TempDir, json: &str) -> String {
+    stored(folder, json);
+    let Error::Broken { path, message } = refusal(folder) else {
+        panic!("expected Broken");
+    };
+    assert_eq!(path, threads_path(folder));
+    message
+}
+
+/// The error's words; the ids they name are the ones asked for.
+fn refused<T: Debug>(result: Result<T, Error>) -> String {
+    match result {
+        Ok(answer) => panic!("expected an error, got {answer:?}"),
+        Err(error) => error.to_string(),
+    }
+}
+
+fn only_thread(list: &ThreadList) -> &Thread {
+    assert_eq!(list.threads.len(), 1, "{list:?}");
+    &list.threads[0]
+}
+
+fn folder_names(folder: &TempDir) -> Vec<String> {
+    let mut names: Vec<String> = fs::read_dir(folder.path())
+        .unwrap()
+        .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    names.sort();
+    names
+}
+
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_secs()
+}
+
+const EVERY_KIND: &str = r#"{
+  "format": 1,
+  "nextThread": 5,
+  "nextMessage": 7,
+  "threads": [
+    { "id": 1, "path": "a.txt", "line": { "kind": "removed", "left": 3 }, "session": "omp-session-1",
+      "messages": [
+        { "id": 1, "body": { "kind": "note", "text": "Why 300?" }, "written": 1761300000, "posting": { "kind": "notQueued" } },
+        { "id": 2, "body": { "kind": "aiAnswer", "turn": 3 }, "written": 1761300001, "posting": { "kind": "queued", "text": "Why 300 ms?" } } ] },
+    { "id": 2, "path": "b.txt", "line": { "kind": "added", "right": 4 }, "session": null,
+      "messages": [
+        { "id": 3, "body": { "kind": "note", "text": "t" }, "written": 1761300002, "posting": { "kind": "refused", "text": "t", "reason": "400 Bad request" } } ] },
+    { "id": 3, "path": "c.txt", "line": { "kind": "unchangedOnLeft", "left": 5, "right": 6 }, "session": null,
+      "messages": [
+        { "id": 4, "body": { "kind": "note", "text": "p" }, "written": 1761300003,
+          "posting": { "kind": "pending", "text": "p", "draft_note": 12345678901, "merge_request": "!12", "link": "https://gitlab.example/g/p/-/merge_requests/12/diffs" } } ] },
+    { "id": 4, "path": "c.txt", "line": { "kind": "unchangedOnRight", "left": 7, "right": 8 }, "session": null,
+      "messages": [
+        { "id": 6, "body": { "kind": "note", "text": "u" }, "written": 1761300004, "posting": { "kind": "notQueued" } } ] }
+  ]
+}"#;
+
+#[test]
+fn a_missing_file_is_an_empty_store_and_nothing_is_written() {
+    let repo = repo();
+    let folder = tempfile::tempdir().unwrap();
+    let store = ThreadStore::open(folder.path()).unwrap();
+    assert_eq!(store.list(&local_range(&repo)).threads, []);
+    assert_eq!(folder_names(&folder), Vec::<String>::new());
+}
+
+#[test]
+fn format_1_round_trips_every_body_and_posting_kind_and_a_session() {
+    let repo = repo();
+    let range = local_range(&repo);
+    let folder = tempfile::tempdir().unwrap();
+    stored(&folder, EVERY_KIND);
+    let mut store = ThreadStore::open(folder.path()).unwrap();
+
+    let list = store.list(&range);
+    let files: Vec<(u32, RangeFileId)> = list.threads.iter().map(|t| (t.id.0, t.file)).collect();
+    assert_eq!(
+        files,
+        [
+            (1, RangeFileId(0)),
+            (2, RangeFileId(1)),
+            (3, RangeFileId(2)),
+            (4, RangeFileId(2))
+        ]
+    );
+    let first = &list.threads[0];
+    assert_eq!(first.session.as_deref(), Some("omp-session-1"));
+    assert_eq!(first.line, ThreadLine::Removed { left: LeftLine(3) });
+    assert_eq!(first.messages[1].body, MessageBody::AiAnswer { turn: 3 });
+    assert_eq!(first.messages[1].written, 1_761_300_001);
+    assert_eq!(
+        list.threads[2].messages[0].posting,
+        Posting::Pending {
+            text: "p".to_owned(),
+            draft_note: 12_345_678_901,
+            merge_request: "!12".to_owned(),
+            link: "https://gitlab.example/g/p/-/merge_requests/12/diffs".to_owned(),
+        }
+    );
+
+    store.add_note(&range, ThreadId(4), "more").unwrap();
+    let mut written = json_on_disk(&folder);
+    written["threads"][3]["messages"]
+        .as_array_mut()
+        .unwrap()
+        .pop();
+    written["nextMessage"] = Value::from(7);
+    let original: Value = serde_json::from_str(EVERY_KIND).unwrap();
+    assert_eq!(written, original);
+}
+
+#[test]
+fn a_broken_file_names_line_and_column_and_is_left_unchanged() {
+    let folder = tempfile::tempdir().unwrap();
+    let json = "{\n  \"format\": 1,\n  oops\n}";
+    let message = broken_message(&folder, json);
+    assert!(message.contains("line 3 column 3"), "{message}");
+    assert_eq!(on_disk(&folder), json.as_bytes());
+    assert_eq!(folder_names(&folder), [THREADS]);
+}
+
+#[test]
+fn a_newer_format_is_refused_and_left_unchanged() {
+    let folder = tempfile::tempdir().unwrap();
+    let json = r#"{"format":2,"anything":"else"}"#;
+    stored(&folder, json);
+    let error = refusal(&folder);
+    assert!(
+        matches!(&error, Error::NewerFormat { path, format: 2 } if *path == threads_path(&folder)),
+        "{error:?}"
+    );
+    assert_eq!(on_disk(&folder), json.as_bytes());
+    assert_eq!(folder_names(&folder), [THREADS]);
+}
+
+fn message_json(id: u32) -> String {
+    format!(
+        r#"{{"id":{id},"body":{{"kind":"note","text":"a"}},"written":0,"posting":{{"kind":"notQueued"}}}}"#
+    )
+}
+
+fn thread_json(id: u32, messages: &[String]) -> String {
+    format!(
+        r#"{{"id":{id},"path":"a.txt","line":{{"kind":"added","right":0}},"session":null,"messages":[{}]}}"#,
+        messages.join(",")
+    )
+}
+
+fn file_json(next_thread: u32, next_message: u32, threads: &[String]) -> String {
+    format!(
+        r#"{{"format":1,"nextThread":{next_thread},"nextMessage":{next_message},"threads":[{}]}}"#,
+        threads.join(",")
+    )
+}
+
+#[test]
+fn repeated_ids_ids_at_or_above_next_and_threads_without_messages_are_broken() {
+    let one = |thread, message| thread_json(thread, &[message_json(message)]);
+    let cases = [
+        (
+            file_json(3, 3, &[one(1, 1), one(1, 2)]),
+            "the thread id 1 appears twice",
+        ),
+        (
+            file_json(2, 3, &[thread_json(1, &[message_json(1), message_json(1)])]),
+            "the message id 1 appears twice",
+        ),
+        (
+            file_json(2, 2, &[one(2, 1)]),
+            "the thread id 2 is not below `nextThread` 2",
+        ),
+        (
+            file_json(2, 2, &[one(1, 3)]),
+            "the message id 3 is not below `nextMessage` 2",
+        ),
+        (
+            file_json(2, 2, &[thread_json(1, &[])]),
+            "the thread 1 has no messages",
+        ),
+    ];
+    for (json, expected) in cases {
+        let folder = tempfile::tempdir().unwrap();
+        assert_eq!(broken_message(&folder, &json), expected);
+        assert_eq!(on_disk(&folder), json.as_bytes());
+    }
+}
+
+#[test]
+fn adding_writes_the_thread_with_its_first_message_and_new_ids() {
+    let repo = repo();
+    let range = local_range(&repo);
+    let folder = tempfile::tempdir().unwrap();
+    let mut store = ThreadStore::open(folder.path()).unwrap();
+    let before = now();
+    let added = store
+        .add_thread(&range, RangeFileId(1), added_line(), "Why 300?")
+        .unwrap();
+    let after = now();
+
+    assert_eq!(added.thread, ThreadId(1));
+    let thread = only_thread(&added.list);
+    assert_eq!(
+        (thread.id, thread.file, thread.line, &thread.session),
+        (ThreadId(1), RangeFileId(1), added_line(), &None)
+    );
+    let first = &thread.messages[0];
+    assert_eq!(first.id, MessageId(1));
+    assert_eq!(first.body, note("Why 300?"));
+    assert_eq!(first.posting, Posting::NotQueued);
+    assert!(
+        (before..=after).contains(&first.written),
+        "{}",
+        first.written
+    );
+
+    let written = json_on_disk(&folder);
+    assert_eq!(written["format"], 1);
+    assert_eq!(written["nextThread"], 2);
+    assert_eq!(written["nextMessage"], 2);
+    assert_eq!(written["threads"][0]["path"], "b.txt");
+    assert_eq!(
+        ThreadStore::open(folder.path()).unwrap().list(&range),
+        added.list
+    );
+
+    let list = store.add_note(&range, ThreadId(1), "Because.").unwrap();
+    let messages = &only_thread(&list).messages;
+    assert_eq!(messages.len(), 2);
+    assert_eq!(messages[1].id, MessageId(2));
+    assert_eq!(messages[1].body, note("Because."));
+    assert_eq!(ThreadStore::open(folder.path()).unwrap().list(&range), list);
+}
+
+#[test]
+fn ids_never_repeat_after_reopening() {
+    let repo = repo();
+    let range = local_range(&repo);
+    let folder = tempfile::tempdir().unwrap();
+    stored(
+        &folder,
+        r#"{"format":1,"nextThread":10,"nextMessage":20,"threads":[{"id":1,"path":"a.txt","line":{"kind":"added","right":0},"session":null,"messages":[{"id":1,"body":{"kind":"note","text":"a"},"written":0,"posting":{"kind":"notQueued"}}]}]}"#,
+    );
+    let mut store = ThreadStore::open(folder.path()).unwrap();
+    let ThreadAdded { thread, list } = store
+        .add_thread(&range, RangeFileId(0), added_line(), "b")
+        .unwrap();
+    assert_eq!(thread, ThreadId(10));
+    assert_eq!(list.threads[1].messages[0].id, MessageId(20));
+
+    let mut reopened = ThreadStore::open(folder.path()).unwrap();
+    let again = reopened
+        .add_thread(&range, RangeFileId(0), added_line(), "c")
+        .unwrap();
+    assert_eq!(again.thread, ThreadId(11));
+    assert_eq!(again.list.threads[2].messages[0].id, MessageId(21));
+}
+
+#[test]
+fn blank_text_is_refused_and_nothing_written() {
+    let repo = repo();
+    let range = local_range(&repo);
+    let folder = tempfile::tempdir().unwrap();
+    let mut store = ThreadStore::open(folder.path()).unwrap();
+    let blank = " \n\t ";
+    let result = store.add_thread(&range, RangeFileId(0), added_line(), blank);
+    assert!(matches!(result, Err(Error::EmptyMessage)), "{result:?}");
+    assert_eq!(folder_names(&folder), Vec::<String>::new());
+
+    let list = store
+        .add_thread(&range, RangeFileId(0), added_line(), "a")
+        .unwrap()
+        .list;
+    let bytes = on_disk(&folder);
+    let note = store.add_note(&range, ThreadId(1), blank);
+    assert!(matches!(note, Err(Error::EmptyMessage)), "{note:?}");
+    let queue = store.queue(&range, MessageId(1), "");
+    assert!(matches!(queue, Err(Error::EmptyMessage)), "{queue:?}");
+    assert_eq!(on_disk(&folder), bytes);
+    assert_eq!(store.list(&range), list);
+}
+
+#[test]
+fn queue_keeps_the_edited_text_and_unqueue_drops_it() {
+    let repo = repo();
+    let range = local_range(&repo);
+    let folder = tempfile::tempdir().unwrap();
+    stored(&folder, EVERY_KIND);
+    let mut store = ThreadStore::open(folder.path()).unwrap();
+
+    let queued = store.queue(&range, MessageId(1), "Why 300 ms?").unwrap();
+    let first = &queued.threads[0].messages[0];
+    assert_eq!(first.body, note("Why 300?"));
+    assert_eq!(
+        first.posting,
+        Posting::Queued {
+            text: "Why 300 ms?".to_owned()
+        }
+    );
+    assert_eq!(
+        ThreadStore::open(folder.path()).unwrap().list(&range),
+        queued
+    );
+
+    let requeued = store.queue(&range, MessageId(3), "t, again").unwrap();
+    assert_eq!(
+        requeued.threads[1].messages[0].posting,
+        Posting::Queued {
+            text: "t, again".to_owned()
+        }
+    );
+
+    let unqueued = store.unqueue(&range, MessageId(1)).unwrap();
+    assert_eq!(unqueued.threads[0].messages[0].posting, Posting::NotQueued);
+    assert_eq!(unqueued.threads[0].messages[0].body, note("Why 300?"));
+    assert_eq!(
+        ThreadStore::open(folder.path()).unwrap().list(&range),
+        unqueued
+    );
+}
