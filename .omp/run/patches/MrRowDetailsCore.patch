+test("authorText names the author by display name, or unknown", () => {
+  expect(authorText(ANNA)).toBe("Author: Anna Berg");
+  expect(authorText(NAMELESS)).toBe("Author: jdoe");
+  expect(authorText(null)).toBe("Author: unknown");
