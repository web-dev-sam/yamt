+  expect(reviewStateText(state)).toBe(text);
+});
+
+test.each<[ReviewState, boolean]>([
+  ["requested", false],
+  ["reviewed", true],
+  ["approved", true],
+  ["changesRequested", true],
+])("only_a_done_review_can_be_re_requested: %s → %s", (state, done) => {
+  expect(reviewDone(state)).toBe(done);
