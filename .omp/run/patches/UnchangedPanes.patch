+import { Text, type RangeSet, type RangeValue } from "@codemirror/state";
+import { expect, test } from "vitest";
+
+import { toDocPos } from "./docPos";
+import type { Fold, Hidden } from "./foldRuns";
+import { foldDecorations } from "./foldView";
+
+const DOC = Text.of(Array.from({ length: 60 }, (_, index) => `line ${index + 1}`));
+
+function lines(first: number, last: number): Hidden {
+  return { from: toDocPos(DOC.line(first).from), to: toDocPos(DOC.line(last).to) };
+}
+
+function ranges<T extends RangeValue>(set: RangeSet<T>): string[] {
+  const found: string[] = [];
+  set.between(0, DOC.length, (from, to) => {
+    found.push(`${DOC.lineAt(from).number}-${DOC.lineAt(to).number}`);
+  });
+  return found;
+}
+
+const FOLDS: readonly Fold[] = [
+  {
+    hidden: [
+      { left: lines(1, 10), center: lines(1, 12), right: null },
+      { left: lines(1, 6), center: lines(1, 8), right: null },
+    ],
+  },
+  {
+    hidden: [
+      { left: null, center: lines(30, 40), right: lines(30, 40) },
+      { left: lines(33, 37), center: lines(33, 37), right: lines(33, 37) },
+    ],
+  },
+  { hidden: [] },
+  { hidden: [{ left: null, center: lines(55, 60), right: null }] },
+];
+
+test("each run replaces its outermost hidden lines with one wave line", () => {
+  const set = foldDecorations(FOLDS, "center");
+  const widgets: string[] = [];
+  set.between(0, DOC.length, (from, to, decoration) => {
+    widgets.push(
+      `${from === DOC.lineAt(from).from} ${to === DOC.lineAt(to).to} ${decoration.point}`,
+    );
+  });
+
+  expect(ranges(set)).toEqual(["1-12", "30-40", "55-60"]);
+  expect(widgets).toEqual(["true true true", "true true true", "true true true"]);
+});
+
+test("a pane without a range at the outer level shows the next level that has one", () => {
+  expect(ranges(foldDecorations(FOLDS, "left"))).toEqual(["1-10", "33-37"]);
+  expect(ranges(foldDecorations(FOLDS, "right"))).toEqual(["30-40"]);
+});
+
+test("a run with no level left has no wave", () => {
+  expect(ranges(foldDecorations([{ hidden: [] }, { hidden: [] }], "center"))).toEqual([]);
+});
diff --git a/frontend/src/editor/internal/foldView.ts b/frontend/src/editor/internal/foldView.ts
new file mode 100644
index 0000000..d730555
--- /dev/null
+++ b/frontend/src/editor/internal/foldView.ts
@@ -0,0 +1,144 @@
+import { RangeSet, RangeSetBuilder, type Extension, type StateField } from "@codemirror/state";
+import {
+  Decoration,
+  EditorView,
+  GutterMarker,
+  lineNumberMarkers,
+  WidgetType,
+  type DecorationSet,
+} from "@codemirror/view";
+
+import { waveCenterY, waveTile, WAVE_TILE_HEIGHT_PX, WAVE_TILE_WIDTH_PX } from "../../connectors";
+import { FOLD_RUN_ATTRIBUTE, HOVER_CLASS } from "./folding";
+import { displayed, type Fold } from "./foldRuns";
+import type { Pane } from "./geometry";
+import { LINE_HEIGHT_PX } from "./pane";
+
+const WAVE_LABEL = "Show unchanged lines";
+const THIN_STROKE_PX = 1;
+const THICK_STROKE_PX = 2;
+const HALF = 0.5;
+
+class FoldLine extends WidgetType {
+  readonly run: number;
+
+  constructor(run: number) {
+    super();
+    this.run = run;
+  }
+
+  override eq(other: FoldLine): boolean {
+    return other.run === this.run;
+  }
+
+  toDOM(): HTMLElement {
+    const line = document.createElement("span");
+    line.className = "fold-line";
+    return line;
+  }
+}
+
+class WaveMarker extends GutterMarker {
+  override readonly elementClass = "fold-wave-cell";
+  readonly run: number;
+  readonly #hovered: () => number | null;
+
+  constructor(run: number, hovered: () => number | null) {
+    super();
+    this.run = run;
+    this.#hovered = hovered;
+  }
+
+  override eq(other: WaveMarker): boolean {
+    return other.run === this.run;
+  }
+
+  override toDOM(): Node {
+    const wave = document.createElement("div");
+    wave.className = "fold-wave";
+    wave.classList.toggle(HOVER_CLASS, this.#hovered() === this.run);
+    wave.setAttribute(FOLD_RUN_ATTRIBUTE, String(this.run));
+    wave.setAttribute("role", "button");
+    wave.setAttribute("aria-label", WAVE_LABEL);
+    return wave;
+  }
+}
+
+export function foldDecorations(folds: readonly Fold[], pane: Pane): DecorationSet {
+  const builder = new RangeSetBuilder<Decoration>();
+  folds.forEach((fold, run) => {
+    const hidden = displayed(fold, pane);
+    if (hidden !== null) {
+      builder.add(hidden.from, hidden.to, Decoration.replace({ widget: new FoldLine(run) }));
+    }
+  });
+  return builder.finish();
+}
+
+function waveMarkers(
+  folds: readonly Fold[],
+  pane: Pane,
+  hovered: () => number | null,
+): RangeSet<GutterMarker> {
+  const builder = new RangeSetBuilder<GutterMarker>();
+  folds.forEach((fold, run) => {
+    const hidden = displayed(fold, pane);
+    if (hidden !== null) {
+      builder.add(hidden.from, hidden.from, new WaveMarker(run, hovered));
+    }
+  });
+  return builder.finish();
+}
+
+function waveMask(strokePx: number): string {
+  const svg =
+    `<svg xmlns='http://www.w3.org/2000/svg' width='${WAVE_TILE_WIDTH_PX}' height='${WAVE_TILE_HEIGHT_PX}'>` +
+    `<path d='${waveTile()}' fill='none' stroke='black' stroke-width='${strokePx}'/></svg>`;
+  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
+}
+
+function maskStyle(strokePx: number): Readonly<Record<string, string>> {
+  const image = waveMask(strokePx);
+  return { maskImage: image, WebkitMaskImage: image };
+}
+
+const waveTop = waveCenterY(LINE_HEIGHT_PX) - WAVE_TILE_HEIGHT_PX * HALF;
+const tile = {
+  maskRepeat: "repeat-x",
+  maskPosition: `0 ${waveTop}px`,
+  maskSize: `${WAVE_TILE_WIDTH_PX}px ${WAVE_TILE_HEIGHT_PX}px`,
+};
+
+const waveTheme = EditorView.theme({
+  ".cm-scroller": { containerType: "inline-size" },
+  ".cm-gutter.cm-lineNumbers": { overflow: "visible" },
+  ".fold-wave-cell": { position: "relative" },
+  ".fold-wave": {
+    position: "absolute",
+    left: "0",
+    top: "0",
+    width: "100cqi",
+    height: "100%",
+    cursor: "pointer",
+    backgroundColor: "var(--color-diff-wave)",
+    ...tile,
+    WebkitMaskRepeat: tile.maskRepeat,
+    WebkitMaskPosition: tile.maskPosition,
+    WebkitMaskSize: tile.maskSize,
+    ...maskStyle(THIN_STROKE_PX),
+  },
+  [`.fold-wave.${HOVER_CLASS}`]: maskStyle(THICK_STROKE_PX),
+});
+
+export function foldView(
+  field: StateField<readonly Fold[]>,
+  pane: Pane,
+  hovered: () => number | null,
+): Extension {
+  return [
+    EditorView.decorations.compute([field], (state) => foldDecorations(state.field(field), pane)),
+    EditorView.atomicRanges.of((view) => foldDecorations(view.state.field(field), pane)),
+    lineNumberMarkers.compute([field], (state) => waveMarkers(state.field(field), pane, hovered)),
+    waveTheme,
+  ];
+}
diff --git a/frontend/src/editor/internal/folding.ts b/frontend/src/editor/internal/folding.ts
new file mode 100644
index 0000000..e7a75b7
--- /dev/null
+++ b/frontend/src/editor/internal/folding.ts
@@ -0,0 +1,76 @@
+export const FOLD_RUN_ATTRIBUTE = "data-fold-run";
+export const HOVER_CLASS = "fold-wave-hover";
+
+export function foldRunAt(target: EventTarget | null): number | null {
+  const wave = target instanceof Element ? target.closest(`[${FOLD_RUN_ATTRIBUTE}]`) : null;
+  const run = wave?.getAttribute(FOLD_RUN_ATTRIBUTE);
+  return run === undefined || run === null ? null : Number(run);
+}
+
+function primaryRun(event: Event): number | null {
+  return event instanceof MouseEvent && event.button === 0 ? foldRunAt(event.target) : null;
+}
+
+export class Folding {
+  readonly #hosts: readonly Element[];
+  readonly #listeners = new AbortController();
+  #hovered: number | null = null;
+
+  constructor(hosts: readonly Element[], show: (run: number) => void) {
+    this.#hosts = hosts;
+    const handlers: Readonly<Record<string, (event: Event) => void>> = {
+      pointerover: (event) => {
+        this.#hover(foldRunAt(event.target));
+      },
+      pointerleave: () => {
+        this.#hover(null);
+      },
+      mousedown: (event) => {
+        if (primaryRun(event) !== null) {
+          event.preventDefault();
+        }
+      },
+      click: (event) => {
+        const run = primaryRun(event);
+        if (run !== null) {
+          show(run);
+          this.#hover(null);
+        }
+      },
+    };
+    const signal = this.#listeners.signal;
+    for (const host of hosts) {
+      for (const [type, handler] of Object.entries(handlers)) {
+        host.addEventListener(type, handler, { signal });
+      }
+    }
+  }
+
+  hovered(): number | null {
+    return this.#hovered;
+  }
+
+  destroy(): void {
+    this.#listeners.abort();
+  }
+
+  #hover(run: number | null): void {
+    if (run === this.#hovered) {
+      return;
+    }
+    this.#mark(this.#hovered, false);
+    this.#hovered = run;
+    this.#mark(run, true);
+  }
+
+  #mark(run: number | null, hovered: boolean): void {
+    if (run === null) {
+      return;
+    }
+    for (const host of this.#hosts) {
+      for (const wave of host.querySelectorAll(`[${FOLD_RUN_ATTRIBUTE}="${run}"]`)) {
+        wave.classList.toggle(HOVER_CLASS, hovered);
+      }
+    }
+  }
+}
diff --git a/frontend/src/editor/internal/folds.test.ts b/frontend/src/editor/internal/folds.test.ts
new file mode 100644
index 0000000..53951c2
--- /dev/null
+++ b/frontend/src/editor/internal/folds.test.ts
@@ -0,0 +1,326 @@
+import { undo } from "@codemirror/commands";
+import {
+  EditorSelection,
+  type EditorState,
+  type StateField,
+  type TransactionSpec,
+} from "@codemirror/state";
+import { expect, test } from "vitest";
+
+import { DEFAULT_KEYS, loadFixture, type FileMergeData } from "../../ipc";
+import { actionSteps, bulkApplySteps, dispatchSteps, type ApplyTarget } from "./apply";
+import { chunkField } from "./chunkField";
+import { selectMatch } from "./findMatch";
+import { foldRuns, type Fold, type Hidden } from "./foldRuns";
+import {
+  foldField,
+  revealKeep,
+  showFolds,
+  showNextStep,
+  sideFoldField,
+  sideFoldPush,
+} from "./folds";
+import { paneState, type PaneSettings } from "./pane";
+import { paneDocs } from "./paneDocs";
+
+const SETTINGS: PaneSettings = {
+  preferences: { theme: "dark", keys: DEFAULT_KEYS },
+  platform: "Linux x86_64",
+};
+
+type Merge = ApplyTarget & {
+  readonly folds: StateField<readonly Fold[]>;
+  readonly runs: Fold[];
+};
+
+function numbered(from: number, to: number): string[] {
+  return Array.from({ length: to - from + 1 }, (_, index) => `line ${from + index}`);
+}
+
+function noWords(id: number) {
+  return {
+    chunk: id,
+    local: { changed: [], removed_at: [] },
+    remote: { changed: [], removed_at: [] },
+  };
+}
+
+async function twoChanges(): Promise<FileMergeData> {
+  const middle = numbered(1, 100);
+  const local = [...numbered(1, 30), "local a", "local b", "local c", ...numbered(33, 100)];
+  const remote = [...numbered(1, 70), "remote x", ...numbered(72, 100)];
+  const record = {
+    path: "synthetic.ts",
+    deleted: null,
+    middle: { kind: "Stages", text: `${middle.join("\n")}\n` },
+    local: `${local.join("\n")}\n`,
+    remote: `${remote.join("\n")}\n`,
+    eol: "Lf",
+    disk_version: 0,
+    chunks: [
+      {
+        chunk: {
+          id: 0,
+          kind: "LocalOnly",
+          base: { start: 30, len: 2 },
+          local: { start: 30, len: 3 },
+          remote: { start: 30, len: 2 },
+        },
+        middle: { start: 30, len: 2 },
+        words: noWords(0),
+      },
+      {
+        chunk: {
+          id: 1,
+          kind: "RemoteOnly",
+          base: { start: 70, len: 1 },
+          local: { start: 71, len: 1 },
+          remote: { start: 70, len: 1 },
+        },
+        middle: { start: 70, len: 1 },
+        words: noWords(1),
+      },
+    ],
+  };
+  return loadFixture("synthetic.ts", { "synthetic.json": record });
+}
+
+async function open(): Promise<Merge> {
+  const data = await twoChanges();
+  const docs = paneDocs(data);
+  const runs = foldRuns(data.chunks, docs);
+  const field = chunkField(data.chunks);
+  const folds = foldField(runs);
+  const state = paneState({
+    kind: "center",
+    doc: docs.center,
+    eol: data.eol,
+    language: null,
+    settings: SETTINGS,
+    extensions: [field, folds],
+  });
+  return { state, field, folds, runs, sides: { local: docs.left, remote: docs.right } };
+}
+
+function after(merge: Merge, ...specs: TransactionSpec[]): Merge {
+  return { ...merge, state: merge.state.update(...specs).state };
+}
+
+function steps(merge: Merge, list: readonly TransactionSpec[]): Merge {
+  let state = merge.state;
+  dispatchSteps((spec) => {
+    state = state.update(spec).state;
+  }, list);
+  return { ...merge, state };
+}
+
+function lineRange(state: EditorState, hidden: Hidden | null): string {
+  return hidden === null
+    ? "-"
+    : `${state.doc.lineAt(hidden.from).number}-${state.doc.lineAt(hidden.to).number}`;
+}
+
+function centerLines(merge: Merge, run: number): string[] {
+  const fold = merge.state.field(merge.folds)[run];
+  return fold === undefined ? [] : fold.hidden.map((level) => lineRange(merge.state, level.center));
+}
+
+function hiddenTexts(merge: Merge): string[] {
+  return merge.state
+    .field(merge.folds)
+    .flatMap((fold) =>
+      fold.hidden.map(({ center }) =>
+        center === null ? "-" : merge.state.sliceDoc(center.from, center.to),
+      ),
+    );
+}
+
+function levelOf(merge: Merge, run: number, level: number): Hidden {
+  const hidden = merge.state.field(merge.folds)[run]?.hidden[level]?.center;
+  if (hidden === undefined || hidden === null) {
+    throw new Error(`run ${run} has no level ${level} in the middle`);
+  }
+  return hidden;
+}
+
+function click(merge: Merge, run: number): Merge {
+  return after(merge, showNextStep(merge.state.field(merge.folds), run));
+}
+
+test("the middle starts with every run's levels: 4, 8 and 16 lines kept next to each change", async () => {
+  const merge = await open();
+
+  expect([0, 1, 2].map((run) => centerLines(merge, run))).toEqual([
+    ["1-26", "1-22", "1-14"],
+    ["37-66", "41-62", "49-54"],
+    ["76-101", "80-101", "88-101"],
+  ]);
+});
+
+test("a line inserted above moves every range below it by one line", async () => {
+  const merge = after(await open(), { changes: { from: 0, insert: "new\n" } });
+
+  expect(centerLines(merge, 1)).toEqual(["38-67", "42-63", "50-55"]);
+  expect(centerLines(merge, 0)).toEqual(["2-27", "2-23", "2-15"]);
+});
+
+test("typing at a hidden range's first or last character shows that line only", async () => {
+  const merge = await open();
+  const { from, to } = levelOf(merge, 1, 0);
+
+  expect(centerLines(after(merge, { changes: { from, insert: "x" } }), 1)[0]).toBe("38-66");
+  expect(centerLines(after(merge, { changes: { from: to, insert: "x" } }), 1)[0]).toBe("37-65");
+});
+
+test("deleting a level down to one line shows it, and undo does not hide it again", async () => {
+  const merge = await open();
+  const doc = merge.state.doc;
+  const deleted = after(merge, {
+    changes: { from: doc.line(50).from, to: doc.line(55).from },
+  });
+  const undone = { ...deleted, state: undoneState(deleted.state) };
+
+  expect(centerLines(deleted, 1)).toEqual(["37-61", "41-57", "-"]);
+  expect(centerLines(undone, 1)).toEqual(["37-66", "41-62", "-"]);
+});
+
+function undoneState(state: EditorState): EditorState {
+  let next = state;
+  undo({
+    state,
+    dispatch: (tr) => {
+      next = tr.state;
+    },
+  });
+  return next;
+}
+
+test("deciding a change and bulk apply keep every hidden range's lines and every count", async () => {
+  const merge = await open();
+  const before = hiddenTexts(merge);
+  const [first, second] = merge.state.field(merge.field);
+  if (first === undefined || second === undefined) {
+    throw new Error("the data lost its chunks");
+  }
+  const applied = steps(
+    merge,
+    actionSteps(merge, { kind: "apply", side: "local", chunks: [first.chunk] }, "side"),
+  );
+  const bulk = steps(
+    merge,
+    bulkApplySteps({ target: merge, side: "remote", visible: { first: 1, last: 10 } }),
+  );
+
+  expect(hiddenTexts(applied)).toEqual(before);
+  expect(hiddenTexts(bulk)).toEqual(before);
+  expect(centerLines(applied, 1)).toEqual(["38-67", "42-63", "50-55"]);
+  expect(applied.state.field(merge.folds).map((fold) => fold.hidden.length)).toEqual([3, 3, 3]);
+});
+
+test("each click shows the outermost hidden level; three clicks empty the run", async () => {
+  const once = click(await open(), 1);
+  const twice = click(once, 1);
+  const thrice = click(twice, 1);
+
+  expect(centerLines(once, 1)).toEqual(["41-62", "49-54"]);
+  expect(centerLines(twice, 1)).toEqual(["49-54"]);
+  expect(centerLines(thrice, 1)).toEqual([]);
+  expect(centerLines(click(thrice, 1), 1)).toEqual([]);
+  expect(centerLines(thrice, 0)).toEqual(["1-26", "1-22", "1-14"]);
+});
+
+test("a step that keeps more levels than are hidden hides nothing again", async () => {
+  const once = click(await open(), 1);
+  const asked = after(once, { effects: showFolds.of({ run: 1, keep: 3 }) });
+
+  expect(asked.state.field(asked.folds)).toBe(once.state.field(once.folds));
+});
+
+test("a click is not an undo step", async () => {
+  const merge = click(await open(), 1);
+  let undid = false;
+
