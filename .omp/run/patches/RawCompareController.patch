@@ -0,0 +1,107 @@
+import { EditorState, type TransactionSpec } from "@codemirror/state";
+import { Decoration } from "@codemirror/view";
+import { afterEach, expect, test, vi } from "vitest";
+
+import type { Span } from "../../connectors";
+import { differenceField, showDifferences } from "./compareFields";
+import { CompareFrame } from "./compareFrame";
+import type { DiffSpan } from "./compareMarks";
+import type { CompareRow } from "./compareStrip";
+import { toDocPos } from "./docPos";
+import { find } from "./find";
+
+const LINE_PX = 20;
+const TEXT = Array.from({ length: 40 }, (_, index) => `line ${index}`).join("\n");
+
+type FakeColumn = {
+  state: EditorState;
+  dispatch(spec: TransactionSpec): void;
+  readonly scrollDOM: EventTarget & { scrollTop: number; readonly clientHeight: number };
+  readonly documentPadding: { readonly top: number };
+  readonly documentTop: number;
+  lineBlockAt(pos: number): Span;
+};
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+function fakeColumn(
+  measured: { count: number },
+  changed: (startState: EditorState, state: EditorState) => void,
+): FakeColumn {
+  const state = EditorState.create({ doc: TEXT, extensions: [differenceField, find] });
+  const line = state.doc.line(5);
+  const marks = { bands: Decoration.none, words: Decoration.none };
+  const spans: readonly DiffSpan[] = [
+    { from: toDocPos(line.from), to: toDocPos(line.to + 1), tone: "modified" },
+  ];
+  const column: FakeColumn = {
+    state: state.update({ effects: showDifferences.of({ ...marks, spans }) }).state,
+    dispatch(spec) {
+      const startState = column.state;
+      column.state = startState.update(spec).state;
+      changed(startState, column.state);
+    },
+    scrollDOM: Object.assign(new EventTarget(), { scrollTop: 0, clientHeight: 10 * LINE_PX }),
+    documentPadding: { top: 0 },
+    documentTop: 0,
+    lineBlockAt(pos) {
+      measured.count += 1;
+      const number = column.state.doc.lineAt(pos).number;
+      return { top: (number - 1) * LINE_PX, bottom: number * LINE_PX };
+    },
+  };
+  return column;
+}
+
+test("a scroll paints the strip from the cached rows; an edit measures them again", () => {
+  const frames: (() => void)[] = [];
+  vi.stubGlobal("requestAnimationFrame", (callback: () => void) => frames.push(callback));
+  vi.stubGlobal("cancelAnimationFrame", () => {});
+  function runFrames(): void {
+    for (const frame of frames.splice(0)) {
+      frame();
+    }
+  }
+  const measured = { count: 0 };
+  const painted: (readonly CompareRow[])[] = [];
+  const holder: { frame: CompareFrame | null } = { frame: null };
+  function changed(startState: EditorState, state: EditorState): void {
+    holder.frame?.changed({ startState, state, geometryChanged: false });
+  }
+  const views = { left: fakeColumn(measured, changed), right: fakeColumn(measured, changed) };
+  const frame = new CompareFrame({
+    views,
+    strip: {
+      paint: (_panes, rows) => {
+        painted.push(rows);
+      },
+    },
+  });
+  holder.frame = frame;
+
+  frame.request();
+  runFrames();
+  const atStart = measured.count;
+  views.left.scrollDOM.scrollTop = 300;
+  views.left.scrollDOM.dispatchEvent(new Event("scroll"));
+  runFrames();
+  views.left.dispatch({ selection: { anchor: 3 } });
+  runFrames();
+  const afterScroll = measured.count;
+  views.left.dispatch({ changes: { from: 0, insert: "new\n" } });
+  runFrames();
+
+  expect(atStart).toBeGreaterThan(0);
+  expect(afterScroll).toBe(atStart);
+  expect(views.right.scrollDOM.scrollTop).toBe(300);
+  expect(painted).toHaveLength(3);
+  expect(painted[1]).toBe(painted[0]);
+  expect(measured.count).toBeGreaterThan(afterScroll);
+  expect(painted[2]?.[0]).toEqual({
+    left: { top: 5 * LINE_PX, bottom: 6 * LINE_PX },
+    right: { top: 4 * LINE_PX, bottom: 5 * LINE_PX },
+    tone: "modified",
+  });
+});
diff --git a/frontend/src/editor/internal/compareFrame.ts b/frontend/src/editor/internal/compareFrame.ts
new file mode 100644
index 0000000..5434dfc
--- /dev/null
+++ b/frontend/src/editor/internal/compareFrame.ts
@@ -0,0 +1,94 @@
+import { searchPanelOpen } from "@codemirror/search";
+import type { ViewUpdate } from "@codemirror/view";
+
+import type { Span } from "../../connectors";
+import type { Column } from "../../ipc";
+import { differenceField } from "./compareFields";
+import type { CompareRow, CompareStrip } from "./compareStrip";
+import { COLUMNS } from "./compareViews";
+import { syncFindSpace, type FindSpaceView } from "./find";
+import { rangeSpan, rowsChanged } from "./geometry";
+import { contentEnd, ScrollSync, type Anchor, type ScrollPane } from "./scrollSync";
+
+type FrameView = ScrollPane &
+  FindSpaceView & {
+    readonly documentTop: number;
+    lineBlockAt(pos: number): Span;
+  };
+type FrameViews = Readonly<Record<Column, FrameView>>;
+
+type CompareLayout = {
+  readonly rows: readonly CompareRow[];
+  readonly anchors: readonly Anchor<Column>[];
+};
+
+function columnSpan(view: FrameView, range: { readonly from: number; readonly to: number }): Span {
+  return rangeSpan(view.state.doc, range, (pos) => view.lineBlockAt(pos));
+}
+
+function measure({ left, right }: FrameViews): CompareLayout {
+  const rightSpans = right.state.field(differenceField).spans;
+  const rows = left.state.field(differenceField).spans.flatMap((span, index) => {
+    const other = rightSpans[index];
+    return other === undefined
+      ? []
+      : [{ left: columnSpan(left, span), right: columnSpan(right, other), tone: span.tone }];
+  });
+  const edges = rows.flatMap((row) => [
+    { left: row.left.top, right: row.right.top },
+    { left: row.left.bottom, right: row.right.bottom },
+  ]);
+  const ends = { left: contentEnd(left), right: contentEnd(right) };
+  return { rows, anchors: [{ left: 0, right: 0 }, ...edges, ends] };
+}
+
+export class CompareFrame {
+  readonly #views: FrameViews;
+  readonly #strip: Pick<CompareStrip, "paint">;
+  readonly #scroll: ScrollSync<Column>;
+  #frameId: number | null = null;
+  #layoutCache: CompareLayout | null = null;
+
+  constructor({
+    views,
+    strip,
+  }: {
+    readonly views: FrameViews;
+    readonly strip: Pick<CompareStrip, "paint">;
+  }) {
+    this.#views = views;
+    this.#strip = strip;
+    this.#scroll = new ScrollSync(views, COLUMNS, () => {
+      this.request();
+    });
+  }
+
+  changed(update: Pick<ViewUpdate, "geometryChanged" | "startState" | "state">): void {
+    const moved = rowsChanged(update, [differenceField]);
+    if (moved) {
+      this.#layoutCache = null;
+    }
+    if (moved || searchPanelOpen(update.startState) !== searchPanelOpen(update.state)) {
+      this.request();
+    }
+  }
+
+  request(): void {
+    this.#frameId ??= requestAnimationFrame(() => {
+      this.#frameId = null;
+      const views = this.#views;
+      syncFindSpace([views.left, views.right]);
+      this.#layoutCache ??= measure(views);
+      const layout = this.#layoutCache;
+      this.#scroll.sync(layout.anchors);
+      this.#strip.paint(views, layout.rows);
+    });
+  }
+
+  destroy(): void {
+    if (this.#frameId !== null) {
+      cancelAnimationFrame(this.#frameId);
+    }
+    this.#scroll.destroy();
+  }
+}
