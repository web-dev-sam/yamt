+import { language } from "@codemirror/language";
+import { languages } from "@codemirror/language-data";
+import { EditorState, type TransactionSpec } from "@codemirror/state";
+import { expect, test, vi } from "vitest";
+
+import { CompareLanguage } from "./compareLanguage";
+import { languageNames } from "./language";
+import { languageCompartment } from "./pane";
+
+type Held = { state: EditorState; dispatch(spec: TransactionSpec): void };
+
+function column(text: string): Held {
+  const held: Held = {
+    state: EditorState.create({ doc: text, extensions: languageCompartment.of([]) }),
+    dispatch(spec) {
+      held.state = held.state.update(spec).state;
+    },
+  };
+  return held;
+}
+
+function typed(held: Held, text: string): void {
+  held.dispatch({ changes: { from: 0, to: held.state.doc.length, insert: text } });
+}
+
+function shownLanguage(held: Held): string | null {
+  return held.state.facet(language)?.name ?? null;
+}
+
+test("Auto finds JSON at build, fires once for it, colours both columns and offers JSON's Format", async () => {
+  const left = column('{"a": 1}\n');
+  const right = column("");
+  const detected = vi.fn<(name: string | null) => void>();
+
+  const auto = new CompareLanguage({ kind: "auto" }, { left, right }, detected);
+  auto.settled();
+  typed(right, '{"b": 2}\n');
+  auto.settled();
+
+  expect(detected.mock.calls).toEqual([["JSON"]]);
+  expect(auto.formatLanguage()).toBe("JSON");
+  await vi.waitFor(() => {
+    expect([shownLanguage(left), shownLanguage(right)]).toEqual(["json", "json"]);
+  });
+
+  typed(left, "<a/>\n");
+  auto.settled();
+
+  expect(detected.mock.calls).toEqual([["JSON"], ["XML"]]);
+  expect(auto.formatLanguage()).toBe("XML");
+  auto.destroy();
+});
+
+test("plain text is reported once as no language and leaves the columns uncoloured", () => {
+  const left = column("just words\n");
+  const right = column("more words\n");
+  const detected = vi.fn<(name: string | null) => void>();
+
+  const auto = new CompareLanguage({ kind: "auto" }, { left, right }, detected);
+  auto.settled();
+
+  expect(detected.mock.calls).toEqual([[null]]);
+  expect(auto.formatLanguage()).toBeNull();
+  expect(shownLanguage(left)).toBeNull();
+});
+
+test("a picked language never fires detected, and Format follows the pick, not the text", async () => {
+  const left = column('{"a": 1}\n');
+  const right = column('{"a": 2}\n');
+  const detected = vi.fn<(name: string | null) => void>();
+
+  const picked = new CompareLanguage({ kind: "picked", name: "XML" }, { left, right }, detected);
+  picked.settled();
+
+  expect(picked.formatLanguage()).toBe("XML");
+  await vi.waitFor(() => {
+    expect(shownLanguage(right)).toBe("xml");
+  });
+
+  picked.set({ kind: "picked", name: "TypeScript" });
+  picked.settled();
+
+  expect(picked.formatLanguage()).toBeNull();
+  expect(detected).not.toHaveBeenCalled();
+
+  picked.set({ kind: "auto" });
+
+  expect(detected.mock.calls).toEqual([["JSON"]]);
+  picked.destroy();
+});
+
+test("languageNames lists every language-data name once, in alphabetical order", () => {
+  const names = languageNames();
+
+  expect(names).toHaveLength(languages.length);
+  expect(new Set(names)).toEqual(new Set(languages.map((description) => description.name)));
+  for (const [index, name] of names.slice(1).entries()) {
+    expect(names[index]?.localeCompare(name)).toBeLessThan(0);
+  }
+  expect(names).toEqual(expect.arrayContaining(["JSON", "XML", "TypeScript", "Python"]));
+});
diff --git a/frontend/src/editor/internal/compareLanguage.ts b/frontend/src/editor/internal/compareLanguage.ts
new file mode 100644
index 0000000..d1d5816
--- /dev/null
+++ b/frontend/src/editor/internal/compareLanguage.ts
@@ -0,0 +1,91 @@
+import type { EditorState } from "@codemirror/state";
+
+import type { Column, TabLanguage } from "../../ipc";
+import { isFormatLanguage, type FormatLanguage } from "./compareFormat";
+import { detectLanguage } from "./detectLanguage";
+import { languageNamed, loadLanguage, type LanguageView } from "./language";
+import { languageCompartment } from "./pane";
+
+type LanguageColumn = LanguageView & { readonly state: EditorState };
+type Finding = { readonly name: string | null };
+
+const LOG_PATH = "compare";
+
+export class CompareLanguage {
+  readonly #columns: Readonly<Record<Column, LanguageColumn>>;
+  readonly #detected: (name: string | null) => void;
+  #language: TabLanguage = { kind: "auto" };
+  #finding: Finding | null = null;
+  #shown: string | null = null;
+  #destroyed = false;
+
+  constructor(
+    language: TabLanguage,
+    columns: Readonly<Record<Column, LanguageColumn>>,
+    detected: (name: string | null) => void,
+  ) {
+    this.#columns = columns;
+    this.#detected = detected;
+    this.set(language);
+  }
+
+  set(language: TabLanguage): void {
+    this.#language = language;
+    if (language.kind === "auto") {
+      this.#detect();
+    }
+    this.#show();
+  }
+
+  settled(): void {
+    if (this.#language.kind === "auto") {
+      this.#detect();
+      this.#show();
+    }
+  }
+
+  formatLanguage(): FormatLanguage | null {
+    const name = this.#current();
+    return name !== null && isFormatLanguage(name) ? name : null;
+  }
+
+  destroy(): void {
+    this.#destroyed = true;
+  }
+
+  #current(): string | null {
+    return this.#language.kind === "auto" ? (this.#finding?.name ?? null) : this.#language.name;
+  }
+
+  #detect(): void {
+    const { left, right } = this.#columns;
+    const name = detectLanguage(left.state.sliceDoc(), right.state.sliceDoc());
+    if (this.#finding === null || this.#finding.name !== name) {
+      this.#finding = { name };
+      this.#detected(name);
+    }
+  }
+
+  #show(): void {
+    const name = this.#current();
+    if (name === this.#shown) {
+      return;
+    }
+    this.#shown = name;
+    const columns = [this.#columns.left, this.#columns.right];
+    const description = name === null ? null : languageNamed(name);
+    if (description === null || description.support !== undefined) {
+      const effects = languageCompartment.reconfigure(description?.support?.language ?? []);
+      for (const column of columns) {
+        column.dispatch({ effects });
+      }
+      return;
+    }
+    void loadLanguage(
+      description,
+      LOG_PATH,
+      columns,
+      () => this.#destroyed || this.#shown !== name,
+    );
+  }
+}
diff --git a/frontend/src/editor/internal/compareStrip.ts b/frontend/src/editor/internal/compareStrip.ts
new file mode 100644
index 0000000..4f89e7a
--- /dev/null
+++ b/frontend/src/editor/internal/compareStrip.ts
@@ -0,0 +1,67 @@
+import "../theme.css";
+import { bandPath, type Span } from "../../connectors";
+import type { Column } from "../../ipc";
+import { crossesStrip } from "./gap";
+import type { ChangeTone } from "./tone";
+
+export type CompareRow = Readonly<Record<Column, Span>> & { readonly tone: ChangeTone };
+export type StripPanes = Readonly<Record<Column, { readonly documentTop: number }>>;
+
+const SVG_NS = "http://www.w3.org/2000/svg";
+
+function shiftedSpan({ top, bottom }: Span, by: number): Span {
+  return { top: top + by, bottom: bottom + by };
+}
+
+function keepEditorFocus(event: MouseEvent): void {
+  event.preventDefault();
+}
+
+export class CompareStrip {
+  readonly #strip: SVGSVGElement;
+  readonly #layer = document.createElementNS(SVG_NS, "g");
+  readonly #bands = new Map<string, SVGPathElement>();
+
+  constructor(strip: SVGSVGElement) {
+    this.#strip = strip;
+    strip.replaceChildren(this.#layer);
+    strip.addEventListener("mousedown", keepEditorFocus);
+  }
+
+  paint(panes: StripPanes, rows: readonly CompareRow[]): void {
+    const strip = this.#strip;
+    const stripTop = strip.getBoundingClientRect().top;
+    const width = strip.clientWidth;
+    const height = strip.clientHeight;
+    const kept = new Set<string>();
+    rows.forEach((row, index) => {
+      const left = shiftedSpan(row.left, panes.left.documentTop - stripTop);
+      const right = shiftedSpan(row.right, panes.right.documentTop - stripTop);
+      const top = Math.min(left.top, right.top);
+      if (!crossesStrip(top, Math.max(left.bottom, right.bottom), height)) {
+        return;
+      }
+      const key = `${index} ${row.tone}`;
+      kept.add(key);
+      let path = this.#bands.get(key);
+      if (path === undefined) {
+        path = document.createElementNS(SVG_NS, "path");
+        path.setAttribute("class", `chunk-${row.tone} chunk-band`);
+        this.#bands.set(key, path);
+        this.#layer.append(path);
+      }
+      path.setAttribute("d", bandPath({ left, right }, width));
+    });
+    for (const [key, path] of this.#bands) {
+      if (!kept.has(key)) {
+        path.remove();
+        this.#bands.delete(key);
+      }
+    }
+  }
+
+  destroy(): void {
+    this.#strip.removeEventListener("mousedown", keepEditorFocus);
+    this.#strip.replaceChildren();
+  }
+}
