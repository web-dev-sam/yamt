+  if (reply.kind === "resolve") {
+    return { text: resolveReplyText(reply.reply, iid), refused: reply.reply.kind !== "started" };
+  }
+  return { text: continueReplyText(reply.reply, iid), refused: reply.reply.kind !== "opened" };
+}
