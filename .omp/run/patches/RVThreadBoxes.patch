diff --git a/frontend/scripts/app-session/startArgs.ts b/frontend/scripts/app-session/startArgs.ts
index 913fb12..0d0a0d8 100644
--- a/frontend/scripts/app-session/startArgs.ts
+++ b/frontend/scripts/app-session/startArgs.ts
@@ -18,6 +18,7 @@ export type StartCommand =
       readonly size: Size;
       readonly record: Recording | null;
       readonly home: string | null;
+      readonly glab: string | null;
     }
   | {
       readonly kind: "start-fixture";
@@ -59,19 +60,49 @@ function opening(parsed: Parsed): Opening {
   return dir === undefined ? { kind: diff ? "diff" : "fresh" } : { kind: "dir", dir };
 }
 
+function reviewSearch(parsed: Parsed): string {
+  const review = new URLSearchParams();
+  for (const name of ["threads", "gitlab"]) {
+    const value = parsed.values.get(name);
+    if (value !== undefined) {
+      review.set(name, value);
+    }
+  }
+  const text = review.toString();
+  return text === "" ? "" : `&${text}`;
+}
+
 function fixtureSearch(parsed: Parsed): string {
   const range = parsed.values.get("range-case");
   const fixture = parsed.values.get("diff-case");
   const diff = parsed.flags.has("diff") ? "?diff" : "";
+  const review = reviewSearch(parsed);
   if (range !== undefined) {
     if (fixture !== undefined || diff !== "") {
       throw new Error("start-fixture takes --range-case without --diff or --diff-case");
     }
-    return `?range=${encodeURIComponent(range)}`;
+    return `?range=${encodeURIComponent(range)}${review}`;
+  }
+  if (review !== "") {
+    throw new Error("start-fixture takes --threads and --gitlab only with --range-case");
   }
   return fixture === undefined ? diff : `?diff=${encodeURIComponent(fixture)}`;
 }
 
+function glabScenario(parsed: Parsed, opens: Opening): string | null {
+  const scenario = parsed.values.get("glab");
+  if (scenario === undefined) {
+    return null;
+  }
+  if (opens.kind !== "range") {
+    throw new Error("start-app --glab <scenario> needs --range: only the range window runs glab");
+  }
+  if (!/^[a-z0-9-]+$/.test(scenario)) {
+    throw new Error(`--glab ${scenario}: expected a folder name under tests/glab/, e.g. lined-up`);
+  }
+  return scenario;
+}
+
 function recording(parsed: Parsed): Recording | null {
   const file = parsed.values.get("record");
   const seconds = parsed.values.get("record-seconds");
@@ -121,14 +152,16 @@ export function startCommand(kind: StartCommand["kind"], parsed: Parsed): StartC
   if (kind === "start-fixture") {
     return { kind, name, size: size(parsed), search: fixtureSearch(parsed) };
   }
+  const opens = opening(parsed);
   return {
     kind,
     name,
     binary: parsed.values.get("binary") ?? DEFAULT_BINARY,
-    opens: opening(parsed),
+    opens,
     settings: settingsText(parsed),
     size: size(parsed),
     record: recording(parsed),
     home: parsed.values.get("home") ?? null,
+    glab: glabScenario(parsed, opens),
   };
 }
diff --git a/frontend/src/ui/AGENTS.md b/frontend/src/ui/AGENTS.md
index a45b1fc..db9647a 100644
--- a/frontend/src/ui/AGENTS.md
+++ b/frontend/src/ui/AGENTS.md
@@ -4,6 +4,8 @@ Compare window (plan §2 #93–#97, #101): a second root, `CompareApp.vue` over
 
 Range window (plan §2 #103–#106): a third root, `RangeApp.vue` over `rangeStore.ts`, mounted by `main.ts` when `<html data-window="range">` (app, `yamt --diff=<range>`) or `?range` / `?range=<case>` (fixture mode). Every range-only file carries the prefix — `Range*.vue`, `range*.ts`, `useRange*.ts` — and none imports `store.ts`, `App.vue`, `compareStore.ts`, `CompareApp.vue` or `lsp/` (fence PM9; PM7 keeps the compare root from `rangeStore.ts`/`RangeApp.vue`). The panel is the shared `FileList.vue` with `RangeFileRow.vue` in its `#file` slot (coloured A/M/D/R with its word as title, the old path of a renamed file muted, `+n −m`). `start` mirrors `openRange`'s reply; `shown` is written only by `showFile` and `startUp` (the first file at start); `visited` keeps first-visit order, at most `MOUNTED_FILES` (16) views mounted, the least recently shown dropped when another file is shown. A failed `loadFile` reports `open` with the path and drops the file from `visited`, so selecting it again retries; that file's later success clears the problem. `RangeView.vue` (one per visited file, `PaneFrame`) shows the header (icon, path or "old → new", the mode note, ↑/↓, gear), the column headers (side and short id, the subject as title) and either the two read-only columns or one sentence. `useRangeController` (`followRange`) keeps a texts reply in a non-reactive slot until the hosts exist, builds `RangeController` once, follows preferences, and drops a reply that lands after unmount; a sentence kind builds nothing. Every range word is in `rangeText.ts`. No close guard: the window closes at once.
 
+Range threads (plan §2 #116–#120): `rangeThreads.ts` (list, open set, drafts through `rangeDrafts.ts`, counts, `boxOf`) and `rangeGitLab.ts` (the check, Send, `postButton`/`sendButton`, the send result) are held by `rangeStore`; every lines-up sentence is in `rangeThreadText.ts`. `RangeView` renders `RangeThreadLayer.vue`, which teleports one `RangeThreadBox.vue` per key of `useRangeController`'s `threadHosts` into the host the editor keeps for that thread, so a box keeps its DOM, focus and typed text across CodeMirror redraws. A box is a draft (place, text, Comment/Cancel) or an open thread (place, collapse, one `RangeMessage.vue` per message, the reply field); a collapsed thread has no host and so no box. `RangeMessage` shows a note's text or the one `aiAnswer` line (an exhaustive switch C replaces), the `postButton` (disabled ones keep their sentence as title on a wrapper), the posting label, and for a pending message the link as selectable text with Copy (a failed clipboard write selects the link). Post opens `RangePostEditor.vue` in the message's place (Queue/Cancel), Unqueue is the same button while queued or refused. Keys in every box field go through `rangeKeys.ts` `boxKeydown`: Ctrl/Cmd+Enter submits, Escape cancels (a draft is dropped, a reply cleared), both `preventDefault` and `stopPropagation`; every other key stays the field's. `RangeApp`'s window keydown skips presses that type into a field (`typesIntoField`: a typing target per `isTypingTarget` without Ctrl/Cmd), so Ctrl/Cmd+B still toggles the list from a box or a find field. `RangeSendButton.vue` sits left of the gear in each `RangeView` header; `RangeApp` shows the last send's result (`sendResultText`) as a closable `NoticeBar` row and passes each file's thread count to `RangeFileRow` (a muted speech bubble, none at 0).
+
 Language servers (plan §2 #67, #70): the store holds the app's one `LanguageServers` (built in `main.ts`) through `servers.ts` (`serverViews` follows `onChange`, the shown log, the actions, `screen` for the log); `ServerStatus.vue` sits left of the gear in all three header rows, `ServerMenu.vue` and `ServerLogView.vue` hang off it; every word is in `serverText.ts`, except an install hint's text (the commands per package manager, steps and lines), which is `installText.ts`. The menu reads each `ServerView`'s `help` and `notes` (plan §2 #72): a failed start or an exit (`failureHelp`) shows "If it is not installed:" and the same install text as "Not installed"; each note is one muted line under the state (`noteLine`).
 
 Which servers exist (plan §2 #67, #70, #71): `serverSetup.ts` owns the start and focus sequences — `startUp` (from `main.ts`) loads the file list and the settings, then detects and asks the question when the repository (the host context's root) has no answer; `refocus` (App's focus watch) refreshes both, then detects again without asking, once `startUp` has run. The answer in force is always what the settings file holds after a write (a failed write changes nothing); "Don't start" halts the runs (`haltAll`) without marking them stopped by the user. With no host (fixture mode without `?servers`) it only loads and refreshes. Its Settings section is `LanguageServerSettings.vue`, whose add form starts with `PresetPicker.vue` ("From the list": `presetChoices()` in the key list's row-menu pattern, filling Command and File types, plan §2 #72); the question's wording is in `question.ts`, every server word (folder labels, "Not installed") in `serverText.ts`.
