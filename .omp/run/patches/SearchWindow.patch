diff --git a/frontend/src/ui/SearchPanel.vue b/frontend/src/ui/SearchPanel.vue
new file mode 100644
index 0000000..6d9c62c
--- /dev/null
+++ b/frontend/src/ui/SearchPanel.vue
@@ -0,0 +1,146 @@
+<script setup lang="ts" generic="P extends string">
+import { computed, nextTick, useTemplateRef, watch } from "vue";
+import CaseSensitive from "~icons/lucide/case-sensitive";
+
+import { PANE_ICONS } from "./searchIcons";
+import type { Searching } from "./searching";
+import SearchResults from "./SearchResults.vue";
+import {
+  CUT_TEXT,
+  MATCH_CASE_LABEL,
+  PANE_FILTERS_LABEL,
+  SEARCH_PLACEHOLDER,
+  SEARCH_TITLE,
+  summaryText,
+} from "./searchText";
+
+type Remembered = { readonly element: Element | null; readonly path: string | null };
+
+const props = defineProps<{ search: Searching<P>; shownPath: string | null; whole: boolean }>();
+
+const panel = useTemplateRef<HTMLElement>("panel");
+const box = useTemplateRef<HTMLInputElement>("box");
+const results = useTemplateRef<{ focusList(): void }>("results");
+let remembered: Remembered = { element: null, path: null };
+
+const summaryLine = computed(() => {
+  const summary = props.search.summary.value;
+  return summary === null ? null : summaryText(summary);
+});
+const cut = computed(() => {
+  const summary = props.search.summary.value;
+  return summary?.kind === "results" && summary.cut;
+});
+
+watch(
+  () => props.search.shown.value,
+  async (shown) => {
+    if (!shown) {
+      focusBack();
+      return;
+    }
+    remembered = { element: document.activeElement, path: props.shownPath };
+    await nextTick();
+    box.value?.focus();
+    box.value?.select();
+  },
+  { flush: "pre" },
+);
+
+function focusBack(): void {
+  const focused = document.activeElement;
+  const inPanel = focused === null || focused === document.body || panel.value?.contains(focused);
+  if (inPanel !== true) {
+    return;
+  }
+  const { element, path } = remembered;
+  if (element instanceof HTMLElement && element.isConnected && path === props.shownPath) {
+    element.focus();
+  } else {
+    props.search.focusShownFile();
+  }
+}
+
+function typed(event: Event): void {
+  if (event.target instanceof HTMLInputElement) {
+    props.search.type(event.target.value);
+  }
+}
+
+function boxKey(event: KeyboardEvent): void {
+  if (event.key === "Enter") {
+    event.preventDefault();
+    props.search.enter();
+  } else if (event.key === "ArrowDown") {
+    event.preventDefault();
+    results.value?.focusList();
+  }
+}
+</script>
+
+<template>
+  <section
+    v-show="search.shown.value"
+    ref="panel"
+    :aria-label="SEARCH_TITLE"
+    class="flex min-h-0 shrink-0 flex-col island bg-sidebar pb-1"
+    :class="whole ? 'flex-1' : 'mb-(--island-overlap) max-h-1/2'"
+  >
+    <div class="flex h-10 shrink-0 items-center pr-2 pl-3">
+      <h2 class="font-semibold">{{ SEARCH_TITLE }}</h2>
+    </div>
+    <div class="relative mx-2 flex shrink-0 items-center">
+      <input
+        ref="box"
+        type="text"
+        spellcheck="false"
+        :placeholder="SEARCH_PLACEHOLDER"
+        :aria-label="SEARCH_PLACEHOLDER"
+        :value="search.query.value"
+        class="w-full rounded border border-control-border bg-panel-inline py-1 pr-8 pl-2 outline-none focus:border-primary"
+        @input="typed"
+        @keydown="boxKey"
+      />
+      <button
+        type="button"
+        :title="MATCH_CASE_LABEL"
+        :aria-label="MATCH_CASE_LABEL"
+        :aria-pressed="search.matchCase.value"
+        class="absolute right-1 rounded p-0.5 hover:bg-hover aria-pressed:bg-row-selected aria-pressed:hover:brightness-110"
+        @mousedown.prevent
+        @click="search.toggleMatchCase()"
+      >
+        <CaseSensitive class="size-4" aria-hidden="true" />
+      </button>
+    </div>
+    <div role="group" :aria-label="PANE_FILTERS_LABEL" class="mx-2 mt-1.5 flex shrink-0 gap-1">
+      <button
+        v-for="info in search.panes.value"
+        :key="info.pane"
+        type="button"
+        :title="info.title"
+        :aria-label="info.title"
+        :aria-pressed="search.panesOn.value.has(info.pane)"
+        class="rounded p-1 hover:bg-hover aria-pressed:bg-row-selected aria-pressed:hover:brightness-110"
+        @mousedown.prevent
+        @click="search.togglePane(info.pane)"
+      >
+        <component :is="PANE_ICONS[info.icon]" class="size-4" aria-hidden="true" />
+      </button>
+    </div>
+    <p v-if="summaryLine !== null" role="status" class="mx-3 mt-1.5 shrink-0 text-fg-muted">
+      {{ summaryLine }}
+    </p>
+    <p v-if="cut" class="mx-3 mt-1 shrink-0 text-fg-muted">{{ CUT_TEXT }}</p>
+    <SearchResults
+      ref="results"
+      class="mt-1"
+      :rows="search.rows.value"
+      :panes="search.panes.value"
+      @toggle="search.toggleGroup"
+      @dismiss-place="search.dismissPlace"
+      @dismiss-group="search.dismissGroup"
+      @go="search.go"
+    />
+  </section>
+</template>
diff --git a/frontend/src/ui/SearchResults.vue b/frontend/src/ui/SearchResults.vue
new file mode 100644
index 0000000..d1ae052
--- /dev/null
+++ b/frontend/src/ui/SearchResults.vue
@@ -0,0 +1,228 @@
+<script setup lang="ts" generic="P extends string">
+import { useVirtualList } from "@vueuse/core";
+import { computed, shallowRef, type Component } from "vue";
+import ChevronDown from "~icons/lucide/chevron-down";
+import ChevronRight from "~icons/lucide/chevron-right";
+import XIcon from "~icons/lucide/x";
+
+import type { ListRow, PaneEntry, Place, PlaceKey } from "../search";
+import { fileIcon } from "./fileIcon";
+import { PANE_ICONS } from "./searchIcons";
+import type { SearchPaneInfo } from "./searching";
+import { DISMISS_LABEL, paneHitTitle, RESULTS_LABEL } from "./searchText";
+
+type Row = ListRow<P>;
+
+const props = defineProps<{ rows: readonly Row[]; panes: readonly SearchPaneInfo<P>[] }>();
+const emit = defineEmits<{
+  toggle: [path: string];
+  dismissPlace: [path: string, key: PlaceKey];
+  dismissGroup: [path: string];
+  go: [path: string, place: Place<P>, pane: P | null];
+}>();
+
+const ROW_HEIGHT_PX = 22;
+const PLACE_INDENT_PX = 28;
+
+const activeKey = shallowRef<string | null>(null);
+
+const rows = computed(() => props.rows);
+const { list, containerProps, wrapperProps } = useVirtualList(rows, {
+  itemHeight: ROW_HEIGHT_PX,
+});
+const activeIndex = computed(() => {
+  const index = props.rows.findIndex((row) => rowKey(row) === activeKey.value);
+  return index === -1 ? null : index;
+});
+
+function rowKey(row: Row): string {
+  return row.kind === "group"
+    ? JSON.stringify(["group", row.path])
+    : JSON.stringify(["place", row.path, row.place.key]);
+}
+
+function fileName(path: string): string {
+  return path.slice(path.lastIndexOf("/") + 1);
+}
+
+function folderOf(path: string): string {
+  return path.slice(0, Math.max(path.lastIndexOf("/"), 0));
+}
+
+function hitTitle(entry: PaneEntry<P>): string {
+  const title = props.panes.find((info) => info.pane === entry.pane)?.title ?? entry.pane;
+  return paneHitTitle(title, entry.hit.line);
+}
+
+function hitIcon(entry: PaneEntry<P>): Component | null {
+  const info = props.panes.find((pane) => pane.pane === entry.pane);
+  return info === undefined ? null : PANE_ICONS[info.icon];
+}
+
+function pressed(row: Row): void {
+  activeKey.value = rowKey(row);
+  if (row.kind === "group") {
+    emit("toggle", row.path);
+  } else {
+    emit("go", row.path, row.place, null);
+  }
+}
+
+function dismiss(row: Row): void {
+  if (row.kind === "group") {
+    emit("dismissGroup", row.path);
+  } else {
+    emit("dismissPlace", row.path, row.place.key);
+  }
+}
+
+function keepInView(index: number): void {
+  const element = containerProps.ref.value;
+  if (element === null) {
+    return;
+  }
+  const top = index * ROW_HEIGHT_PX;
+  if (top < element.scrollTop) {
+    element.scrollTop = top;
+  } else if (top + ROW_HEIGHT_PX > element.scrollTop + element.clientHeight) {
+    element.scrollTop = top + ROW_HEIGHT_PX - element.clientHeight;
+  }
+}
+
+function activate(index: number): void {
+  const row = props.rows[Math.min(Math.max(index, 0), props.rows.length - 1)];
+  if (row !== undefined) {
+    activeKey.value = rowKey(row);
+    keepInView(props.rows.indexOf(row));
+  }
+}
+
+function groupIndexOf(path: string): number {
+  return props.rows.findIndex((row) => row.kind === "group" && row.path === path);
+}
+
+function sideways(row: Row, opening: boolean): void {
+  if (row.kind === "place") {
+    if (!opening) {
+      activate(groupIndexOf(row.path));
+    }
+    return;
+  }
+  if (row.open !== opening) {
+    emit("toggle", row.path);
+  } else if (opening) {
+    activate(groupIndexOf(row.path) + 1);
+  }
+}
+
+function keydown(event: KeyboardEvent): void {
+  const index = activeIndex.value ?? -1;
+  const row = props.rows[index];
+  const moves: Readonly<Record<string, () => void>> = {
+    ArrowDown: () => {
+      activate(index + 1);
+    },
+    ArrowUp: () => {
+      activate(index - 1);
+    },
+    ArrowLeft: () => {
+      if (row !== undefined) {
+        sideways(row, false);
+      }
+    },
+    ArrowRight: () => {
+      if (row !== undefined) {
+        sideways(row, true);
+      }
+    },
+    Enter: () => {
+      if (row !== undefined) {
+        pressed(row);
+      }
+    },
+  };
+  const move = moves[event.key];
+  if (move !== undefined) {
+    event.preventDefault();
+    move();
+  }
+}
+
+function focusList(): void {
+  containerProps.ref.value?.focus();
+  if (activeIndex.value === null) {
+    activate(0);
+  }
+}
+
+defineExpose({ focusList });
+</script>
+
+<template>
+  <div
+    v-bind="containerProps"
+    role="tree"
+    tabindex="0"
+    :aria-label="RESULTS_LABEL"
+    class="group/list mr-0.5 min-h-0 flex-1 rounded-b-island opaque-sidebar-scroller outline-none"
+    @keydown="keydown"
+  >
+    <div v-bind="wrapperProps">
+      <div
+        v-for="{ data: row } in list"
+        :key="rowKey(row)"
+        role="treeitem"
+        :aria-level="row.kind === 'group' ? 1 : 2"
+        :aria-expanded="row.kind === 'group' ? row.open : undefined"
+        :aria-selected="rowKey(row) === activeKey"
+        class="group mx-1 flex cursor-default items-center gap-1.5 rounded pr-1 pl-2 hover:bg-row-hover aria-selected:bg-row-selected"
+        :style="{
+          height: `${ROW_HEIGHT_PX}px`,
+          paddingLeft: row.kind === 'place' ? `${PLACE_INDENT_PX}px` : undefined,
+        }"
+        @click="pressed(row)"
+      >
+        <template v-if="row.kind === 'group'">
+          <span class="flex size-4 shrink-0 items-center justify-center text-fg-muted">
+            <ChevronDown v-if="row.open" class="size-4" aria-hidden="true" />
+            <ChevronRight v-else class="size-4" aria-hidden="true" />
+          </span>
+          <component :is="fileIcon(row.path)" class="size-4 shrink-0" aria-hidden="true" />
+          <span class="shrink-0">{{ fileName(row.path) }}</span>
+          <span class="min-w-0 flex-1 truncate text-fg-muted">{{ folderOf(row.path) }}</span>
+          <span class="shrink-0 rounded-full bg-hover px-1.5 text-xs">{{ row.count }}</span>
+        </template>
+        <template v-else>
+          <span class="flex min-w-0 flex-1 overflow-hidden whitespace-pre">
+            <span class="shrink-0">{{ row.place.preview.before }}</span>
+            <mark class="shrink-0 rounded-sm bg-search-match text-inherit">{{
+              row.place.preview.match
+            }}</mark>
+            <span class="truncate">{{ row.place.preview.after }}</span>
+          </span>
+          <button
+            v-for="entry in row.shown"
+            :key="entry.pane"
+            type="button"
+            :title="hitTitle(entry)"
+            :aria-label="hitTitle(entry)"
+            class="shrink-0 rounded p-0.5 text-fg-muted hover:bg-hover"
+            @click.stop="emit('go', row.path, row.place, entry.pane)"
+          >
+            <component :is="hitIcon(entry)" class="size-3.5" aria-hidden="true" />
+          </button>
+        </template>
+        <button
+          type="button"
+          :title="DISMISS_LABEL"
+          :aria-label="DISMISS_LABEL"
+          class="invisible shrink-0 rounded p-0.5 group-hover:visible group-aria-selected:visible hover:bg-hover"
+          @mousedown.prevent
+          @click.stop="dismiss(row)"
+        >
+          <XIcon class="size-3.5" aria-hidden="true" />
+        </button>
+      </div>
+    </div>
+  </div>
+</template>
