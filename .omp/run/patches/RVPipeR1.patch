-//! answers `stderr closed`.
 use std::io::{self, BufRead, Read, Write};
-use std::process::{Command, Stdio};
 use std::time::Duration;
 use std::{env, process, thread};
 
 const IGNORE_STOP: &str = "--ignore-stop";
