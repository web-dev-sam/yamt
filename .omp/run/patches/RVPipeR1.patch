-#[cfg(unix)]
-fn close_stderr() -> io::Result<()> {
-    use std::os::unix::process::CommandExt;
-    let mut command = Command::new(env::current_exe()?);
-    Err(command.arg(STDERR_CLOSED).stderr(Stdio::null()).exec())
-}
-
-#[cfg(not(unix))]
-fn close_stderr() -> io::Result<()> {
-    Err(io::Error::other("close-stderr needs unix"))
-}
