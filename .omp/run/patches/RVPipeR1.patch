-/// A copy with no stdin and this process's stderr.
-fn spawn_copy(args: &[&str], stdout: Stdio) -> io::Result<()> {
-    Command::new(env::current_exe()?)
-        .args(args)
-        .stdin(Stdio::null())
-        .stdout(stdout)
-        .spawn()?;
-    Ok(())
-}
