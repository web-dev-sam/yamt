+import { expect, test } from "vitest";
+
+import { farTop } from "./exactScroll";
+
+const PADDING_PX = 4;
+const HEIGHT_PX = 600;
+const RENDERED = { top: 1000, bottom: 2000 };
+
+function at(scrollTop: number): number | null {
+  return farTop({ scrollTop, clientHeight: HEIGHT_PX, paddingTop: PADDING_PX }, RENDERED);
+}
+
+test("a visible span that ends where the rendered lines start is far, measured below the padding", () => {
+  expect(at(404)).toBe(400);
+});
+
+test("one pixel of the rendered lines' top in view is not far", () => {
+  expect(at(405)).toBeNull();
+});
+
+test("a visible span that starts where the rendered lines end is far, measured below the padding", () => {
+  expect(at(2004)).toBe(2000);
+});
+
+test("one pixel of the rendered lines' bottom in view is not far", () => {
+  expect(at(2003)).toBeNull();
+});
+
+test("a visible span inside the rendered lines is not far", () => {
+  expect(at(1200)).toBeNull();
+});
+
+test("a jump fully above or fully below the rendered lines places its visible top", () => {
+  expect(at(100)).toBe(96);
+  expect(at(2552)).toBe(2548);
+});
diff --git a/frontend/src/editor/internal/exactScroll.ts b/frontend/src/editor/internal/exactScroll.ts
new file mode 100644
index 0000000..145b83b
--- /dev/null
+++ b/frontend/src/editor/internal/exactScroll.ts
@@ -0,0 +1,80 @@
+import { EditorSelection, StateEffect, StateField } from "@codemirror/state";
+import type { Extension, SelectionRange } from "@codemirror/state";
+import { EditorView } from "@codemirror/view";
+
+import type { Span } from "../../connectors";
+
+type Placed = { readonly range: SelectionRange; readonly top: number };
+type ScrollBox = {
+  readonly scrollTop: number;
+  readonly clientHeight: number;
+  readonly paddingTop: number;
+};
+
+export function farTop(
+  { scrollTop, clientHeight, paddingTop }: ScrollBox,
+  rendered: Span,
+): number | null {
+  const visibleTop = scrollTop - paddingTop;
+  const overlaps = visibleTop < rendered.bottom && visibleTop + clientHeight > rendered.top;
+  return overlaps ? null : visibleTop;
+}
+
+const placeTop = StateEffect.define<Placed>();
+
+const placed = StateField.define<Placed | null>({
+  create: () => null,
+  update(value, tr) {
+    let next = value;
+    for (const effect of tr.effects) {
+      if (effect.is(placeTop)) {
+        next = effect.value;
+      }
+    }
+    return next;
+  },
+});
+
+// WebKitGTK 2.54 pulls back a scrollTop that shows none of the rendered lines while CodeMirror swaps
+// its viewport in its scroll measure (docs/plan.md §2 #82, docs/slices/briefs/3.M-minimap-window-rework-3.md);
+// a scroll request places the viewport first.
+function placeFarScroll(view: EditorView): void {
+  const top = view.scrollDOM.scrollTop;
+  const { from, to } = view.viewport;
+  const visibleTop = farTop(
+    {
+      scrollTop: top,
+      clientHeight: view.scrollDOM.clientHeight,
+      paddingTop: view.documentPadding.top,
+    },
+    { top: view.lineBlockAt(from).top, bottom: view.lineBlockAt(to).bottom },
+  );
+  if (visibleTop === null) {
+    return;
+  }
+  const line = view.lineBlockAtHeight(visibleTop);
+  const range = EditorSelection.cursor(line.from);
+  view.dispatch({
+    effects: [
+      placeTop.of({ range, top }),
+      EditorView.scrollIntoView(range, { y: "start", yMargin: line.top - visibleTop }),
+    ],
+  });
+}
+
+export const exactScroll: Extension = [
+  placed,
+  EditorView.domEventObservers({
+    scroll: (_event, view) => {
+      placeFarScroll(view);
+    },
+  }),
+  EditorView.scrollHandler.of((view, range) => {
+    const place = view.state.field(placed);
+    if (place === null || place.range !== range) {
+      return false;
+    }
+    view.scrollDOM.scrollTop = place.top;
+    return true;
+  }),
+];
