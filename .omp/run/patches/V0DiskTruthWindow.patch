+          kind: "Conflict",
+          base: range(base),
+          local: range(side),
+          remote: range(side),
+        },
+        middle: range(at),
+        words: {
+          chunk: 0,
+          local: { changed: [], removed_at: [] },
+          remote: { changed: [], removed_at: [] },
+        },
+      },
+    ],
+  };
+  return loadFixture("worked.txt", { "worked.json": record });
