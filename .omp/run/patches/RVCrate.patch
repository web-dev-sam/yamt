index 0000000..5932ace
--- /dev/null
+++ b/crates/range/src/lib.rs
@@ -0,0 +1,154 @@
+//! A commit range of a git repository: its spec, both sides, the changed files and what each one shows.
+#![forbid(unsafe_code)]
+
+mod entries;
+mod load;
+mod lock;
+mod open;
+mod spec;
+
+use std::path::PathBuf;
+
+use serde::{Deserialize, Serialize};
+use specta::Type;
+use yamt_merge_core::Difference;
+
+pub use crate::lock::PairLock;
+pub use crate::open::{Range, Resolved};
+pub use crate::spec::{RangeSpec, SpecError};
+
+/// A changed file's place in the range's list: 0.. in list order, fixed for the window's life.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize, Type)]
+pub struct RangeFileId(pub u32);
+
+/// How a column header names its side.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum RangeSideLabel {
+    /// A side as typed; an empty side is `HEAD`.
+    Named { name: String },
+    /// The left of `a...b`: where `right` branched off `left`.
+    MergeBase { left: String, right: String },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct RangeSide {
+    pub label: RangeSideLabel,
+    pub short_id: String,
+    pub subject: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum RangeChange {
+    Added,
+    Modified,
+    Deleted,
+    Renamed { old_path: String },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum RangeLineCounts {
+    Counted { added: u32, removed: u32 },
+    NotCounted,
+}
+
+/// One row of the list; `path` is the new path, the old one for a deleted file (UTF-8, lossy for display).
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct RangeEntry {
+    pub id: RangeFileId,
+    pub path: String,
+    pub change: RangeChange,
+    pub lines: RangeLineCounts,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct RangeStart {
+    pub range: String,
+    pub left: RangeSide,
+    pub right: RangeSide,
+    pub files: Vec<RangeEntry>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub enum RangeEntryKind {
+    File,
+    Executable,
+    Link,
+    Submodule,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum RangeModeChange {
+    Same,
+    Changed {
+        old: RangeEntryKind,
+        new: RangeEntryKind,
+    },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub enum RangeSides {
+    Left,
+    Right,
+    Both,
+}
+
+/// What one file shows: decided once, here.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum RangeFile {
+    Texts {
+        left: String,
+        right: String,
+        differences: Vec<Difference>,
+        mode: RangeModeChange,
+    },
+    Binary,
+    TooLarge {
+        limit: u32,
+    },
+    NotUtf8 {
+        sides: RangeSides,
+    },
+    ModeOnly {
+        old: RangeEntryKind,
+        new: RangeEntryKind,
+    },
+    KindChanged {
+        old: RangeEntryKind,
+        new: RangeEntryKind,
+    },
+    Submodule {
+        old: Option<String>,
+        new: Option<String>,
+    },
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum Error {
+    #[error("{} is not inside a git repository: {message}", path.display())]
+    NotARepository { path: PathBuf, message: String },
+    #[error("git names no commit \"{name}\"")]
+    UnknownName { name: String },
+    #[error("{left} and {right} have no merge base")]
+    NoMergeBase { left: String, right: String },
+    #[error("another yamt window shows {left}..{right} of {}", root.display())]
+    Locked {
+        root: PathBuf,
+        left: String,
+        right: String,
+    },
+    #[error("cannot write {}: {message}", path.display())]
+    LockFailed { path: PathBuf, message: String },
+    #[error("no file {} in this range", file.0)]
+    UnknownFile { file: RangeFileId },
+    #[error(transparent)]
+    Git(#[from] yamt_gitio::Error),
+}
+
+pub type Result<T, E = Error> = std::result::Result<T, E>;
diff --git a/crates/range/src/load.rs b/crates/range/src/load.rs
new file mode 100644
index 0000000..6fc3e3b
--- /dev/null
+++ b/crates/range/src/load.rs
@@ -0,0 +1,97 @@
+use yamt_gitio::{BlobReader, Repo};
+use yamt_merge_core::{MAX_TEXT_BYTES, compare};
+
+use crate::entries::{BlobAt, FileAt};
+use crate::{RangeEntryKind, RangeFile, RangeModeChange, RangeSides, Result};
+
+/// What `file` shows, read from the repository only when the listing cannot answer.
+pub(crate) fn load_file(repo: &Repo, file: &FileAt) -> Result<RangeFile> {
+    if let Some(answer) = decide(file) {
+        return Ok(answer);
+    }
+    let mut reader = repo.blob_reader()?;
+    let left = read_side(&mut reader, file.old.as_ref())?;
+    let right = read_side(&mut reader, file.new.as_ref())?;
+    match (String::from_utf8(left), String::from_utf8(right)) {
+        (Ok(left), Ok(right)) => Ok(RangeFile::Texts {
+            differences: compare(&left, &right),
+            left,
+            right,
+            mode: mode_change(file),
+        }),
+        (Err(_), Ok(_)) => Ok(RangeFile::NotUtf8 {
+            sides: RangeSides::Left,
+        }),
+        (Ok(_), Err(_)) => Ok(RangeFile::NotUtf8 {
+            sides: RangeSides::Right,
+        }),
+        (Err(_), Err(_)) => Ok(RangeFile::NotUtf8 {
+            sides: RangeSides::Both,
+        }),
+    }
+}
+
+/// The answer the listing alone gives (plan §2 #105's order up to the size), or `None`: read the blobs.
+fn decide(file: &FileAt) -> Option<RangeFile> {
+    let (old, new) = (file.old.as_ref(), file.new.as_ref());
+    if old.is_some_and(BlobAt::is_gitlink) || new.is_some_and(BlobAt::is_gitlink) {
+        return Some(RangeFile::Submodule {
+            old: commit_id(old),
+            new: commit_id(new),
+        });
+    }
+    if let (Some(old), Some(new)) = (old, new) {
+        let (old_kind, new_kind) = (old.kind(), new.kind());
+        if is_link(old_kind) != is_link(new_kind) {
+            return Some(RangeFile::KindChanged {
+                old: old_kind,
+                new: new_kind,
+            });
+        }
+        if old.oid == new.oid && old_kind != new_kind {
+            return Some(RangeFile::ModeOnly {
+                old: old_kind,
+                new: new_kind,
+            });
+        }
+    }
+    if file.binary {
+        return Some(RangeFile::Binary);
+    }
+    if old.is_some_and(is_too_large) || new.is_some_and(is_too_large) {
+        return Some(RangeFile::TooLarge {
+            limit: u32::try_from(MAX_TEXT_BYTES).unwrap_or(u32::MAX),
+        });
+    }
+    None
+}
+
+fn commit_id(side: Option<&BlobAt>) -> Option<String> {
+    side.filter(|side| side.is_gitlink())
+        .map(|side| side.oid.as_str().to_owned())
+}
+
+fn is_link(kind: RangeEntryKind) -> bool {
+    kind == RangeEntryKind::Link
+}
+
+fn is_too_large(blob: &BlobAt) -> bool {
+    blob.size.is_some_and(|size| size > MAX_TEXT_BYTES as u64)
+}
+
+fn read_side(reader: &mut BlobReader, side: Option<&BlobAt>) -> Result<Vec<u8>> {
+    match side {
+        Some(blob) => Ok(reader.read(&blob.oid)?),
+        None => Ok(Vec::new()),
+    }
+}
+
+fn mode_change(file: &FileAt) -> RangeModeChange {
+    match (&file.old, &file.new) {
+        (Some(old), Some(new)) if old.kind() != new.kind() => RangeModeChange::Changed {
+            old: old.kind(),
+            new: new.kind(),
+        },
+        _ => RangeModeChange::Same,
+    }
+}
