--- /dev/null
+++ b/crates/range/src/lock.rs
@@ -0,0 +1,118 @@
+use std::ffi::OsString;
+use std::fs::{self, File, OpenOptions, TryLockError};
+use std::io;
+use std::path::{Path, PathBuf};
+
+use crate::{Error, Resolved, Result};
+
+const LOCK_FILE: &str = "lock";
+const GIT_DIR_NAME: &str = ".git";
+const FNV_OFFSET_BASIS: u64 = 0xcbf2_9ce4_8422_2325;
+const FNV_PRIME: u64 = 0x0100_0000_01b3;
+
+/// The range window's claim on one repository and commit pair, held for the process's life.
+#[derive(Debug)]
+pub struct PairLock {
+    _lock: File,
+    folder: PathBuf,
+}
+
+impl PairLock {
+    /// Takes `<range_dir>/<repo key>/<left id>-<right id>/lock`; another process holding it is `Locked`.
+    pub fn take(range_dir: &Path, resolved: &Resolved) -> Result<PairLock> {
+        let common_dir = resolved.repo.common_dir()?;
+        let pair = format!(
+            "{}-{}",
+            resolved.left.oid.as_str(),
+            resolved.right.oid.as_str()
+        );
+        let folder = range_dir.join(repo_key(&common_dir)).join(pair);
+        fs::create_dir_all(&folder).map_err(|error| lock_failed(&folder, &error))?;
+        let path = folder.join(LOCK_FILE);
+        let file = OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .write(true)
+            .open(&path)
+            .map_err(|error| lock_failed(&path, &error))?;
+        // The lock is the file's own: the OS releases it when the process ends, also on `kill -9`
+        // (`File::try_lock`, flock(2) / `LockFileEx`).
+        match file.try_lock() {
+            Ok(()) => Ok(PairLock {
+                _lock: file,
+                folder,
+            }),
+            Err(TryLockError::WouldBlock) => Err(Error::Locked {
+                root: resolved.root().to_owned(),
+                left: resolved.left.side.short_id.clone(),
+                right: resolved.right.side.short_id.clone(),
+            }),
+            Err(TryLockError::Error(error)) => Err(lock_failed(&path, &error)),
+        }
+    }
+
+    #[must_use]
+    pub fn folder(&self) -> &Path {
+        &self.folder
+    }
+}
+
+/// The repository's folder name, `-`, and the FNV-1a hash of its common git dir: the same from every worktree.
+fn repo_key(common_dir: &Path) -> OsString {
+    let in_work_tree = common_dir
+        .file_name()
+        .is_some_and(|name| name == GIT_DIR_NAME);
+    let named = if in_work_tree {
+        common_dir.parent().unwrap_or(common_dir)
+    } else {
+        common_dir
+    };
+    let mut key = named.file_name().unwrap_or_default().to_os_string();
+    let hash = fnv1a_64(common_dir.as_os_str().as_encoded_bytes());
+    key.push(format!("-{hash:016x}"));
+    key
+}
+
+/// FNV-1a, 64 bits (<http://www.isthe.com/chongo/tech/comp/fnv/>): stable across Rust releases, unlike `DefaultHasher`.
+fn fnv1a_64(bytes: &[u8]) -> u64 {
+    let mut hash = FNV_OFFSET_BASIS;
+    for &byte in bytes {
+        hash ^= u64::from(byte);
+        hash = hash.wrapping_mul(FNV_PRIME);
+    }
+    hash
+}
+
+fn lock_failed(path: &Path, error: &io::Error) -> Error {
+    Error::LockFailed {
+        path: path.to_owned(),
+        message: error.to_string(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fnv1a_64_gives_the_published_vectors() {
+        assert_eq!(format!("{:016x}", fnv1a_64(b"a")), "af63dc4c8601ec8c");
+        assert_eq!(format!("{:016x}", fnv1a_64(b"")), "cbf29ce484222325");
+        assert_eq!(format!("{:016x}", fnv1a_64(b"foobar")), "85944171f73967e8");
+    }
+
+    #[test]
+    fn the_key_names_the_work_tree_folder_or_a_bare_repository_and_hashes_the_common_dir() {
+        let key = |dir: &str| repo_key(Path::new(dir)).into_string().unwrap();
+        let hash = |dir: &str| format!("{:016x}", fnv1a_64(dir.as_bytes()));
+        assert_eq!(
+            key("/x/proj/.git"),
+            format!("proj-{}", hash("/x/proj/.git"))
+        );
+        assert_eq!(
+            key("/x/proj.git"),
+            format!("proj.git-{}", hash("/x/proj.git"))
+        );
+        assert_ne!(key("/x/proj/.git"), key("/y/proj/.git"));
+    }
+}
diff --git a/crates/range/src/open.rs b/crates/range/src/open.rs
new file mode 100644
index 0000000..2d7ca69
--- /dev/null
+++ b/crates/range/src/open.rs
@@ -0,0 +1,132 @@
+use std::path::Path;
+
+use yamt_gitio::{Oid, Repo};
+
+use crate::entries::{FileAt, blob_ids, files_at, sort_by_display_path};
+use crate::load::load_file;
+use crate::spec::Dots;
+use crate::{
+    Error, RangeFile, RangeFileId, RangeSide, RangeSideLabel, RangeSpec, RangeStart, Result,
+};
+
+/// A range whose two commits git has named: built before any window opens.
+pub struct Resolved {
+    pub(crate) repo: Repo,
+    spec: RangeSpec,
+    pub(crate) left: SideAt,
+    pub(crate) right: SideAt,
+}
+
+/// One side's commit, and how the window names it.
+pub(crate) struct SideAt {
+    pub(crate) oid: Oid,
+    pub(crate) side: RangeSide,
+}
+
+/// A resolved range and its changed files: immutable for the window's life.
+pub struct Range {
+    resolved: Resolved,
+    files: Vec<FileAt>,
+}
+
+impl Resolved {
+    pub fn resolve(cwd: &Path, spec: &RangeSpec) -> Result<Resolved> {
+        let repo = Repo::discover(cwd).map_err(|error| not_a_repository(cwd, error))?;
+        let left_tip = commit_named(&repo, &spec.left)?;
+        let right_tip = commit_named(&repo, &spec.right)?;
+        let (left_oid, left_label) = match spec.dots {
+            Dots::Two => (left_tip, named(&spec.left)),
+            Dots::Three => {
+                let base = repo.merge_base(&left_tip, &right_tip)?;
+                let Some(base) = base else {
+                    return Err(Error::NoMergeBase {
+                        left: spec.left.clone(),
+                        right: spec.right.clone(),
+                    });
+                };
+                let label = RangeSideLabel::MergeBase {
+                    left: spec.left.clone(),
+                    right: spec.right.clone(),
+                };
+                (base, label)
+            }
+        };
+        let left = side_at(&repo, left_oid, left_label)?;
+        let right = side_at(&repo, right_tip, named(&spec.right))?;
+        Ok(Resolved {
+            repo,
+            spec: spec.clone(),
+            left,
+            right,
+        })
+    }
+
+    #[must_use]
+    pub fn root(&self) -> &Path {
+        self.repo.root()
+    }
+
+    pub fn list(self) -> Result<Range> {
+        let mut changed = self.repo.changed_files(&self.left.oid, &self.right.oid)?;
+        sort_by_display_path(&mut changed);
+        let sizes = self.repo.blob_sizes(&blob_ids(&changed))?;
+        let files = files_at(changed, sizes);
+        Ok(Range {
+            resolved: self,
+            files,
+        })
+    }
+}
+
+impl Range {
+    #[must_use]
+    pub fn start(&self) -> RangeStart {
+        RangeStart {
+            range: self.resolved.spec.text().to_owned(),
+            left: self.resolved.left.side.clone(),
+            right: self.resolved.right.side.clone(),
+            files: self.files.iter().map(|file| file.entry.clone()).collect(),
+        }
+    }
+
+    pub fn load(&self, file: RangeFileId) -> Result<RangeFile> {
+        let Some(found) = self.files.iter().find(|at| at.entry.id == file) else {
+            return Err(Error::UnknownFile { file });
+        };
+        load_file(&self.resolved.repo, found)
+    }
+}
+
+/// `Repo::discover` fails with git's own refusal outside a work tree; its first line names why.
+fn not_a_repository(cwd: &Path, error: yamt_gitio::Error) -> Error {
+    if let yamt_gitio::Error::GitFailed { stderr, .. } = &error {
+        let message = stderr.lines().next().unwrap_or_default().to_owned();
+        return Error::NotARepository {
+            path: cwd.to_owned(),
+            message,
+        };
+    }
+    Error::Git(error)
+}
+
+fn commit_named(repo: &Repo, name: &str) -> Result<Oid> {
+    repo.commit_named(name)?.ok_or_else(|| Error::UnknownName {
+        name: name.to_owned(),
+    })
+}
+
+fn named(name: &str) -> RangeSideLabel {
+    RangeSideLabel::Named {
+        name: name.to_owned(),
+    }
+}
+
+fn side_at(repo: &Repo, oid: Oid, label: RangeSideLabel) -> Result<SideAt> {
+    let summary = repo.commit_summary(&oid)?;
+    let side = RangeSide {
+        label,
+        short_id: String::from_utf8_lossy(&summary.short_id).into_owned(),
+        subject: String::from_utf8_lossy(&summary.subject).into_owned(),
+    };
+    Ok(SideAt { oid, side })
+}
diff --git a/crates/range/src/spec.rs b/crates/range/src/spec.rs
new file mode 100644
index 0000000..ae8584c
--- /dev/null
+++ b/crates/range/src/spec.rs
@@ -0,0 +1,159 @@
+const DOTS: &str = "..";
+const EMPTY_SIDE: &str = "HEAD";
+
+/// A range as the user typed it: `a..b` compares the two commits, `a...b` where `b` branched off `a` with `b`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RangeSpec {
+    text: String,
+    pub(crate) left: String,
+    pub(crate) dots: Dots,
+    pub(crate) right: String,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Dots {
+    Two,
+    Three,
+}
+
+#[derive(Debug, PartialEq, Eq, thiserror::Error)]
+pub enum SpecError {
+    #[error("--diff= needs a range, such as main...dev")]
+    Empty,
+    #[error(
+        "--diff={text}: a range needs two dots (a..b) or three (a...b); yamt does not compare the working tree"
+    )]
+    NoDots { text: String },
+    #[error("--diff={text}: a range holds one \"..\" or \"...\"")]
+    ExtraDots { text: String },
+    #[error("--diff={text}: a side may not start with \"-\"")]
+    Dash { text: String },
+}
+
+impl RangeSpec {
+    pub fn parse(text: &str) -> Result<RangeSpec, SpecError> {
+        if text.is_empty() {
+            return Err(SpecError::Empty);
+        }
+        let Some((left, rest)) = text.split_once(DOTS) else {
+            return Err(SpecError::NoDots {
+                text: text.to_owned(),
+            });
+        };
+        let (dots, right) = match rest.strip_prefix('.') {
+            Some(right) => (Dots::Three, right),
+            None => (Dots::Two, rest),
+        };
+        if right.starts_with('.') || right.contains(DOTS) {
+            return Err(SpecError::ExtraDots {
+                text: text.to_owned(),
+            });
+        }
+        if left.starts_with('-') || right.starts_with('-') {
+            return Err(SpecError::Dash {
+                text: text.to_owned(),
+            });
+        }
+        Ok(RangeSpec {
+            text: text.to_owned(),
+            left: side_name(left),
+            dots,
+            right: side_name(right),
+        })
+    }
+
+    #[must_use]
+    pub fn text(&self) -> &str {
+        &self.text
+    }
+}
+
+fn side_name(typed: &str) -> String {
+    if typed.is_empty() {
+        EMPTY_SIDE.to_owned()
+    } else {
+        typed.to_owned()
+    }
+}
