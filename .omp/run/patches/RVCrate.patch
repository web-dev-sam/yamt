+        file("b.txt", Some(b"b\n"), Some(b"b\n"), Some(b"b remote\n")),
+    ]);
+    let root = dir.path();
+
+    let three = range(root, "remote...local");
+    let two = range(root, "remote..local");
+
+    assert_eq!(paths(&three), ["a.txt"]);
