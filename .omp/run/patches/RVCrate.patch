+    commit(root, "y2");
+    git_ok(root, &["checkout", "--quiet", "x"]).unwrap();
+    git_ok(root, &["merge", "--quiet", "--no-edit", &y1]).unwrap();
+    write_and_add(root, "x.txt", "x2\n");
+    write_and_add(root, "f.txt", "f from x\n");
+    commit(root, "x2");
