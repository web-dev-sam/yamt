+++ 2/crates/session/src/decode.rs
@@ -0,0 +1,81 @@
+use std::path::Path;
+
+use serde::Serialize;
+use specta::Type;
+
+// git's binary heuristic: a NUL within the first 8000 bytes (xdiff-interface.c FIRST_FEW_BYTES).
+const BINARY_PROBE_LEN: usize = 8000;
+const MAX_TEXT_BYTES: usize = 8 * 1024 * 1024;
+const TYPESCRIPT_EXTENSIONS: [&str; 4] = ["ts", "tsx", "mts", "cts"];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+pub enum Eol {
+    Lf,
+    CrLf,
+    Mixed,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+pub enum UnsupportedReason {
+    Binary,
+    NonUtf8,
+    TooLarge,
+    LocalDeleted,
+    RemoteDeleted,
+}
+
+pub(crate) fn decode_side(bytes: Vec<u8>) -> Result<String, UnsupportedReason> {
+    let probe = bytes.get(..BINARY_PROBE_LEN).unwrap_or(&bytes);
+    if probe.contains(&b'\0') {
+        return Err(UnsupportedReason::Binary);
+    }
+    if bytes.len() > MAX_TEXT_BYTES {
+        return Err(UnsupportedReason::TooLarge);
+    }
+    String::from_utf8(bytes).map_err(|_| UnsupportedReason::NonUtf8)
+}
+
+pub(crate) fn detect_eol(text: &str) -> Eol {
+    let line_breaks = text.matches('\n').count();
+    let crlf_breaks = text.matches("\r\n").count();
+    if crlf_breaks == 0 {
+        Eol::Lf
+    } else if crlf_breaks == line_breaks {
+        Eol::CrLf
+    } else {
+        Eol::Mixed
+    }
+}
+
+pub(crate) fn language_of(path: &Path) -> Option<String> {
+    let extension = path.extension()?.to_str()?;
+    if TYPESCRIPT_EXTENSIONS.contains(&extension) {
+        Some("typescript".to_owned())
+    } else {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn eol_is_crlf_only_when_every_line_break_is_crlf() {
+        assert_eq!(detect_eol(""), Eol::Lf);
+        assert_eq!(detect_eol("a\nb"), Eol::Lf);
+        assert_eq!(detect_eol("a\r\nb\r\n"), Eol::CrLf);
+        assert_eq!(detect_eol("a\r\nb\n"), Eol::Mixed);
+        assert_eq!(detect_eol("a\rb\n"), Eol::Lf);
+    }
+
+    #[test]
+    fn nul_after_the_probe_window_is_still_text() {
+        let mut bytes = vec![b'a'; BINARY_PROBE_LEN];
+        bytes.push(b'\0');
+        assert!(decode_side(bytes).is_ok());
+        let mut bytes = vec![b'a'; BINARY_PROBE_LEN - 1];
+        bytes.push(b'\0');
+        assert_eq!(decode_side(bytes), Err(UnsupportedReason::Binary));
+    }
+}
diff --git 1/crates/session/src/session.rs 2/crates/session/src/session.rs
new file mode 100644
index 0000000..e35db6a
--- /dev/null
+++ 2/crates/session/src/session.rs
@@ -0,0 +1,261 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use serde::Serialize;
+use specta::Type;
+use yamt_gitio::{BlobReader, Repo, Stage, StageEntry};
+use yamt_merge_core::{Chunk, Options, compute_chunks};
+
+use crate::decode::{Eol, UnsupportedReason, decode_side, detect_eol, language_of};
+use crate::{Error, Result};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+pub enum FileStatus {
+    Unresolved,
+    Resolved,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct FileEntry {
+    pub path: String,
+    pub status: FileStatus,
+    pub unsupported: Option<UnsupportedReason>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct FileMergeData {
+    pub path: String,
+    pub base: String,
+    pub local: String,
+    pub remote: String,
+    pub eol: Eol,
+    pub language: Option<String>,
+    pub chunks: Vec<Chunk>,
+}
+
+pub struct MergeSession {
+    repo: Repo,
+    files: Vec<FileState>,
+}
+
+struct FileState {
+    path: PathBuf,
+    stages: CapturedStages,
+    status: FileStatus,
+    content: Content,
+}
+
+#[derive(Default)]
+struct CapturedStages {
+    base: Option<StageEntry>,
+    local: Option<StageEntry>,
+    remote: Option<StageEntry>,
+}
+
+enum Content {
+    Text(Texts),
+    Unsupported(UnsupportedReason),
+}
+
+struct Texts {
+    base: String,
+    local: String,
+    remote: String,
+}
+
+impl MergeSession {
+    pub fn open(cwd: &Path) -> Result<MergeSession> {
+        let repo = Repo::discover(cwd)?;
+        let mut blobs = repo.blob_reader()?;
+        let mut files = Vec::new();
+        for (path, stages) in group_by_path(repo.unmerged()?) {
+            let content = read_content(&mut blobs, &path, &stages)?;
+            files.push(FileState {
+                path,
+                stages,
+                status: FileStatus::Unresolved,
+                content,
+            });
+        }
+        Ok(MergeSession { repo, files })
+    }
+
+    #[must_use]
+    pub fn files(&self) -> Vec<FileEntry> {
+        let mut entries = Vec::with_capacity(self.files.len());
+        for file in &self.files {
+            let unsupported = match &file.content {
+                Content::Text(_) => None,
+                Content::Unsupported(reason) => Some(*reason),
+            };
+            entries.push(FileEntry {
+                path: file.display_path(),
+                status: file.status,
+                unsupported,
+            });
+        }
+        entries
+    }
+
+    pub fn load(&mut self, path: &str) -> Result<FileMergeData> {
+        let file = self.file(path)?;
+        let texts = file.texts()?;
+        let eol_source = if texts.base.is_empty() {
+            &texts.local
+        } else {
+            &texts.base
+        };
+        let chunks = compute_chunks(
+            &texts.base,
+            &texts.local,
+            &texts.remote,
+            &Options::default(),
+        );
+        Ok(FileMergeData {
+            path: file.display_path(),
+            base: texts.base.clone(),
+            local: texts.local.clone(),
+            remote: texts.remote.clone(),
+            eol: detect_eol(eol_source),
+            language: language_of(&file.path),
+            chunks,
+        })
+    }
+
+    pub fn finish(&mut self, path: &str, result: &str) -> Result<()> {
+        let file = self.file(path)?;
+        file.texts()?;
+        let worktree_file = self.repo.root().join(&file.path);
+        fs::write(&worktree_file, result).map_err(|source| Error::WriteFailed {
+            path: path.to_owned(),
+            source,
+        })?;
+        self.repo.add(&file.path)?;
+        self.file_mut(path)?.status = FileStatus::Resolved;
+        Ok(())
+    }
+
+    pub fn reset(&mut self, path: &str) -> Result<()> {
+        let file = self.file(path)?;
+        self.repo.restore_stages(&file.stages.entries())?;
+        // `checkout -m` refuses a path without both sides: "does not have all necessary versions".
+        if file.stages.has_both_sides() {
+            self.repo.checkout_merge(&file.path)?;
+        }
+        self.file_mut(path)?.status = FileStatus::Unresolved;
+        Ok(())
+    }
+
+    #[must_use]
+    pub fn remaining(&self) -> usize {
+        self.files
+            .iter()
+            .filter(|file| file.status == FileStatus::Unresolved)
+            .count()
+    }
+
+    fn file(&self, path: &str) -> Result<&FileState> {
+        self.files
+            .iter()
+            .find(|file| file.display_path() == path)
+            .ok_or_else(|| Error::UnknownPath {
+                path: path.to_owned(),
+            })
+    }
+
+    fn file_mut(&mut self, path: &str) -> Result<&mut FileState> {
+        self.files
+            .iter_mut()
+            .find(|file| file.display_path() == path)
+            .ok_or_else(|| Error::UnknownPath {
+                path: path.to_owned(),
+            })
+    }
+}
+
+impl FileState {
+    fn display_path(&self) -> String {
+        self.path.to_string_lossy().into_owned()
+    }
+
+    fn texts(&self) -> Result<&Texts> {
+        match &self.content {
+            Content::Text(texts) => Ok(texts),
+            Content::Unsupported(reason) => Err(Error::Unsupported {
+                path: self.display_path(),
+                reason: *reason,
+            }),
+        }
+    }
+}
+
+impl CapturedStages {
+    fn insert(&mut self, entry: StageEntry) {
+        match entry.stage {
+            Stage::Base => self.base = Some(entry),
+            Stage::Local => self.local = Some(entry),
+            Stage::Remote => self.remote = Some(entry),
+        }
+    }
+
+    fn has_both_sides(&self) -> bool {
+        self.local.is_some() && self.remote.is_some()
+    }
+
+    fn entries(&self) -> Vec<StageEntry> {
+        [&self.base, &self.local, &self.remote]
+            .into_iter()
+            .flatten()
+            .cloned()
+            .collect()
+    }
+}
+
+fn group_by_path(entries: Vec<StageEntry>) -> Vec<(PathBuf, CapturedStages)> {
+    let mut groups: Vec<(PathBuf, CapturedStages)> = Vec::new();
+    for entry in entries {
+        match groups.last_mut() {
+            Some((path, stages)) if *path == entry.path => stages.insert(entry),
+            Some(_) | None => {
+                let mut stages = CapturedStages::default();
+                let path = entry.path.clone();
+                stages.insert(entry);
+                groups.push((path, stages));
+            }
+        }
+    }
+    groups
+}
+
+fn read_content(blobs: &mut BlobReader, path: &Path, stages: &CapturedStages) -> Result<Content> {
+    if path.to_str().is_none() {
+        return Ok(Content::Unsupported(UnsupportedReason::NonUtf8));
+    }
+    let Some(local) = &stages.local else {
+        return Ok(Content::Unsupported(UnsupportedReason::LocalDeleted));
+    };
+    let Some(remote) = &stages.remote else {
+        return Ok(Content::Unsupported(UnsupportedReason::RemoteDeleted));
+    };
+    let base = match &stages.base {
+        Some(entry) => blobs.read(&entry.oid)?,
+        None => Vec::new(),
+    };
+    let decoded = decode_texts(base, blobs.read(&local.oid)?, blobs.read(&remote.oid)?);
+    match decoded {
+        Ok(texts) => Ok(Content::Text(texts)),
+        Err(reason) => Ok(Content::Unsupported(reason)),
+    }
+}
+
+fn decode_texts(
+    base: Vec<u8>,
+    local: Vec<u8>,
+    remote: Vec<u8>,
+) -> Result<Texts, UnsupportedReason> {
+    Ok(Texts {
+        base: decode_side(base)?,
+        local: decode_side(local)?,
+        remote: decode_side(remote)?,
+    })
+}
diff --git 1/crates/session/tests/finish_and_reset.rs 2/crates/session/tests/finish_and_reset.rs
new file mode 100644
index 0000000..682a372
--- /dev/null
+++ 2/crates/session/tests/finish_and_reset.rs
@@ -0,0 +1,176 @@
+#![cfg(test)]
+
+use std::fs;
+
+use yamt_conflict_repo::{ConflictFile, TempDir, conflict_repo, git_ok};
+use yamt_session::{Eol, Error, FileStatus, MergeSession, UnsupportedReason};
+
+const FILE: &str = "src/cart.ts";
+const OTHER: &str = "src/other.ts";
+
+fn two_file_conflict() -> TempDir {
+    conflict_repo(&[
+        ConflictFile {
+            path: FILE,
+            base: Some(b"one\ntwo\nthree\n"),
+            local: Some(b"one\nlocal\nthree\n"),
+            remote: Some(b"one\nremote\nthree\n"),
+        },
+        ConflictFile {
+            path: OTHER,
+            base: Some(b"four\nfive\n"),
+            local: Some(b"four\nlocal five\n"),
+            remote: Some(b"four\nremote five\n"),
+        },
+    ])
+    .unwrap()
+}
+
+fn single_conflict(path: &str, sides: [&[u8]; 3]) -> TempDir {
+    let [base, local, remote] = sides;
+    conflict_repo(&[ConflictFile {
+        path,
+        base: Some(base),
+        local: Some(local),
+        remote: Some(remote),
+    }])
+    .unwrap()
+}
+
+fn unmerged(dir: &TempDir) -> String {
+    String::from_utf8(git_ok(dir.path(), &["ls-files", "-u"]).unwrap()).unwrap()
+}
+
+fn status_of(session: &MergeSession, path: &str) -> FileStatus {
+    let files = session.files();
+    files.iter().find(|file| file.path == path).unwrap().status
+}
+
+fn assert_finish_with_local_round_trips_bytes(sides: [&[u8]; 3], expected_eol: Eol) {
+    const PATH: &str = "eol.txt";
+    let dir = single_conflict(PATH, sides);
+    let mut session = MergeSession::open(dir.path()).unwrap();
+    let data = session.load(PATH).unwrap();
+    assert_eq!(data.eol, expected_eol);
+
+    session.finish(PATH, &data.local).unwrap();
+
+    let worktree = fs::read(dir.path().join(PATH)).unwrap();
+    assert_eq!(worktree, sides[1]);
+}
+
+#[test]
+fn crlf_file_is_detected_and_finish_writes_its_crlf_bytes_unchanged() {
+    let sides: [&[u8]; 3] = [b"a\r\nb\r\nc", b"a\r\nlocal\r\nc", b"a\r\nremote\r\nc"];
+    assert_finish_with_local_round_trips_bytes(sides, Eol::CrLf);
+}
+
+#[test]
+fn mixed_eol_file_is_detected_and_finish_writes_its_bytes_unchanged() {
+    let sides: [&[u8]; 3] = [
+        b"a\r\nb\nc\r\n",
+        b"a\r\nlocal\nc\r\n",
+        b"a\r\nremote\nc\r\n",
+    ];
+    assert_finish_with_local_round_trips_bytes(sides, Eol::Mixed);
+}
+
+#[test]
+fn finish_writes_the_result_marks_it_resolved_and_git_no_longer_lists_it() {
+    const RESULT: &str = "one\nmerged\nthree\n";
+    let dir = two_file_conflict();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+    assert_eq!(session.remaining(), 2);
+
+    session.finish(FILE, RESULT).unwrap();
+
+    assert!(!unmerged(&dir).contains(FILE));
+    assert!(unmerged(&dir).contains(OTHER));
+    assert_eq!(fs::read_to_string(dir.path().join(FILE)).unwrap(), RESULT);
+    assert_eq!(status_of(&session, FILE), FileStatus::Resolved);
+    assert_eq!(session.remaining(), 1);
+}
+
+#[test]
+fn reset_after_finish_restores_git_stages_and_conflict_markers() {
+    let dir = two_file_conflict();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+    let before_finish = unmerged(&dir);
+    session.finish(FILE, "resolved\n").unwrap();
+    // `git add` leaves a resolve-undo record that `checkout -m` alone would use to bring the
+    // conflict back (git-ls-files(1) --resolve-undo); without it only the captured stages can.
+    git_ok(dir.path(), &["update-index", "--clear-resolve-undo"]).unwrap();
+
+    session.reset(FILE).unwrap();
+
+    assert_eq!(unmerged(&dir), before_finish);
+    let worktree = fs::read_to_string(dir.path().join(FILE)).unwrap();
+    assert!(worktree.contains("<<<<<<<"), "no markers in {worktree:?}");
+    assert_eq!(status_of(&session, FILE), FileStatus::Unresolved);
+    assert_eq!(session.remaining(), 2);
+}
+
+#[test]
+fn unknown_path_is_rejected_by_load_finish_and_reset() {
+    const UNKNOWN: &str = "not-conflicted.ts";
+    let dir = two_file_conflict();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+
+    let errors = [
+        session.load(UNKNOWN).unwrap_err(),
+        session.finish(UNKNOWN, "text\n").unwrap_err(),
+        session.reset(UNKNOWN).unwrap_err(),
+    ];
+
+    for error in errors {
+        assert!(
+            matches!(&error, Error::UnknownPath { path } if path == UNKNOWN),
+            "{error:?}"
+        );
+    }
+    assert!(!dir.path().join(UNKNOWN).exists());
+}
+
+#[test]
+fn finish_refuses_an_unsupported_file_and_leaves_the_worktree_alone() {
+    const PATH: &str = "image.bin";
+    let dir = single_conflict(PATH, [b"\0base", b"\0local", b"\0remote"]);
+    let worktree_before = fs::read(dir.path().join(PATH)).unwrap();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+
+    let error = session.finish(PATH, "text\n").unwrap_err();
+
+    assert!(
+        matches!(
+            &error,
+            Error::Unsupported {
+                reason: UnsupportedReason::Binary,
+                ..
+            }
+        ),
+        "{error:?}"
+    );
+    assert_eq!(fs::read(dir.path().join(PATH)).unwrap(), worktree_before);
+    assert!(unmerged(&dir).contains(PATH));
+}
+
+#[test]
+fn reset_of_a_delete_modify_file_resolved_outside_restores_its_stages() {
+    const PATH: &str = "gone.txt";
+    let dir = conflict_repo(&[ConflictFile {
+        path: PATH,
+        base: Some(b"kept\nbase\n"),
+        local: None,
+        remote: Some(b"kept\nremote\n"),
+    }])
+    .unwrap();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+    let before = unmerged(&dir);
+    git_ok(dir.path(), &["add", "--", PATH]).unwrap();
+    git_ok(dir.path(), &["update-index", "--clear-resolve-undo"]).unwrap();
+
+    session.reset(PATH).unwrap();
+
+    assert_eq!(unmerged(&dir), before);
+    assert_eq!(status_of(&session, PATH), FileStatus::Unresolved);
+}
diff --git 1/crates/session/tests/open_and_load.rs 2/crates/session/tests/open_and_load.rs
new file mode 100644
index 0000000..55a985c
--- /dev/null
+++ 2/crates/session/tests/open_and_load.rs
@@ -0,0 +1,198 @@
+#![cfg(test)]
+
+use yamt_conflict_repo::{ConflictFile, TempDir, conflict_repo, git_ok};
+use yamt_merge_core::{ChunkKind, Options, compute_chunks};
+use yamt_session::{Eol, Error, FileEntry, FileStatus, MergeSession, UnsupportedReason};
+
+const MODIFY_TS: &str = "a_modify.ts";
+const ADD_ADD: &str = "b_added.txt";
+const LOCAL_DELETED: &str = "c_local_deleted.txt";
+const REMOTE_DELETED: &str = "d_remote_deleted.txt";
+const BINARY: &str = "e_binary.bin";
+const LATIN1: &str = "f_latin1.txt";
+const CRLF: &str = "g_crlf.txt";
+
+const MODIFY_SIDES: [&str; 3] = [
+    "one\ntwo\nthree\n",
+    "one\nlocal\nthree\n",
+    "one\nremote\nthree\n",
+];
+
+const EVERY_KIND_OF_CONFLICT: [ConflictFile<'static>; 7] = [
+    ConflictFile {
+        path: MODIFY_TS,
+        base: Some(MODIFY_SIDES[0].as_bytes()),
+        local: Some(MODIFY_SIDES[1].as_bytes()),
+        remote: Some(MODIFY_SIDES[2].as_bytes()),
+    },
+    ConflictFile {
+        path: ADD_ADD,
+        base: None,
+        local: Some(b"alpha added by local\n"),
+        remote: Some(b"bravo added by remote\n"),
+    },
+    ConflictFile {
+        path: LOCAL_DELETED,
+        base: Some(b"charlie\ndelta\n"),
+        local: None,
+        remote: Some(b"charlie\nchanged by remote\n"),
+    },
+    ConflictFile {
+        path: REMOTE_DELETED,
+        base: Some(b"echo\nfoxtrot\n"),
+        local: Some(b"echo\nchanged by local\n"),
+        remote: None,
+    },
+    ConflictFile {
+        path: BINARY,
+        base: Some(b"\0binary base"),
+        local: Some(b"\0binary local"),
+        remote: Some(b"\0binary remote"),
+    },
+    ConflictFile {
+        path: LATIN1,
+        base: Some(b"caf\xe9 base\n"),
+        local: Some(b"caf\xe9 local\n"),
+        remote: Some(b"caf\xe9 remote\n"),
+    },
+    ConflictFile {
+        path: CRLF,
+        base: Some(b"golf\r\nhotel\r\n"),
+        local: Some(b"golf\r\nlocal\r\n"),
+        remote: Some(b"golf\r\nremote\r\n"),
+    },
+];
+
+fn every_kind_of_conflict() -> TempDir {
+    conflict_repo(&EVERY_KIND_OF_CONFLICT).unwrap()
+}
+
+fn unmerged_paths_in_git_order(dir: &TempDir) -> Vec<String> {
+    let output = git_ok(dir.path(), &["ls-files", "-u", "-z"]).unwrap();
+    let mut paths: Vec<String> = Vec::new();
+    for record in output
+        .split(|&byte| byte == b'\0')
+        .filter(|r| !r.is_empty())
+    {
+        let tab = record.iter().position(|&byte| byte == b'\t').unwrap();
+        let path = String::from_utf8(record[tab + 1..].to_vec()).unwrap();
+        if paths.last() != Some(&path) {
+            paths.push(path);
+        }
+    }
+    paths
+}
+
+fn unsupported_error(session: &mut MergeSession, path: &str) -> UnsupportedReason {
+    let error = session.load(path).unwrap_err();
+    let Error::Unsupported {
+        path: error_path,
+        reason,
+    } = error
+    else {
+        panic!("expected Unsupported for {path}, got {error:?}");
+    };
+    assert_eq!(error_path, path);
+    reason
+}
+
+#[test]
+fn open_lists_each_conflicted_file_once_in_git_order_with_its_unsupported_reason() {
+    let dir = every_kind_of_conflict();
+
+    let session = MergeSession::open(dir.path()).unwrap();
+
+    let expected = [
+        (MODIFY_TS, None),
+        (ADD_ADD, None),
+        (LOCAL_DELETED, Some(UnsupportedReason::LocalDeleted)),
+        (REMOTE_DELETED, Some(UnsupportedReason::RemoteDeleted)),
+        (BINARY, Some(UnsupportedReason::Binary)),
+        (LATIN1, Some(UnsupportedReason::NonUtf8)),
+        (CRLF, None),
+    ]
+    .map(|(path, unsupported)| FileEntry {
+        path: path.to_owned(),
+        status: FileStatus::Unresolved,
+        unsupported,
+    });
+    let files = session.files();
+    assert_eq!(files, expected);
+    let listed: Vec<String> = files.into_iter().map(|file| file.path).collect();
+    assert_eq!(listed, unmerged_paths_in_git_order(&dir));
+    assert_eq!(session.remaining(), expected.len());
+}
+
+#[test]
+fn load_modify_modify_typescript_returns_three_sides_and_their_chunks() {
+    let dir = every_kind_of_conflict();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+
+    let data = session.load(MODIFY_TS).unwrap();
+
+    let [base, local, remote] = MODIFY_SIDES;
+    assert_eq!(data.path, MODIFY_TS);
+    assert_eq!(
+        [&data.base, &data.local, &data.remote],
+        [base, local, remote]
+    );
+    assert_eq!(data.language.as_deref(), Some("typescript"));
+    assert_eq!(data.eol, Eol::Lf);
+    assert_eq!(
+        data.chunks,
+        compute_chunks(base, local, remote, &Options::default())
+    );
+}
+
+#[test]
+fn load_add_add_has_empty_base_and_one_conflict_chunk() {
+    let dir = every_kind_of_conflict();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+
+    let data = session.load(ADD_ADD).unwrap();
+
+    assert_eq!(data.base, "");
+    assert_eq!(data.language, None);
+    let kinds: Vec<ChunkKind> = data.chunks.iter().map(|chunk| chunk.kind).collect();
+    assert_eq!(kinds, [ChunkKind::Conflict]);
+}
+
+#[test]
+fn load_refuses_deleted_binary_and_non_utf8_files_with_their_reason() {
+    let dir = every_kind_of_conflict();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+
+    let cases = [
+        (LOCAL_DELETED, UnsupportedReason::LocalDeleted),
+        (REMOTE_DELETED, UnsupportedReason::RemoteDeleted),
+        (BINARY, UnsupportedReason::Binary),
+        (LATIN1, UnsupportedReason::NonUtf8),
+    ];
+    for (path, reason) in cases {
+        assert_eq!(unsupported_error(&mut session, path), reason);
+    }
+}
+
+#[test]
+fn load_refuses_a_side_over_eight_mib_as_too_large() {
+    const PATH: &str = "huge.txt";
+    const EIGHT_MIB: usize = 8 * 1024 * 1024;
+    let huge_local = "x".repeat(EIGHT_MIB) + "\n";
+    let dir = conflict_repo(&[ConflictFile {
+        path: PATH,
+        base: Some(b"base\n"),
+        local: Some(huge_local.as_bytes()),
+        remote: Some(b"remote\n"),
+    }])
+    .unwrap();
+    let mut session = MergeSession::open(dir.path()).unwrap();
+
+    assert_eq!(
+        session.files()[0].unsupported,
+        Some(UnsupportedReason::TooLarge)
+    );
+    assert_eq!(
+        unsupported_error(&mut session, PATH),
+        UnsupportedReason::TooLarge
+    );
+}
