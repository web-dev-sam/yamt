+  await threads.addNote(id, "More?");
+
+  expect(texts(threadAt(threads, 0))).toEqual(["Why does the overdue check go?", "More?"]);
+  expect(threads.noteText(id)).toBe("");
+
+  const refused = await opened(SEEDED, () => ({
