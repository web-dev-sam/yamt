+/// How many of `messages` are answers in `session`: the turn its next answer gets.
+fn answers_in(messages: &[Message], session: &str) -> u32 {
+    let mut answers = 0;
+    for message in messages {
+        if let MessageBody::AiAnswer {
+            session: answered_in,
+            ..
+        } = &message.body
+            && answered_in == session
+        {
+            answers += 1;
+        }
     }
