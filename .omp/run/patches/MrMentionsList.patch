+test("the_mirror_copies_what_moves_a_glyph_and_wraps_like_the_field", () => {
+  expect(mirrorStyle({ ...COPIED, ...IGNORED }, 314)).toEqual({
+    ...COPIED,
+    "box-sizing": "content-box",
