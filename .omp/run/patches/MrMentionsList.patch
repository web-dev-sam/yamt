+  direction: "rtl",
+  "padding-top": "4px",
+  "padding-right": "8px",
+  "padding-bottom": "4px",
+  "padding-left": "6px",
+  "font-family": "Inter",
+  "font-size": "13px",
+  "font-style": "italic",
+  "font-weight": "600",
+  "font-variant-ligatures": "none",
+  "font-feature-settings": '"tnum"',
+  "font-kerning": "none",
+  "line-height": "20px",
+  "letter-spacing": "0.5px",
+  "word-spacing": "2px",
+  "tab-size": "4",
+  "text-indent": "3px",
