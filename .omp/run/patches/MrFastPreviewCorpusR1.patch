+/// The first part of `html` the local preview never renders: an emoji, math, a diagram, a reference, or a link other
+/// than a heading's anchor.
+fn first_remote_markup(html: &str) -> Option<&'static str> {
+    let marker = [
+        "<gl-emoji",
+        "js-render-math",
+        "js-render-mermaid",
+        "data-reference-type",
+    ]
+    .into_iter()
+    .find(|marker| html.contains(marker));
+    let link = html.split("<a ").skip(1).find(|link| {
+        let tag = link.split('>').next().unwrap_or(link);
+        !tag.contains("class=\"anchor\"")
+    });
+    marker.or(link.map(|_| "<a"))
+}
+
+#[test]
+fn a_local_entry_html_holds_no_emoji_math_diagram_reference_or_link() {
+    let holding: Vec<(String, &str)> = corpus()
+        .entries
+        .iter()
+        .filter(|entry| entry.local)
+        .filter_map(|entry| Some((entry.name.clone(), first_remote_markup(&entry.html)?)))
+        .collect();
+
+    assert_eq!(holding, Vec::<(String, &str)>::new());
+}
