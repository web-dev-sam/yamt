@@ -0,0 +1,41 @@
+name: setup
+description: The toolchains and packages that ci.yml and release.yml build with.
+
+inputs:
+  rust:
+    description: "'false' skips the Rust/Tauri part (Linux system packages, rustup, tauri-cli) for a frontend-only job."
+    default: "true"
+
+runs:
+  using: composite
+  steps:
+    - name: Linux system packages
+      if: inputs.rust == 'true' && runner.os == 'Linux'
+      shell: bash
+      run: |
+        sudo apt-get update
+        sudo apt-get install -y libwebkit2gtk-4.1-dev librsvg2-dev patchelf
+
+    - name: Rust toolchain from rust-toolchain.toml
+      if: inputs.rust == 'true'
+      shell: bash
+      run: |
+        rustup toolchain install
+        rustup show active-toolchain
+
+    - name: Tauri CLI
+      if: inputs.rust == 'true'
+      shell: bash
+      run: cargo install tauri-cli --version 2.12.1 --locked
+
+    - uses: actions/setup-node@v7.1.0
+      with:
+        node-version: 24
+
+    - uses: pnpm/action-setup@v6.1.0
+      with:
+        package_json_file: frontend/package.json
+
+    - name: Frontend packages
+      shell: bash
+      run: pnpm -C frontend install --frozen-lockfile
