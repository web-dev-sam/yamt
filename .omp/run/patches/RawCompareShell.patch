+    }
+
+    #[test]
+    fn a_fresh_tab_loads_two_empty_texts_without_differences() {
+        let window = open_compare_window();
+        let versions = json!({ "left": 0, "right": 0 });
+        assert_eq!(
+            window.invoke("load_tab", json!({ "tab": 1 })),
