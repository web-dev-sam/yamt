+import { expect, test } from "vitest";
+
+import { sizeText, sizeTitle } from "../index";
+
+test("the size reads +added −removed · files, the minus a real minus sign (U+2212)", () => {
+  const text = sizeText({ additions: 120, deletions: 40, files: 6 });
