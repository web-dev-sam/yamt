+        const opener = which === null ? null : parts.opener(which);
+        return opener === null ? [] : [opener];
+      },
+    },
+  );
+  return {
+    openFor: dropdown.openFor,
+    above: dropdown.above,
+    toggle: (which) => toggle(dropdown, which),
+    close: () => close(dropdown),
+    menuKey: (event) => {
+      menuKey(dropdown, event);
+    },
+  };
+}
