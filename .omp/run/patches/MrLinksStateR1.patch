diff --git a/frontend/src/ipc/linksDomain.test.ts b/frontend/src/ipc/linksDomain.test.ts
new file mode 100644
index 0000000..10bff59
--- /dev/null
+++ b/frontend/src/ipc/linksDomain.test.ts
@@ -0,0 +1,63 @@
+import { expect, test } from "vitest";
+
+import type * as Generated from "./bindings";
+import { toLinksReply } from "./linksDomain";
+
+function linksAt(page: (field: string) => string): Generated.LinksReply {
+  const parent = {
+    reference: "&3",
+    title: "Board",
+    page: page("links.issues[1].shown.parent.page"),
+  };
+  return {
+    kind: "read",
+    links: {
+      epics: [{ reference: "&3", page: page("links.epics[0].page"), shown: null }],
+      issues: [
+        { reference: "#9", page: page("links.issues[0].page"), shown: null },
+        {
+          reference: "#12",
+          page: page("links.issues[1].page"),
+          shown: { title: "Snooze", closed: true, parent },
+        },
+        {
+          reference: "#13",
+          page: page("links.issues[2].page"),
+          shown: { title: "Test", closed: false, parent: null },
+        },
+      ],
+      commits: [{ reference: "fa3335f3", page: page("links.commits[0].page"), title: "Backfill" }],
+    },
+  };
+}
+
+const LINKS_FIELDS = [
+  "links.epics[0].page",
+  "links.issues[0].page",
+  "links.issues[1].page",
+  "links.issues[1].shown.parent.page",
+  "links.issues[2].page",
+  "links.commits[0].page",
+];
+
+test("every_links_page_is_branded_and_a_non_https_one_fails", () => {
+  const raw = linksAt((field) => `https://gitlab.example/${field}`);
+  expect(toLinksReply(raw)).toEqual(raw);
+  for (const bad of LINKS_FIELDS) {
+    for (const page of ["http://gitlab.example/x", "ftp://x"]) {
+      const reply = linksAt((field) => (field === bad ? page : "https://gitlab.example/"));
+      expect(() => toLinksReply(reply)).toThrow(`${bad} must be an https address, got "${page}"`);
+    }
+  }
+});
+
+test("a_links_refusal_passes_unchanged", () => {
+  const replies: Generated.LinksReply[] = [
+    { kind: "glabMissing" },
+    { kind: "notLoggedIn", detail: "d" },
+    { kind: "failed", message: "m" },
+  ];
+  for (const reply of replies) {
+    expect(toLinksReply(reply)).toBe(reply);
+  }
+});
diff --git a/frontend/src/ipc/linksDomain.ts b/frontend/src/ipc/linksDomain.ts
new file mode 100644
index 0000000..0366e54
--- /dev/null
+++ b/frontend/src/ipc/linksDomain.ts
@@ -0,0 +1,76 @@
+import type * as Generated from "./bindings";
+import type { WebPage } from "./domain";
+import { toWebPage } from "./mergeRequestDomain";
+
+export type LinkedParent = {
+  readonly reference: string;
+  readonly title: string;
+  readonly page: WebPage;
+};
+export type LinkedEpic = {
+  readonly reference: string;
+  readonly page: WebPage;
+  readonly shown: { readonly title: string; readonly closed: boolean } | null;
+};
+export type LinkedIssue = {
+  readonly reference: string;
+  readonly page: WebPage;
+  readonly shown: {
+    readonly title: string;
+    readonly closed: boolean;
+    readonly parent: LinkedParent | null;
+  } | null;
+};
+export type LinkedCommit = {
+  readonly reference: string;
+  readonly page: WebPage;
+  readonly title: string | null;
+};
+export type DescriptionLinks = {
+  readonly epics: readonly LinkedEpic[];
+  readonly issues: readonly LinkedIssue[];
+  readonly commits: readonly LinkedCommit[];
+};
+export type LinksReply =
+  | { readonly kind: "read"; readonly links: DescriptionLinks }
+  | Readonly<Exclude<Generated.LinksReply, { kind: "read" }>>;
+
+function toIssue(raw: Generated.LinkedIssue, field: string): LinkedIssue {
+  const page = toWebPage(raw.page, `${field}.page`);
+  if (raw.shown === null) {
+    return { ...raw, page, shown: null };
+  }
+  const { parent } = raw.shown;
+  const parentPage = `${field}.shown.parent.page`;
+  return {
+    ...raw,
+    page,
+    shown: {
+      ...raw.shown,
+      parent: parent === null ? null : { ...parent, page: toWebPage(parent.page, parentPage) },
+    },
+  };
+}
+
+/** Brands every line's and parent's page as an https WebPage, the only kind Rust's links lookup sends; any other
+ *  throws. */
+export function toLinksReply(raw: Generated.LinksReply): LinksReply {
+  if (raw.kind !== "read") {
+    return raw;
+  }
+  const { epics, issues, commits } = raw.links;
+  return {
+    kind: "read",
+    links: {
+      epics: epics.map((epic, at) => ({
+        ...epic,
+        page: toWebPage(epic.page, `links.epics[${at}].page`),
+      })),
+      issues: issues.map((issue, at) => toIssue(issue, `links.issues[${at}]`)),
+      commits: commits.map((commit, at) => ({
+        ...commit,
+        page: toWebPage(commit.page, `links.commits[${at}].page`),
+      })),
+    },
+  };
+}
