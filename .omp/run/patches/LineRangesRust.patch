+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize, Type)]
+pub struct ThreadPlace {
+    /// The first line.
+    pub start: DiffLine,
+    /// The last line, in the column it was picked in.
+    pub end: ThreadLine,
+}
+
+impl ThreadPlace {
+    /// The place of one line.
+    #[must_use]
+    pub fn one_line(line: ThreadLine) -> ThreadPlace {
