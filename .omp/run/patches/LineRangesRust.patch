+    }
+
+    fn removed(left: u32) -> DiffLine {
+        DiffLine::Removed {
+            left: LeftLine(left),
+        }
+    }
+
+    fn added(right: u32) -> ThreadLine {
+        ThreadLine::Added {
+            right: RightLine(right),
+        }
+    }
+
+    fn range_end(
+        line_code: &str,
+        line_type: Option<LineType>,
+        old_line: Option<u32>,
+        new_line: Option<u32>,
+    ) -> RangeEnd {
