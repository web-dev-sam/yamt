diff --git c/frontend/src/ui/KeyRecorder.vue i/frontend/src/ui/KeyRecorder.vue
new file mode 100644
index 0000000..2c0281d
--- /dev/null
+++ i/frontend/src/ui/KeyRecorder.vue
@@ -0,0 +1,205 @@
+<script setup lang="ts">
+import { onClickOutside } from "@vueuse/core";
+import { computed, nextTick, onMounted, shallowRef, useTemplateRef } from "vue";
+import Plus from "~icons/lucide/plus";
+import TriangleAlert from "~icons/lucide/triangle-alert";
+
+import {
+  KEY_ACTIONS,
+  keyLabel,
+  keyOfEvent,
+  sameKey,
+  type Key,
+  type KeyAction,
+  type KeyBindings,
+} from "../ipc";
+import { ACTION_NAMES, setKeyMenu, usedByText } from "./keyText";
+
+const props = defineProps<{ action: KeyAction; initial: Key | null; bindings: KeyBindings }>();
+const emit = defineEmits<{ record: [key: Key]; close: [] }>();
+
+const MENU_STEPS: Readonly<Record<string, number>> = { ArrowDown: 1, ArrowUp: -1 };
+
+const dialog = useTemplateRef<HTMLDialogElement>("dialog");
+const field = useTemplateRef<HTMLInputElement>("field");
+const plusButton = useTemplateRef<HTMLButtonElement>("plusButton");
+const plusMenu = useTemplateRef<HTMLUListElement>("plusMenu");
+const shown = shallowRef<Key | null>(props.initial);
+const plusOpen = shallowRef(false);
+const setKeys = setKeyMenu(navigator.platform);
+
+const shownText = computed(() =>
+  shown.value === null ? "" : keyLabel(shown.value, navigator.platform),
+);
+const owners = computed(() => {
+  const key = shown.value;
+  return key === null
+    ? []
+    : KEY_ACTIONS.filter(
+        (other) =>
+          other !== props.action && props.bindings[other].some((held) => sameKey(held, key)),
+      );
+});
+
+onClickOutside(
+  plusMenu,
+  () => {
+    plusOpen.value = false;
+  },
+  { ignore: [plusButton] },
+);
+
+onMounted(() => {
+  dialog.value?.showModal();
+  field.value?.focus();
+});
+
+function confirm(): void {
+  if (shown.value !== null) {
+    emit("record", shown.value);
+  }
+}
+
+function cancel(event: Event): void {
+  event.preventDefault();
+  emit("close");
+}
+
+// ShortcutTextField.processKeyEvent: plain Escape and (with a key shown) plain Enter go to the
+// dialog, a modifier alone changes nothing, every other key with its modifiers replaces the shown one.
+function recordKey(event: KeyboardEvent): void {
+  const modified = event.ctrlKey || event.metaKey || event.altKey;
+  if (event.key === "Tab" && !modified) {
+    return;
+  }
+  event.preventDefault();
+  event.stopPropagation();
+  const plain = !modified && !event.shiftKey;
+  if (plain && event.key === "Escape") {
+    emit("close");
+    return;
+  }
+  if (plain && event.key === "Enter" && shown.value !== null) {
+    confirm();
+    return;
+  }
+  const key = keyOfEvent(event, navigator.platform);
+  if (key !== null) {
+    shown.value = key;
+  }
+}
+
+async function togglePlus(): Promise<void> {
+  plusOpen.value = !plusOpen.value;
+  await nextTick();
+  plusMenu.value?.querySelector<HTMLElement>("[role=menuitem]")?.focus();
+}
+
+function closePlus(): void {
+  plusOpen.value = false;
+  field.value?.focus();
+}
+
+function setKey(key: Key): void {
+  shown.value = key;
+  closePlus();
+}
+
+function plusMenuKey(event: KeyboardEvent): void {
+  if (event.key === "Escape" || event.key === "Tab") {
+    event.preventDefault();
+    event.stopPropagation();
+    closePlus();
+    return;
+  }
+  const step = MENU_STEPS[event.key];
+  const items = [...(plusMenu.value?.querySelectorAll<HTMLElement>("[role=menuitem]") ?? [])];
+  if (step === undefined || items.length === 0) {
+    return;
+  }
+  event.preventDefault();
+  const index = items.findIndex((item) => item === event.target);
+  items[(index + step + items.length) % items.length]?.focus();
+}
+</script>
+
+<template>
+  <dialog
+    ref="dialog"
+    aria-labelledby="key-dialog-title"
+    class="m-auto w-[22rem] overflow-visible rounded-lg border border-control-border bg-panel text-fg"
+    @cancel="cancel"
+  >
+    <h2 id="key-dialog-title" class="border-b border-control-border px-4 py-2 font-semibold">
+      Keyboard Shortcut
+    </h2>
+    <div class="px-4 pt-3">
+      <p class="mb-2">{{ ACTION_NAMES[action] }}</p>
+      <div class="relative">
+        <input
+          ref="field"
+          type="text"
+          readonly
+          aria-label="Keyboard shortcut"
+          :value="shownText"
+          class="w-full rounded border border-control-border bg-panel-inline py-1 pr-9 pl-2 caret-transparent outline-none focus:border-primary"
+          @keydown="recordKey"
+        />
+        <button
+          ref="plusButton"
+          type="button"
+          title="Set a key the field cannot record"
+          aria-label="Set a key the field cannot record"
+          aria-haspopup="menu"
+          :aria-expanded="plusOpen"
+          class="absolute inset-y-0.5 right-0.5 rounded px-1.5 hover:bg-hover"
+          @click="togglePlus"
+        >
+          <Plus class="size-4" aria-hidden="true" />
+        </button>
+        <ul
+          v-if="plusOpen"
+          ref="plusMenu"
+          role="menu"
+          aria-label="Set a key"
+          class="absolute top-full right-0 z-10 mt-1 min-w-36 rounded border border-control-border bg-panel py-1"
+          @keydown="plusMenuKey"
+        >
+          <li v-for="entry in setKeys" :key="entry.label" role="none">
+            <button
+              type="button"
+              role="menuitem"
+              class="w-full px-3 py-1 text-left outline-none hover:bg-hover focus:bg-row-selected"
+              @click="setKey(entry.key)"
+            >
+              {{ entry.label }}
+            </button>
+          </li>
+        </ul>
+      </div>
+      <p role="status" class="mt-2 flex min-h-6 items-start gap-1.5">
+        <template v-if="owners.length > 0">
+          <TriangleAlert class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
+          {{ usedByText(owners) }}
+        </template>
+      </p>
+    </div>
+    <div class="flex justify-end gap-2 px-4 pt-2 pb-4">
+      <button
+        type="button"
+        :disabled="shown === null"
+        class="rounded border border-primary bg-primary px-3.5 py-1 text-on-primary hover:brightness-110 disabled:border-control-border disabled:bg-transparent disabled:text-fg-muted disabled:hover:brightness-100"
+        @click="confirm"
+      >
+        OK
+      </button>
+      <button
+        type="button"
+        class="rounded border border-control-border px-3.5 py-1 hover:bg-hover"
+        @click="emit('close')"
+      >
+        Cancel
+      </button>
+    </div>
+  </dialog>
+</template>
diff --git c/frontend/src/ui/KeymapList.vue i/frontend/src/ui/KeymapList.vue
new file mode 100644
index 0000000..a7c46cd
--- /dev/null
+++ i/frontend/src/ui/KeymapList.vue
@@ -0,0 +1,224 @@
+<script setup lang="ts">
+import { onClickOutside } from "@vueuse/core";
+import { computed, nextTick, shallowRef, useTemplateRef } from "vue";
+
+import { keyLabel, type Key, type KeyAction } from "../ipc";
+import { isDefault } from "./keymapEdit";
+import KeyRecorder from "./KeyRecorder.vue";
+import {
+  ACTION_NAMES,
+  ACTION_PLACES,
+  KEYMAP_GROUPS,
+  keymapMenu,
+  type KeymapCommand,
+} from "./keyText";
+import { useAppStore } from "./store";
+
+type Recording = { readonly action: KeyAction; readonly from: Key | null };
+
+const ROW_STEPS: Readonly<Record<string, number>> = { ArrowDown: 1, ArrowUp: -1 };
+
+const { settings, addKey, changeKey, removeKey, removeAllKeys, resetKeys } = useAppStore();
+const list = useTemplateRef<HTMLDivElement>("list");
+const menu = useTemplateRef<HTMLUListElement[]>("menu");
+const menuFor = shallowRef<KeyAction | null>(null);
+const recording = shallowRef<Recording | null>(null);
+
+const bindings = computed(() => settings.value.keys.bindings);
+const groups = computed(() =>
+  KEYMAP_GROUPS.map(({ title, actions }) => ({
+    title,
+    rows: actions.map((action) => {
+      const keys = bindings.value[action];
+      return {
+        action,
+        labels: keys.map((key) => keyLabel(key, navigator.platform)),
+        changed: !isDefault(action, keys),
+      };
+    }),
+  })),
+);
+const menuEntries = computed(() =>
+  menuFor.value === null
+    ? []
+    : keymapMenu(menuFor.value, bindings.value[menuFor.value], navigator.platform),
+);
+
+onClickOutside(
+  () => menu.value?.[0] ?? null,
+  () => {
+    void closeMenu();
+  },
+  { ignore: ["[data-keymap-row][aria-expanded=true]"] },
+);
+
+function rowOf(action: KeyAction): HTMLElement | null {
+  return list.value?.querySelector<HTMLElement>(`[data-keymap-row="${action}"]`) ?? null;
+}
+
+async function focusRow(action: KeyAction): Promise<void> {
+  await nextTick();
+  rowOf(action)?.focus();
+}
+
+async function closeMenu(): Promise<void> {
+  const action = menuFor.value;
+  menuFor.value = null;
+  if (action !== null) {
+    await focusRow(action);
+  }
+}
+
+async function toggleMenu(action: KeyAction): Promise<void> {
+  if (menuFor.value === action) {
+    await closeMenu();
+    return;
+  }
+  menuFor.value = action;
+  await nextTick();
+  menu.value?.[0]?.querySelector<HTMLElement>("[role=menuitem]")?.focus();
+}
+
+function stepRow(event: KeyboardEvent): void {
+  const step = ROW_STEPS[event.key];
+  const rows = [...(list.value?.querySelectorAll<HTMLElement>("[data-keymap-row]") ?? [])];
+  if (step === undefined) {
+    return;
+  }
+  event.preventDefault();
+  rows[rows.findIndex((row) => row === event.currentTarget) + step]?.focus();
+}
+
+function menuKey(event: KeyboardEvent): void {
+  if (event.key === "Escape" || event.key === "Tab") {
+    event.preventDefault();
+    void closeMenu();
+    return;
+  }
+  const step = ROW_STEPS[event.key];
+  const items = [...(menu.value?.[0]?.querySelectorAll<HTMLElement>("[role=menuitem]") ?? [])];
+  if (step === undefined || items.length === 0) {
+    return;
+  }
+  event.preventDefault();
+  const index = items.findIndex((item) => item === event.target);
+  items[(index + step + items.length) % items.length]?.focus();
+}
+
+async function run(action: KeyAction, command: KeymapCommand): Promise<void> {
+  await closeMenu();
+  switch (command.kind) {
+    case "add":
+      recording.value = { action, from: null };
+      return;
+    case "change":
+      recording.value = { action, from: command.key };
+      return;
+    case "remove":
+      await removeKey(action, command.key);
+      return;
+    case "removeAll":
+      await removeAllKeys(action);
+      return;
+    case "reset":
+      await resetKeys(action);
+      return;
+    default: {
+      const _exhaustive: never = command;
+      return _exhaustive;
+    }
+  }
+}
+
+async function stopRecording(): Promise<Recording | null> {
+  const done = recording.value;
+  recording.value = null;
+  if (done !== null) {
+    await focusRow(done.action);
+  }
+  return done;
+}
+
+async function recorded(key: Key): Promise<void> {
+  const done = await stopRecording();
+  if (done === null) {
+    return;
+  }
+  await (done.from === null ? addKey(done.action, key) : changeKey(done.action, done.from, key));
+  if (document.activeElement === document.body) {
+    await focusRow(done.action);
+  }
+}
+</script>
+
+<template>
+  <div ref="list" class="flex flex-col gap-4">
+    <section v-for="group in groups" :key="group.title" :aria-label="group.title">
+      <h4 class="mb-1 text-fg-muted">{{ group.title }}</h4>
+      <ul class="flex flex-col">
+        <li v-for="row in group.rows" :key="row.action" class="relative">
+          <button
+            type="button"
+            :data-keymap-row="row.action"
+            aria-haspopup="menu"
+            :aria-expanded="menuFor === row.action"
+            class="flex w-full items-start gap-3 rounded px-2 py-1 text-left hover:bg-row-hover aria-expanded:bg-row-selected"
+            @click="toggleMenu(row.action)"
+            @keydown="stepRow"
+          >
+            <span class="min-w-0 flex-1">
+              <span class="block" :class="{ 'text-primary': row.changed }">
+                {{ ACTION_NAMES[row.action] }}
+              </span>
+              <span class="block text-fg-muted">{{ ACTION_PLACES[row.action] }}</span>
+            </span>
+            <span class="flex shrink-0 flex-wrap justify-end gap-1">
+              <kbd
+                v-for="label in row.labels"
+                :key="label"
+                class="rounded border border-control-border bg-panel-inline px-1.5 font-sans"
+              >
+                {{ label }}
+              </kbd>
+              <span v-if="row.labels.length === 0" class="text-fg-muted">None</span>
+            </span>
+          </button>
+          <ul
+            v-if="menuFor === row.action"
+            ref="menu"
+            role="menu"
+            :aria-label="ACTION_NAMES[row.action]"
+            class="absolute top-full left-2 z-10 min-w-56 rounded border border-control-border bg-panel py-1"
+            @keydown="menuKey"
+          >
+            <template v-for="(entry, index) in menuEntries" :key="index">
+              <li
+                v-if="entry.kind === 'separator'"
+                role="separator"
+                class="my-1 border-t border-control-border"
+              />
+              <li v-else role="none">
+                <button
+                  type="button"
+                  role="menuitem"
+                  class="w-full px-3 py-1 text-left outline-none hover:bg-hover focus:bg-row-selected"
+                  @click="run(row.action, entry.command)"
+                >
+                  {{ entry.label }}
+                </button>
+              </li>
+            </template>
+          </ul>
+        </li>
+      </ul>
+    </section>
+    <KeyRecorder
+      v-if="recording !== null"
+      :action="recording.action"
+      :initial="recording.from"
+      :bindings="bindings"
+      @record="recorded"
+      @close="stopRecording"
+    />
+  </div>
+</template>
