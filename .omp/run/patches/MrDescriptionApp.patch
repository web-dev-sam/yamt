+    let window = open_window_in(gitlab_repo());
+    let path = format!("/upload~{HEX_A}");
+    assert!(is_not_found(&asked(&window, &path)));
+
+    read(&window, 52);
+
+    let answer = asked(&window, &path);
+    assert_eq!(answer.status(), StatusCode::OK);
+    assert_eq!(
+        answer.body(),
