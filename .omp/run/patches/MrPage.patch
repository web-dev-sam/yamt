diff --git a/frontend/src/ui/MergeRequestFilter.vue b/frontend/src/ui/MergeRequestFilter.vue
new file mode 100644
index 0000000..a7250eb
--- /dev/null
+++ b/frontend/src/ui/MergeRequestFilter.vue
@@ -0,0 +1,124 @@
+<script setup lang="ts">
+import { computed, shallowRef, useTemplateRef } from "vue";
+import Check from "~icons/lucide/check";
+import ChevronDown from "~icons/lucide/chevron-down";
+import X from "~icons/lucide/x";
+
+import {
+  NARROW_FROM,
+  narrowed,
+  type Choice,
+  type LabelValue,
+  type ListFilter,
+  type PersonValue,
+} from "../mergeRequests";
+import { useDropdownMenu } from "./useDropdownMenu";
+
+type Value = PersonValue | LabelValue;
+
+const props = defineProps<{
+  filter: ListFilter;
+  name: string;
+  label: string;
+  set: boolean;
+  choices: readonly Choice<Value>[];
+}>();
+const emit = defineEmits<{ toggle: [value: Value]; clear: [] }>();
+
+const opener = useTemplateRef<HTMLButtonElement>("opener");
+const menu = useTemplateRef<HTMLDivElement>("menu");
+const narrowBox = useTemplateRef<HTMLInputElement>("narrowBox");
+const typed = shallowRef("");
+const { openFor, above, toggle, menuKey } = useDropdownMenu<ListFilter>({
+  menu: () => menu.value,
+  opener: () => opener.value,
+});
+
+const narrows = computed(() => props.choices.length > NARROW_FROM);
+const shown = computed(() =>
+  narrows.value ? narrowed(props.choices, typed.value) : props.choices,
+);
+
+function keyOf(value: Value): string {
+  switch (value.kind) {
+    case "me":
+    case "none":
+      return value.kind;
+    case "person":
+      return `user:${value.username}`;
+    case "label":
+      return `label:${value.title}`;
+    default: {
+      const _exhaustive: never = value;
+      return _exhaustive;
+    }
+  }
+}
+
+async function openerClicked(): Promise<void> {
+  typed.value = "";
+  await toggle(props.filter);
+  narrowBox.value?.focus();
+}
+</script>
+
+<template>
+  <div class="relative flex items-center">
+    <button
+      ref="opener"
+      type="button"
+      aria-haspopup="menu"
+      :aria-expanded="openFor !== null"
+      class="flex items-center gap-1 border border-control-border py-1 pr-2 pl-3 hover:bg-hover aria-expanded:bg-row-selected"
+      :class="set ? 'rounded-l border-primary' : 'rounded'"
+      @click="openerClicked"
+    >
+      {{ label }}
+      <ChevronDown class="size-3.5" aria-hidden="true" />
+    </button>
+    <button
+      v-if="set"
+      type="button"
+      :title="`Clear the ${name} filter`"
+      :aria-label="`Clear the ${name} filter`"
+      class="self-stretch rounded-r border border-l-0 border-primary px-1.5 hover:bg-hover"
+      @click="emit('clear')"
+    >
+      <X class="size-3.5" aria-hidden="true" />
+    </button>
+    <div
+      v-if="openFor !== null"
+      ref="menu"
+      class="absolute left-0 z-10 flex max-h-[60vh] min-w-56 flex-col rounded border border-control-border bg-panel-inline p-1 shadow-lg"
+      :class="above ? 'bottom-full' : 'top-full'"
+      @keydown="menuKey"
+    >
+      <input
+        v-if="narrows"
+        ref="narrowBox"
+        v-model="typed"
+        type="search"
+        :aria-label="`Narrow the ${name} list`"
+        :placeholder="`Find ${name.toLowerCase()}…`"
+        spellcheck="false"
+        class="mb-1 rounded border border-control-border bg-panel px-2 py-1 outline-none focus:border-primary"
+      />
+      <ul role="menu" :aria-label="name" class="min-h-0 overflow-y-auto">
+        <li v-for="choice in shown" :key="keyOf(choice.value)" role="none">
+          <button
+            type="button"
+            role="menuitemcheckbox"
+            :aria-checked="choice.checked"
+            class="flex w-full items-center gap-2 rounded py-1 pr-2 pl-1.5 text-left whitespace-nowrap outline-none hover:bg-hover focus:bg-row-selected"
+            @click="emit('toggle', choice.value)"
+          >
+            <Check v-if="choice.checked" class="size-4 shrink-0" aria-hidden="true" />
+            <span v-else class="size-4 shrink-0" aria-hidden="true" />
+            <span class="truncate">{{ choice.label }}</span>
+            <span class="ml-auto pl-3 text-fg-muted">{{ choice.count }}</span>
+          </button>
+        </li>
+      </ul>
+    </div>
+  </div>
+</template>
diff --git a/frontend/src/ui/MergeRequestRow.vue b/frontend/src/ui/MergeRequestRow.vue
new file mode 100644
index 0000000..f976a7a
--- /dev/null
+++ b/frontend/src/ui/MergeRequestRow.vue
@@ -0,0 +1,93 @@
+<script setup lang="ts">
+import { computed } from "vue";
+import FileDiff from "~icons/lucide/file-diff";
+import LoaderCircle from "~icons/lucide/loader-circle";
+import MessageSquare from "~icons/lucide/message-square";
+import ThumbsUp from "~icons/lucide/thumbs-up";
+
+import type { JobPage, MergeRequestIid, MergeRequestRow } from "../ipc";
+import { createdAgo } from "../mergeRequests";
+import CiStatusBox from "./CiStatusBox.vue";
+import type { Opening } from "./mergeRequests";
+import { openReplyText } from "./mergeRequestsText";
+
+const props = defineProps<{ row: MergeRequestRow; now: number; opening: Opening | null }>();
+const emit = defineEmits<{ open: [iid: MergeRequestIid]; openJob: [page: JobPage] }>();
+
+const CREATED_AT = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short" });
+
+const mr = computed(() => `!${props.row.iid}`);
+const created = computed(() => createdAgo(props.row.createdAt, props.now));
+const createdTitle = computed(() => CREATED_AT.format(props.row.createdAt));
+const discussionsText = computed(() => countText(props.row.openDiscussions, "open discussion"));
+const approvalsText = computed(() => countText(props.row.approvals, "approval"));
+const fetching = computed(() => props.opening?.kind === "fetching");
+const sentence = computed(() => {
+  const opening = props.opening;
+  if (opening === null || opening.kind === "fetching") {
+    return null;
+  }
+  const reply = opening.kind === "opened" ? ({ kind: "opened" } as const) : opening.reply;
+  return { text: openReplyText(reply, props.row.iid), refused: opening.kind === "refused" };
+});
+
+function countText(count: number, word: string): string {
+  return `${count} ${count === 1 ? word : `${word}s`}`;
+}
+</script>
+
+<template>
+  <li class="flex flex-col gap-0.5 border-b border-separator px-3 py-2">
+    <div class="flex items-center gap-3">
+      <div class="flex min-w-0 flex-1 items-baseline gap-2">
+        <span class="truncate" :title="row.title">{{ row.title }}</span>
+        <span class="shrink-0 text-fg-muted">{{ mr }}</span>
+        <span class="shrink-0 text-fg-muted" :title="createdTitle">{{ created }}</span>
+      </div>
+      <span
+        class="flex w-12 shrink-0 items-center gap-1"
+        :class="{ 'text-fg-muted': row.openDiscussions === 0 }"
+        :title="discussionsText"
+        :aria-label="discussionsText"
+      >
+        <MessageSquare class="size-4" aria-hidden="true" />
+        <span aria-hidden="true">{{ row.openDiscussions }}</span>
+      </span>
+      <span
+        class="flex w-12 shrink-0 items-center gap-1"
+        :class="{ 'text-fg-muted': row.approvals === 0 }"
+        :title="approvalsText"
+        :aria-label="approvalsText"
+      >
+        <ThumbsUp class="size-4" aria-hidden="true" />
+        <span aria-hidden="true">{{ row.approvals }}</span>
+      </span>
+      <span class="flex w-7 shrink-0 justify-center">
+        <CiStatusBox
+          v-if="row.pipeline !== null"
+          :pipeline="row.pipeline"
+          @open-job="emit('openJob', $event)"
+        />
+      </span>
+      <button
+        type="button"
+        :title="`Open the changes of ${mr}`"
+        :aria-label="`Open the changes of ${mr}`"
+        :aria-busy="fetching"
+        :disabled="fetching"
+        class="shrink-0 rounded p-1.5 hover:bg-hover disabled:text-fg-muted disabled:hover:bg-transparent"
+        @click="emit('open', row.iid)"
+      >
+        <LoaderCircle v-if="fetching" class="size-4 animate-spin" aria-hidden="true" />
+        <FileDiff v-else class="size-4" aria-hidden="true" />
+      </button>
+    </div>
+    <p
+      v-if="sentence !== null"
+      role="status"
+      :class="sentence.refused ? 'text-problem-error' : 'text-fg-muted'"
+    >
+      {{ sentence.text }}
+    </p>
+  </li>
+</template>
