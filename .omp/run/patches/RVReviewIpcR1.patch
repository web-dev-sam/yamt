diff --git a/frontend/src/ipc/validate.test.ts b/frontend/src/ipc/validate.test.ts
new file mode 100644
index 0000000..8a51734
--- /dev/null
+++ b/frontend/src/ipc/validate.test.ts
@@ -0,0 +1,14 @@
+import { expect, test } from "vitest";
+
+import { isTabId } from "./domain";
+import { branded } from "./validate";
+
+test("branded returns a value its guard accepts", () => {
+  expect(branded(3, isTabId, "tab")).toBe(3);
+});
+
+test.each([-1, 0.5])("branded refuses %s, naming the field", (bad) => {
+  expect(() => branded(bad, isTabId, "tabs[2].id")).toThrow(
+    `tabs[2].id must be a non-negative safe integer, got ${bad}`,
+  );
+});
diff --git a/frontend/src/ipc/validate.ts b/frontend/src/ipc/validate.ts
index 59c0580..464e19d 100644
--- a/frontend/src/ipc/validate.ts
+++ b/frontend/src/ipc/validate.ts
@@ -5,3 +5,14 @@ export function isNonNegativeInteger(n: number): boolean {
 export function invalid(field: string, value: number): Error {
   return new Error(`${field} must be a non-negative safe integer, got ${value}`);
 }
+
+export function branded<T extends number>(
+  value: number,
+  isBrand: (n: number) => n is T,
+  field: string,
+): T {
+  if (!isBrand(value)) {
+    throw invalid(field, value);
+  }
+  return value;
+}
