diff --git c/frontend/src/editor/internal/lineSpan.ts i/frontend/src/editor/internal/lineSpan.ts
new file mode 100644
index 0000000..ff097eb
--- /dev/null
+++ i/frontend/src/editor/internal/lineSpan.ts
@@ -0,0 +1,14 @@
+import type { Text } from "@codemirror/state";
+
+import type { Chunk } from "../../ipc";
+
+export function lineSpan(
+  doc: Text,
+  range: Chunk["base"] | Chunk["local"] | Chunk["remote"],
+): { from: number; to: number } {
+  const end = range.start + range.len;
+  return {
+    from: range.start < doc.lines ? doc.line(range.start + 1).from : doc.length,
+    to: end < doc.lines ? doc.line(end + 1).from : doc.length,
+  };
+}
