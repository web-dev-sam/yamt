+# $1: name, $2: version, $3: licence expression, $4: package directory, $5: holder for the standard text.
+entry() {
+    local files file
+    printf '\n---- %s %s (%s) ----\n' "$1" "$2" "${3:-no licence declared}"
+    files=$(licence_files "$4" "$3")
