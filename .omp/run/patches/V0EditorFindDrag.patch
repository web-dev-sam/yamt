new file mode 100644
index 0000000..3cadd29
--- /dev/null
+++ b/frontend/src/editor/internal/drag.test.ts
@@ -0,0 +1,77 @@
+import { expect, test } from "vitest";
+
+import { loadFixture, type Chunk } from "../../ipc";
+import { coveredChunks } from "./drag";
+import type { ChunkRow } from "./geometry";
+import type { Side } from "./side";
+import { PENDING, type ChunkStatus } from "./status";
+import { gapArrows } from "./strips";
+
+const LINE_PX = 20;
+const FAR_BELOW = 1_000_000;
+const APPLIED_LEFT: ChunkStatus = { local: "applied", remote: "pending" };
+
+async function magicRows(
+  statuses: Readonly<Record<number, ChunkStatus>> = {},
+): Promise<ChunkRow[]> {
+  const data = await loadFixture("vueuse-use-magic-keys.ts");
+  return data.chunks.map((chunk) => ({
+    chunk,
+    status: statuses[chunk.id] ?? PENDING,
+    left: { top: chunk.local.start * LINE_PX, bottom: 0 },
+    center: { top: 0, bottom: 0 },
+    right: { top: chunk.remote.start * LINE_PX, bottom: 0 },
+  }));
+}
+
+function covered(
+  rows: readonly ChunkRow[],
+  { side, pressed, pointerTop }: { side: Side; pressed: number; pointerTop: number },
+): number[] {
+  const chunk: Chunk | undefined = rows[pressed]?.chunk;
+  if (chunk === undefined) {
+    throw new Error(`no chunk ${pressed}`);
+  }
+  return coveredChunks(gapArrows(rows, side), {
+    pressed: chunk,
+    pointerTop,
+    lineHeight: LINE_PX,
+  }).map(({ id }) => id);
+}
+
+test("dragging down covers the pressed icon and every open icon whose row the pointer reached", async () => {
+  const rows = await magicRows();
+  const pressTop = 53 * LINE_PX;
+
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: pressTop + LINE_PX - 1 })).toEqual([
+    2,
+  ]);
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: 102 * LINE_PX - 1 })).toEqual([2]);
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: 102 * LINE_PX })).toEqual([2, 5]);
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: FAR_BELOW })).toEqual([2, 5, 7, 8]);
+});
+
+test("dragging up covers every open icon whose row the pointer reached, down to the pressed one", async () => {
+  const rows = await magicRows();
+
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: 22 * LINE_PX })).toEqual([2]);
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: 22 * LINE_PX - 1 })).toEqual([
+    1, 2,
+  ]);
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: -FAR_BELOW })).toEqual([0, 1, 2]);
+});
+
+test("a pointer between icons covers nothing beyond the last icon it passed", async () => {
+  const rows = await magicRows();
+
+  expect(covered(rows, { side: "local", pressed: 1, pointerTop: 40 * LINE_PX })).toEqual([1]);
+  expect(covered(rows, { side: "local", pressed: 5, pointerTop: 80 * LINE_PX })).toEqual([5]);
+});
+
+test("closed sides are skipped: a handled change and changes of the other side are never covered", async () => {
+  const rows = await magicRows({ 5: APPLIED_LEFT });
+
+  expect(covered(rows, { side: "local", pressed: 2, pointerTop: FAR_BELOW })).toEqual([2, 7, 8]);
+  expect(covered(rows, { side: "remote", pressed: 4, pointerTop: FAR_BELOW })).toEqual([4, 6, 8]);
+  expect(covered(rows, { side: "local", pressed: 5, pointerTop: FAR_BELOW })).toEqual([]);
+});
diff --git a/frontend/src/editor/internal/drag.ts b/frontend/src/editor/internal/drag.ts
new file mode 100644
index 0000000..34b1fd5
--- /dev/null
+++ b/frontend/src/editor/internal/drag.ts
@@ -0,0 +1,110 @@
+import type { Chunk } from "../../ipc";
+import type { ChunkAction } from "./apply";
+import type { ChunkRow, PaneViews } from "./geometry";
+import { gapArrows, type IconPress } from "./strips";
+
+type Press = IconPress & { readonly pointerId: number; readonly clientY: number };
+
+type DragEvents = {
+  readonly changed: () => void;
+  readonly released: (press: Press) => void;
+};
+
+type IconRow = { readonly top: number; readonly chunk: Chunk };
+
+export function coveredChunks(
+  rows: readonly IconRow[],
+  {
+    pressed,
+    pointerTop,
+    lineHeight,
+  }: { readonly pressed: Chunk; readonly pointerTop: number; readonly lineHeight: number },
+): Chunk[] {
+  const press = rows.find((row) => row.chunk.id === pressed.id);
+  if (press === undefined) {
+    return [];
+  }
+  const low = Math.min(press.top, pointerTop);
+  const high = Math.max(press.top, pointerTop);
+  return rows.filter(({ top }) => top <= high && top + lineHeight > low).map((row) => row.chunk);
+}
+
+export function coveredAction(
+  press: Press,
+  rows: readonly ChunkRow[],
+  views: PaneViews,
+): ChunkAction {
+  const view = press.side === "local" ? views.left : views.right;
+  return {
+    kind: press.kind,
+    side: press.side,
+    chunks: coveredChunks(gapArrows(rows, press.side), {
+      pressed: press.chunk,
+      pointerTop: press.clientY - view.documentTop,
+      lineHeight: view.defaultLineHeight,
+    }),
+  };
+}
+
+export class IconDrag {
+  readonly #strips: readonly [SVGSVGElement, SVGSVGElement];
+  readonly #events: DragEvents;
+  #press: Press | null = null;
+
+  constructor(strips: readonly [SVGSVGElement, SVGSVGElement], events: DragEvents) {
+    this.#strips = strips;
+    this.#events = events;
+    for (const strip of strips) {
+      strip.addEventListener("pointermove", this.#move);
+      strip.addEventListener("pointerup", this.#release);
+      strip.addEventListener("pointercancel", this.#cancel);
+      strip.addEventListener("lostpointercapture", this.#cancel);
+    }
+  }
+
+  get press(): Press | null {
+    return this.#press;
+  }
+
+  start(press: IconPress, event: PointerEvent): void {
+    if (this.#press !== null) {
+      return;
+    }
+    this.#strips[press.side === "local" ? 0 : 1].setPointerCapture(event.pointerId);
+    this.#press = { ...press, pointerId: event.pointerId, clientY: event.clientY };
+    this.#events.changed();
+  }
+
+  readonly #move = (event: PointerEvent): void => {
+    if (this.#press?.pointerId === event.pointerId) {
+      this.#press = { ...this.#press, clientY: event.clientY };
+      this.#events.changed();
+    }
+  };
+
+  readonly #release = (event: PointerEvent): void => {
+    const press = this.#press;
+    if (press?.pointerId === event.pointerId) {
+      this.#press = null;
+      this.#events.released({ ...press, clientY: event.clientY });
+      this.#events.changed();
+    }
+  };
+
+  readonly #cancel = (event: PointerEvent): void => {
+    if (this.#press?.pointerId === event.pointerId) {
+      this.#press = null;
+      this.#events.changed();
+    }
+  };
+
+  destroy(): void {
+    this.#press = null;
+    for (const strip of this.#strips) {
+      strip.removeEventListener("pointermove", this.#move);
+      strip.removeEventListener("pointerup", this.#release);
+      strip.removeEventListener("pointercancel", this.#cancel);
+      strip.removeEventListener("lostpointercapture", this.#cancel);
+    }
+  }
+}
diff --git a/frontend/src/editor/internal/find.test.ts b/frontend/src/editor/internal/find.test.ts
