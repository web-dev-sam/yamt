+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum Readiness {
+    /// It can be merged.
+    Ready,
+    /// Its branch conflicts with its target.
+    Conflicts {
