diff --git a/frontend/src/ui/MergeRequestReplyField.vue b/frontend/src/ui/MergeRequestReplyField.vue
new file mode 100644
index 0000000..c13a75b
--- /dev/null
+++ b/frontend/src/ui/MergeRequestReplyField.vue
@@ -0,0 +1,206 @@
+<script setup lang="ts">
+import { computed, nextTick, onMounted, useTemplateRef, watch } from "vue";
+
+import type { DescriptionBlock } from "../ipc";
+import MergeRequestDescriptionBlocks from "./MergeRequestDescriptionBlocks.vue";
+import type { Preview } from "./mergeRequestPreview";
+import { useMergeRequests } from "./mergeRequestsStore";
+import type { Thread } from "./mergeRequestThread";
+import {
+  ADD_COMMENT,
+  ADD_REVIEW,
+  commentingReason,
+  MAY_NOT_RESOLVE,
+  NOTHING_TO_PREVIEW,
+  PREVIEW,
+  previewFailureText,
+  REPLY_PLACEHOLDER,
+  RESOLVE_THREAD,
+  THREAD_LOADING,
+  UNRESOLVE_THREAD,
+  WRITE,
+  writeFailureText,
+} from "./mergeRequestThreadText";
+import { vTooltip } from "./tooltip";
+
+type Shown =
+  | { readonly kind: "blocks"; readonly blocks: readonly DescriptionBlock[] }
+  | { readonly kind: "note"; readonly text: string }
+  | { readonly kind: "refusal"; readonly text: string };
+type Button = { readonly disabled: boolean; readonly reason: string | null };
+
+const props = defineProps<{ thread: Thread }>();
+
+const MIN_LINES = 3;
+const MAX_LINES = 12;
+const BUTTON =
+  "rounded border border-control-border px-3 py-0.5 hover:bg-hover disabled:pointer-events-none disabled:text-fg-muted";
+
+const { replyTexts, setReplyText, showPreview, showWrite, sendReply, setResolved } =
+  useMergeRequests();
+const field = useTemplateRef<HTMLTextAreaElement>("field");
+
+const text = computed({
+  get: () => replyTexts.value.get(props.thread.shown.discussion) ?? "",
+  set: (typed: string) => {
+    setReplyText(props.thread.shown.discussion, typed);
+  },
+});
+const writing = computed(() => props.thread.preview.kind === "writing");
+const shownPreview = computed(() => previewOf(props.thread.preview));
+const loaded = computed(() => (props.thread.load.kind === "read" ? props.thread.load : null));
+const ready = computed(
+  () =>
+    loaded.value !== null && !loaded.value.refreshing && props.thread.sending.kind !== "sending",
+);
+const add = computed((): Button => {
+  const reason = loaded.value === null ? null : commentingReason(loaded.value.thread.commenting);
+  return { disabled: !ready.value || text.value.trim() === "" || reason !== null, reason };
+});
+const resolve = computed((): Button & { readonly label: string; readonly to: boolean } => {
+  const thread = loaded.value?.thread ?? null;
+  const reason = thread === null || thread.mayResolve ? null : MAY_NOT_RESOLVE;
+  const resolved = thread?.resolved ?? false;
+  return {
+    disabled: !ready.value || reason !== null,
+    reason,
+    label: resolved ? UNRESOLVE_THREAD : RESOLVE_THREAD,
+    to: !resolved,
+  };
+});
+const failure = computed(() => {
+  const { sending } = props.thread;
+  return sending.kind === "failed"
+    ? writeFailureText(sending.what, sending.failure, navigator.platform)
+    : null;
+});
+
+watch([text, writing], fit, { flush: "post" });
+
+onMounted(fit);
+
+function previewOf(preview: Preview): Shown | null {
+  switch (preview.kind) {
+    case "writing":
+      return null;
+    case "loading":
+      return { kind: "note", text: THREAD_LOADING };
+    case "empty":
+      return { kind: "note", text: NOTHING_TO_PREVIEW };
+    case "read":
+      return preview.preview.blocks.length === 0
+        ? { kind: "note", text: NOTHING_TO_PREVIEW }
+        : { kind: "blocks", blocks: preview.preview.blocks };
+    case "refused":
+    case "failed":
+      return { kind: "refusal", text: previewFailureText(preview, navigator.platform) };
+    default: {
+      const _exhaustive: never = preview;
+      return _exhaustive;
+    }
+  }
+}
+
+function pixels(value: string): number {
+  return Number.parseFloat(value);
+}
+
+function fit(): void {
+  const element = field.value;
+  if (element === null || !writing.value) {
+    return;
+  }
+  const style = getComputedStyle(element);
+  const line = pixels(style.lineHeight);
+  const padding = pixels(style.paddingTop) + pixels(style.paddingBottom);
+  const border = pixels(style.borderTopWidth) + pixels(style.borderBottomWidth);
+  element.style.height = "auto";
+  const content = Math.min(
+    Math.max(element.scrollHeight - padding, MIN_LINES * line),
+    MAX_LINES * line,
+  );
+  element.style.height = `${content + padding + border}px`;
+}
+
+async function backToWrite(): Promise<void> {
+  showWrite();
+  await nextTick();
+  field.value?.focus();
+}
+
+function send(kind: "comment" | "draft"): void {
+  if (!add.value.disabled) {
+    void sendReply(kind);
+  }
+}
+
+function toggleResolved(): void {
+  void setResolved(resolve.value.to);
+}
+</script>
+
+<template>
+  <div class="flex shrink-0 flex-col gap-2 border-t border-separator px-3 py-2">
+    <div class="flex gap-1">
+      <button
+        type="button"
+        :aria-pressed="writing"
+        class="rounded px-2 py-0.5 hover:bg-hover aria-pressed:bg-row-selected"
+        @click="backToWrite"
+      >
+        {{ WRITE }}
+      </button>
+      <button
+        type="button"
+        :aria-pressed="!writing"
+        class="rounded px-2 py-0.5 hover:bg-hover aria-pressed:bg-row-selected"
+        @click="showPreview"
+      >
+        {{ PREVIEW }}
+      </button>
+    </div>
+    <textarea
+      v-show="writing"
+      ref="field"
+      v-model="text"
+      :placeholder="REPLY_PLACEHOLDER"
+      :aria-label="REPLY_PLACEHOLDER"
+      class="w-full resize-none overflow-y-auto rounded border border-control-border bg-panel px-2 py-1 leading-5 outline-none focus:border-primary"
+      @keydown.ctrl.enter.exact.prevent="send('comment')"
+    ></textarea>
+    <div
+      v-if="shownPreview !== null"
+      class="max-h-60 min-h-[4.5rem] overflow-y-auto rounded border border-control-border px-2 py-1 [overflow-wrap:anywhere]"
+    >
+      <MergeRequestDescriptionBlocks
+        v-if="shownPreview.kind === 'blocks'"
+        :blocks="shownPreview.blocks"
+      />
+      <p v-else-if="shownPreview.kind === 'note'" class="text-fg-muted">{{ shownPreview.text }}</p>
+      <p v-else role="alert" class="text-problem-error">{{ shownPreview.text }}</p>
+    </div>
+    <div class="flex items-center gap-2">
+      <span v-tooltip="add.reason" class="flex">
+        <button type="button" :disabled="add.disabled" :class="BUTTON" @click="send('draft')">
+          {{ ADD_REVIEW }}
+        </button>
+      </span>
+      <span v-tooltip="add.reason" class="flex">
+        <button
+          type="button"
+          :disabled="add.disabled"
+          class="rounded border border-primary bg-primary px-3 py-0.5 text-on-primary hover:brightness-110 disabled:pointer-events-none disabled:border-control-border disabled:bg-transparent disabled:text-fg-muted"
+          @click="send('comment')"
+        >
+          {{ ADD_COMMENT }}
+        </button>
+      </span>
+      <span v-tooltip="resolve.reason" class="ml-auto flex">
+        <button type="button" :disabled="resolve.disabled" :class="BUTTON" @click="toggleResolved">
+          {{ resolve.label }}
+        </button>
+      </span>
+    </div>
+    <p v-if="failure !== null" role="alert" class="text-problem-error">{{ failure }}</p>
+  </div>
+</template>
diff --git a/frontend/src/ui/MergeRequestThread.vue b/frontend/src/ui/MergeRequestThread.vue
new file mode 100644
index 0000000..e7934b3
--- /dev/null
+++ b/frontend/src/ui/MergeRequestThread.vue
@@ -0,0 +1,195 @@
+<script setup lang="ts">
+import { useElementSize } from "@vueuse/core";
+import { computed, onMounted, useTemplateRef } from "vue";
+import Check from "~icons/lucide/check";
+import ExternalLink from "~icons/lucide/external-link";
+import X from "~icons/lucide/x";
+
+import type { DiscussionThread, MergeRequestIid } from "../ipc";
+import { RETRY } from "./aiText";
+import MergeRequestReplyField from "./MergeRequestReplyField.vue";
+import { useMergeRequests } from "./mergeRequestsStore";
+import type { ThreadLoad } from "./mergeRequestThread";
+import MergeRequestThreadComment from "./MergeRequestThreadComment.vue";
+import {
+  CLOSE_THREAD,
+  OPEN_ON_GITLAB,
+  PENDING,
+  pendingText,
+  RESOLVED,
+  SUBMIT_REVIEW,
+  submitTip,
+  THREAD_LOADING,
+  threadLabel,
+  threadRefusalText,
+} from "./mergeRequestThreadText";
+import { problemText } from "./problemText";
+import { vTooltip } from "./tooltip";
+import { useMenuPlacement } from "./useMenuPlacement";
+
+type Content =
+  | { readonly kind: "thread"; readonly thread: DiscussionThread }
+  | { readonly kind: "note"; readonly text: string }
+  | { readonly kind: "refusal"; readonly text: string };
+
+const props = defineProps<{
+  iid: MergeRequestIid;
+  /** The merge request's author's username (null: unknown): the crown. */
+  author: string | null;
+  /** The box's words for the row: where it is and whose turn (the core's rule, via the box). */
+  place: string;
+  turn: string;
+  /** The box's left and top: the panel's right edge meets the left, tops aligned (as CiStatusJobLog). */
+  anchor: { readonly left: number; readonly top: number };
+  /** The page's clock, as the box gets it: "3 hours ago". */
+  now: number;
+}>();
+const emit = defineEmits<{ close: [] }>();
+
+const { thread, retryThread, submitReview, openPage } = useMergeRequests();
+const panel = useTemplateRef<HTMLDivElement>("panel");
+const panelSize = useElementSize(panel, undefined, { box: "border-box" });
+const placement = useMenuPlacement(panel, () => ({
+  x: props.anchor.left - panelSize.width.value,
+  y: props.anchor.top,
+}));
+
+const shown = computed(() => (thread.value?.shown.iid === props.iid ? thread.value : null));
+const content = computed(() => (shown.value === null ? null : contentOf(shown.value.load)));
+const read = computed(() => (content.value?.kind === "thread" ? content.value.thread : null));
+const label = computed(() => threadLabel(props.place));
+const page = computed(() => read.value?.comments[0]?.page ?? null);
+const submit = computed(() => {
+  const pending = read.value?.pending ?? 0;
+  return pending > 0 ? { tip: submitTip(pending), count: pendingText(pending) } : null;
+});
+const refreshing = computed(() => shown.value?.load.kind === "read" && shown.value.load.refreshing);
+const sending = computed(() => shown.value?.sending.kind === "sending");
+
+onMounted(() => {
+  panel.value?.focus();
+});
+
+function contentOf(load: ThreadLoad): Content {
+  switch (load.kind) {
+    case "loading":
+      return { kind: "note", text: THREAD_LOADING };
+    case "read":
+      return { kind: "thread", thread: load.thread };
+    case "refused":
+      return { kind: "refusal", text: threadRefusalText(load.reply, navigator.platform) };
+    case "failed":
+      return {
+        kind: "refusal",
+        text: problemText(
+          { action: "mergeRequests", step: "thread", cause: load.cause },
+          navigator.platform,
+        ),
+      };
+    default: {
+      const _exhaustive: never = load;
+      return _exhaustive;
+    }
+  }
+}
+
+async function openThread(): Promise<void> {
+  if (page.value !== null) {
+    await openPage("discussion", page.value);
+  }
+}
+
+function keyPressed(event: KeyboardEvent): void {
+  if (event.key !== "Escape" || event.defaultPrevented) {
+    return;
+  }
+  event.preventDefault();
+  emit("close");
+}
+</script>
+
+<template>
+  <div
+    v-if="shown !== null"
+    ref="panel"
+    role="dialog"
+    :aria-label="label"
+    tabindex="-1"
+    class="fixed z-10 flex h-[min(48rem,calc(100vh-2rem))] w-[min(40rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-md border border-control-border bg-panel-inline text-fg shadow-lg outline-none"
+    :style="placement"
+    @keydown="keyPressed"
+  >
+    <header class="flex shrink-0 items-center gap-2 border-b border-separator px-3 py-2">
+      <span class="min-w-0 truncate font-semibold">{{ place }}</span>
+      <span v-if="read?.resolved" class="flex shrink-0 items-center gap-1 text-fg-muted">
+        <Check class="size-4" aria-hidden="true" />{{ RESOLVED }}
+      </span>
+      <span v-else class="shrink-0 text-fg-muted">{{ turn }}</span>
+      <button
+        v-tooltip="OPEN_ON_GITLAB"
+        type="button"
+        :aria-label="OPEN_ON_GITLAB"
+        :disabled="page === null"
+        class="ml-auto shrink-0 rounded p-1 hover:bg-hover disabled:pointer-events-none disabled:text-fg-muted"
+        @click="openThread"
+      >
+        <ExternalLink class="size-4" aria-hidden="true" />
+      </button>
+      <button
+        v-if="submit !== null"
+        v-tooltip="submit.tip"
+        type="button"
+        :disabled="sending"
+        class="flex shrink-0 items-center gap-1.5 rounded border border-control-border px-2 py-0.5 hover:bg-hover disabled:pointer-events-none disabled:text-fg-muted"
+        @click="submitReview"
+      >
+        {{ SUBMIT_REVIEW }}<span class="text-fg-muted">{{ submit.count }}</span>
+      </button>
+      <button
+        v-tooltip="CLOSE_THREAD"
+        type="button"
+        :aria-label="CLOSE_THREAD"
+        class="shrink-0 cursor-pointer rounded p-1 hover:bg-hover"
+        @click="emit('close')"
+      >
+        <X class="size-4" aria-hidden="true" />
+      </button>
+    </header>
+    <div
+      class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto overscroll-contain px-3 py-2"
+      :aria-busy="refreshing"
+    >
+      <template v-if="content?.kind === 'thread'">
+        <MergeRequestThreadComment
+          v-for="(comment, index) in content.thread.comments"
+          :key="index"
+          :comment="comment"
+          :author="author"
+          :now="now"
+        />
+        <article
+          v-for="(draft, index) in content.thread.drafts"
+          :key="`draft-${index}`"
+          class="flex flex-col gap-1"
+        >
+          <span class="w-max rounded border border-control-border px-1.5 text-fg-muted">{{
+            PENDING
+          }}</span>
+          <p class="[overflow-wrap:anywhere] whitespace-pre-wrap">{{ draft.text }}</p>
+        </article>
+      </template>
+      <p v-else-if="content?.kind === 'note'" class="text-fg-muted">{{ content.text }}</p>
+      <p v-else role="alert" class="flex items-center gap-3">
+        <span class="text-problem-error">{{ content?.text }}</span>
+        <button
+          type="button"
+          class="shrink-0 cursor-pointer rounded border border-control-border px-3.5 py-1 hover:bg-hover"
+          @click="retryThread"
+        >
+          {{ RETRY }}
+        </button>
+      </p>
+    </div>
+    <MergeRequestReplyField :thread="shown" />
+  </div>
+</template>
diff --git a/frontend/src/ui/MergeRequestThreadComment.vue b/frontend/src/ui/MergeRequestThreadComment.vue
