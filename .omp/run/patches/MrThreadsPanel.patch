+const STOPPED = { kind: "ipc", cause: { kind: "WorkerStopped" } } as const;
+const DMITRI = { username: "dmitri", name: "Dmitri Volkov", picture: null };
+
+test("the panel's fixed words", () => {
+  expect([
+    THREAD_LOADING,
+    THREAD_GONE,
+    RESOLVED,
+    OPEN_ON_GITLAB,
+    SUBMIT_REVIEW,
+    CLOSE_THREAD,
+    AUTHOR,
+    PENDING,
+    WRITE,
+    PREVIEW,
+    REPLY_PLACEHOLDER,
+    NOTHING_TO_PREVIEW,
+    ADD_REVIEW,
+    ADD_COMMENT,
+    RESOLVE_THREAD,
+    UNRESOLVE_THREAD,
+    MAY_NOT_RESOLVE,
+  ]).toEqual([
+    "Loading…",
+    "This discussion is no longer on GitLab.",
+    "Resolved",
+    "Open on GitLab",
+    "Submit review",
+    "Close",
+    "Author",
+    "Pending",
+    "Write",
+    "Preview",
+    "Write a reply… (Markdown)",
+    "Nothing to preview.",
+    "Add review",
+    "Add comment",
+    "Resolve thread",
+    "Unresolve thread",
+    "You may not resolve this thread.",
+  ]);
+  expect(threadLabel("src/app.ts:12")).toBe("Thread: src/app.ts:12");
+});
