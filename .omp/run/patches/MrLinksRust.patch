+#[test]
+fn only_issue_epic_and_commit_addresses_on_the_projects_server_count() {
+    let server = server();
+
+    for (path, expected) in counted_items() {
+        assert_eq!(target_of(&server, &at(path)), Some(expected), "{path}");
+    }
+    for (path, expected) in counted_commits() {
