+});
+
+test("timeTitle compares local days, not UTC days (catches getUTCDate)", () => {
+  expect(timeTitle(Date.UTC(2026, 10, 8, 23, 30), Date.UTC(2026, 10, 9, 12))).toBe("00:30");
