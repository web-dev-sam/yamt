+  await picking;
+  expect(store.active.value).toBe("b.ts");
+
+  store.openSettings();
+  await store.pick("b.ts");
+
+  expect(store.settingsOpen.value).toBe(false);
+  expect(store.active.value).toBe("b.ts");
+  expect(pending).toHaveLength(2);
+});
+
+test.each([true, false])(
