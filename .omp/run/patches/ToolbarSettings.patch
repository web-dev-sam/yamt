+    if (settingsOpen) {
+      store.openSettings();
+    }
+
+    const loading = store.loadFiles();
+    await vi.waitFor(() => {
+      expect(pending.at(-1)?.path).toBe("a.ts");
+    });
+    pending.at(-1)?.resolve(ok(await dataFor("a.ts")));
