+++ b/crates/local-merge/src/push.rs
@@ -0,0 +1,17 @@
+use std::path::Path;
+
+use yamt_gitio::{PUSH_TIMEOUT, Repo};
+
+use crate::{PushOffer, PushReply};
+
+/// A plain push of the offered branch to the remote it came from: never forced, never prompting.
+#[must_use]
+pub fn push(root: &Path, offer: &PushOffer) -> PushReply {
+    let pushed = Repo::discover(root)
+        .map_err(|error| error.to_string())
+        .and_then(|repo| repo.push_branch(&offer.remote, &offer.branch, PUSH_TIMEOUT));
+    match pushed {
+        Ok(()) => PushReply::Pushed,
+        Err(message) => PushReply::Failed { message },
+    }
+}
diff --git a/crates/local-merge/src/record.rs b/crates/local-merge/src/record.rs
new file mode 100644
index 0000000..11c2add
--- /dev/null
+++ b/crates/local-merge/src/record.rs
@@ -0,0 +1,314 @@
+use std::fs::{self, File, OpenOptions, TryLockError};
+use std::io::{self, Write};
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+use yamt_gitio::{Operation, Stop};
+
+use crate::{BranchBefore, MergeView, ReturnTo};
+
+pub(crate) const RECORD_FILE: &str = "yamt-merge-request.json";
+pub(crate) const START_LOCK_FILE: &str = "yamt-merge-request.lock";
+pub(crate) const WINDOW_LOCK_FILE: &str = "yamt-merge-window.lock";
+pub(crate) const FORMAT: u32 = 1;
+const TEMPORARY_SUFFIX: &str = ".tmp";
+const SHORT_ID_LEN: usize = 7;
+
+/// What a start changed and what Abort puts back: `<git dir>/yamt-merge-request.json`.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct MergeRecord {
+    pub format: u32,
+    pub iid: u32,
+    pub remote: String,
+    pub branch: String,
+    pub target: String,
+    pub return_to: RecordedReturn,
+    pub branch_before: RecordedBranch,
+    /// The full id of the branch tip the start checked out.
+    pub head: String,
+    /// The full id of the target tip the start merged.
+    pub merging: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub(crate) enum RecordedReturn {
+    Branch { name: String },
+    Detached { commit: String },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub(crate) enum RecordedBranch {
+    Created,
+    MovedFrom { commit: String },
+    Unchanged,
+}
+
+#[derive(Deserialize)]
+struct FormatOnly {
+    format: u32,
+}
+
+impl MergeRecord {
+    /// Whether the start found the merge request's branch already checked out.
+    pub fn returns_to_itself(&self) -> bool {
+        matches!(&self.return_to, RecordedReturn::Branch { name } if *name == self.branch)
+    }
+
+    pub fn view(&self) -> MergeView {
+        let return_to = if self.returns_to_itself() {
+            None
+        } else {
+            Some(self.return_to.shown())
+        };
+        let branch_before = match &self.branch_before {
+            RecordedBranch::Created => BranchBefore::Created,
+            RecordedBranch::MovedFrom { commit } => BranchBefore::MovedFrom {
+                id: short_id(commit),
+            },
+            RecordedBranch::Unchanged => BranchBefore::Unchanged,
+        };
+        MergeView {
+            branch: self.branch.clone(),
+            target: self.target.clone(),
+            return_to,
+            branch_before,
+        }
+    }
+}
+
+impl RecordedReturn {
+    pub fn shown(&self) -> ReturnTo {
+        match self {
+            RecordedReturn::Branch { name } => ReturnTo::Branch { name: name.clone() },
+            RecordedReturn::Detached { commit } => ReturnTo::Commit {
+                id: short_id(commit),
+            },
+        }
+    }
+}
+
+fn short_id(commit: &str) -> String {
+    commit.chars().take(SHORT_ID_LEN).collect()
+}
+
+/// The record at `path`; `Ok(None)` when there is none, `Err` with the reason when it cannot be read, does not
+/// parse, or has a format newer than this yamt's.
+pub(crate) fn read(path: &Path) -> Result<Option<MergeRecord>, String> {
+    let bytes = match fs::read(path) {
+        Ok(bytes) => bytes,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.to_string()),
+    };
+    let format = serde_json::from_slice::<FormatOnly>(&bytes)
+        .map_err(|error| error.to_string())?
+        .format;
+    if format > FORMAT {
+        return Err(format!(
+            "its format {format} is newer than this yamt reads ({FORMAT})"
+        ));
+    }
+    let record = serde_json::from_slice(&bytes).map_err(|error| error.to_string())?;
+    Ok(Some(record))
+}
+
+/// Writes `record` to `<path>.tmp`, syncs it and renames it over `path`, so a crash leaves the old file or the new.
+pub(crate) fn write(path: &Path, record: &MergeRecord) -> io::Result<()> {
+    let bytes = serde_json::to_vec_pretty(record).map_err(io::Error::other)?;
+    let mut temporary = path.as_os_str().to_owned();
+    temporary.push(TEMPORARY_SUFFIX);
+    let temporary = PathBuf::from(temporary);
+    let mut file = File::create(&temporary)?;
+    file.write_all(&bytes)?;
+    file.sync_all()?;
+    fs::rename(&temporary, path)
+}
+
+/// Removes the record; a failure is logged, as nobody could act on it.
+pub(crate) fn remove(path: &Path) {
+    match fs::remove_file(path) {
+        Ok(()) => {}
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => {
+            tracing::warn!(path = %path.display(), %error, "cannot remove the merge record");
+        }
+    }
+}
+
+/// The lock file opened (created when missing) and locked; `None` when another open file holds the lock.
+pub(crate) fn hold(path: &Path) -> io::Result<Option<File>> {
+    let file = OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .write(true)
+        .open(path)?;
+    // The lock is the open file's own: the OS releases it when the file is closed or the process ends, also on
+    // `kill -9` (`File::try_lock`, flock(2)).
+    match file.try_lock() {
+        Ok(()) => Ok(Some(file)),
+        Err(TryLockError::WouldBlock) => Ok(None),
+        Err(TryLockError::Error(error)) => Err(error),
+    }
+}
+
+/// Whether git is still in the merge `record` started: merging the recorded commit, at the recorded head, on the
+/// recorded branch.
+pub(crate) fn is_live(record: &MergeRecord, stop: &Stop, current_branch: Option<&[u8]>) -> bool {
+    let merging_it = matches!(
+        &stop.operation,
+        Some(Operation::Merge { merging }) if merging.as_str() == record.merging
+    );
+    let at_head = stop
+        .head
+        .as_ref()
+        .is_some_and(|head| head.as_str() == record.head);
+    merging_it && at_head && current_branch == Some(record.branch.as_bytes())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    use yamt_gitio::Oid;
+
+    const HEAD: &str = "1111111111111111111111111111111111111111";
+    const MERGING: &str = "2222222222222222222222222222222222222222";
+    const OTHER: &str = "3333333333333333333333333333333333333333";
+    const BRANCH: &str = "feature/due-dates";
+
+    fn record() -> MergeRecord {
+        MergeRecord {
+            format: FORMAT,
+            iid: 21,
+            remote: "origin".to_owned(),
+            branch: BRANCH.to_owned(),
+            target: "main".to_owned(),
+            return_to: RecordedReturn::Branch {
+                name: "develop".to_owned(),
+            },
+            branch_before: RecordedBranch::MovedFrom {
+                commit: OTHER.to_owned(),
+            },
+            head: HEAD.to_owned(),
+            merging: MERGING.to_owned(),
+        }
+    }
+
+    fn merge_stop(merging: &str, head: &str) -> Stop {
+        Stop {
+            operation: Some(Operation::Merge {
+                merging: Oid::parse(merging).unwrap(),
+            }),
+            head: Some(Oid::parse(head).unwrap()),
+        }
+    }
+
+    #[test]
+    fn the_recorded_merge_at_its_head_on_its_branch_is_live() {
+        let stop = merge_stop(MERGING, HEAD);
+
+        assert!(is_live(&record(), &stop, Some(BRANCH.as_bytes())));
+    }
+
+    #[test]
+    fn any_mismatch_makes_the_record_stale() {
+        let on_branch = Some(BRANCH.as_bytes());
+        let another_merge = merge_stop(OTHER, HEAD);
+        let another_head = merge_stop(MERGING, OTHER);
+        let no_operation = Stop {
+            operation: None,
+            head: Some(Oid::parse(HEAD).unwrap()),
+        };
+        let no_head = Stop {
+            head: None,
+            ..merge_stop(MERGING, HEAD)
+        };
+        let cherry_pick = Stop {
+            operation: Some(Operation::CherryPick {
+                picking: Some(Oid::parse(MERGING).unwrap()),
+                progress: None,
+            }),
+            ..merge_stop(MERGING, HEAD)
+        };
+
+        assert!(!is_live(&record(), &another_merge, on_branch));
+        assert!(!is_live(&record(), &another_head, on_branch));
+        assert!(!is_live(&record(), &no_operation, on_branch));
+        assert!(!is_live(&record(), &no_head, on_branch));
+        assert!(!is_live(&record(), &cherry_pick, on_branch));
+        let at_head = merge_stop(MERGING, HEAD);
+        assert!(!is_live(&record(), &at_head, Some(b"develop")));
+        assert!(!is_live(&record(), &at_head, None));
+    }
+
+    #[test]
+    fn a_written_record_reads_back_and_leaves_no_temporary_file() {
+        let folder = tempfile::tempdir().unwrap();
+        let path = folder.path().join(RECORD_FILE);
+
+        write(&path, &record()).unwrap();
+
+        assert_eq!(read(&path), Ok(Some(record())));
+        let files = fs::read_dir(folder.path()).unwrap().count();
+        assert_eq!(files, 1);
+    }
+
+    #[test]
+    fn a_missing_record_is_none() {
+        let folder = tempfile::tempdir().unwrap();
+
+        assert_eq!(read(&folder.path().join(RECORD_FILE)), Ok(None));
+    }
+
+    #[test]
+    fn a_record_path_that_cannot_be_read_is_unreadable_not_missing() {
+        let folder = tempfile::tempdir().unwrap();
+
+        assert!(read(folder.path()).is_err());
+    }
+
+    #[test]
+    fn a_newer_format_or_unparsable_json_is_unreadable() {
+        let folder = tempfile::tempdir().unwrap();
+        let path = folder.path().join(RECORD_FILE);
+        let mut newer = serde_json::to_value(record()).unwrap();
+        newer["format"] = serde_json::json!(FORMAT + 1);
+
+        fs::write(&path, serde_json::to_vec(&newer).unwrap()).unwrap();
+        let newer_read = read(&path);
+        fs::write(&path, b"{ \"format\": 1, \"iid\": 21 }").unwrap();
+        let incomplete_read = read(&path);
+        fs::write(&path, b"not json").unwrap();
+        let garbage_read = read(&path);
+
+        let newer_message = "its format 2 is newer than this yamt reads (1)".to_owned();
+        assert_eq!(newer_read, Err(newer_message));
+        assert!(incomplete_read.is_err());
+        assert!(garbage_read.is_err());
+    }
+
+    #[test]
+    fn the_view_shortens_ids_and_omits_a_return_to_the_branch_itself() {
+        let mut detached = record();
+        detached.return_to = RecordedReturn::Detached {
+            commit: HEAD.to_owned(),
+        };
+        let mut on_itself = record();
+        on_itself.return_to = RecordedReturn::Branch {
+            name: BRANCH.to_owned(),
+        };
+
+        let id = "1111111".to_owned();
+        assert_eq!(detached.view().return_to, Some(ReturnTo::Commit { id }));
+        assert_eq!(on_itself.view().return_to, None);
+        let name = "develop".to_owned();
+        assert_eq!(record().view().return_to, Some(ReturnTo::Branch { name }));
+        let id = "3333333".to_owned();
+        assert_eq!(
+            record().view().branch_before,
+            BranchBefore::MovedFrom { id }
+        );
+    }
+}
diff --git a/crates/local-merge/src/restore.rs b/crates/local-merge/src/restore.rs
new file mode 100644
index 0000000..79ab57a
--- /dev/null
+++ b/crates/local-merge/src/restore.rs
@@ -0,0 +1,102 @@
+use std::path::Path;
+
+use yamt_gitio::{Oid, Repo};
+
+use crate::record::{self, MergeRecord, RecordedBranch, RecordedReturn};
+use crate::{Leftover, git_message};
+
+/// Puts back what the start changed, as far as it still matches the record (design §4.3 "Abort" steps 1–3): HEAD
+/// returned while it is still the branch at the recorded head, then the branch deleted or moved back while it is
+/// still at that head. Removes the record. Runs after git's merge abort, or after a start that failed.
+pub(crate) fn restore(repo: &Repo, path: &Path, record: &MergeRecord) -> Vec<Leftover> {
+    let mut left = Vec::new();
+    if let Some(leftover) = return_head(repo, record) {
+        left.push(leftover);
+    }
+    if let Some(leftover) = put_branch_back(repo, record) {
+        left.push(leftover);
+    }
+    record::remove(path);
+    left
+}
+
+fn return_head(repo: &Repo, record: &MergeRecord) -> Option<Leftover> {
+    if record.returns_to_itself() {
+        return None;
+    }
+    let to = record.return_to.shown();
+    match is_on_branch_at_head(repo, record) {
+        Ok(true) => {}
+        Ok(false) => return Some(Leftover::NotReturned { to }),
+        Err(error) => {
+            let message = git_message(&error);
+            return Some(Leftover::ReturnRefused { to, message });
+        }
+    }
+    let returned = match &record.return_to {
+        RecordedReturn::Branch { name } => repo.checkout_branch(name),
+        RecordedReturn::Detached { commit } => {
+            Oid::parse(commit).and_then(|commit| repo.checkout_detached(&commit))
+        }
+    };
+    let message = git_message(&returned.err()?);
+    Some(Leftover::ReturnRefused { to, message })
+}
+
+fn is_on_branch_at_head(repo: &Repo, record: &MergeRecord) -> yamt_gitio::Result<bool> {
+    Ok(is_checked_out(repo, record)? && repo.head_commit()?.as_str() == record.head)
+}
+
+fn is_checked_out(repo: &Repo, record: &MergeRecord) -> yamt_gitio::Result<bool> {
+    Ok(repo.current_branch()?.as_deref() == Some(record.branch.as_bytes()))
+}
+
+fn put_branch_back(repo: &Repo, record: &MergeRecord) -> Option<Leftover> {
+    let put_back = match &record.branch_before {
+        RecordedBranch::Unchanged => return None,
+        RecordedBranch::Created => delete_created(repo, record),
+        RecordedBranch::MovedFrom { commit } => move_back(repo, record, commit),
+    };
+    let branch = record.branch.clone();
+    match put_back {
+        Ok(true) => None,
+        Ok(false) => Some(Leftover::BranchKept { branch }),
+        Err(error) => {
+            let message = git_message(&error);
+            Some(Leftover::BranchRefused { branch, message })
+        }
+    }
+}
+
+/// Deletes the branch the start created while it is still at the recorded head and not checked out; true when it
+/// is gone.
+fn delete_created(repo: &Repo, record: &MergeRecord) -> yamt_gitio::Result<bool> {
+    let Some(tip) = repo.commit_named(&branch_ref(record))? else {
+        return Ok(true);
+    };
+    if tip.as_str() != record.head || is_checked_out(repo, record)? {
+        return Ok(false);
+    }
+    repo.delete_branch(&record.branch)?;
+    Ok(true)
+}
+
+/// Moves the branch the start fast-forwarded back to `from` while it is still at the recorded head; true when it
+/// is back.
+fn move_back(repo: &Repo, record: &MergeRecord, from: &str) -> yamt_gitio::Result<bool> {
+    let tip = repo.commit_named(&branch_ref(record))?;
+    if tip.as_ref().map(Oid::as_str) != Some(record.head.as_str()) {
+        return Ok(false);
+    }
+    let from = Oid::parse(from)?;
+    if is_checked_out(repo, record)? {
+        repo.reset_keep(&from)?;
+    } else {
+        repo.move_branch(&record.branch, &from)?;
+    }
+    Ok(true)
+}
+
+fn branch_ref(record: &MergeRecord) -> String {
+    format!("refs/heads/{}", record.branch)
+}
diff --git a/crates/local-merge/src/start.rs b/crates/local-merge/src/start.rs
new file mode 100644
index 0000000..1939d1f
--- /dev/null
+++ b/crates/local-merge/src/start.rs
@@ -0,0 +1,219 @@
+use std::path::Path;
+
+use yamt_gitio::{FETCH_TIMEOUT, Oid, Repo, first_line};
+
+use crate::record::{
+    self, FORMAT, MergeRecord, RECORD_FILE, RecordedBranch, RecordedReturn, START_LOCK_FILE, hold,
+    is_live,
+};
+use crate::restore::restore;
+use crate::{MergeRequestBranches, Refusal, Started, git_message};
+
+const MERGE_FAILED: &str = "git merge stopped without a merge in progress";
+const BRANCH_NOT_UTF8: &str = "the name of the checked-out branch is not UTF-8";
+
+/// Merges the merge request's target branch into its branch, checked out in the checkout at `root`, without
+/// committing (design §4.2). Every refusal before the checkout changes nothing; a failure after it puts back what
+/// it can and lists the rest.
+pub fn start(root: &Path, branches: &MergeRequestBranches) -> Result<Started, Refusal> {
+    let repo = Repo::discover(root).map_err(|error| refused(&error))?;
+    let lock_path = repo
+        .git_path(START_LOCK_FILE)
+        .map_err(|error| refused(&error))?;
+    let held = hold(&lock_path).map_err(|error| Refusal::GitRefused {
+        message: format!("cannot lock {}: {error}", lock_path.display()),
+        left: Vec::new(),
+    })?;
+    let Some(_lock) = held else {
+        return Err(Refusal::AlreadyMerging { iid: None });
+    };
+    let path = repo
+        .git_path(RECORD_FILE)
+        .map_err(|error| refused(&error))?;
+    drop_stale_record(&repo, &path)?;
+    let (record, source) = checked_record(&repo, branches)?;
+    change_checkout(&repo, &path, &record, &source)
+}
+
+/// Step 3: a live record refuses, an unreadable one refuses and stays, a stale one is removed.
+fn drop_stale_record(repo: &Repo, path: &Path) -> Result<(), Refusal> {
+    let record = match record::read(path) {
+        Ok(None) => return Ok(()),
+        Ok(Some(record)) => record,
+        Err(message) => {
+            let path = path.display().to_string();
+            return Err(Refusal::RecordUnreadable { path, message });
+        }
+    };
+    let stop = repo.stop().map_err(|error| refused(&error))?;
+    let current_branch = repo.current_branch().map_err(|error| refused(&error))?;
+    if is_live(&record, &stop, current_branch.as_deref()) {
+        return Err(Refusal::AlreadyMerging {
+            iid: Some(record.iid),
+        });
+    }
+    tracing::info!(path = %path.display(), "dropping the record of a merge that is no longer in progress");
+    record::remove(path);
+    Ok(())
+}
+
+/// Steps 4–10: the record to write, and the commit of GitLab's branch to check out.
+fn checked_record(
+    repo: &Repo,
+    branches: &MergeRequestBranches,
+) -> Result<(MergeRecord, Oid), Refusal> {
+    let MergeRequestBranches {
+        iid,
+        remote,
+        branch,
+        target,
+    } = branches;
+    require_quiet_checkout(repo)?;
+    repo.fetch_branches(remote, &[branch, target], FETCH_TIMEOUT)
+        .map_err(|message| Refusal::FetchFailed { message })?;
+    let source = remote_tip(repo, remote, branch)?;
+    let goal = remote_tip(repo, remote, target)?;
+    let branch_before = branch_before(repo, branch, &source)?;
+    if repo
+        .is_ancestor(&goal, &source)
+        .map_err(|error| refused(&error))?
+    {
+        let (branch, target) = (branch.clone(), target.clone());
+        return Err(Refusal::AlreadyContains { branch, target });
+    }
+    let record = MergeRecord {
+        format: FORMAT,
+        iid: *iid,
+        remote: remote.clone(),
+        branch: branch.clone(),
+        target: target.clone(),
+        return_to: return_to(repo)?,
+        branch_before,
+        head: source.as_str().to_owned(),
+        merging: goal.as_str().to_owned(),
+    };
+    Ok((record, source))
+}
+
+/// Steps 4 and 5: no git operation in progress, no change to a tracked file.
+fn require_quiet_checkout(repo: &Repo) -> Result<(), Refusal> {
+    let stop = repo.stop().map_err(|error| refused(&error))?;
+    if stop.operation.is_some() {
+        return Err(Refusal::Busy);
+    }
+    if repo
+        .has_tracked_changes()
+        .map_err(|error| refused(&error))?
+    {
+        return Err(Refusal::UncommittedChanges);
+    }
+    Ok(())
+}
+
+fn remote_tip(repo: &Repo, remote: &str, branch: &str) -> Result<Oid, Refusal> {
+    let name = format!("refs/remotes/{remote}/{branch}");
+    match repo.commit_named(&name) {
+        Ok(Some(tip)) => Ok(tip),
+        Ok(None) => Err(Refusal::GitRefused {
+            message: format!("{name} names no commit after the fetch"),
+            left: Vec::new(),
+        }),
+        Err(error) => Err(refused(&error)),
+    }
+}
+
+/// Step 8: what checking out GitLab's `source` does to the local branch; a local commit GitLab's lacks refuses.
+fn branch_before(repo: &Repo, branch: &str, source: &Oid) -> Result<RecordedBranch, Refusal> {
+    let local = repo.commit_named(&format!("refs/heads/{branch}"));
+    let Some(local) = local.map_err(|error| refused(&error))? else {
+        return Ok(RecordedBranch::Created);
+    };
+    if local == *source {
+        return Ok(RecordedBranch::Unchanged);
+    }
+    if repo
+        .is_ancestor(&local, source)
+        .map_err(|error| refused(&error))?
+    {
+        let commit = local.as_str().to_owned();
+        return Ok(RecordedBranch::MovedFrom { commit });
+    }
+    Err(Refusal::LocalAhead {
+        branch: branch.to_owned(),
+    })
+}
+
+fn return_to(repo: &Repo) -> Result<RecordedReturn, Refusal> {
+    let Some(name) = repo.current_branch().map_err(|error| refused(&error))? else {
+        let head = repo.head_commit().map_err(|error| refused(&error))?;
+        let commit = head.as_str().to_owned();
+        return Ok(RecordedReturn::Detached { commit });
+    };
+    let name = String::from_utf8(name).map_err(|_| Refusal::GitRefused {
+        message: BRANCH_NOT_UTF8.to_owned(),
+        left: Vec::new(),
+    })?;
+    Ok(RecordedReturn::Branch { name })
+}
+
+/// Steps 11–13: the record written, the branch checked out at `source`, the merge started; a failure after the
+/// checkout restores.
+fn change_checkout(
+    repo: &Repo,
+    path: &Path,
+    record: &MergeRecord,
+    source: &Oid,
+) -> Result<Started, Refusal> {
+    record::write(path, record).map_err(|error| Refusal::GitRefused {
+        message: format!("cannot write {}: {error}", path.display()),
+        left: Vec::new(),
+    })?;
+    if let Err(error) = repo.checkout_branch_at(&record.branch, source) {
+        record::remove(path);
+        return Err(refused(&error));
+    }
+    merged(repo, record).map_err(|message| Refusal::GitRefused {
+        message,
+        left: restore(repo, path, record),
+    })
+}
+
+/// Steps 12 and 13; `Err` holds git's words.
+fn merged(repo: &Repo, record: &MergeRecord) -> Result<Started, String> {
+    if record.branch_before == RecordedBranch::Created {
+        repo.set_upstream(&record.branch, &record.remote)
+            .map_err(|error| git_message(&error))?;
+    }
+    let run = repo
+        .merge_no_commit(&merge_name(repo, record))
+        .map_err(|error| git_message(&error))?;
+    let stop = repo.stop().map_err(|error| git_message(&error))?;
+    let current_branch = repo.current_branch().map_err(|error| git_message(&error))?;
+    if !is_live(record, &stop, current_branch.as_deref()) {
+        return Err(first_line(&run.output).unwrap_or_else(|| MERGE_FAILED.to_owned()));
+    }
+    let unmerged = repo.unmerged().map_err(|error| git_message(&error))?;
+    Ok(Started {
+        branch: record.branch.clone(),
+        target: record.target.clone(),
+        conflicts: !unmerged.is_empty(),
+    })
+}
+
+/// `<remote>/<target>`, so git's default message reads "Merge remote-tracking branch 'origin/main' into …" (git
+/// names the merged ref as it was given); the full `refs/remotes/…` when another ref of that short name would win.
+fn merge_name(repo: &Repo, record: &MergeRecord) -> String {
+    let short = format!("{}/{}", record.remote, record.target);
+    let full = format!("refs/remotes/{short}");
+    match repo.symbolic_full_name(&short) {
+        Ok(Some(name)) if name == full.as_bytes() => short,
+        Ok(_) | Err(_) => full,
+    }
+}
+
+fn refused(error: &yamt_gitio::Error) -> Refusal {
+    Refusal::GitRefused {
+        message: git_message(error),
+        left: Vec::new(),
+    }
+}
diff --git a/crates/local-merge/tests/local_merge/abort.rs b/crates/local-merge/tests/local_merge/abort.rs
new file mode 100644
index 0000000..72d03bb
--- /dev/null
+++ b/crates/local-merge/tests/local_merge/abort.rs
@@ -0,0 +1,172 @@
+use yamt_local_merge::{BranchBefore, Leftover, ReturnTo, find_live, start};
+
+use crate::common::{DEVELOP, DUE_DATES, Fixture, MAIN, branches};
+
+fn started(fixture: &Fixture) {
+    start(fixture.root(), &branches(DUE_DATES)).unwrap();
+}
+
+fn develop() -> ReturnTo {
+    ReturnTo::Branch {
+        name: DEVELOP.to_owned(),
+    }
+}
+
+#[test]
+fn abort_after_a_restart_returns_to_develop_and_deletes_the_created_branch() {
+    let fixture = Fixture::new();
+    let before = fixture.checkout();
+    started(&fixture);
+
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    fixture.abort_git_merge();
+    let left = live.restore();
+
+    assert_eq!(left, []);
+    assert_eq!(fixture.checkout(), before);
+    assert!(!fixture.has_branch(DUE_DATES));
+    assert_eq!(fixture.config(&format!("branch.{DUE_DATES}.remote")), None);
+    assert_eq!(fixture.git(&["status", "--porcelain=v1"]), "");
+}
+
+#[test]
+fn abort_moves_a_fast_forwarded_branch_back() {
+    let fixture = Fixture::new();
+    let behind = fixture.gitlab(&["rev-parse", &format!("{DUE_DATES}~1")]);
+    fixture.git(&["branch", DUE_DATES, &behind]);
+    let before = fixture.checkout();
+    started(&fixture);
+
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    fixture.abort_git_merge();
+    let left = live.restore();
+
+    assert_eq!(left, []);
+    assert_eq!(fixture.checkout(), before);
+    assert_eq!(fixture.tip(DUE_DATES), behind);
+}
+
+#[test]
+fn abort_on_the_branch_itself_resets_it_back() {
+    let fixture = Fixture::new();
+    let behind = fixture.gitlab(&["rev-parse", &format!("{DUE_DATES}~1")]);
+    fixture.git(&["checkout", "-q", "-b", DUE_DATES, &behind]);
+    let before = fixture.checkout();
+    started(&fixture);
+
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    assert_eq!(live.view().return_to, None);
+    fixture.abort_git_merge();
+    let left = live.restore();
+
+    assert_eq!(left, []);
+    assert_eq!(fixture.checkout(), before);
+}
+
+#[test]
+fn abort_from_a_detached_head_returns_to_the_commit() {
+    let fixture = Fixture::new();
+    let develop_tip = fixture.tip(DEVELOP);
+    fixture.git(&["checkout", "-q", "--detach", DEVELOP]);
+    let before = fixture.checkout();
+    started(&fixture);
+
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    let id = develop_tip[..7].to_owned();
+    assert_eq!(live.view().return_to, Some(ReturnTo::Commit { id }));
+    fixture.abort_git_merge();
+    let left = live.restore();
+
+    assert_eq!(left, []);
+    assert_eq!(fixture.checkout(), before);
+    assert_eq!(fixture.head(), format!("HEAD {develop_tip}"));
+}
+
+#[test]
+fn abort_keeps_a_branch_that_moved_after_the_merge_started() {
+    let fixture = Fixture::new();
+    started(&fixture);
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    fixture.abort_git_merge();
+    fixture.git(&["commit", "-q", "--allow-empty", "-m", "Mine"]);
+    let mine = fixture.tip(DUE_DATES);
+
+    let left = live.restore();
+
+    let branch = DUE_DATES.to_owned();
+    let to = develop();
+    let expected = [
+        Leftover::NotReturned { to },
+        Leftover::BranchKept { branch },
+    ];
+    assert_eq!(left, expected);
+    assert_eq!(fixture.head(), format!("refs/heads/{DUE_DATES} {mine}"));
+    assert!(!fixture.record_path().exists());
+}
+
+#[test]
+fn abort_leaves_head_where_the_user_moved_it() {
+    let fixture = Fixture::new();
+    started(&fixture);
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    fixture.abort_git_merge();
+    fixture.git(&["checkout", "-q", MAIN]);
+    let main = fixture.tip(MAIN);
+
+    let left = live.restore();
+
+    assert_eq!(left, [Leftover::NotReturned { to: develop() }]);
+    assert_eq!(fixture.head(), format!("refs/heads/{MAIN} {main}"));
+    assert!(!fixture.has_branch(DUE_DATES));
+    assert!(!fixture.record_path().exists());
+}
+
+#[test]
+fn a_refused_return_is_listed_and_the_created_branch_kept() {
+    let fixture = Fixture::new();
+    started(&fixture);
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    fixture.abort_git_merge();
+    fixture.write("src/board/card.ts", "mine\n");
+
+    let left = live.restore();
+
+    let [
+        Leftover::ReturnRefused { to, message },
+        Leftover::BranchKept { branch },
+    ] = left.as_slice()
+    else {
+        panic!("{left:?}");
+    };
+    assert_eq!(*to, develop());
+    assert!(
+        message.starts_with("error: Your local changes"),
+        "{message}"
+    );
+    assert_eq!(branch, DUE_DATES);
+    assert_eq!(fixture.git(&["branch", "--show-current"]), DUE_DATES);
+    assert!(!fixture.record_path().exists());
+}
+
+#[test]
+fn a_refused_move_back_is_listed() {
+    let fixture = Fixture::new();
+    let behind = fixture.gitlab(&["rev-parse", &format!("{DUE_DATES}~1")]);
+    fixture.git(&["checkout", "-q", "-b", DUE_DATES, &behind]);
+    started(&fixture);
+    let live = find_live(fixture.root()).unwrap().unwrap();
+    let id = behind[..7].to_owned();
+    assert_eq!(live.view().branch_before, BranchBefore::MovedFrom { id });
+    fixture.abort_git_merge();
+    fixture.write("src/board/card.ts", "mine\n");
+    let tip = fixture.tip(DUE_DATES);
+
+    let left = live.restore();
+
+    let [Leftover::BranchRefused { branch, message }] = left.as_slice() else {
+        panic!("{left:?}");
+    };
+    assert_eq!(branch, DUE_DATES);
+    assert!(message.starts_with("error:"), "{message}");
+    assert_eq!(fixture.tip(DUE_DATES), tip);
+}
