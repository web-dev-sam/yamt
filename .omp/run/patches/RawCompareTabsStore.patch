+    logged({
+      action: "settings",
+      cause: { kind: "Keys", path: "/home/me/settings.json", problems: [] },
+    }),
+  ).toEqual(['[error] store.settings_failed {kind: "Keys", path: "/home/me/settings.json"}']);
+});
