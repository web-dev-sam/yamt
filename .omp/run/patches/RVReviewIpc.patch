+import { beforeEach, expect, test, vi } from "vitest";
+
+import type * as Generated from "./bindings";
+import {
+  isMessageId,
+  isRangeFileId,
+  isThreadId,
+  type MessageId,
+  type RangeFileId,
+  type ThreadId,
+} from "./domain";
+import { createTauriReview } from "./tauriReview";
+import { changedThreadLine } from "./threadLine";
+
+const commands = vi.hoisted(() => ({
+  listThreads: vi.fn(),
+  addThread: vi.fn(),
+  addNote: vi.fn(),
+  queueMessage: vi.fn(),
+  unqueueMessage: vi.fn(),
+  checkGitlab: vi.fn(),
+  sendQueue: vi.fn(),
+}));
+
+vi.mock("./bindings", () => ({ commands }));
+
+vi.mock("@tauri-apps/api/core", () => ({
+  Channel: class {
+    constructor(readonly onmessage: (message: unknown) => void) {}
+  },
+}));
+
+const PENDING_LIST: Generated.ThreadList = {
+  threads: [
+    {
+      id: 2,
+      file: 7,
+      line: { kind: "unchangedOnLeft", left: 5, right: 6 },
+      messages: [
+        {
+          id: 4,
+          body: { kind: "note", text: "Rename?" },
+          written: 1700,
+          posting: {
+            kind: "pending",
+            text: "Rename?",
+            draft_note: 88,
+            merge_request: "!12",
+            link: "l",
+          },
+        },
+      ],
+      session: "s",
+    },
+  ],
+};
+
+const CAMEL_LIST = {
+  threads: [
+    {
+      id: 2,
+      file: 7,
+      line: { kind: "unchangedOnLeft", left: 5, right: 6 },
+      messages: [
+        {
+          id: 4,
+          body: { kind: "note", text: "Rename?" },
+          written: 1700,
+          posting: {
+            kind: "pending",
+            text: "Rename?",
+            draftNote: 88,
+            mergeRequest: "!12",
+            link: "l",
+          },
+        },
+      ],
+      session: "s",
+    },
+  ],
+};
+
+const MERGE_REQUEST: Generated.MergeRequestRef = { reference: "!12", title: "T", web_url: "u" };
+
+function fileId(n: number): RangeFileId {
