+  }
+  return n;
+}
+
+function threadId(n: number): ThreadId {
+  if (!isThreadId(n)) {
+    throw new Error(`${n} is no thread id`);
+  }
+  return n;
+}
+
+function messageId(n: number): MessageId {
+  if (!isMessageId(n)) {
+    throw new Error(`${n} is no message id`);
+  }
+  return n;
+}
+
+function ok<T>(data: T): { status: "ok"; data: T } {
+  return { status: "ok", data };
+}
