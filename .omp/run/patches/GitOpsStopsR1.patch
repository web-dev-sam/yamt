+        answers.push(resolve);
+      }),
+  );
+
+  const pressed = abort.abortOperation();
+  abort.asking.answer(true);
+  await vi.waitFor(() => {
+    expect(answers).toHaveLength(1);
+  });
+  abort.stop.dropped = true;
+  answers[0]?.({ ok: false, failure: { kind: "StopMovedOn" } });
