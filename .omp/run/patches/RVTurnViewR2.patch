From 0916a24ae38581b615495f69ce9e7a31f3a80b40 Mon Sep 17 00:00:00 2001
From: Samuel Braun <sam@webry.com>
Date: Mon, 26 Oct 2026 23:50:02 +0100
Subject: [PATCH] fix(ai): a last line without a break claims no ending;
 survivors killed

---
 frontend/src/ui/editDiffLines.test.ts | 39 +++++++++++++++++++++++----
 frontend/src/ui/editDiffLines.ts      | 10 ++++---
 2 files changed, 41 insertions(+), 8 deletions(-)

diff --git a/frontend/src/ui/editDiffLines.test.ts b/frontend/src/ui/editDiffLines.test.ts
index 07e65d1..cd819b8 100644
--- a/frontend/src/ui/editDiffLines.test.ts
+++ b/frontend/src/ui/editDiffLines.test.ts
@@ -152,11 +152,11 @@ test("a side without a final newline gets git's marker after its last line, wher
 });
 
 test("a pair differing only by a carriage return is marked with each side's line ending, the \\r never shown", () => {
-  expect(shape(editDiffLines("a\r\nb\r\n", "a\nb\n", [placed([0, 2, 0, 2])]))).toEqual([
-    "-1 a [crlf]",
-    "-2 b [crlf]",
-    "+1 a [lf]",
-    "+2 b [lf]",
+  expect(shape(editDiffLines("ab\r\ncd\r\n", "ab\ncd\n", [placed([0, 2, 0, 2])]))).toEqual([
+    "-1 ab [crlf]",
+    "-2 cd [crlf]",
+    "+1 ab [lf]",
+    "+2 cd [lf]",
   ]);
   expect(shape(editDiffLines("x\r\ny\r\nz\r\n", "x\r\nY\nz\r\n", [placed([1, 1, 1, 1])]))).toEqual([
     " 1:1 x",
@@ -171,6 +171,34 @@ test("a pair differing only by a carriage return is marked with each side's line
   ]);
 });
 
+test("a last line without a line break claims no ending; its pair keeps its own", () => {
+  expect(shape(editDiffLines("a\r\n", "a", [placed([0, 1, 0, 1])]))).toEqual([
+    "-1 a [crlf]",
+    "+1 a",
+    "\\",
+  ]);
+  expect(shape(editDiffLines("a", "a\r\n", [placed([0, 1, 0, 1])]))).toEqual([
+    "-1 a",
+    "\\",
+    "+1 a [crlf]",
+  ]);
+});
+
+test("an unpaired changed line is never paired with the unchanged line after the change", () => {
+  expect(shape(editDiffLines("a\r\nc\r\nc\n", "a\nc\n", [placed([0, 2, 0, 1])]))).toEqual([
+    "-1 a [crlf]",
+    "-2 c",
+    "+1 a [lf]",
+    " 3:2 c",
+  ]);
+  expect(shape(editDiffLines("a\nc\n", "a\r\nc\r\nc\n", [placed([0, 1, 0, 2])]))).toEqual([
+    "-1 a [lf]",
+    "+1 a [crlf]",
+    "+2 c",
+    " 2:3 c",
+  ]);
+});
+
 test("rows stop at 2,000 and a last row counts the changed and unchanged lines not shown", () => {
   const old = numbered(1500, "old");
   const next = numbered(1500, "new");
@@ -233,4 +261,5 @@ test("each row kind fills its own cells; words come from the AI text", () => {
   expect(diffRowCells({ kind: "removed", old: 1, text: "a", ending: "crlf" }).note).toBe(
     "CRLF line ending",
   );
+  expect(diffRowCells({ kind: "added", new: 1, text: "a", ending: null }).note).toBe("");
 });
diff --git a/frontend/src/ui/editDiffLines.ts b/frontend/src/ui/editDiffLines.ts
index 87901d4..77a94ca 100644
--- a/frontend/src/ui/editDiffLines.ts
+++ b/frontend/src/ui/editDiffLines.ts
@@ -80,8 +80,12 @@ function add(rows: Rows, row: DiffRow): void {
   }
 }
 
+function lacksBreak(side: Side, line: number): boolean {
+  return side.open && line === side.lines.length - 1;
+}
+
 function addLastLine(rows: Rows, side: Side, line: number): void {
-  if (side.open && line === side.lines.length - 1) {
+  if (lacksBreak(side, line)) {
     add(rows, { kind: "noNewline" });
   }
 }
@@ -132,7 +136,7 @@ function addChange(rows: Rows, texts: Texts, { left, right }: Placed): void {
       kind: "removed",
       old: line + 1,
       text: withoutCr(text),
-      ending: pairEnding(text, pair),
+      ending: lacksBreak(texts.old, line) ? null : pairEnding(text, pair),
     });
     addLastLine(rows, texts.old, line);
   }
@@ -144,7 +148,7 @@ function addChange(rows: Rows, texts: Texts, { left, right }: Placed): void {
       kind: "added",
       new: line + 1,
       text: withoutCr(text),
-      ending: pairEnding(text, pair),
+      ending: lacksBreak(texts.new, line) ? null : pairEnding(text, pair),
     });
     addLastLine(rows, texts.new, line);
   }
-- 
