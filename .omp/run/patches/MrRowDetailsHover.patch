index 0000000..e3fd362
--- /dev/null
+++ b/frontend/src/ui/useHoverBox.test.ts
@@ -0,0 +1,300 @@
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+import { effectScope, type EffectScope } from "vue";
+
+import { useHoverBox, type HoverBox } from "./useHoverBox";
+
+class FakeNode extends EventTarget {
+  readonly children: FakeNode[] = [];
+  left = 0;
+  bottom = 0;
+  contains(node: unknown): boolean {
+    return node === this || this.children.some((child) => child.contains(node));
+  }
+  focus(): void {
+    page.focused = this;
+  }
+  getBoundingClientRect(): { readonly left: number; readonly bottom: number } {
+    return { left: this.left, bottom: this.bottom };
+  }
+}
+
+class FakeFocusEvent extends Event {
+  readonly relatedTarget: EventTarget | null;
+  constructor(type: string, relatedTarget: EventTarget | null) {
+    super(type);
+    this.relatedTarget = relatedTarget;
+  }
+}
+
+class FakeKeyboardEvent extends Event {
+  readonly key: string;
+  constructor(key: string) {
+    super("keydown", { cancelable: true });
+    this.key = key;
+  }
+}
+
+const page: { focused: unknown; window: EventTarget } = {
+  focused: null,
+  window: new EventTarget(),
+};
+
+let scope: EffectScope;
+let area: FakeNode;
+let opener: FakeNode;
+let item: FakeNode;
+let outside: FakeNode;
+let openerShown: boolean;
+let areaShown: boolean;
+
+beforeEach(() => {
+  vi.stubGlobal("Node", FakeNode);
+  vi.stubGlobal("HTMLElement", FakeNode);
+  vi.stubGlobal("FocusEvent", FakeFocusEvent);
+  vi.stubGlobal("KeyboardEvent", FakeKeyboardEvent);
+  page.window = new EventTarget();
+  vi.stubGlobal("window", page.window);
+  vi.stubGlobal("document", {
+    get activeElement() {
+      return page.focused;
+    },
+  });
+  area = new FakeNode();
+  opener = Object.assign(new FakeNode(), { left: 10, bottom: 40 });
+  const box = new FakeNode();
+  item = new FakeNode();
+  box.children.push(item);
+  area.children.push(opener, box);
+  outside = new FakeNode();
+  page.focused = outside;
+  openerShown = true;
+  areaShown = true;
+  scope = effectScope();
+});
+
+afterEach(() => {
+  scope.stop();
+  vi.unstubAllGlobals();
+});
+
+function asElement(fake: FakeNode): HTMLElement {
+  if (fake instanceof HTMLElement) {
+    return fake;
+  }
+  throw new Error("HTMLElement is not the stub");
+}
+
+function hoverBox(): HoverBox {
+  const made = scope.run(() =>
+    useHoverBox({
+      area: () => (areaShown ? asElement(area) : null),
+      opener: () => (openerShown ? asElement(opener) : null),
+      box: null,
+    }),
+  );
+  if (made === undefined) {
+    throw new Error("scope stopped");
+  }
+  return made;
+}
+
+function focusEvent(type: "focusin" | "focusout", related: FakeNode | null): FocusEvent {
+  const event = new FakeFocusEvent(type, related);
+  if (event instanceof FocusEvent) {
+    return event;
+  }
+  throw new Error("FocusEvent is not the stub");
+}
+
+function key(name: string): KeyboardEvent {
+  const event = new FakeKeyboardEvent(name);
+  if (event instanceof KeyboardEvent) {
+    return event;
+  }
+  throw new Error("KeyboardEvent is not the stub");
+}
+
+function scroll(target: EventTarget): void {
+  const event = new Event("scroll");
+  Object.defineProperty(event, "target", { value: target });
+  page.window.dispatchEvent(event);
+}
+
+test("the pointer entering opens the box at once below the opener's left edge", () => {
+  const box = hoverBox();
+
+  box.on.pointerenter();
+
+  expect(box.open.value).toBe(true);
+  expect(box.placement.value).toEqual({ left: "10px", top: "40px" });
+});
+
+test("focus entering from outside opens the box", () => {
+  const box = hoverBox();
+
+  box.on.focusin(focusEvent("focusin", outside));
+
+  expect(box.open.value).toBe(true);
+});
+
+test("without an opener nothing opens", () => {
+  openerShown = false;
+  const box = hoverBox();
+
+  box.on.pointerenter();
+
+  expect(box.open.value).toBe(false);
+});
+
+test("the box stays while focus is inside after the pointer leaves, and closes once both left", () => {
+  const box = hoverBox();
+  box.on.pointerenter();
+  box.on.focusin(focusEvent("focusin", outside));
+
+  box.on.pointerleave();
+  expect(box.open.value).toBe(true);
+  box.on.focusout(focusEvent("focusout", outside));
+
+  expect(box.open.value).toBe(false);
+});
+
+test("the box stays while the pointer is inside after focus leaves, and closes once both left", () => {
+  const box = hoverBox();
+  box.on.focusin(focusEvent("focusin", null));
+  box.on.pointerenter();
+
+  box.on.focusout(focusEvent("focusout", null));
+  expect(box.open.value).toBe(true);
+  box.on.pointerleave();
+
+  expect(box.open.value).toBe(false);
+});
+
+test("focus moving inside the area neither opens nor closes the box", () => {
+  const box = hoverBox();
+  box.on.focusin(focusEvent("focusin", item));
+  expect(box.open.value).toBe(false);
+
+  box.on.focusin(focusEvent("focusin", outside));
+  box.on.focusout(focusEvent("focusout", item));
+
+  expect(box.open.value).toBe(true);
+});
+
+test("Escape closes the box, takes the key and returns focus to the opener", () => {
+  const box = hoverBox();
+  const closedEscape = key("Escape");
+  box.on.keydown(closedEscape);
+  expect(closedEscape.defaultPrevented).toBe(false);
+  box.on.pointerenter();
+  page.focused = item;
+
+  const enter = key("Enter");
+  box.on.keydown(enter);
+  expect([box.open.value, enter.defaultPrevented]).toEqual([true, false]);
+  const escape = key("Escape");
+  box.on.keydown(escape);
+
+  expect([box.open.value, escape.defaultPrevented, page.focused]).toEqual([false, true, opener]);
+});
+
+test("a scroll outside the box closes it; one inside keeps it", () => {
+  const box = hoverBox();
+  box.on.pointerenter();
+
+  scroll(item);
+  expect(box.open.value).toBe(true);
+  scroll(outside);
+
+  expect(box.open.value).toBe(false);
+});
+
+test("after a scroll closed it with focus in the box, the pointer alone holds it again", () => {
+  const box = hoverBox();
+  box.on.focusin(focusEvent("focusin", outside));
+  page.focused = item;
+  box.on.pointerenter();
+  scroll(outside);
+
+  box.on.pointerleave();
+  box.on.pointerenter();
+  box.on.pointerleave();
+
+  expect(box.open.value).toBe(false);
+});
+
+test("after a scroll closed it with focus on the opener, that focus still holds it", () => {
+  const box = hoverBox();
+  box.on.focusin(focusEvent("focusin", outside));
+  page.focused = opener;
+  box.on.pointerenter();
+  scroll(outside);
+
+  box.on.pointerleave();
+  box.on.pointerenter();
+  box.on.pointerleave();
+
+  expect(box.open.value).toBe(true);
+});
+
+test("close shuts the box and the pointer re-entering opens it again", () => {
+  const box = hoverBox();
+  box.on.focusin(focusEvent("focusin", outside));
+  page.focused = item;
+
+  box.close();
+  expect(box.open.value).toBe(false);
+  box.on.pointerenter();
+  expect(box.open.value).toBe(true);
+  box.on.pointerleave();
+
+  expect(box.open.value).toBe(false);
+});
+
+test("the pointer alone holds the box: leaving closes it", () => {
+  const box = hoverBox();
+  box.on.pointerenter();
+
+  box.on.pointerleave();
+
+  expect(box.open.value).toBe(false);
+});
+
+test("focus alone holds the box: leaving closes it", () => {
+  const box = hoverBox();
+  box.on.focusin(focusEvent("focusin", outside));
+
+  box.on.focusout(focusEvent("focusout", outside));
+
+  expect(box.open.value).toBe(false);
+});
+
+test("it listens for scrolls anywhere, captured and passive", () => {
+  const listen = vi.spyOn(page.window, "addEventListener");
+
+  hoverBox();
+
+  expect(listen.mock.calls.map(([type, , options]) => [type, options])).toEqual([
+    ["scroll", { capture: true, passive: true }],
+  ]);
+});
+
+test("without an area every focus move counts as one from outside", () => {
+  areaShown = false;
+  const box = hoverBox();
+
+  box.on.focusin(focusEvent("focusin", item));
+
+  expect(box.open.value).toBe(true);
+});
+
+test("Escape after the opener went closes the box and leaves focus alone", () => {
+  const box = hoverBox();
+  box.on.pointerenter();
+  page.focused = item;
+  openerShown = false;
+
+  box.on.keydown(key("Escape"));
+
+  expect([box.open.value, page.focused]).toEqual([false, item]);
+});
diff --git a/frontend/src/ui/useHoverBox.ts b/frontend/src/ui/useHoverBox.ts
new file mode 100644
index 0000000..a606b44
--- /dev/null
+++ b/frontend/src/ui/useHoverBox.ts
@@ -0,0 +1,126 @@
+import { useEventListener } from "@vueuse/core";
+import { shallowRef, type ComputedRef, type MaybeRefOrGetter, type ShallowRef } from "vue";
+
+import type { Point } from "./menuPosition";
+import { belowLeft, useMenuPlacement } from "./useMenuPlacement";
+
+type HoverBoxParts = {
+  readonly area: () => HTMLElement | null;
+  readonly opener: () => HTMLElement | null;
+  readonly box: MaybeRefOrGetter<HTMLElement | null>;
+};
+
+type Held = HoverBoxParts & {
+  readonly open: ShallowRef<boolean>;
+  readonly at: ShallowRef<Point>;
+  pointerInside: boolean;
+  focusInside: boolean;
+};
+
+export type HoverBox = {
+  readonly open: Readonly<ShallowRef<boolean>>;
+  readonly placement: ComputedRef<{ readonly left: string; readonly top: string }>;
+  readonly on: {
+    readonly pointerenter: () => void;
+    readonly pointerleave: () => void;
+    readonly focusin: (event: FocusEvent) => void;
+    readonly focusout: (event: FocusEvent) => void;
+    readonly keydown: (event: KeyboardEvent) => void;
+  };
+  readonly close: () => void;
+};
+
+function show(held: Held): void {
+  const opener = held.opener();
+  if (!held.open.value && opener !== null) {
+    held.at.value = belowLeft(opener);
+    held.open.value = true;
+  }
+}
+
+function hideUnlessHeld(held: Held): void {
+  if (!held.pointerInside && !held.focusInside) {
+    held.open.value = false;
+  }
+}
+
+function isInside(held: Held, target: EventTarget | null): boolean {
+  return target instanceof Node && held.area()?.contains(target) === true;
+}
+
+function close(held: Held): void {
+  held.focusInside = document.activeElement === held.opener();
+  held.open.value = false;
+}
+
+function focusEntered(held: Held, event: FocusEvent): void {
+  if (!isInside(held, event.relatedTarget)) {
+    held.focusInside = true;
+    show(held);
+  }
+}
+
+function focusLeft(held: Held, event: FocusEvent): void {
+  if (!isInside(held, event.relatedTarget)) {
+    held.focusInside = false;
+    hideUnlessHeld(held);
+  }
+}
+
+function keyPressed(held: Held, event: KeyboardEvent): void {
+  if (event.key === "Escape" && held.open.value) {
+    event.preventDefault();
+    held.open.value = false;
+    held.opener()?.focus();
+  }
+}
+
+function areaListeners(held: Held): HoverBox["on"] {
+  return {
+    pointerenter: () => {
+      held.pointerInside = true;
+      show(held);
+    },
+    pointerleave: () => {
+      held.pointerInside = false;
+      hideUnlessHeld(held);
+    },
+    focusin: (event) => {
+      focusEntered(held, event);
+    },
+    focusout: (event) => {
+      focusLeft(held, event);
+    },
+    keydown: (event) => {
+      keyPressed(held, event);
+    },
+  };
+}
+
+export function useHoverBox(parts: HoverBoxParts): HoverBox {
+  const held: Held = {
+    ...parts,
+    open: shallowRef(false),
+    at: shallowRef({ x: 0, y: 0 }),
+    pointerInside: false,
+    focusInside: false,
+  };
+  useEventListener(
+    window,
+    "scroll",
+    (event) => {
+      if (held.open.value && !isInside(held, event.target)) {
+        close(held);
+      }
+    },
+    { capture: true, passive: true },
+  );
+  return {
+    open: held.open,
+    placement: useMenuPlacement(parts.box, held.at),
+    on: areaListeners(held),
+    close: () => {
+      close(held);
+    },
+  };
+}
