+use yamt_conflict_repo::{
+    ConflictFile, FileKind, Remembered, Replay, conflict_repo, git_ok, rerere_repo,
+    run_ignored_in_child,
+};
 use yamt_gitio::Repo;
 
 const REPLAYED: &str = "replayed.txt";
