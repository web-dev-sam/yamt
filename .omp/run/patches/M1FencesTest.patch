--- /dev/null
+++ 2/frontend/scripts/fences.ts
@@ -0,0 +1,174 @@
+import { globSync, readFileSync } from "node:fs";
+import { join, posix } from "node:path";
+
+import { parse } from "@vue/compiler-sfc";
+import ts from "typescript";
+
+export type SourceFile = { readonly path: string; readonly text: string };
+
+export type FenceViolation = {
+  readonly rule: "PM2" | "PM3" | "PM5";
+  readonly file: string;
+  readonly specifier: string;
+  readonly reason: string;
+};
+
+type Finding = Pick<FenceViolation, "rule" | "reason">;
+
+type Edge = { readonly specifier: string; readonly file: string };
+
+const SKIPPED_FILE = "src/ipc/bindings.ts";
+const QUERY_SUFFIX = /\?.*$/;
+const MODULE_OF = /^src\/([^/]+)\//;
+const RESOLVE_SUFFIXES = ["", ".ts", ".vue", "/index.ts"] as const;
+const FRAMEWORK_FREE_MODULES: Record<string, true> = {
+  editor: true,
+  model: true,
+  connectors: true,
+};
+const FRAMEWORK_PACKAGE_PREFIXES = ["vue/", "@vue/", "@vueuse/", "@tauri-apps/"] as const;
+
+function scriptTexts(file: SourceFile): string[] {
+  if (!file.path.endsWith(".vue")) {
+    return [file.text];
+  }
+  const { descriptor } = parse(file.text, { filename: file.path });
+  return [descriptor.script, descriptor.scriptSetup].flatMap((block) =>
+    block === null ? [] : [block.content],
+  );
+}
+
+function isInside(path: string, directory: string): boolean {
+  return path === directory || path.startsWith(`${directory}/`);
+}
+
+function relativeTarget(importer: string, bare: string): string | undefined {
+  if (!bare.startsWith(".")) {
+    return undefined;
+  }
+  return posix.join(posix.dirname(importer), bare).replace(/\/$/, "");
+}
+
+function packageFinding(module: string | undefined, bare: string): Finding | undefined {
+  if (module === "ui" && bare.startsWith("@codemirror/")) {
+    return { rule: "PM2", reason: "ui/ never imports CodeMirror; go through editor/index.ts" };
+  }
+  const isFrameworkPackage =
+    bare === "vue" || FRAMEWORK_PACKAGE_PREFIXES.some((prefix) => bare.startsWith(prefix));
+  if (module !== undefined && Object.hasOwn(FRAMEWORK_FREE_MODULES, module) && isFrameworkPackage) {
+    return { rule: "PM3", reason: `${module}/ is framework-free` };
+  }
+  return undefined;
+}
+
+function pathFinding(module: string | undefined, target: string): Finding | undefined {
+  if (module === "ui" && isInside(target, "src/editor/internal")) {
+    return {
+      rule: "PM2",
+      reason: "ui/ never reaches editor/internal/; go through editor/index.ts",
+    };
+  }
+  if (module === "ui" && isInside(target, "src/model")) {
+    return { rule: "PM2", reason: "ui/ never imports model/" };
+  }
+  if (target.split("/").includes("internal") && MODULE_OF.exec(target)?.[1] !== module) {
+    return { rule: "PM5", reason: "no module imports another module's internal/" };
+  }
+  return undefined;
+}
+
+function stronglyConnected(graph: ReadonlyMap<string, readonly Edge[]>): string[][] {
+  type Visit = { readonly index: number; low: number };
+  const visits = new Map<string, Visit>();
+  const stack: string[] = [];
+  const onStack = new Set<string>();
+  const components: string[][] = [];
+
+  function visit(node: string): Visit {
+    const self: Visit = { index: visits.size, low: visits.size };
+    visits.set(node, self);
+    stack.push(node);
+    onStack.add(node);
+    for (const edge of graph.get(node) ?? []) {
+      const seen = visits.get(edge.file);
+      if (seen === undefined) {
+        self.low = Math.min(self.low, visit(edge.file).low);
+      } else if (onStack.has(edge.file)) {
+        self.low = Math.min(self.low, seen.index);
+      }
+    }
+    if (self.low === self.index) {
+      const component = stack.splice(stack.lastIndexOf(node));
+      component.forEach((member) => onStack.delete(member));
+      components.push(component);
+    }
+    return self;
+  }
+
+  for (const node of graph.keys()) {
+    if (!visits.has(node)) {
+      visit(node);
+    }
+  }
+  return components;
+}
+
+function cycleViolations(graph: ReadonlyMap<string, readonly Edge[]>): FenceViolation[] {
+  return stronglyConnected(graph).flatMap((component) => {
+    const members = component.toSorted();
+    const [file] = members;
+    if (file === undefined) {
+      return [];
+    }
+    const edge = graph.get(file)?.find((candidate) => members.includes(candidate.file));
+    if (edge === undefined) {
+      return [];
+    }
+    return [
+      {
+        rule: "PM5",
+        file,
+        specifier: edge.specifier,
+        reason: `import cycle: ${members.join(" ↔ ")}`,
+      } satisfies FenceViolation,
+    ];
+  });
+}
+
+export function findFenceViolations(files: readonly SourceFile[]): FenceViolation[] {
+  const known: ReadonlySet<string> = new Set(files.map((file) => file.path));
+  const violations: FenceViolation[] = [];
+  const graph = new Map<string, Edge[]>();
+  for (const file of files) {
+    const module = MODULE_OF.exec(file.path)?.[1];
+    const edges: Edge[] = [];
+    const specifiers = scriptTexts(file).flatMap((text) =>
+      ts.preProcessFile(text, true, true).importedFiles.map((reference) => reference.fileName),
+    );
+    for (const specifier of specifiers) {
+      const bare = specifier.replace(QUERY_SUFFIX, "");
+      const target = relativeTarget(file.path, bare);
+      const finding =
+        target === undefined ? packageFinding(module, bare) : pathFinding(module, target);
+      if (finding !== undefined) {
+        violations.push({ ...finding, file: file.path, specifier });
+      }
+      const resolved =
+        target === undefined
+          ? undefined
+          : RESOLVE_SUFFIXES.map((suffix) => target + suffix).find((path) => known.has(path));
+      if (resolved !== undefined) {
+        edges.push({ specifier, file: resolved });
+      }
+    }
+    graph.set(file.path, edges);
+  }
+  return [...violations, ...cycleViolations(graph)];
+}
+
+export function readSourceTree(frontendRoot: string): SourceFile[] {
+  return globSync(["src/**/*.ts", "src/**/*.vue"], { cwd: frontendRoot })
+    .filter((path) => path !== SKIPPED_FILE)
+    .toSorted()
+    .map((path) => ({ path, text: readFileSync(join(frontendRoot, path), "utf8") }));
+}
diff --git 1/frontend/scripts/fences.test.ts 2/frontend/scripts/fences.test.ts
new file mode 100644
index 0000000..17c87d6
--- /dev/null
+++ 2/frontend/scripts/fences.test.ts
@@ -0,0 +1,155 @@
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { expect, test } from "vitest";
+
+import {
+  findFenceViolations,
+  readSourceTree,
+  type FenceViolation,
+  type SourceFile,
+} from "./fences";
+
+const FRONTEND_ROOT = fileURLToPath(new URL("..", import.meta.url));
+
+function violationsOf(files: SourceFile[]): Omit<FenceViolation, "reason">[] {
+  return findFenceViolations(files).map(({ rule, file, specifier }) => ({ rule, file, specifier }));
+}
+
+test("the real source tree has no fence violations", () => {
+  expect(findFenceViolations(readSourceTree(FRONTEND_ROOT))).toEqual([]);
+});
+
+test("readSourceTree reports PM2 probes on disk and skips src/ipc/bindings.ts", () => {
+  const root = mkdtempSync(join(tmpdir(), "yamt-fences-"));
+  try {
+    const probes: Record<string, string> = {
+      "src/ui/probe.ts": `import "@codemirror/state";\n`,
+      "src/ui/Probe.vue": `<script setup lang="ts">\nimport { EditorView } from "@codemirror/view";\n</script>\n<template><p>{{ EditorView }}</p></template>\n`,
+      "src/ipc/bindings.ts": `import "./bindings";\n`,
+    };
+    for (const [path, text] of Object.entries(probes)) {
+      mkdirSync(dirname(join(root, path)), { recursive: true });
+      writeFileSync(join(root, path), text);
+    }
+
+    expect(violationsOf(readSourceTree(root))).toEqual([
+      { rule: "PM2", file: "src/ui/Probe.vue", specifier: "@codemirror/view" },
+      { rule: "PM2", file: "src/ui/probe.ts", specifier: "@codemirror/state" },
+    ]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("ui importing @codemirror/view violates PM2", () => {
+  const files = [
+    { path: "src/ui/Pane.ts", text: `import { EditorView } from "@codemirror/view";` },
+  ];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM2", file: "src/ui/Pane.ts", specifier: "@codemirror/view" },
+  ]);
+});
+
+test("ui importing editor/internal violates PM2", () => {
+  const files = [
+    { path: "src/ui/Pane.ts", text: `import { pane } from "../editor/internal/pane";` },
+  ];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM2", file: "src/ui/Pane.ts", specifier: "../editor/internal/pane" },
+  ]);
+});
+
+test("ui side-effect importing model violates PM2", () => {
+  const files = [{ path: "src/ui/store.ts", text: `import "../model";` }];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM2", file: "src/ui/store.ts", specifier: "../model" },
+  ]);
+});
+
+test("editor dynamically importing vue violates PM3", () => {
+  const files = [
+    { path: "src/editor/index.ts", text: `export async function load() { return import("vue"); }` },
+  ];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM3", file: "src/editor/index.ts", specifier: "vue" },
+  ]);
+});
+
+test("connectors re-exporting @vueuse/core violates PM3", () => {
+  const files = [
+    { path: "src/connectors/raf.ts", text: `export { useRafFn } from "@vueuse/core";` },
+  ];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM3", file: "src/connectors/raf.ts", specifier: "@vueuse/core" },
+  ]);
+});
+
+test("both script blocks of a ui .vue file are checked", () => {
+  const text = `<script lang="ts">
+import "@codemirror/state";
+</script>
+<script setup lang="ts">
+import { pane } from "../editor/internal";
+</script>
+<template><p>{{ pane }}</p></template>
+`;
+  const files = [{ path: "src/ui/MergeView.vue", text }];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM2", file: "src/ui/MergeView.vue", specifier: "@codemirror/state" },
+    { rule: "PM2", file: "src/ui/MergeView.vue", specifier: "../editor/internal" },
+  ]);
+});
+
+test("editor importing ipc/internal violates PM5", () => {
+  const files = [{ path: "src/editor/apply.ts", text: `import { x } from "../ipc/internal/x";` }];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM5", file: "src/editor/apply.ts", specifier: "../ipc/internal/x" },
+  ]);
+});
+
+test("a two-file cycle violates PM5 once", () => {
+  const files = [
+    { path: "src/model/a.ts", text: `import { b } from "./b";\nexport const a = 1;` },
+    { path: "src/model/b/index.ts", text: `import { a } from "../a.ts";\nexport const b = a;` },
+  ];
+
+  expect(violationsOf(files)).toEqual([{ rule: "PM5", file: "src/model/a.ts", specifier: "./b" }]);
+});
+
+test("a type-only import into model violates PM2", () => {
+  const files = [{ path: "src/ui/store.ts", text: `import type { Chunk } from "../model/chunk";` }];
+
+  expect(violationsOf(files)).toEqual([
+    { rule: "PM2", file: "src/ui/store.ts", specifier: "../model/chunk" },
+  ]);
+});
+
+test("a ?raw import of an allowed file violates nothing", () => {
+  const files = [
+    {
+      path: "src/editor/index.ts",
+      text: `import theme from "./theme.css?raw";\nexport { theme };`,
+    },
+  ];
+
+  expect(violationsOf(files)).toEqual([]);
+});
+
+test("a module importing its own internal/ is allowed", () => {
+  const files = [
+    { path: "src/editor/index.ts", text: `export { pane } from "./internal/pane";` },
+    { path: "src/editor/internal/pane.ts", text: `export const pane = 1;` },
+  ];
+
+  expect(violationsOf(files)).toEqual([]);
+});
