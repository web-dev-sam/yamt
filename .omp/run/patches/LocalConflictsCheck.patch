+    merged_in_finishing_order(&[pair('1', 'a')], MERGE_PHASE_LIMIT, &merge, &mut on_merged);
+
+    assert_eq!(
+        results,
+        [Err("merge-tree: not something we can merge".to_owned())]
+    );
