+import { expect, test } from "vitest";
+
+import {
+  changedThreadLine,
+  loadCompareFixture,
+  unchangedThreadLine,
+  type Difference,
+} from "../../ipc";
+import { rowHeight, threadRows, type ShownThread, type ThreadRow } from "./threadRows";
+
+type Lines = { readonly start: number; readonly len: number };
+
+const NO_WORDS = { changed: [], removals: [] };
+
+async function differencesOf(
+  ranges: readonly { readonly left: Lines; readonly right: Lines }[],
+): Promise<readonly Difference[]> {
+  const differences = ranges.map((range) => ({
+    ...range,
+    words: { left: NO_WORDS, right: NO_WORDS },
+  }));
+  const files = { "case.json": { left: "", right: "", differences } };
+  return (await loadCompareFixture("case", files)).comparison.differences;
+}
+
+function places(rows: readonly ThreadRow[]): unknown[] {
+  return rows.map(({ place, keys }) => ({ place, keys }));
+}
+
+test("a removed line's gap sits after the difference's right lines", async () => {
+  const differences = await differencesOf([
+    { left: { start: 1, len: 2 }, right: { start: 1, len: 4 } },
+  ]);
+  const threads: ShownThread[] = [
+    { key: "removed", line: changedThreadLine("left", 1), shown: "open" },
+    { key: "added", line: changedThreadLine("right", 2), shown: "open" },
+  ];
+
+  expect(places(threadRows(differences, threads))).toEqual([
+    { place: { left: 2, right: 5 }, keys: { left: ["removed"], right: [] } },
+    { place: { left: 3, right: 3 }, keys: { left: [], right: ["added"] } },
+  ]);
+});
+
+test("an unchanged line's threads from both columns share one row", async () => {
+  const differences = await differencesOf([
+    { left: { start: 1, len: 1 }, right: { start: 1, len: 3 } },
+  ]);
+  const lines = { left: 7, right: 9 };
+  const threads: ShownThread[] = [
+    { key: "on-left", line: unchangedThreadLine("left", lines), shown: "open" },
+    { key: "on-right", line: unchangedThreadLine("right", lines), shown: "draft" },
+    { key: "second", line: unchangedThreadLine("left", lines), shown: "open" },
+  ];
+
+  const rows = threadRows(differences, threads);
+
+  expect(places(rows)).toEqual([
+    { place: { left: 8, right: 10 }, keys: { left: ["on-left", "second"], right: ["on-right"] } },
+  ]);
+  expect(rows[0]?.unchanged).toBe(true);
+});
+
+test("rows at one place keep their order by the other column's place", async () => {
+  const differences = await differencesOf([
+    { left: { start: 3, len: 0 }, right: { start: 3, len: 3 } },
+  ]);
+  const threads: ShownThread[] = [
+    { key: "later", line: changedThreadLine("right", 5), shown: "open" },
+    { key: "earlier", line: changedThreadLine("right", 3), shown: "open" },
+  ];
+
+  expect(places(threadRows(differences, threads))).toEqual([
+    { place: { left: 3, right: 4 }, keys: { left: [], right: ["earlier"] } },
+    { place: { left: 3, right: 6 }, keys: { left: [], right: ["later"] } },
+  ]);
+});
+
+test("collapsed threads place no row, drafts do", async () => {
+  const differences = await differencesOf([]);
+  const threads: ShownThread[] = [
+    {
+      key: "collapsed",
+      line: unchangedThreadLine("left", { left: 0, right: 0 }),
+      shown: "collapsed",
+    },
+    { key: "draft", line: unchangedThreadLine("right", { left: 4, right: 4 }), shown: "draft" },
+  ];
+
+  expect(places(threadRows(differences, threads))).toEqual([
+    { place: { left: 5, right: 5 }, keys: { left: [], right: ["draft"] } },
+  ]);
+});
+
+test("a row's height is the larger column's sum", () => {
+  const heights: Readonly<Record<string, number>> = { a: 30, b: 40, c: 50 };
+  const row = {
+    key: "1:1",
+    place: { left: 1, right: 1 },
+    keys: { left: ["a", "b"], right: ["c"] },
+    unchanged: true,
+  };
+
+  expect(rowHeight(row, (key) => heights[key] ?? 0)).toBe(70);
+});
diff --git a/frontend/src/editor/internal/threadRows.ts b/frontend/src/editor/internal/threadRows.ts
new file mode 100644
index 0000000..1b88337
--- /dev/null
+++ b/frontend/src/editor/internal/threadRows.ts
@@ -0,0 +1,73 @@
+import { shownColumn, type Column, type Difference, type ThreadLine } from "../../ipc";
+import { linePlace } from "./threadAnchor";
+
+export type ShownThread = {
+  readonly key: string;
+  readonly line: ThreadLine;
+  readonly shown: "open" | "collapsed" | "draft";
+};
+
+type ThreadPlace = Readonly<Record<Column, number>>;
+
+export type ThreadRow = {
+  readonly key: string;
+  readonly place: ThreadPlace;
+  readonly keys: Readonly<Record<Column, readonly string[]>>;
+  readonly unchanged: boolean;
+};
+
+type GrowingRow = Omit<ThreadRow, "keys"> & { readonly keys: Record<Column, string[]> };
+
+function gapAfter(differences: readonly Difference[], column: Column, line: number): number {
+  const place = linePlace(differences, column, line);
+  if (place.kind === "between") {
+    return place.partner + 1;
+  }
+  const other = column === "left" ? place.difference.right : place.difference.left;
+  return other.start + other.len;
+}
+
+function placeOf(differences: readonly Difference[], line: ThreadLine): ThreadPlace {
+  switch (line.kind) {
+    case "removed":
+      return { left: line.left + 1, right: gapAfter(differences, "left", line.left) };
+    case "added":
+      return { left: gapAfter(differences, "right", line.right), right: line.right + 1 };
+    case "unchangedOnLeft":
+    case "unchangedOnRight":
+      return { left: line.left + 1, right: line.right + 1 };
+    default: {
+      const _exhaustive: never = line;
+      return _exhaustive;
+    }
+  }
+}
+
+export function threadRows(
+  differences: readonly Difference[],
+  shown: readonly ShownThread[],
+): ThreadRow[] {
+  const rows = new Map<string, GrowingRow>();
+  for (const thread of shown) {
+    if (thread.shown === "collapsed") {
+      continue;
+    }
+    const place = placeOf(differences, thread.line);
+    const key = `${place.left}:${place.right}`;
+    const unchanged =
+      thread.line.kind === "unchangedOnLeft" || thread.line.kind === "unchangedOnRight";
+    const row = rows.get(key) ?? { key, place, keys: { left: [], right: [] }, unchanged };
+    row.keys[shownColumn(thread.line)].push(thread.key);
+    rows.set(key, row);
+  }
+  return [...rows.values()].sort(({ place: a }, { place: b }) =>
+    a.left === b.left ? a.right - b.right : a.left - b.left,
+  );
+}
+
+export function rowHeight(row: ThreadRow, heightOf: (key: string) => number): number {
+  function summed(keys: readonly string[]): number {
+    return keys.reduce((total, key) => total + heightOf(key), 0);
+  }
+  return Math.max(summed(row.keys.left), summed(row.keys.right));
+}
