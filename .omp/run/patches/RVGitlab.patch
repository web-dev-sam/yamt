+
+    let by_branch = check_gitlab(&range_of(&repo, "main...feature"), Some(&fake.glab));
+    let by_remote = check_gitlab(&range_of(&repo, "main...origin/feature"), Some(&fake.glab));
+
+    let lined_up = GitLabCheck::LinedUp {
