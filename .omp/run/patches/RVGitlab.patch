+            [
+                "api",
+                "--paginate",
+                "projects/7/merge_requests/12/draft_notes"
+            ]
+        );
+        assert_eq!(
+            merge_requests_of_commit("abc"),
+            [
+                "api",
+                "projects/:fullpath/repository/commits/abc/merge_requests"
+            ]
+        );
+    }
+}
