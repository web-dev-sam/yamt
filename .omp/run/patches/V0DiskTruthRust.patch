diff --git a/crates/session/src/start.rs b/crates/session/src/start.rs
new file mode 100644
index 0000000..a2934cf
--- /dev/null
+++ b/crates/session/src/start.rs
@@ -0,0 +1,316 @@
+use std::fs;
+use std::io;
+use std::os::unix::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+use yamt_gitio::{
+    AttributeValue, BlobReader, GitVersion, MergeAttributes, MergeFileOptions, MergeInputs, Oid,
+    Repo, StageEntry,
+};
+
+use crate::Result;
+use crate::decode::is_binary;
+use crate::disk::OnDisk;
+use crate::markers::{DEFAULT_MARKER_SIZE, views};
+use crate::session::LOG_TARGET;
+use crate::sides::{SUBMODULE_MODE, SYMLINK_MODE};
+use crate::stages::CapturedStages;
+
+// merge-ort merges with histogram (merge-ort.c `DIFF_WITH_ALG(opt, HISTOGRAM_DIFF)`); `git merge-file`
+// has `--diff-algorithm` since 2.44 (git-merge-file(1)).
+const HISTOGRAM_SINCE: GitVersion = GitVersion {
+    major: 2,
+    minor: 44,
+};
+const SCRATCH_ATTEMPTS: u32 = 1000;
+
+/// The gitattributes that decide what git wrote to a conflicted path.
+pub(crate) struct Attributes {
+    pub(crate) marker_size: usize,
+    pub(crate) driver: MergeDriver,
+    /// `working-tree-encoding` is set: the worktree bytes are not the blob's encoding.
+    pub(crate) encoded: bool,
+}
+
+/// The `merge` attribute (gitattributes(5) "Built-in merge drivers").
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum MergeDriver {
+    Text,
+    Union,
+    /// `-merge` or `merge=binary`: git keeps ours.
+    Binary,
+    /// Any other driver: what it wrote cannot be known.
+    Custom,
+}
+
+/// One conflicted path as `open()` found it, before its stages are decoded.
+pub(crate) struct StartFile<'a> {
+    pub(crate) path: &'a Path,
+    pub(crate) stages: &'a CapturedStages,
+    /// base, local and remote bytes of a regular file with at least one side.
+    pub(crate) sides: Option<&'a [Vec<u8>; 3]>,
+    pub(crate) attributes: &'a Attributes,
+    pub(crate) disk: &'a OnDisk,
+}
+
+/// The result of comparing one path with what git wrote; `BlobOf` is decided in one batch.
+pub(crate) enum StartLook {
+    Untouched,
+    Changed,
+    /// Untouched when the worktree file, cleaned by git, hashes to this blob.
+    BlobOf(Oid),
+}
+
+enum GitWrote<'a> {
+    Merged {
+        sides: &'a [Vec<u8>; 3],
+        union: bool,
+    },
+    Stage(&'a StageEntry),
+    Nothing,
+    Unknown,
+    NotWritten,
+}
+
+/// The start-up comparison of every conflicted path with what git wrote to it.
+pub(crate) struct StartCheck<'r> {
+    repo: &'r Repo,
+    scratch: Option<ScratchDir>,
+    histogram: Option<bool>,
+    merge_file_runs: u32,
+    started: Instant,
+}
+
+/// A directory under the system temp directory, removed when dropped.
+struct ScratchDir(PathBuf);
+
+impl Attributes {
+    pub(crate) fn from_git(found: &MergeAttributes) -> Attributes {
+        let marker_size = match &found.conflict_marker_size {
+            AttributeValue::Value(value) => std::str::from_utf8(value)
+                .ok()
+                .and_then(|text| text.parse().ok())
+                .filter(|&size| size > 0)
+                .unwrap_or(DEFAULT_MARKER_SIZE),
+            AttributeValue::Unspecified | AttributeValue::Unset | AttributeValue::Set => {
+                DEFAULT_MARKER_SIZE
+            }
+        };
+        let driver = match &found.merge {
+            AttributeValue::Unspecified | AttributeValue::Set => MergeDriver::Text,
+            AttributeValue::Unset => MergeDriver::Binary,
+            AttributeValue::Value(name) => match name.as_slice() {
+                b"text" => MergeDriver::Text,
+                b"union" => MergeDriver::Union,
+                b"binary" => MergeDriver::Binary,
+                _ => MergeDriver::Custom,
+            },
+        };
+        let encoded = match &found.working_tree_encoding {
+            AttributeValue::Value(_) => true,
+            AttributeValue::Unspecified | AttributeValue::Unset | AttributeValue::Set => false,
+        };
+        Attributes {
+            marker_size,
+            driver,
+            encoded,
+        }
+    }
+}
+
+fn git_wrote<'a>(file: &StartFile<'a>) -> GitWrote<'a> {
+    if file.attributes.encoded || file.stages.has_mode(SUBMODULE_MODE) {
+        return GitWrote::NotWritten;
+    }
+    let local = match (&file.stages.local, &file.stages.remote) {
+        (None, None) => return GitWrote::Nothing,
+        // merge-ort.c, modify/delete: "Version %s of %s left in tree" — the kept side.
+        (Some(kept), None) | (None, Some(kept)) => return GitWrote::Stage(kept),
+        (Some(local), Some(_)) => local,
+    };
+    // merge-ort.c `handle_content_merge`: two symlinks keep ours; merge-ll.c `ll_binary_merge`:
+    // "For the final merge, it is 'ours' by default", also when any version is binary.
+    if file.stages.has_mode(SYMLINK_MODE) {
+        return GitWrote::Stage(local);
+    }
+    let union = match file.attributes.driver {
+        MergeDriver::Custom => return GitWrote::Unknown,
+        MergeDriver::Binary => return GitWrote::Stage(local),
+        MergeDriver::Text => false,
+        MergeDriver::Union => true,
+    };
+    match file.sides {
+        Some(sides) if !sides.iter().any(|side| is_binary(side)) => {
+            GitWrote::Merged { sides, union }
+        }
+        Some(_) | None => GitWrote::Stage(local),
+    }
+}
+
+impl<'r> StartCheck<'r> {
+    pub(crate) fn new(repo: &'r Repo) -> StartCheck<'r> {
+        StartCheck {
+            repo,
+            scratch: None,
+            histogram: None,
+            merge_file_runs: 0,
+            started: Instant::now(),
+        }
+    }
+
+    pub(crate) fn look(&mut self, file: &StartFile, blobs: &mut BlobReader) -> Result<StartLook> {
+        let look = match git_wrote(file) {
+            GitWrote::NotWritten => StartLook::Untouched,
+            GitWrote::Nothing if *file.disk == OnDisk::Missing => StartLook::Untouched,
+            GitWrote::Unknown | GitWrote::Nothing => StartLook::Changed,
+            GitWrote::Merged { sides, union } => self.compare_merged(file, sides, union),
+            GitWrote::Stage(entry) => compare_stage(file, entry, blobs)?,
+        };
+        Ok(look)
+    }
+
+    fn compare_merged(&mut self, file: &StartFile, sides: &[Vec<u8>; 3], union: bool) -> StartLook {
+        let OnDisk::File(disk) = file.disk else {
+            return StartLook::Changed;
+        };
+        let marker_size = file.attributes.marker_size;
+        match self.merged(sides, marker_size, union) {
+            Ok(output) if views(disk, marker_size) == views(&output, marker_size) => {
+                StartLook::Untouched
+            }
+            Ok(_) => StartLook::Changed,
+            Err(error) => {
+                let path = file.path.to_string_lossy();
+                tracing::warn!(target: LOG_TARGET, event = "start_merge_file_failed", %path, %error, "the file counts as untouched");
+                StartLook::Untouched
+            }
+        }
+    }
+
+    fn merged(
+        &mut self,
+        sides: &[Vec<u8>; 3],
+        marker_size: usize,
+        union: bool,
+    ) -> std::result::Result<Vec<u8>, String> {
+        let histogram = self.histogram()?;
+        let scratch = match self.scratch.take() {
+            Some(scratch) => scratch,
+            None => ScratchDir::create().map_err(|error| error.to_string())?,
+        };
+        let [base, local, remote] = sides;
+        let inputs = MergeInputs {
+            base,
+            local,
+            remote,
+        };
+        let options = MergeFileOptions {
+            marker_size,
+            union,
+            histogram,
+        };
+        self.merge_file_runs += 1;
+        let merged = self.repo.merge_file(&scratch.0, &inputs, &options);
+        self.scratch = Some(scratch);
+        merged.map_err(|error| error.to_string())
+    }
+
+    fn histogram(&mut self) -> std::result::Result<bool, String> {
+        if let Some(histogram) = self.histogram {
+            return Ok(histogram);
+        }
+        let version = self.repo.version().map_err(|error| error.to_string())?;
+        let histogram = version >= HISTOGRAM_SINCE;
+        self.histogram = Some(histogram);
+        Ok(histogram)
+    }
+
+    /// Whether each path is untouched, in the order of `looks`.
+    pub(crate) fn untouched(self, looks: &[(&Path, StartLook)]) -> Vec<bool> {
+        let mut hashed_paths = Vec::new();
+        for (path, look) in looks {
+            match look {
+                StartLook::BlobOf(_) => hashed_paths.push(*path),
+                StartLook::Untouched | StartLook::Changed => {}
+            }
+        }
+        let hashes = match self.repo.hash_objects(&hashed_paths) {
+            Ok(hashes) => Some(hashes),
+            Err(error) => {
+                tracing::warn!(target: LOG_TARGET, event = "start_hash_failed", %error, "files git wrote one stage to count as untouched");
+                None
+            }
+        };
+        let mut hashes = hashes.map(Vec::into_iter);
+        let mut untouched = Vec::with_capacity(looks.len());
+        for (_, look) in looks {
+            untouched.push(match look {
+                StartLook::Untouched => true,
+                StartLook::Changed => false,
+                StartLook::BlobOf(expected) => match &mut hashes {
+                    Some(hashes) => hashes.next().is_some_and(|hash| hash == *expected),
+                    None => true,
+                },
+            });
+        }
+        let elapsed_ms = self.started.elapsed().as_millis();
+        tracing::debug!(target: LOG_TARGET, event = "start_checked", merge_file_runs = self.merge_file_runs, hashed = hashed_paths.len(), elapsed_ms, "compared the worktree with what git wrote");
+        untouched
+    }
+}
+
+fn compare_stage(
+    file: &StartFile,
+    entry: &StageEntry,
+    blobs: &mut BlobReader,
+) -> Result<StartLook> {
+    let is_link = entry.mode == SYMLINK_MODE;
+    let look = match file.disk {
+        OnDisk::Link(target) if is_link => same(&blobs.read(&entry.oid)?, target),
+        // git-hash-object(1) `--stdin-paths` reads one path per line.
+        OnDisk::File(bytes) if !is_link && file.path.as_os_str().as_bytes().contains(&b'\n') => {
+            same(&blobs.read(&entry.oid)?, bytes)
+        }
+        OnDisk::File(_) if !is_link => StartLook::BlobOf(entry.oid.clone()),
+        OnDisk::Missing
+        | OnDisk::File(_)
+        | OnDisk::Link(_)
+        | OnDisk::Submodule(_)
+        | OnDisk::Other => StartLook::Changed,
+    };
+    Ok(look)
+}
+
+fn same(expected: &[u8], found: &[u8]) -> StartLook {
+    if expected == found {
+        StartLook::Untouched
+    } else {
+        StartLook::Changed
+    }
+}
+
+impl ScratchDir {
+    fn create() -> io::Result<ScratchDir> {
+        let temp = std::env::temp_dir();
+        let process = std::process::id();
+        for attempt in 0..SCRATCH_ATTEMPTS {
+            let dir = temp.join(format!("yamt-merge-file-{process}-{attempt}"));
+            match fs::create_dir(&dir) {
+                Ok(()) => return Ok(ScratchDir(dir)),
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+                Err(error) => return Err(error),
+            }
+        }
+        Err(io::Error::from(io::ErrorKind::AlreadyExists))
+    }
+}
+
+impl Drop for ScratchDir {
+    fn drop(&mut self) {
+        if let Err(error) = fs::remove_dir_all(&self.0) {
+            let dir = self.0.display();
+            tracing::warn!(target: LOG_TARGET, event = "scratch_not_removed", %dir, %error, "temporary merge inputs were left behind");
+        }
+    }
+}
diff --git a/crates/session/src/writes.rs b/crates/session/src/writes.rs
new file mode 100644
index 0000000..23462f8
--- /dev/null
+++ b/crates/session/src/writes.rs
@@ -0,0 +1,199 @@
+use std::fs;
+use std::io;
+use std::path::Path;
+
+use yamt_gitio::{Repo, StageEntry};
+
+use crate::disk::{DiskChange, DiskVersion, OnDisk, Seen};
+use crate::session::{
+    FileState, FileStatus, LOG_TARGET, MergeSession, Settled, WriteReply, find_file,
+};
+use crate::sides::{SUBMODULE_MODE, Side};
+use crate::{Error, Result};
+
+enum IndexBefore {
+    Conflicted,
+    Resolved(Vec<u8>),
+}
+
+impl MergeSession {
+    /// Writes `result` and stages it, unless the file changed on disk or since `disk_version`.
+    pub fn finish(
+        &mut self,
+        path: &str,
+        result: &str,
+        disk_version: DiskVersion,
+    ) -> Result<WriteReply> {
+        find_file(&mut self.files, path)?.require_text()?;
+        if let Some(change) = self.changed_on_disk(path, disk_version)? {
+            return Ok(self.changed_reply(change));
+        }
+        let file = find_file(&mut self.files, path)?;
+        let worktree_file = self.repo.root().join(&file.path);
+        let before = worktree_bytes(&worktree_file, path)?;
+        write_worktree_file(&worktree_file, path, result.as_bytes())?;
+        if let Err(error) = self.repo.add_paths(&[file.path.as_path()]) {
+            let rollback = match before {
+                Some(bytes) => write_worktree_file(&worktree_file, path, &bytes),
+                None => remove_worktree_file(&worktree_file, path),
+            };
+            if let Err(rollback_error) = rollback {
+                warn_rollback_failed("finish_rollback_failed", path, &rollback_error);
+            }
+            return Err(error.into());
+        }
+        file.status = FileStatus::Resolved;
+        let read_back = file.read_disk(&self.repo)?;
+        file.seen = match &file.seen {
+            Seen::Disk(_) => Seen::Disk(read_back),
+            Seen::Stages(_) | Seen::GitOutput => Seen::Stages(read_back),
+        };
+        Ok(self.written_reply())
+    }
+
+    /// Resolves the file with one side, unless it changed on disk or since `disk_version`.
+    pub fn take(
+        &mut self,
+        path: &str,
+        side: Side,
+        disk_version: DiskVersion,
+    ) -> Result<WriteReply> {
+        if let Some(change) = self.changed_on_disk(path, disk_version)? {
+            return Ok(self.changed_reply(change));
+        }
+        let file = find_file(&mut self.files, path)?;
+        let index_before = match file.status {
+            FileStatus::Unresolved => IndexBefore::Conflicted,
+            FileStatus::Resolved => IndexBefore::Resolved(self.repo.index_records(&file.path)?),
+        };
+        let chosen = file.stages.side(side);
+        match chosen {
+            Some(entry) => self.repo.resolve_with(entry)?,
+            None => self.repo.remove_paths(&[file.path.as_path()])?,
+        }
+        if let Err(error) = write_chosen_side(&self.repo, file, chosen) {
+            if let Err(restore_error) = restore_index(&self.repo, file, index_before) {
+                warn_rollback_failed("take_restore_failed", path, &restore_error);
+                // A failed `update-index` leaves the index as it was: git replaces it only by
+                // renaming `index.lock` over it (git lockfile.h), so the chosen side is still staged.
+                file.status = FileStatus::Resolved;
+            }
+            return Err(error);
+        }
+        file.status = FileStatus::Resolved;
+        file.seen = Seen::Stages(file.read_disk(&self.repo)?);
+        Ok(self.written_reply())
+    }
+
+    /// Puts the captured stages back (and the markers, where git can), unless the file changed on
+    /// disk or since `disk_version`.
+    pub fn reset(&mut self, path: &str, disk_version: DiskVersion) -> Result<WriteReply> {
+        if let Some(change) = self.changed_on_disk(path, disk_version)? {
+            return Ok(self.changed_reply(change));
+        }
+        let file = find_file(&mut self.files, path)?;
+        self.repo.restore_stages(&file.stages.entries())?;
+        file.status = FileStatus::Unresolved;
+        if file.stages.can_rebuild_markers() {
+            self.repo.checkout_merge(&file.path)?;
+        }
+        file.seen = Seen::Stages(file.read_disk(&self.repo)?);
+        Ok(self.written_reply())
+    }
+
+    /// The change that stops a write to `path`: one settled after the window's `disk_version`,
+    /// or one found now, which is settled before returning.
+    fn changed_on_disk(
+        &mut self,
+        path: &str,
+        disk_version: DiskVersion,
+    ) -> Result<Option<DiskChange>> {
+        let file = find_file(&mut self.files, path)?;
+        if let Some(Settled { version, result }) = &file.settled
+            && *version != disk_version
+        {
+            return Ok(Some(DiskChange {
+                path: file.display_path(),
+                result: result.clone(),
+            }));
+        }
+        let Some(disk) = file.look(&self.repo)? else {
+            return Ok(None);
+        };
+        let mut disk = Some(disk);
+        let looked: Vec<Option<OnDisk>> = self
+            .files
+            .iter()
+            .map(|other| {
+                if other.path.to_string_lossy() == path {
+                    disk.take()
+                } else {
+                    None
+                }
+            })
+            .collect();
+        let change = self.settle(looked).pop();
+        self.refresh_statuses()?;
+        Ok(change)
+    }
+
+    fn changed_reply(&self, change: DiskChange) -> WriteReply {
+        WriteReply::ChangedOnDisk {
+            files: self.files(),
+            change,
+        }
+    }
+
+    fn written_reply(&self) -> WriteReply {
+        WriteReply::Written {
+            files: self.files(),
+        }
+    }
+}
+
+fn write_chosen_side(repo: &Repo, file: &FileState, chosen: Option<&StageEntry>) -> Result<()> {
+    match chosen {
+        Some(entry) if entry.mode == SUBMODULE_MODE => Ok(()),
+        Some(_) => Ok(repo.checkout_from_index(&file.path)?),
+        None if file.stages.has_mode(SUBMODULE_MODE) => Ok(()),
+        None => remove_worktree_file(&repo.root().join(&file.path), &file.display_path()),
+    }
+}
+
+fn restore_index(repo: &Repo, file: &FileState, before: IndexBefore) -> Result<()> {
+    match before {
+        IndexBefore::Conflicted => Ok(repo.restore_stages(&file.stages.entries())?),
+        IndexBefore::Resolved(records) => Ok(repo.restore_index_records(&file.path, records)?),
+    }
+}
+
+fn warn_rollback_failed(event: &str, path: &str, error: &Error) {
+    tracing::warn!(target: LOG_TARGET, event, path, %error, "rollback failed");
+}
+
+fn worktree_bytes(worktree_file: &Path, path: &str) -> Result<Option<Vec<u8>>> {
+    match fs::read(worktree_file) {
+        Ok(bytes) => Ok(Some(bytes)),
+        Err(source) if source.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(source) => Err(write_failed(path, source)),
+    }
+}
+
+fn write_worktree_file(worktree_file: &Path, path: &str, bytes: &[u8]) -> Result<()> {
+    fs::write(worktree_file, bytes).map_err(|source| write_failed(path, source))
+}
+
+fn remove_worktree_file(worktree_file: &Path, path: &str) -> Result<()> {
+    match fs::remove_file(worktree_file) {
+        Ok(()) => Ok(()),
+        Err(source) if source.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(source) => Err(write_failed(path, source)),
+    }
+}
+
+fn write_failed(path: &str, source: io::Error) -> Error {
+    Error::WriteFailed {
+        path: path.to_owned(),
+        source,
+    }
+}
