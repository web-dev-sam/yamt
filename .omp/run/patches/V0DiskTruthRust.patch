--- /dev/null
+++ b/crates/session/src/markers.rs
@@ -0,0 +1,355 @@
+use std::ops::Range;
+
+pub(crate) const DEFAULT_MARKER_SIZE: usize = 7;
+
+/// A stretch of a worktree file, as line indexes into `split_lines` of its bytes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Piece {
+    Settled(Range<usize>),
+    Block(Block),
+    Raw(Range<usize>),
+}
+
+/// An open conflict: its lines from `<<<<<<<` to `>>>>>>>`, and the lines of each side's section.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Block {
+    pub(crate) whole: Range<usize>,
+    pub(crate) ours: Range<usize>,
+    pub(crate) theirs: Range<usize>,
+}
+
+/// The file as each side would read it: settled lines, raw regions as they are, and each block's
+/// section of that side; marker lines, labels and base sections dropped, `\r\n` read as `\n`.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct Views {
+    pub(crate) ours: Vec<u8>,
+    pub(crate) theirs: Vec<u8>,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Marker {
+    Open,
+    Base,
+    Separator,
+    Close,
+}
+
+enum InBlock {
+    Ours { from: usize },
+    Base { ours: Range<usize> },
+    Theirs { ours: Range<usize>, from: usize },
+}
+
+pub(crate) fn split_lines(text: &[u8]) -> Vec<&[u8]> {
+    text.split_inclusive(|&byte| byte == b'\n').collect()
+}
+
+pub(crate) fn open_regions(pieces: &[Piece]) -> u32 {
+    let open = pieces.iter().filter(|piece| match piece {
+        Piece::Settled(_) => false,
+        Piece::Block(_) | Piece::Raw(_) => true,
+    });
+    u32::try_from(open.count()).unwrap_or(u32::MAX)
+}
+
+pub(crate) fn parse(lines: &[&[u8]], marker_size: usize) -> Vec<Piece> {
+    let mut pieces = Vec::new();
+    let mut settled_from = 0;
+    let mut at = 0;
+    while let Some(line) = lines.get(at) {
+        let found = match marker(line, marker_size) {
+            Some(Marker::Open) => Some(read_block(lines, at, marker_size)),
+            Some(Marker::Close) => Some(Piece::Raw(at..at + 1)),
+            Some(Marker::Base | Marker::Separator) | None => None,
+        };
+        let Some(piece) = found else {
+            at += 1;
+            continue;
+        };
+        if settled_from < at {
+            pieces.push(Piece::Settled(settled_from..at));
+        }
+        at = piece_end(&piece);
+        settled_from = at;
+        pieces.push(piece);
+    }
+    if settled_from < lines.len() {
+        pieces.push(Piece::Settled(settled_from..lines.len()));
+    }
+    pieces
+}
+
+fn piece_end(piece: &Piece) -> usize {
+    match piece {
+        Piece::Settled(lines) | Piece::Raw(lines) => lines.end,
+        Piece::Block(block) => block.whole.end,
+    }
+}
+
+fn read_block(lines: &[&[u8]], start: usize, marker_size: usize) -> Piece {
+    let mut state = InBlock::Ours { from: start + 1 };
+    for (at, line) in lines.iter().enumerate().skip(start + 1) {
+        let Some(found) = marker(line, marker_size) else {
+            continue;
+        };
+        state = match (state, found) {
+            (InBlock::Ours { from }, Marker::Base) => InBlock::Base { ours: from..at },
+            (InBlock::Ours { from }, Marker::Separator) => InBlock::Theirs {
+                ours: from..at,
+                from: at + 1,
+            },
+            (InBlock::Base { ours }, Marker::Separator) => InBlock::Theirs { ours, from: at + 1 },
+            (InBlock::Theirs { ours, from }, Marker::Close) => {
+                return Piece::Block(Block {
+                    whole: start..at + 1,
+                    ours,
+                    theirs: from..at,
+                });
+            }
+            (InBlock::Ours { .. } | InBlock::Base { .. }, Marker::Close) => {
+                return Piece::Raw(start..at + 1);
+            }
+            (_, Marker::Open | Marker::Base | Marker::Separator) => {
+                return Piece::Raw(start..raw_end(lines, at + 1, marker_size));
+            }
+        };
+    }
+    Piece::Raw(start..lines.len())
+}
+
+fn raw_end(lines: &[&[u8]], from: usize, marker_size: usize) -> usize {
+    for (at, line) in lines.iter().enumerate().skip(from) {
+        match marker(line, marker_size) {
+            Some(Marker::Close) => return at + 1,
+            Some(Marker::Open) => return at,
+            Some(Marker::Base | Marker::Separator) | None => {}
+        }
+    }
+    lines.len()
+}
+
+// git rerere.c `is_cmarker`: exactly `marker_size` copies of the marker character, then a space,
+// or the end of the line.
+fn marker(line: &[u8], marker_size: usize) -> Option<Marker> {
+    let first = *line.first()?;
+    let kind = match first {
+        b'<' => Marker::Open,
+        b'|' => Marker::Base,
+        b'=' => Marker::Separator,
+        b'>' => Marker::Close,
+        _ => return None,
+    };
+    let run = line.get(..marker_size)?;
+    if run.iter().any(|&byte| byte != first) {
+        return None;
+    }
+    match line.get(marker_size) {
+        None | Some(b' ' | b'\r' | b'\n') => Some(kind),
+        Some(_) => None,
+    }
+}
+
+pub(crate) fn views(text: &[u8], marker_size: usize) -> Views {
+    let lines = split_lines(text);
+    let mut views = Views {
+        ours: Vec::with_capacity(text.len()),
+        theirs: Vec::with_capacity(text.len()),
+    };
+    for piece in parse(&lines, marker_size) {
+        let (ours, theirs) = match &piece {
+            Piece::Settled(both) | Piece::Raw(both) => (both, both),
+            Piece::Block(block) => (&block.ours, &block.theirs),
+        };
+        push_without_cr(&mut views.ours, &lines, ours);
+        push_without_cr(&mut views.theirs, &lines, theirs);
+    }
+    views
+}
+
+fn push_without_cr(view: &mut Vec<u8>, lines: &[&[u8]], range: &Range<usize>) {
+    for line in lines.get(range.clone()).unwrap_or_default() {
+        match line.strip_suffix(b"\r\n") {
+            Some(content) => {
+                view.extend_from_slice(content);
+                view.push(b'\n');
+            }
+            None => view.extend_from_slice(line),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MERGE: &[u8] = include_bytes!("../tests/markers/style-merge.txt");
+    const DIFF3: &[u8] = include_bytes!("../tests/markers/style-diff3.txt");
+    const ZDIFF3: &[u8] = include_bytes!("../tests/markers/style-zdiff3.txt");
+    const SIZE_12: &[u8] = include_bytes!("../tests/markers/marker-size-12.txt");
+    const CRLF: &[u8] = include_bytes!("../tests/markers/crlf.txt");
+    const SIZE_12_MARKERS: usize = 12;
+
+    fn parsed(text: &[u8]) -> Vec<Piece> {
+        parse(&split_lines(text), DEFAULT_MARKER_SIZE)
+    }
+
+    fn section_texts(text: &[u8], marker_size: usize) -> Vec<(String, String)> {
+        let lines = split_lines(text);
+        let joined =
+            |range: &Range<usize>| String::from_utf8(lines[range.clone()].concat()).unwrap();
+        let blocks = parse(&lines, marker_size)
+            .into_iter()
+            .filter_map(|piece| match piece {
+                Piece::Block(block) => Some((joined(&block.ours), joined(&block.theirs))),
+                Piece::Settled(_) | Piece::Raw(_) => None,
+            });
+        blocks.collect()
+    }
+
+    #[test]
+    fn the_three_styles_parse_to_two_blocks_with_the_same_sections_around_the_settled_separator() {
+        let first = (
+            "one\nTWO\nshared-a\nthree-ours\n".to_owned(),
+            "ONE\ntwo\nshared-a\nthree-theirs\n".to_owned(),
+        );
+        let second = ("eight-ours\n".to_owned(), "eight-theirs\n".to_owned());
+        assert_eq!(
+            section_texts(MERGE, DEFAULT_MARKER_SIZE),
+            [first.clone(), second.clone()]
+        );
+        assert_eq!(
+            section_texts(ZDIFF3, DEFAULT_MARKER_SIZE),
+            [first, second.clone()]
+        );
+        let diff3_first = (
+            "one\nTWO\nshared-a\nthree-ours\nshared-b\n".to_owned(),
+            "ONE\ntwo\nshared-a\nthree-theirs\nshared-b\n".to_owned(),
+        );
+        assert_eq!(
+            section_texts(DIFF3, DEFAULT_MARKER_SIZE),
+            [diff3_first, second]
+        );
+        let zdiff3 = parsed(ZDIFF3);
+        assert_eq!(zdiff3[0], Piece::Settled(0..2));
+        assert_eq!(
+            zdiff3[1],
+            Piece::Block(Block {
+                whole: 2..17,
+                ours: 3..7,
+                theirs: 12..16
+            })
+        );
+        assert_eq!(open_regions(&zdiff3), 2);
+    }
+
+    #[test]
+    fn marker_size_twelve_parses_with_twelve_and_is_all_text_with_seven() {
+        assert_eq!(
+            section_texts(SIZE_12, SIZE_12_MARKERS),
+            section_texts(ZDIFF3, DEFAULT_MARKER_SIZE)
+        );
+        let lines = split_lines(SIZE_12).len();
+        assert_eq!(
+            parse(&split_lines(SIZE_12), DEFAULT_MARKER_SIZE),
+            [Piece::Settled(0..lines)]
+        );
+    }
+
+    #[test]
+    fn crlf_markers_parse_like_lf_ones() {
+        let crlf = parse(&split_lines(CRLF), DEFAULT_MARKER_SIZE);
+        assert_eq!(crlf, parsed(ZDIFF3));
+    }
+
+    #[test]
+    fn a_deleted_separator_or_a_close_before_it_makes_the_block_raw_to_its_close() {
+        let text = b"a\n<<<<<<< ours\nx\n||||||| base\nb\n>>>>>>> theirs\nz\n";
+        assert_eq!(
+            parsed(text),
+            [Piece::Settled(0..1), Piece::Raw(1..6), Piece::Settled(6..7)]
+        );
+        let no_base = b"<<<<<<< ours\nx\ny\n>>>>>>> theirs\n";
+        assert_eq!(parsed(no_base), [Piece::Raw(0..4)]);
+    }
+
+    #[test]
+    fn a_nested_open_makes_the_block_raw_to_the_next_close() {
+        let text = b"<<<<<<< a\nx\n<<<<<<< b\ny\n=======\nz\n>>>>>>> b\nafter\n";
+        assert_eq!(parsed(text), [Piece::Raw(0..7), Piece::Settled(7..8)]);
+        let open_again =
+            b"<<<<<<< a\nx\n=======\n=======\ny\n<<<<<<< b\nc\n=======\nd\n>>>>>>> b\n";
+        assert_eq!(
+            parsed(open_again),
+            [
+                Piece::Raw(0..5),
+                Piece::Block(Block {
+                    whole: 5..10,
+                    ours: 6..7,
+                    theirs: 8..9
+                })
+            ]
+        );
+    }
+
+    #[test]
+    fn a_stray_close_is_one_raw_line_and_an_open_without_close_is_raw_to_the_end() {
+        let stray = b"a\n>>>>>>> x\nb\n";
+        assert_eq!(
+            parsed(stray),
+            [Piece::Settled(0..1), Piece::Raw(1..2), Piece::Settled(2..3)]
+        );
+        let unclosed = b"a\n<<<<<<< ours\nx\n=======\ny\n";
+        assert_eq!(parsed(unclosed), [Piece::Settled(0..1), Piece::Raw(1..5)]);
+        assert_eq!(open_regions(&parsed(unclosed)), 1);
+    }
+
+    #[test]
+    fn separators_and_base_markers_outside_a_block_are_text() {
+        let text = b"=======\n||||||| x\ntext\n";
+        assert_eq!(parsed(text), [Piece::Settled(0..3)]);
+        assert_eq!(open_regions(&parsed(text)), 0);
+    }
+
+    #[test]
+    fn a_last_line_without_a_newline_closes_a_block_and_needs_no_label() {
+        let text = b"<<<<<<<\nx\n=======\ny\n>>>>>>>";
+        assert_eq!(
+            parsed(text),
+            [Piece::Block(Block {
+                whole: 0..5,
+                ours: 1..2,
+                theirs: 3..4
+            })]
+        );
+    }
+
+    #[test]
+    fn markers_two_longer_than_the_size_and_markers_followed_by_text_stay_text() {
+        let text = b"<<<<<<<<< inner\n=========\n>>>>>>>>> inner\n<<<<<<<x\n";
+        assert_eq!(parsed(text), [Piece::Settled(0..4)]);
+    }
+
+    #[test]
+    fn views_are_the_same_in_every_style_and_line_ending() {
+        let expected = views(MERGE, DEFAULT_MARKER_SIZE);
+        assert_eq!(views(ZDIFF3, DEFAULT_MARKER_SIZE), expected);
+        assert_eq!(views(DIFF3, DEFAULT_MARKER_SIZE), expected);
+        assert_eq!(views(CRLF, DEFAULT_MARKER_SIZE), expected);
+        assert_eq!(views(SIZE_12, SIZE_12_MARKERS), expected);
+        let ours = include_bytes!("../tests/markers/ours.txt");
+        assert_eq!(expected.ours, ours);
+    }
+
+    #[test]
+    fn views_keep_raw_regions_whole_in_both_sides() {
+        let text = b"a\r\n<<<<<<< ours\nx\n>>>>>>> theirs\n";
+        let expected = b"a\n<<<<<<< ours\nx\n>>>>>>> theirs\n".to_vec();
+        assert_eq!(
+            views(text, DEFAULT_MARKER_SIZE),
+            Views {
+                ours: expected.clone(),
+                theirs: expected
+            }
+        );
+    }
+}
diff --git a/crates/session/src/merge_data.rs b/crates/session/src/merge_data.rs
new file mode 100644
index 0000000..525a0b4
--- /dev/null
+++ b/crates/session/src/merge_data.rs
@@ -0,0 +1,156 @@
+use serde::Serialize;
+use specta::Type;
+use yamt_merge_core::{Chunk, LineRange, Options, WordChanges, compute_chunks, word_changes};
+
+use crate::decode::{Eol, MAX_TEXT_BYTES, detect_eol, is_binary};
+use crate::disk::{DiskVersion, OnDisk};
+use crate::seed::{Seeded, seed};
+use crate::sides::Side;
+
+/// 0-based line of the middle pane's starting text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Type)]
+pub struct MiddleLine(pub u32);
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct MergeChunk {
+    pub chunk: Chunk,
+    pub middle: LineRange<MiddleLine>,
+    pub words: WordChanges,
+}
+
+/// Why the file on disk cannot be shown as the middle text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+pub enum NotText {
+    Deleted,
+    Binary,
+    NonUtf8,
+    TooLarge,
+    Link,
+    Directory,
+}
+
+/// Where the middle pane starts: yamt's merge of the stages (base), or the file as found on disk.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind")]
+pub enum Middle {
+    Stages { text: String },
+    Disk { text: String },
+    DiskNotText { found: NotText },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct FileMergeData {
+    pub path: String,
+    pub middle: Middle,
+    pub local: String,
+    pub remote: String,
+    pub deleted: Option<Side>,
+    pub eol: Eol,
+    pub chunks: Vec<MergeChunk>,
+    pub disk_version: DiskVersion,
+}
+
+pub(crate) struct Texts {
+    pub(crate) base: String,
+    pub(crate) local: String,
+    pub(crate) remote: String,
+    pub(crate) deleted: Option<Side>,
+}
+
+#[must_use]
+pub fn merge_data(
+    path: &str,
+    base: &str,
+    local: &str,
+    remote: &str,
+    deleted: Option<Side>,
+    disk_version: DiskVersion,
+) -> FileMergeData {
+    let chunks = compute_chunks(base, local, remote, &Options::default());
+    let words = word_changes(base, local, remote, &chunks);
+    let mut merge_chunks = Vec::with_capacity(chunks.len());
+    for (chunk, words) in chunks.into_iter().zip(words) {
+        let middle = LineRange {
+            start: MiddleLine(chunk.base.start.0),
+            len: chunk.base.len,
+        };
+        merge_chunks.push(MergeChunk {
+            chunk,
+            middle,
+            words,
+        });
+    }
+    FileMergeData {
+        path: path.to_owned(),
+        middle: Middle::Stages {
+            text: base.to_owned(),
+        },
+        local: local.to_owned(),
+        remote: remote.to_owned(),
+        deleted,
+        eol: stages_eol(base, local, remote),
+        chunks: merge_chunks,
+        disk_version,
+    }
+}
+
+pub(crate) fn disk_merge_data(
+    path: &str,
+    texts: &Texts,
+    disk: &OnDisk,
+    marker_size: usize,
+    disk_version: DiskVersion,
+) -> FileMergeData {
+    let (middle, eol, chunks) = match seeded_from_disk(disk, marker_size, texts) {
+        Ok(seeded) => (
+            Middle::Disk {
+                text: seeded.middle,
+            },
+            seeded.eol,
+            seeded.chunks,
+        ),
+        Err(found) => (
+            Middle::DiskNotText { found },
+            stages_eol(&texts.base, &texts.local, &texts.remote),
+            Vec::new(),
+        ),
+    };
+    FileMergeData {
+        path: path.to_owned(),
+        middle,
+        local: texts.local.clone(),
+        remote: texts.remote.clone(),
+        deleted: texts.deleted,
+        eol,
+        chunks,
+        disk_version,
+    }
+}
+
+fn seeded_from_disk(disk: &OnDisk, marker_size: usize, texts: &Texts) -> Result<Seeded, NotText> {
+    let bytes = match disk {
+        OnDisk::File(bytes) => bytes,
+        OnDisk::Missing => return Err(NotText::Deleted),
+        OnDisk::Link(_) => return Err(NotText::Link),
+        OnDisk::Submodule(_) | OnDisk::Other => return Err(NotText::Directory),
+    };
+    Ok(seed(disk_text(bytes)?, marker_size, texts))
+}
+
+fn disk_text(bytes: &[u8]) -> Result<&str, NotText> {
+    if is_binary(bytes) {
+        return Err(NotText::Binary);
+    }
+    if bytes.len() > MAX_TEXT_BYTES {
+        return Err(NotText::TooLarge);
+    }
+    std::str::from_utf8(bytes).map_err(|_| NotText::NonUtf8)
+}
+
+fn stages_eol(base: &str, local: &str, remote: &str) -> Eol {
+    let eol_source = [base, local, remote]
+        .into_iter()
+        .find(|text| text.contains('\n'))
+        .unwrap_or_default();
+    detect_eol(eol_source)
+}
diff --git a/crates/session/src/open.rs b/crates/session/src/open.rs
new file mode 100644
index 0000000..54c79a5
--- /dev/null
+++ b/crates/session/src/open.rs
@@ -0,0 +1,184 @@
+use std::path::{Path, PathBuf};
+
+use yamt_gitio::{BlobReader, MergeAttributes, Repo, StageEntry};
+
+use crate::Result;
+use crate::decode::{UnsupportedReason, decode_sides};
+use crate::disk::{MarkerRule, Seen, read_on_disk};
+use crate::merge_data::Texts;
+use crate::remote_name::read_remote_name;
+use crate::session::{Content, FileState, FileStatus, MergeSession};
+use crate::sides::{SUBMODULE_MODE, SYMLINK_MODE, Side};
+use crate::stages::{CapturedStages, group_by_path};
+use crate::start::{Attributes, StartCheck, StartFile, StartLook};
+
+/// What the index holds for a path, with the blobs of a regular file read.
+enum Stored {
+    Submodule,
+    Symlink,
+    BothDeleted,
+    /// base, local and remote bytes; a deleted side holds base.
+    Regular {
+        deleted: Option<Side>,
+        sides: [Vec<u8>; 3],
+    },
+}
+
+impl MergeSession {
+    pub fn open(cwd: &Path) -> Result<MergeSession> {
+        let repo = Repo::discover(cwd)?;
+        let groups = group_by_path(repo.unmerged()?);
+        let paths: Vec<&Path> = groups.iter().map(|(path, _)| path.as_path()).collect();
+        let attributes = repo.attributes(&paths)?;
+        let files = open_files(&repo, groups, &attributes)?;
+        let remote_name = read_remote_name(&repo);
+        Ok(MergeSession {
+            repo,
+            files,
+            remote_name,
+        })
+    }
+}
+
+fn open_files(
+    repo: &Repo,
+    groups: Vec<(PathBuf, CapturedStages)>,
+    attributes: &[MergeAttributes],
+) -> Result<Vec<FileState>> {
+    let mut blobs = repo.blob_reader()?;
+    let mut check = StartCheck::new(repo);
+    let mut files = Vec::with_capacity(groups.len());
+    let mut looks = Vec::with_capacity(groups.len());
+    for ((path, stages), found) in groups.into_iter().zip(attributes) {
+        let (file, look) = open_file(repo, &mut blobs, &mut check, path, stages, found)?;
+        files.push(file);
+        looks.push(look);
+    }
+    let paths = files.iter().map(|file| file.path.as_path());
+    let looks: Vec<(&Path, StartLook)> = paths.zip(looks).collect();
+    let untouched = check.untouched(&looks);
+    for (file, untouched) in files.iter_mut().zip(untouched) {
+        if !untouched {
+            file.seen = Seen::GitOutput;
+        }
+    }
+    Ok(files)
+}
+
+fn open_file(
+    repo: &Repo,
+    blobs: &mut BlobReader,
+    check: &mut StartCheck,
+    path: PathBuf,
+    stages: CapturedStages,
+    found: &MergeAttributes,
+) -> Result<(FileState, StartLook)> {
+    let attributes = Attributes::from_git(found);
+    let stored = stored(blobs, &stages)?;
+    let disk = read_on_disk(repo, &path, stages.has_mode(SUBMODULE_MODE))?;
+    let sides = match &stored {
+        Stored::Regular { sides, .. } => Some(sides),
+        Stored::Submodule | Stored::Symlink | Stored::BothDeleted => None,
+    };
+    let start = StartFile {
+        path: &path,
+        stages: &stages,
+        sides,
+        attributes: &attributes,
+        disk: &disk,
+    };
+    let look = check.look(&start, blobs)?;
+    let content = content(&path, stored);
+    let file = FileState {
+        rule: marker_rule(&content, &attributes),
+        path,
+        stages,
+        status: FileStatus::Unresolved,
+        content,
+        marker_size: attributes.marker_size,
+        seen: Seen::Stages(disk),
+        settled: None,
+    };
+    Ok((file, look))
+}
+
+fn stored(blobs: &mut BlobReader, stages: &CapturedStages) -> Result<Stored> {
+    if stages.has_mode(SUBMODULE_MODE) {
+        return Ok(Stored::Submodule);
+    }
+    if stages.has_mode(SYMLINK_MODE) {
+        return Ok(Stored::Symlink);
+    }
+    let deleted = match (&stages.local, &stages.remote) {
+        (Some(_), Some(_)) => None,
+        (None, Some(_)) => Some(Side::Local),
+        (Some(_), None) => Some(Side::Remote),
+        (None, None) => return Ok(Stored::BothDeleted),
+    };
+    let base = stage_bytes(blobs, stages.base.as_ref(), b"")?;
+    let local = stage_bytes(blobs, stages.local.as_ref(), &base)?;
+    let remote = stage_bytes(blobs, stages.remote.as_ref(), &base)?;
+    Ok(Stored::Regular {
+        deleted,
+        sides: [base, local, remote],
+    })
+}
+
+fn stage_bytes(
+    blobs: &mut BlobReader,
+    entry: Option<&StageEntry>,
+    missing: &[u8],
+) -> Result<Vec<u8>> {
+    match entry {
+        Some(entry) => Ok(blobs.read(&entry.oid)?),
+        None => Ok(missing.to_vec()),
+    }
+}
+
+fn content(path: &Path, stored: Stored) -> Content {
+    if path.to_str().is_none() {
+        return Content::Unsupported(UnsupportedReason::NonUtf8);
+    }
+    let (deleted, sides) = match stored {
+        Stored::Submodule => return Content::Unsupported(UnsupportedReason::Submodule),
+        Stored::Symlink => return Content::Unsupported(UnsupportedReason::Symlink),
+        Stored::BothDeleted => return Content::Unsupported(UnsupportedReason::LocalDeleted),
+        Stored::Regular { deleted, sides } => (deleted, sides),
+    };
+    match decode_sides(sides) {
+        Ok([base, local, remote]) => Content::Text(Texts {
+            base,
+            local,
+            remote,
+            deleted,
+        }),
+        Err(reason) => Content::Unsupported(deleted_reason(deleted).unwrap_or(reason)),
+    }
+}
+
+fn deleted_reason(deleted: Option<Side>) -> Option<UnsupportedReason> {
+    deleted.map(|side| match side {
+        Side::Local => UnsupportedReason::LocalDeleted,
+        Side::Remote => UnsupportedReason::RemoteDeleted,
+    })
+}
+
+fn marker_rule(content: &Content, attributes: &Attributes) -> MarkerRule {
+    if attributes.encoded {
+        return MarkerRule::NeverStage;
+    }
+    match content {
+        Content::Text(texts) if texts.deleted.is_none() => MarkerRule::StageWithoutMarkers,
+        Content::Text(_) => MarkerRule::StageAny,
+        Content::Unsupported(reason) => match reason {
+            UnsupportedReason::NonUtf8 | UnsupportedReason::TooLarge => {
+                MarkerRule::StageWithoutMarkers
+            }
+            UnsupportedReason::Binary
+            | UnsupportedReason::LocalDeleted
+            | UnsupportedReason::RemoteDeleted
+            | UnsupportedReason::Symlink
+            | UnsupportedReason::Submodule => MarkerRule::StageAny,
+        },
+    }
+}
diff --git a/crates/session/src/seed.rs b/crates/session/src/seed.rs
new file mode 100644
index 0000000..42ccc7a
--- /dev/null
+++ b/crates/session/src/seed.rs
@@ -0,0 +1,393 @@
+use std::ops::Range;
+
+use yamt_merge_core::{
+    BaseLine, Chunk, ChunkId, ChunkKind, LineMap, LineRange, LocalLine, RemoteLine, line_map,
+    word_changes,
+};
+
+use crate::decode::{Eol, detect_eol};
+use crate::markers::{Block, Piece, parse, split_lines};
+use crate::merge_data::{MergeChunk, MiddleLine, Texts};
+
+/// The middle pane's starting text built from a worktree file, and its open conflicts.
+pub(crate) struct Seeded {
+    pub(crate) middle: String,
+    pub(crate) eol: Eol,
+    pub(crate) chunks: Vec<MergeChunk>,
+}
+
+/// One side's reading of the disk text with raw regions left out (`\r\n` read as `\n`), and the
+/// line where each piece starts in it.
+struct SideView {
+    text: String,
+    piece_starts: Vec<u32>,
+}
+
+/// Where an open block or raw region sits in local and remote; `exact` when every line of both
+/// sections was found unchanged.
+struct Located {
+    local: Range<u32>,
+    remote: Range<u32>,
+    exact: bool,
+}
+
+struct Maps {
+    ours_to_local: LineMap,
+    theirs_to_remote: LineMap,
+    local_to_base: LineMap,
+    remote_to_base: LineMap,
+}
+
+/// The middle text as it is built, with each conflict's chunk and its lines in the middle.
+struct MiddleText<'a> {
+    disk_lines: &'a [&'a str],
+    base_lines: Vec<&'a str>,
+    eol: Eol,
+    text: String,
+    line_count: u32,
+    chunks: Vec<Chunk>,
+    ranges: Vec<LineRange<MiddleLine>>,
+}
+
+pub(crate) fn seed(disk: &str, marker_size: usize, texts: &Texts) -> Seeded {
+    let disk_lines: Vec<&str> = disk.split_inclusive('\n').collect();
+    let pieces = parse(&split_lines(disk.as_bytes()), marker_size);
+    let ours = side_view(&disk_lines, &pieces, |block| &block.ours);
+    let theirs = side_view(&disk_lines, &pieces, |block| &block.theirs);
+    let maps = Maps {
+        ours_to_local: line_map(&ours.text, &texts.local.replace("\r\n", "\n")),
+        theirs_to_remote: line_map(&theirs.text, &texts.remote.replace("\r\n", "\n")),
+        local_to_base: line_map(&texts.local, &texts.base),
+        remote_to_base: line_map(&texts.remote, &texts.base),
+    };
+    let mut middle = MiddleText {
+        disk_lines: &disk_lines,
+        base_lines: texts.base.split_inclusive('\n').collect(),
+        eol: detect_eol(disk),
+        text: String::with_capacity(disk.len()),
+        line_count: 0,
+        chunks: Vec::new(),
+        ranges: Vec::new(),
+    };
+    let starts = ours.piece_starts.into_iter().zip(theirs.piece_starts);
+    for (piece, (ours_start, theirs_start)) in pieces.iter().zip(starts) {
+        match piece {
+            Piece::Settled(lines) => middle.push_disk_lines(lines),
+            Piece::Block(block) => {
+                let located = maps.block(block, ours_start, theirs_start);
+                middle.push_conflict(&located, maps.base(&located), &block.whole);
+            }
+            Piece::Raw(lines) => {
+                let located = maps.raw(ours_start, theirs_start);
+                middle.push_conflict(&located, maps.base(&located), lines);
+            }
+        }
+    }
+    middle.seeded(texts)
+}
+
+fn side_view(lines: &[&str], pieces: &[Piece], section: fn(&Block) -> &Range<usize>) -> SideView {
+    let mut view = SideView {
+        text: String::new(),
+        piece_starts: Vec::with_capacity(pieces.len()),
+    };
+    let mut line_count = 0;
+    for piece in pieces {
+        view.piece_starts.push(line_count);
+        let included = match piece {
+            Piece::Settled(lines) => lines,
+            Piece::Block(block) => section(block),
+            Piece::Raw(_) => continue,
+        };
+        for line in lines.get(included.clone()).unwrap_or_default() {
+            match line.strip_suffix("\r\n") {
+                Some(content) => {
+                    view.text.push_str(content);
+                    view.text.push('\n');
+                }
+                None => view.text.push_str(line),
+            }
+            line_count += 1;
+        }
+    }
+    view
+}
+
+impl Maps {
+    fn block(&self, block: &Block, ours_start: u32, theirs_start: u32) -> Located {
+        let ours = ours_start..ours_start + line_number(block.ours.len());
+        let theirs = theirs_start..theirs_start + line_number(block.theirs.len());
+        match (
+            self.ours_to_local.exact(ours.clone()),
+            self.theirs_to_remote.exact(theirs.clone()),
+        ) {
+            (Some(local), Some(remote)) => Located {
+                local,
+                remote,
+                exact: true,
+            },
+            (None, _) | (_, None) => Located {
+                local: self.ours_to_local.covering(ours),
+                remote: self.theirs_to_remote.covering(theirs),
+                exact: false,
+            },
+        }
+    }
+
+    fn raw(&self, ours_start: u32, theirs_start: u32) -> Located {
+        Located {
+            local: self.ours_to_local.covering(ours_start..ours_start),
+            remote: self.theirs_to_remote.covering(theirs_start..theirs_start),
+            exact: false,
+        }
+    }
+
+    fn base(&self, located: &Located) -> Range<u32> {
+        let from_local = self.local_to_base.covering(located.local.clone());
+        let from_remote = self.remote_to_base.covering(located.remote.clone());
+        from_local.start.min(from_remote.start)..from_local.end.max(from_remote.end)
+    }
+}
+
+impl MiddleText<'_> {
+    fn push_disk_lines(&mut self, lines: &Range<usize>) {
+        for line in self.disk_lines.get(lines.clone()).unwrap_or_default() {
+            self.text.push_str(line);
+            self.line_count += 1;
+        }
+    }
+
+    fn push_base_lines(&mut self, lines: &Range<u32>) {
+        let range = lines.start as usize..lines.end as usize;
+        for line in self.base_lines.get(range).unwrap_or_default() {
+            let bare_lf = line
+                .strip_suffix('\n')
+                .filter(|content| !content.ends_with('\r'));
+            match (self.eol, bare_lf) {
+                (Eol::CrLf, Some(content)) => {
+                    self.text.push_str(content);
+                    self.text.push_str("\r\n");
+                }
+                (Eol::CrLf | Eol::Lf | Eol::Mixed, _) => self.text.push_str(line),
+            }
+            self.line_count += 1;
+        }
+    }
+
+    fn push_conflict(&mut self, located: &Located, base: Range<u32>, disk_lines: &Range<usize>) {
+        let start = self.line_count;
+        if located.exact {
+            self.push_base_lines(&base);
+        } else {
+            self.push_disk_lines(disk_lines);
+        }
+        self.ranges.push(LineRange {
+            start: MiddleLine(start),
+            len: self.line_count - start,
+        });
+        self.chunks.push(Chunk {
+            id: ChunkId(line_number(self.chunks.len())),
+            kind: ChunkKind::Conflict,
+            base: LineRange {
+                start: BaseLine(base.start),
+                len: base.end - base.start,
+            },
+            local: LineRange {
+                start: LocalLine(located.local.start),
+                len: located.local.end - located.local.start,
+            },
+            remote: LineRange {
+                start: RemoteLine(located.remote.start),
+                len: located.remote.end - located.remote.start,
+            },
+        });
+    }
+
+    fn seeded(self, texts: &Texts) -> Seeded {
+        let words = word_changes(&texts.base, &texts.local, &texts.remote, &self.chunks);
+        let mut chunks = Vec::with_capacity(self.chunks.len());
+        for ((chunk, middle), words) in self.chunks.into_iter().zip(self.ranges).zip(words) {
+            chunks.push(MergeChunk {
+                chunk,
+                middle,
+                words,
+            });
+        }
+        Seeded {
+            middle: self.text,
+            eol: self.eol,
+            chunks,
+        }
+    }
+}
+
+fn line_number(count: usize) -> u32 {
+    u32::try_from(count).unwrap_or(u32::MAX)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::markers::DEFAULT_MARKER_SIZE;
+
+    const BASE: &str = include_str!("../tests/markers/base.txt");
+    const OURS: &str = include_str!("../tests/markers/ours.txt");
+    const THEIRS: &str = include_str!("../tests/markers/theirs.txt");
+    const ZDIFF3: &str = include_str!("../tests/markers/style-zdiff3.txt");
+    const MERGE: &str = include_str!("../tests/markers/style-merge.txt");
+    const SECOND_BLOCK_ZDIFF3: &str =
+        "<<<<<<< HEAD\neight-ours\n||||||| 8409db1\neight\n=======\neight-theirs\n>>>>>>> theirs\n";
+    const SECOND_BLOCK_MERGE: &str =
+        "<<<<<<< HEAD\neight-ours\n=======\neight-theirs\n>>>>>>> theirs\n";
+    const WORKED_MIDDLE: &str = "title\n=======\none\ntwo\nthree\nshared-b\nfour\nfive\nsix\nseven\neight-theirs\nnine\nten\n";
+
+    fn texts(base: &str, local: &str, remote: &str) -> Texts {
+        Texts {
+            base: base.to_owned(),
+            local: local.to_owned(),
+            remote: remote.to_owned(),
+            deleted: None,
+        }
+    }
+
+    fn sample_texts() -> Texts {
+        texts(BASE, OURS, THEIRS)
+    }
+
+    fn ranges(seeded: &Seeded) -> Vec<[(u32, u32); 3]> {
+        let ranges = seeded.chunks.iter().map(|chunk| {
+            [
+                (chunk.middle.start.0, chunk.middle.len),
+                (chunk.chunk.local.start.0, chunk.chunk.local.len),
+                (chunk.chunk.remote.start.0, chunk.chunk.remote.len),
+            ]
+        });
+        ranges.collect()
+    }
+
+    fn with_local_applied(seeded: &Seeded, local: &str) -> String {
+        let middle: Vec<&str> = seeded.middle.split_inclusive('\n').collect();
