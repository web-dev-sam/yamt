+test("a checked row replaces only its own row's readiness and keeps the row and the order (catches another row or field changed)", () => {
+  const rows: { iid: number; title: string; readiness: Readiness }[] = [
+    { iid: 640, title: "newest", readiness: { kind: "conflicts", also: [] } },
+    { iid: 638, title: "older", readiness: { kind: "checking" } },
+  ];
+  expect(rechecked(rows, { iid: 640, readiness: { kind: "mergesCleanly" } })).toEqual([
+    { iid: 640, title: "newest", readiness: { kind: "mergesCleanly" } },
+    { iid: 638, title: "older", readiness: { kind: "checking" } },
+  ]);
+});
+
+test("a checked row whose iid is not listed changes nothing", () => {
+  const rows: { iid: number; readiness: Readiness }[] = [
+    { iid: 640, readiness: { kind: "ready" } },
+  ];
+  expect(rechecked(rows, { iid: 1, readiness: { kind: "mergesCleanly" } })).toEqual(rows);
+});
diff --git a/frontend/src/mergeRequests/internal/readiness.ts b/frontend/src/mergeRequests/internal/readiness.ts
index 518170b..3a4b7e1 100644
--- a/frontend/src/mergeRequests/internal/readiness.ts
+++ b/frontend/src/mergeRequests/internal/readiness.ts
@@ -96,3 +96,12 @@ export function readinessText(readiness: Readiness): string {
 export function readinessIcon(readiness: Readiness): ReadinessIcon {
   return ICONS[readiness.kind];
 }
+
+export function rechecked<R extends { readonly iid: number; readonly readiness: Readiness }>(
+  rows: readonly R[],
+  checked: Pick<R, "iid" | "readiness">,
+): readonly R[] {
+  return rows.map((row) =>
+    row.iid === checked.iid ? { ...row, readiness: checked.readiness } : row,
+  );
+}
