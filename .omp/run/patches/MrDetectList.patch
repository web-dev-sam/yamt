+++ b/crates/merge-requests/src/detect.rs
@@ -0,0 +1,184 @@
+use std::path::Path;
+
+use yamt_gitio::{RemoteUrl, Repo};
+
+use crate::GitLabProject;
+
+const GITLAB_LABEL_START: &str = "gitlab";
+const SCHEME_END: &str = "://";
+const FILE_SCHEME: &str = "file";
+/// glab's own variables naming a self-managed GitLab (glab docs, "Environment variables").
+const GLAB_HOST_VARIABLES: [&str; 2] = ["GITLAB_HOST", "GL_HOST"];
+
+/// A repository with a remote on a GitLab server, found without the network.
+pub struct GitLabRepository {
+    repo: Repo,
+    repository: String,
+    remotes: Vec<Remote>,
+}
+
+/// A remote's name and URL: lossy UTF-8 of git's bytes.
+pub(crate) struct Remote {
+    pub name: String,
+    pub url: String,
+}
+
+/// The repository holding `folder` when one of its remotes is on a GitLab server; `None` otherwise.
+#[must_use]
+pub fn gitlab_repository(folder: &Path) -> Option<GitLabRepository> {
+    let repo = Repo::discover(folder)
+        .inspect_err(|error| tracing::info!(%error, "no git repository, so no merge requests"))
+        .ok()?;
+    let urls = repo
+        .remote_urls()
+        .inspect_err(|error| tracing::warn!(%error, "cannot read the remotes"))
+        .ok()?;
+    let common_dir = repo
+        .common_dir()
+        .inspect_err(|error| tracing::warn!(%error, "cannot find the common git dir"))
+        .ok()?;
+    let found = GitLabRepository {
+        repo,
+        repository: common_dir.to_string_lossy().into_owned(),
+        remotes: urls.into_iter().map(Remote::from).collect(),
+    };
+    let glab_host = glab_host();
+    let gitlab_remote = found.remotes().iter().find(|remote| {
+        remote_host(&remote.url).is_some_and(|host| is_gitlab_host(&host, glab_host.as_deref()))
+    })?;
+    tracing::info!(remote = %gitlab_remote.name, "a remote on GitLab");
+    Some(found)
+}
+
+impl GitLabRepository {
+    /// What the window is told at start.
+    #[must_use]
+    pub fn project(&self) -> GitLabProject {
+        GitLabProject::Found {
+            repository: self.repository.clone(),
+        }
+    }
+
+    /// The repository's root: glab and git run there.
+    #[must_use]
+    pub fn root(&self) -> &Path {
+        self.repo().root()
+    }
+
+    pub(crate) fn remotes(&self) -> &[Remote] {
+        &self.remotes
+    }
+
+    pub(crate) fn repo(&self) -> &Repo {
+        &self.repo
+    }
+}
+
+impl From<RemoteUrl> for Remote {
+    fn from(remote: RemoteUrl) -> Remote {
+        Remote {
+            name: String::from_utf8_lossy(&remote.name).into_owned(),
+            url: String::from_utf8_lossy(&remote.url).into_owned(),
+        }
+    }
+}
+
+/// The host in `GITLAB_HOST`, else `GL_HOST`: a host, `host:port` or a URL.
+fn glab_host() -> Option<String> {
+    let set = |name: &&str| std::env::var(name).ok().filter(|value| !value.is_empty());
+    let value = GLAB_HOST_VARIABLES.iter().find_map(set)?;
+    Some(remote_host(&value).unwrap_or_else(|| value.to_ascii_lowercase()))
+}
+
+/// The server a remote URL names (git-clone(1) "GIT URLS"), lowercase; `None` for a local path or `file://`.
+fn remote_host(url: &str) -> Option<String> {
+    let authority = match url.split_once(SCHEME_END) {
+        Some((scheme, _)) if scheme.eq_ignore_ascii_case(FILE_SCHEME) => return None,
+        Some((_, rest)) => rest.split('/').next()?,
+        None => scp_authority(url)?,
+    };
+    let host_and_port = authority
+        .rsplit_once('@')
+        .map_or(authority, |(_, host)| host);
+    let host = host_and_port.split(':').next()?;
+    (!host.is_empty()).then(|| host.to_ascii_lowercase())
+}
+
+/// git reads `[user@]host:path` as scp-like when the colon comes before any slash; a single letter before it is a
+/// Windows drive (git-clone(1) "GIT URLS").
+fn scp_authority(url: &str) -> Option<&str> {
+    let (before, _) = url.split_once(':')?;
+    let is_path = before.contains(['/', '\\']) || before.len() == 1;
+    (!is_path).then_some(before)
+}
+
+/// A host is GitLab's when one of its dot-separated labels starts with "gitlab" (gitlab.com included), or when glab
+/// is set up for it (`GITLAB_HOST`).
+fn is_gitlab_host(host: &str, glab_host: Option<&str>) -> bool {
+    let named_gitlab = host
+        .split('.')
+        .any(|label| label.starts_with(GITLAB_LABEL_START));
+    named_gitlab || glab_host == Some(host)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_host_comes_from_scp_like_ssh_and_https_urls_without_user_or_port() {
+        let hosts = [
+            (
+                "git@gitlab.example:taskboard/taskboard.git",
+                "gitlab.example",
+            ),
+            (
+                "ssh://git@GitLab.Example:2222/taskboard/taskboard",
+                "gitlab.example",
+            ),
+            (
+                "https://sam:token@gitlab.com/taskboard/taskboard.git",
+                "gitlab.com",
+            ),
+            ("https://gitlab.example:8443", "gitlab.example"),
+            ("gitlab.example:taskboard", "gitlab.example"),
+        ];
+        for (url, host) in hosts {
+            assert_eq!(remote_host(url).as_deref(), Some(host), "{url}");
+        }
+    }
+
+    #[test]
+    fn a_local_path_a_file_url_or_a_drive_letter_has_no_host() {
+        let local = [
+            "/srv/git/taskboard.git",
+            "../taskboard",
+            "./with:colon",
+            "file:///srv/git/taskboard.git",
+            "FILE://gitlab.example/x",
+            r"C:\repo",
+            "C:/repo",
+            r"..\x:y",
+            "https:///no-host",
+            "git@:path",
+        ];
+        for url in local {
+            assert_eq!(remote_host(url), None, "{url}");
+        }
+    }
+
+    #[test]
+    fn gitlab_hosts_are_gitlab_com_a_label_starting_with_gitlab_or_glab_s_host() {
+        for host in ["gitlab.com", "gitlab.example", "code.gitlab-int.corp"] {
+            assert!(is_gitlab_host(host, None), "{host}");
+        }
+        for host in ["github.com", "my-gitlab.com", "notgitlab.example"] {
+            assert!(!is_gitlab_host(host, None), "{host}");
+        }
+        assert!(is_gitlab_host("git.corp.example", Some("git.corp.example")));
+        assert!(!is_gitlab_host(
+            "git.corp.example",
+            Some("git.other.example")
+        ));
+    }
+}
diff --git a/crates/merge-requests/src/job_page.rs b/crates/merge-requests/src/job_page.rs
new file mode 100644
index 0000000..5110b5f
--- /dev/null
+++ b/crates/merge-requests/src/job_page.rs
@@ -0,0 +1,97 @@
+use crate::JobPage;
+
+const HTTPS: &str = "https://";
+const JOBS_SEGMENT: &str = "/-/jobs/";
+const PARENT_SEGMENT: &str = "..";
+
+impl JobPage {
+    /// The job log page `web_path` names on the GitLab at `origin` (`https://<host[:port]>`); `None` for any other
+    /// origin or path, so a page never leaves the project's GitLab.
+    pub(crate) fn built(origin: &str, web_path: &str) -> Option<JobPage> {
+        let authority = origin.strip_prefix(HTTPS)?;
+        let (project, job) = web_path.rsplit_once(JOBS_SEGMENT)?;
+        let is_page = is_authority(authority) && is_project_path(project) && is_number(job);
+        is_page.then(|| JobPage(format!("{origin}{web_path}")))
+    }
+
+    /// The page's address.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+fn is_authority(authority: &str) -> bool {
+    let is_host_char = |c: char| c.is_ascii_alphanumeric() || matches!(c, '.' | '-' | ':');
+    !authority.is_empty() && authority.chars().all(is_host_char)
+}
+
+/// `/<group>/<project>`: URL path characters only, no empty or `..` segment.
+fn is_project_path(path: &str) -> bool {
+    let Some(segments) = path.strip_prefix('/') else {
+        return false;
+    };
+    let is_path_char = |c: char| c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | '~' | '-');
+    let is_segment = |segment: &str| {
+        !segment.is_empty() && segment != PARENT_SEGMENT && segment.chars().all(is_path_char)
+    };
+    segments.split('/').all(is_segment)
+}
+
+fn is_number(text: &str) -> bool {
+    !text.is_empty() && text.chars().all(|c| c.is_ascii_digit())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ORIGIN: &str = "https://gitlab.example";
+
+    fn built(origin: &str, web_path: &str) -> Option<String> {
+        JobPage::built(origin, web_path).map(|page| page.as_str().to_owned())
+    }
+
+    #[test]
+    fn a_job_path_on_an_https_gitlab_is_its_page() {
+        let page = built(ORIGIN, "/taskboard/taskboard/-/jobs/301");
+        assert_eq!(
+            page.as_deref(),
+            Some("https://gitlab.example/taskboard/taskboard/-/jobs/301")
+        );
+        let with_port = built("https://gitlab-2.example:8443", "/a/b.c_d~e-f/-/jobs/7");
+        assert_eq!(
+            with_port.as_deref(),
+            Some("https://gitlab-2.example:8443/a/b.c_d~e-f/-/jobs/7")
+        );
+    }
+
+    #[test]
+    fn another_origin_or_an_odd_path_is_no_page() {
+        let origins = [
+            "http://gitlab.example",
+            "https://",
+            "https://sam@gitlab.example",
+            "https://gitlab.example/",
+        ];
+        for origin in origins {
+            assert_eq!(built(origin, "/a/b/-/jobs/1"), None, "{origin}");
+        }
+        let paths = [
+            "//evil.example/a/-/jobs/1",
+            "/a/../../b/-/jobs/1",
+            "/a/-/jobs/1?x=1",
+            "/a/-/jobs/1#log",
+            "/a/-/jobs/",
+            "/a/-/jobs/-1",
+            "/a/-/pipelines/1",
+            "a/-/jobs/1",
+            "https://evil.example/a/-/jobs/1",
+            "/-/jobs/1",
+            "/a b/-/jobs/1",
+        ];
+        for path in paths {
+            assert_eq!(built(ORIGIN, path), None, "{path}");
+        }
+    }
+}
diff --git a/crates/merge-requests/src/lib.rs b/crates/merge-requests/src/lib.rs
new file mode 100644
index 0000000..7845770
--- /dev/null
+++ b/crates/merge-requests/src/lib.rs
@@ -0,0 +1,162 @@
+//! The GitLab project's open merge requests for the compare and range windows: found offline, listed through glab.
+#![forbid(unsafe_code)]
+#![warn(missing_docs)]
+
+mod detect;
+mod job_page;
+mod list;
+mod page;
+mod project;
+mod query;
+
+use serde::{Deserialize, Serialize};
+use specta::Type;
+
+pub use detect::{GitLabRepository, gitlab_repository};
+pub use list::list_merge_requests;
+
+/// Merge requests asked for in one glab call: GitLab's largest page.
+pub const PAGE_SIZE: u32 = 100;
+/// The most merge requests one load lists; beyond, the list ends `Cut`.
+pub const MAX_MERGE_REQUESTS: u32 = 500;
+const MAX_FAILED_JOBS: u32 = 50;
+
+/// Whether the window shows the button: decided once at start, offline.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum GitLabProject {
+    /// No repository, or no remote on a GitLab server.
+    None,
+    /// A repository with a remote on a GitLab server.
+    Found {
+        /// The absolute common git dir (lossy UTF-8): the key filters are remembered by.
+        repository: String,
+    },
+}
+
+/// A merge request's number within its project, "!12" without the "!".
+#[derive(
+    Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize, Type,
+)]
+pub struct MergeRequestIid(pub u32);
+
+/// A GitLab user.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct Person {
+    /// The login name, without "@".
+    pub username: String,
+    /// The display name.
+    pub name: String,
+}
+
+/// A pipeline's status, GitLab's fifteen folded into the seven the window shows.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub enum CiStatus {
+    /// It succeeded.
+    Passed,
+    /// It failed.
+    Failed,
+    /// It runs.
+    Running,
+    /// It waits to run.
+    Pending,
+    /// It was canceled.
+    Canceled,
+    /// It was skipped.
+    Skipped,
+    /// It waits for a manual job.
+    Manual,
+}
+
+/// The address of a failed job's log page on the project's GitLab; only `JobPage::built` makes one.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize, Type)]
+pub struct JobPage(String);
+
+/// A failed job of a merge request's latest pipeline, the latest run of it.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct FailedJob {
+    /// The job's name.
+    pub name: String,
+    /// Its stage's name.
+    pub stage: String,
+    /// Whether the pipeline may pass while it fails.
+    pub allow_failure: bool,
+    /// Its log page; `None` when GitLab is not on https or sent an odd path.
+    pub page: Option<JobPage>,
+}
+
+/// A merge request's latest pipeline.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct Pipeline {
+    /// Its status.
+    pub status: CiStatus,
+    /// Its failed jobs, in GitLab's order.
+    pub failed_jobs: Vec<FailedJob>,
+    /// Whether it has more failed jobs than were asked for.
+    pub more_failed_jobs: bool,
+}
+
+/// One open merge request as a row of the list.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct MergeRequestRow {
+    /// Its number.
+    pub iid: MergeRequestIid,
+    /// Its title, GitLab's "Draft: " prefix included.
+    pub title: String,
+    /// GitLab's ISO 8601 time, as sent.
+    pub created_at: String,
+    /// Whether it is a draft.
+    pub draft: bool,
+    /// Its assignees.
+    pub assignees: Vec<Person>,
+    /// Its reviewers.
+    pub reviewers: Vec<Person>,
+    /// Its labels' titles.
+    pub labels: Vec<String>,
+    /// Resolvable discussions not yet resolved.
+    pub open_discussions: u32,
+    /// Approvals given.
+    pub approvals: u32,
+    /// Its latest pipeline; `None` when it has none.
+    pub pipeline: Option<Pipeline>,
+}
+
+/// One page of the list, sent as soon as it arrives.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct MergeRequestPage {
+    /// The logged-in user's username.
+    pub me: Option<String>,
+    /// The page's merge requests, newest first.
+    pub rows: Vec<MergeRequestRow>,
+}
+
+/// How a load ended; the pages already sent stay.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum ListEnd {
+    /// Every open merge request was sent.
+    Loaded,
+    /// The newest `limit` were sent; GitLab has more.
+    Cut {
+        /// How many were sent.
+        limit: u32,
+    },
+    /// glab is not found on PATH.
+    GlabMissing,
+    /// `glab auth status` failed.
+    NotLoggedIn {
+        /// glab's first output line, which names the instance.
+        detail: String,
+    },
+    /// glab failed, timed out or answered something unexpected.
+    Failed {
+        /// What went wrong, in glab's, GitLab's or yamt's words.
+        message: String,
+    },
+}
diff --git a/crates/merge-requests/src/list.rs b/crates/merge-requests/src/list.rs
new file mode 100644
index 0000000..94f10ea
--- /dev/null
+++ b/crates/merge-requests/src/list.rs
@@ -0,0 +1,153 @@
+use yamt_gitio::{AuthStatus, Glab};
+
+use crate::page::{ParsedPage, parsed};
+use crate::project::project;
+use crate::query::list_args;
+use crate::{GitLabRepository, ListEnd, MAX_MERGE_REQUESTS, MergeRequestPage, PAGE_SIZE};
+
+const MAX_PAGES: u32 = MAX_MERGE_REQUESTS / PAGE_SIZE;
+
+/// The project's open merge requests, newest created first: each page goes to `on_page` as it arrives, one glab call
+/// (and one deadline) per page, at most `MAX_MERGE_REQUESTS`.
+pub fn list_merge_requests(
+    repository: &GitLabRepository,
+    glab: Option<&Glab>,
+    on_page: &dyn Fn(MergeRequestPage),
+) -> ListEnd {
+    let Some(glab) = glab else {
+        return ListEnd::GlabMissing;
+    };
+    let root = repository.root();
+    match glab.auth_status(root) {
+        AuthStatus::LoggedIn => {}
+        AuthStatus::LoggedOut { detail } => return ListEnd::NotLoggedIn { detail },
+        AuthStatus::Failed { message } => return ListEnd::Failed { message },
+    }
+    let project = match project(glab, root) {
+        Ok(project) => project,
+        Err(message) => return ListEnd::Failed { message },
+    };
+    let mut fetch = |after: Option<&str>| {
+        let args = list_args(&project.full_path, after);
+        let args: Vec<&str> = args.iter().map(String::as_str).collect();
+        let json = glab.get(root, &args)?;
+        parsed(&json, project.web_origin.as_deref())
+    };
+    pages(&mut fetch, on_page)
+}
+
+/// Fetches page after page, each after the cursor the one before ended at; the pages sent stay whatever comes next.
+fn pages(
+    fetch: &mut dyn FnMut(Option<&str>) -> Result<ParsedPage, String>,
+    on_page: &dyn Fn(MergeRequestPage),
+) -> ListEnd {
+    let mut after: Option<String> = None;
+    for number in 1..=MAX_PAGES {
+        let page = match fetch(after.as_deref()) {
+            Ok(page) => page,
+            Err(message) => return ListEnd::Failed { message },
+        };
+        if let (1, Some(complexity)) = (number, page.complexity) {
+            tracing::info!(
+                score = complexity.score,
+                limit = complexity.limit,
+                "GitLab's complexity of the merge-request query"
+            );
+        }
+        on_page(MergeRequestPage {
+            me: page.me,
+            rows: page.rows,
+        });
+        match page.next {
+            Some(cursor) => after = Some(cursor),
+            None => return ListEnd::Loaded,
+        }
+    }
+    ListEnd::Cut {
+        limit: MAX_MERGE_REQUESTS,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::mpsc;
+
+    use super::*;
+    use crate::{MergeRequestIid, MergeRequestRow};
+
+    fn row(iid: u32) -> MergeRequestRow {
+        MergeRequestRow {
+            iid: MergeRequestIid(iid),
+            title: format!("MR {iid}"),
+            created_at: "2026-10-30T00:00:00Z".to_owned(),
+            draft: false,
+            assignees: Vec::new(),
+            reviewers: Vec::new(),
+            labels: Vec::new(),
+            open_discussions: 0,
+            approvals: 0,
+            pipeline: None,
+        }
+    }
+
+    /// Page `n` (from 1) holds the merge request numbered `n`, and names `cursor-<n+1>` as the next while `n` is
+    /// below `last`; page `fails_at` fails.
+    fn answer(after: Option<&str>, last: u32, fails_at: Option<u32>) -> Result<ParsedPage, String> {
+        let number = after.map_or(1, |cursor| cursor["cursor-".len()..].parse().unwrap());
+        if fails_at == Some(number) {
+            return Err(format!("page {number} failed"));
+        }
+        Ok(ParsedPage {
+            me: Some("sam".to_owned()),
+            rows: vec![row(number)],
+            next: (number < last).then(|| format!("cursor-{}", number + 1)),
+            complexity: None,
+        })
+    }
+
+    /// The end, each cursor asked with, and the merge requests sent, page by page.
+    fn listed(last: u32, fails_at: Option<u32>) -> (ListEnd, Vec<Option<String>>, Vec<Vec<u32>>) {
+        let mut asked = Vec::new();
+        let (sender, sent) = mpsc::channel();
+        let mut fetch = |after: Option<&str>| {
+            asked.push(after.map(str::to_owned));
+            answer(after, last, fails_at)
+        };
+        let on_page = |page: MergeRequestPage| {
+            let iids = page.rows.iter().map(|row| row.iid.0).collect();
+            sender.send(iids).unwrap();
+        };
+        let end = pages(&mut fetch, &on_page);
+        (end, asked, sent.try_iter().collect())
+    }
+
+    #[test]
+    fn each_page_is_asked_after_the_cursor_the_one_before_ended_at() {
+        let (end, asked, sent) = listed(2, None);
+
+        assert_eq!(end, ListEnd::Loaded);
+        assert_eq!(asked, [None, Some("cursor-2".to_owned())]);
+        assert_eq!(sent, [[1], [2]]);
+    }
+
+    #[test]
+    fn five_full_pages_with_more_to_come_are_cut_at_500_without_a_sixth_call() {
+        let (end, asked, sent) = listed(6, None);
+
+        assert_eq!(end, ListEnd::Cut { limit: 500 });
+        assert_eq!(asked.len(), 5);
+        assert_eq!(sent, [[1], [2], [3], [4], [5]]);
+        let (exactly_five, _, _) = listed(5, None);
+        assert_eq!(exactly_five, ListEnd::Loaded);
+    }
+
+    #[test]
+    fn a_failing_page_ends_the_list_and_the_pages_sent_before_stay_sent() {
+        let (end, asked, sent) = listed(4, Some(3));
+
+        let message = "page 3 failed".to_owned();
+        assert_eq!(end, ListEnd::Failed { message });
+        assert_eq!(asked.len(), 3);
+        assert_eq!(sent, [[1], [2]]);
+    }
+}
diff --git a/crates/merge-requests/src/page.rs b/crates/merge-requests/src/page.rs
new file mode 100644
index 0000000..474bb22
--- /dev/null
+++ b/crates/merge-requests/src/page.rs
@@ -0,0 +1,236 @@
+use serde::Deserialize;
+use serde::de::IgnoredAny;
+
+use crate::{CiStatus, FailedJob, JobPage, MergeRequestIid, MergeRequestRow, Person, Pipeline};
+
+const NO_DATA: &str = "GitLab's answer holds no data";
+const NO_PROJECT: &str = "GitLab finds no such project, or you may not see it";
+const NO_CURSOR: &str = "GitLab says more merge requests follow, but sent no cursor for them";
+
+/// One GraphQL answer of the list query.
+pub(crate) struct ParsedPage {
+    pub me: Option<String>,
+    pub rows: Vec<MergeRequestRow>,
+    /// The cursor of the next page; `None` on the last.
+    pub next: Option<String>,
+    pub complexity: Option<Complexity>,
+}
+
+/// GitLab's cost of the query, and its limit (GitLab GraphQL docs, "Query complexity").
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize)]
+pub(crate) struct Complexity {
+    pub score: u32,
+    pub limit: u32,
+}
+
+#[derive(Deserialize)]
+struct Answer {
+    data: Option<Data>,
+    #[serde(default)]
+    errors: Vec<GraphQlError>,
+}
+
+#[derive(Deserialize)]
+struct GraphQlError {
+    message: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Data {
+    query_complexity: Option<Complexity>,
+    current_user: Option<User>,
+    project: Option<Project>,
+}
+
+#[derive(Deserialize)]
+struct User {
+    username: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Project {
+    merge_requests: Option<Connection<Node>>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Connection<T> {
+    page_info: PageInfo,
+    nodes: Vec<T>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct PageInfo {
+    has_next_page: bool,
+    end_cursor: Option<String>,
+}
+
+#[derive(Deserialize)]
+struct Nodes<T> {
+    nodes: Vec<T>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Node {
+    iid: String,
+    title: String,
+    created_at: String,
+    draft: bool,
+    labels: Option<Nodes<Label>>,
+    assignees: Option<Nodes<Person>>,
+    reviewers: Option<Nodes<Person>>,
+    approved_by: Option<Nodes<IgnoredAny>>,
+    resolvable_discussions_count: Option<i64>,
+    resolved_discussions_count: Option<i64>,
+    head_pipeline: Option<PipelineNode>,
+}
+
+#[derive(Deserialize)]
+struct Label {
+    title: String,
+}
+
+#[derive(Deserialize)]
+struct PipelineNode {
+    status: String,
+    jobs: Option<Connection<Job>>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Job {
+    name: String,
+    allow_failure: bool,
+    web_path: Option<String>,
+    stage: Option<Stage>,
+}
+
+#[derive(Deserialize)]
+struct Stage {
+    name: String,
+}
+
+/// The page in a GraphQL answer; `Err` holds GitLab's first error, or what yamt could not read. `origin` is the
+/// project's `https://<host[:port]>`, which job pages are built on.
+pub(crate) fn parsed(json: &[u8], origin: Option<&str>) -> Result<ParsedPage, String> {
+    let answer: Answer = serde_json::from_slice(json)
+        .map_err(|error| format!("GitLab's answer is not what yamt expects: {error}"))?;
+    if let Some(error) = answer.errors.into_iter().next() {
+        return Err(error.message);
+    }
+    let data = answer.data.ok_or(NO_DATA)?;
+    let project = data.project.ok_or(NO_PROJECT)?;
+    let merge_requests = project.merge_requests.ok_or(NO_PROJECT)?;
+    let mut rows = Vec::new();
+    for node in merge_requests.nodes {
+        rows.push(row(node, origin)?);
+    }
+    Ok(ParsedPage {
+        me: data.current_user.map(|user| user.username),
+        rows,
+        next: next_cursor(merge_requests.page_info)?,
+        complexity: data.query_complexity,
+    })
+}
+
+fn next_cursor(page_info: PageInfo) -> Result<Option<String>, String> {
+    match (page_info.has_next_page, page_info.end_cursor) {
+        (false, _) => Ok(None),
+        (true, Some(cursor)) => Ok(Some(cursor)),
+        (true, None) => Err(NO_CURSOR.to_owned()),
+    }
+}
+
+fn row(node: Node, origin: Option<&str>) -> Result<MergeRequestRow, String> {
+    let iid = node
+        .iid
+        .parse()
+        .map_err(|_| format!("GitLab sent {:?} as a merge request number", node.iid))?;
+    let labels = listed(node.labels).into_iter().map(|label| label.title);
+    Ok(MergeRequestRow {
+        iid: MergeRequestIid(iid),
+        title: node.title,
+        created_at: node.created_at,
+        draft: node.draft,
+        assignees: listed(node.assignees),
+        reviewers: listed(node.reviewers),
+        labels: labels.collect(),
+        open_discussions: open_discussions(
+            node.resolvable_discussions_count,
+            node.resolved_discussions_count,
+        ),
+        approvals: count(listed(node.approved_by).len()),
+        pipeline: node.head_pipeline.map(|found| pipeline(found, origin)),
+    })
+}
+
+fn listed<T>(connection: Option<Nodes<T>>) -> Vec<T> {
+    connection.map_or_else(Vec::new, |connection| connection.nodes)
+}
+
+/// Resolvable discussions not resolved; a missing count is 0, and the result never below 0.
+fn open_discussions(resolvable: Option<i64>, resolved: Option<i64>) -> u32 {
+    let open = resolvable
+        .unwrap_or(0)
+        .saturating_sub(resolved.unwrap_or(0));
+    u32::try_from(open.max(0)).unwrap_or(u32::MAX)
+}
+
+fn count(length: usize) -> u32 {
+    u32::try_from(length).unwrap_or(u32::MAX)
+}
+
+fn pipeline(found: PipelineNode, origin: Option<&str>) -> Pipeline {
+    let (jobs, more_failed_jobs) = match found.jobs {
+        Some(jobs) => (jobs.nodes, jobs.page_info.has_next_page),
+        None => (Vec::new(), false),
+    };
+    let failed_jobs = jobs.into_iter().map(|job| failed_job(job, origin));
+    Pipeline {
+        status: ci_status(&found.status),
+        failed_jobs: failed_jobs.collect(),
+        more_failed_jobs,
+    }
+}
+
+fn failed_job(job: Job, origin: Option<&str>) -> FailedJob {
+    let page = origin.zip(job.web_path.as_deref());
+    FailedJob {
+        page: page.and_then(|(origin, web_path)| JobPage::built(origin, web_path)),
+        name: job.name,
+        stage: job.stage.map(|stage| stage.name).unwrap_or_default(),
+        allow_failure: job.allow_failure,
+    }
+}
+
+/// GitLab's `PipelineStatusEnum` (GraphQL reference) in the window's seven.
+fn ci_status(status: &str) -> CiStatus {
+    match status {
+        "SUCCESS" => CiStatus::Passed,
+        "FAILED" => CiStatus::Failed,
+        "RUNNING" => CiStatus::Running,
+        "CREATED"
+        | "WAITING_FOR_RESOURCE"
+        | "PREPARING"
+        | "WAITING_FOR_CALLBACK"
+        | "PENDING"
+        | "SCHEDULED" => CiStatus::Pending,
+        "CANCELED" | "CANCELING" => CiStatus::Canceled,
+        "SKIPPED" => CiStatus::Skipped,
+        "MANUAL" => CiStatus::Manual,
+        unknown => {
+            tracing::warn!(
+                status = unknown,
+                "unknown pipeline status, shown as pending"
+            );
+            CiStatus::Pending
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests;
