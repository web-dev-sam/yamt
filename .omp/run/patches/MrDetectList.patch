+        ("PREPARING", CiStatus::Pending),
+        ("WAITING_FOR_CALLBACK", CiStatus::Pending),
+        ("PENDING", CiStatus::Pending),
+        ("SCHEDULED", CiStatus::Pending),
+        ("CANCELED", CiStatus::Canceled),
+        ("CANCELING", CiStatus::Canceled),
