+    let no_merge_requests = json!({ "data": { "project": { "mergeRequests": null } } }).to_string();
+    let bad_iid = json!([{ "iid": "!4", "title": "t", "createdAt": "x", "draft": false }]);
+    let error = |answer: &[u8]| parsed(answer, Some(ORIGIN)).err();
