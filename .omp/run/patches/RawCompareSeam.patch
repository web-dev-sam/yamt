diff --git a/frontend/src/ui/settingsStore.test.ts b/frontend/src/ui/settingsStore.test.ts
new file mode 100644
index 0000000..c65a5a2
--- /dev/null
+++ b/frontend/src/ui/settingsStore.test.ts
@@ -0,0 +1,35 @@
+import { expect, test } from "vitest";
+import { shallowRef } from "vue";
+
+import { startSettings } from "./settings";
+import { registerSettingsStore, useSettingsStore, type SettingsStore } from "./settingsStore";
+
+async function nothing(): Promise<void> {}
+
+function nothingShown(): void {}
+
+function settingsStore(): SettingsStore {
+  return {
+    settings: shallowRef(startSettings("dark")),
+    openSettings: nothingShown,
+    closeSettings: nothingShown,
+    setTheme: nothing,
+    setAntialiasing: nothing,
+    moveSettings: nothing,
+    addKey: nothing,
+    changeKey: nothing,
+    removeKey: nothing,
+    removeAllKeys: nothing,
+    resetKeys: nothing,
+  };
+}
+
+test("the settings view gets the store its window root registered, and nothing before that", () => {
+  expect(() => useSettingsStore()).toThrow(
+    "useSettingsStore() called before registerSettingsStore()",
+  );
+
+  const store = settingsStore();
+  registerSettingsStore(store);
+  expect(useSettingsStore()).toBe(store);
+});
diff --git a/frontend/src/ui/settingsStore.ts b/frontend/src/ui/settingsStore.ts
new file mode 100644
index 0000000..91ab6e1
--- /dev/null
+++ b/frontend/src/ui/settingsStore.ts
@@ -0,0 +1,32 @@
+import type { ShallowRef } from "vue";
+
+import type { SettingsActions, SettingsInUse } from "./settings";
+
+export type SettingsStore = Pick<
+  SettingsActions,
+  | "setTheme"
+  | "setAntialiasing"
+  | "moveSettings"
+  | "addKey"
+  | "changeKey"
+  | "removeKey"
+  | "removeAllKeys"
+  | "resetKeys"
+> & {
+  readonly settings: Readonly<ShallowRef<SettingsInUse>>;
+  openSettings(): void;
+  closeSettings(): void;
+};
+
+let registered: SettingsStore | null = null;
+
+export function registerSettingsStore(store: SettingsStore): void {
+  registered = store;
+}
+
+export function useSettingsStore(): SettingsStore {
+  if (registered === null) {
+    throw new Error("useSettingsStore() called before registerSettingsStore()");
+  }
+  return registered;
+}
