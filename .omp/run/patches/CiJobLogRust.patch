+        JobLogReply::NotOffered => "notOffered",
+        JobLogReply::NoLog => "noLog",
+        JobLogReply::GlabMissing => "glabMissing",
+        JobLogReply::NotLoggedIn { .. } => "notLoggedIn",
+        JobLogReply::Failed { .. } => "failed",
+    }
