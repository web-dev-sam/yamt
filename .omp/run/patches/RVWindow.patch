+  store.showFile(second.path);
+  expect(visitedIndexes(store)).toEqual([0, 1]);
+  expect(await store.loadFile(second.id)).toEqual({
+    kind: "texts",
+    left: "src/f01.ts\n",
+    right: "src/f01.ts!\n",
+    differences: [],
+    mode: { kind: "same" },
