+const FILES: readonly FileEntry[] = [{ path: "a.ts", status: "Unresolved", unsupported: null }];
+const REBASE: OperationView = {
+  kind: "Rebase",
+  branch: "feature",
+  onto: { kind: "Branch", name: "main" },
+  replaying: null,
