diff --git c/frontend/src/editor/internal/side.ts i/frontend/src/editor/internal/side.ts
new file mode 100644
index 0000000..896bcdc
--- /dev/null
+++ i/frontend/src/editor/internal/side.ts
@@ -0,0 +1,14 @@
+import type { Chunk } from "../../ipc";
+
+export type Side = "local" | "remote";
+
+const CHANGED_SIDES: Readonly<Record<Chunk["kind"], readonly Side[]>> = {
+  LocalOnly: ["local"],
+  RemoteOnly: ["remote"],
+  BothSame: ["local", "remote"],
+  Conflict: ["local", "remote"],
+};
+
+export function sideChanged(chunk: Chunk, side: Side): boolean {
+  return CHANGED_SIDES[chunk.kind].includes(side);
+}
