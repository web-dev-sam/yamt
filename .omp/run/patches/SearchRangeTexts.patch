+        SearchTexts {
+            files: Vec::new(),
+            next: None
+        }
+    );
+    let error = range.search_texts(RangeFileId(2)).unwrap_err();
+    assert!(matches!(
+        error,
+        Error::UnknownFile {
+            file: RangeFileId(2)
+        }
+    ));
+}
