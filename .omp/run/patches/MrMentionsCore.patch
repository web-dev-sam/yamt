diff --git a/frontend/src/mergeRequests/internal/mentions.test.ts b/frontend/src/mergeRequests/internal/mentions.test.ts
new file mode 100644
index 0000000..82024d8
--- /dev/null
+++ b/frontend/src/mergeRequests/internal/mentions.test.ts
@@ -0,0 +1,144 @@
+import { expect, test } from "vitest";
+
+import {
+  MENTION_LINES,
+  knownMentions,
+  mentionEdit,
+  mentionLines,
+  mentionWordAt,
+  type KnownPeople,
+  type MentionWord,
+  type Person,
+} from "../index";
+
+function person(username: string, name: string): Person {
+  return { username, name };
+}
+
+function usernames(people: readonly Person[]): readonly string[] {
+  return people.map((one) => one.username);
+}
+
+function atEnd(text: string): MentionWord | null {
+  return mentionWordAt(text, text.length);
+}
+
+test("a_word_starts_at_the_text_start_or_after_a_space_a_line_break_or_an_opening_bracket", () => {
+  expect(atEnd("@an")).toEqual({ start: 0, end: 3, typed: "an" });
+  for (const before of [" ", "\n", "\t"]) {
+    expect(atEnd(`x${before}@an`)).toEqual({ start: 2, end: 5, typed: "an" });
+  }
+  for (const bracket of ["(", "[", "{"]) {
+    expect(atEnd(`${bracket}@an`)).toEqual({ start: 1, end: 4, typed: "an" });
+  }
+});
+
+test("an_at_after_a_letter_starts_no_word", () => {
+  expect(mentionWordAt("a@b.c", 3)).toBeNull();
+  expect(atEnd("a@b.c")).toBeNull();
+  expect(atEnd("x@y")).toBeNull();
+  expect(atEnd("see x@y")).toBeNull();
+  expect(atEnd("@@a")).toBeNull();
+  expect(atEnd(")@a")).toBeNull();
+});
+
+test("a_caret_inside_the_word_searches_the_text_before_it", () => {
+  expect(mentionWordAt("@anna x", 3)).toEqual({ start: 0, end: 5, typed: "an" });
+  expect(mentionWordAt("@a1_b.c-dë e", 2)).toEqual({ start: 0, end: 10, typed: "a" });
+  expect(mentionWordAt("x @an", 4)).toEqual({ start: 2, end: 5, typed: "a" });
+  expect(mentionWordAt("@an x", 3)).toEqual({ start: 0, end: 3, typed: "an" });
+});
+
+test("a_space_or_a_caret_outside_ends_the_word", () => {
+  expect(atEnd("@an ")).toBeNull();
+  expect(atEnd("@an x")).toBeNull();
+  expect(mentionWordAt("x @an", 2)).toBeNull();
+  expect(mentionWordAt("@an", -1)).toBeNull();
+  expect(mentionWordAt("@an", 4)).toBeNull();
+  expect(atEnd("@")).toEqual({ start: 0, end: 1, typed: "" });
+});
+
+test("a_name_with_an_accent_stays_one_word", () => {
+  expect(atEnd("@zoë")).toEqual({ start: 0, end: 4, typed: "zoë" });
+  expect(atEnd("@an.na-b_1")).toEqual({ start: 0, end: 10, typed: "an.na-b_1" });
+  expect(atEnd("hi @😀x")).toBeNull();
+});
+
+const BEN = person("ben", "Ben Ode");
+const ANNA = person("anna", "Anna Berg");
+const ANNA2 = person("anna2", "Anna Two");
+const ADAM = person("adam", "Adam Fox");
+const DSCOTT = person("dscott", "Dana Scott");
+
+test("known_people_come_before_found_people", () => {
+  expect(usernames(mentionLines([BEN, ANNA], [ANNA2, ADAM], "a"))).toEqual([
+    "anna",
+    "anna2",
+    "adam",
+  ]);
+});
+
+test("starts_with_comes_before_contains_in_each_group", () => {
+  expect(usernames(mentionLines([DSCOTT, ANNA], [], "an"))).toEqual(["anna", "dscott"]);
+  expect(usernames(mentionLines([], [DSCOTT, ANNA], "AN"))).toEqual(["anna", "dscott"]);
+  expect(usernames(mentionLines([BEN], [DSCOTT, ANNA], "an"))).toEqual(["anna", "dscott"]);
+});
+
+test("a_name_matches_without_its_spaces", () => {
+  expect(usernames(mentionLines([ANNA], [], "annaberg"))).toEqual(["anna"]);
+  expect(usernames(mentionLines([ADAM, ANNA], [], "berg"))).toEqual(["anna"]);
+  expect(usernames(mentionLines([ANNA, person("bergo", "Bo Bergo")], [], "berg"))).toEqual([
+    "bergo",
+    "anna",
+  ]);
+});
+
+test("each_person_is_listed_once", () => {
+  const foundAnna = person("anna", "Anna B.");
+  const lines = mentionLines([ADAM, ANNA], [foundAnna, ANNA2], "a");
+  expect(usernames(lines)).toEqual(["adam", "anna", "anna2"]);
+  expect(lines[1]).toBe(ANNA);
+});
+
+test("at_most_ten_lines", () => {
+  const known = Array.from({ length: 8 }, (_, index) => person(`known${index}`, "Kim"));
+  const found = Array.from({ length: 8 }, (_, index) => person(`found${index}`, "Kim"));
+  const lines = mentionLines(known, found, "kim");
+  expect(lines).toHaveLength(MENTION_LINES);
+  expect(usernames(lines).slice(-2)).toEqual(["found0", "found1"]);
+});
+
+test("a_blank_text_lists_every_known_person_and_no_found_one", () => {
+  expect(usernames(mentionLines([BEN, ANNA, BEN], [ADAM], ""))).toEqual(["ben", "anna"]);
+  expect(usernames(mentionLines([BEN, ANNA], [ADAM], " "))).toEqual(["ben", "anna"]);
+});
+
+test("known_mentions_are_the_row_then_the_writers_each_once", () => {
+  const row: KnownPeople<Person> = {
+    author: BEN,
+    assignees: [ANNA],
+    reviewers: [{ person: ADAM }],
+    approvedBy: [DSCOTT, ANNA],
+  };
+  expect(usernames(knownMentions(row, [null, ANNA2, BEN, null, ANNA2]))).toEqual([
+    "ben",
+    "anna",
+    "adam",
+    "dscott",
+    "anna2",
+  ]);
+  expect(usernames(knownMentions({ ...row, author: null }, []))).toEqual([
+    "anna",
+    "adam",
+    "dscott",
+  ]);
+  expect(usernames(knownMentions(null, [ANNA2, null, BEN, ANNA2]))).toEqual(["anna2", "ben"]);
+});
+
+test("the_pick_replaces_the_whole_word_and_adds_one_space", () => {
+  expect(mentionEdit({ start: 4, end: 9, typed: "an" }, "anna")).toEqual({
+    from: 4,
+    to: 9,
+    insert: "@anna ",
+  });
+});
diff --git a/frontend/src/mergeRequests/internal/mentions.ts b/frontend/src/mergeRequests/internal/mentions.ts
new file mode 100644
index 0000000..3656268
--- /dev/null
+++ b/frontend/src/mergeRequests/internal/mentions.ts
@@ -0,0 +1,83 @@
+import type { Person } from "./filters";
+import { peopleOnRow, type KnownPeople } from "./suggestions";
+
+/** GitLab's `@` list shows 10 lines (gfm_auto_complete.js `limit: 10`, request rule 2). */
+export const MENTION_LINES = 10;
+
+/** The mention being typed: `text[start]` is "@"; `typed` is the text between it and the caret; `end` (≥ the
+ *  caret) is where the word's characters stop. */
+export type MentionWord = { readonly start: number; readonly end: number; readonly typed: string };
+
+/** Rule 4: replace the whole word with "@<username> " (one space). */
+export type MentionEdit = { readonly from: number; readonly to: number; readonly insert: string };
+
+/** Request rule 1. `caret` is a UTF-16 index (a textarea's `selectionStart`); null: the caret is in no mention word. */
+export function mentionWordAt(text: string, caret: number): MentionWord | null {
+  if (caret < 0 || caret > text.length) {
+    return null;
+  }
+  const at = /@[\p{L}\p{N}_.-]*$/u.exec(text.slice(0, caret));
+  if (at === null) {
+    return null;
+  }
+  const start = at.index;
+  if (start > 0 && !/[\s([{]/u.test(text.charAt(start - 1))) {
+    return null;
+  }
+  const wordStop = text.slice(caret).search(/[^\p{L}\p{N}_.-]/u);
+  const end = wordStop < 0 ? text.length : caret + wordStop;
+  return { start, end, typed: text.slice(start + 1, caret) };
+}
+
+function eachUsernameOnce<P extends Person>(people: readonly P[]): readonly P[] {
+  const seen = new Set<string>();
+  return people.filter((person) => {
+    const first = !seen.has(person.username);
+    seen.add(person.username);
+    return first;
+  });
+}
+
+/** The merge request's people for a field (rule 2): `row`'s author, assignees, reviewers, approvers (suggestions'
+ *  `peopleOnRow`), then the non-null `writers`, each username once, in that order; a null `row`: the writers only. */
+export function knownMentions<P extends Person>(
+  row: KnownPeople<P> | null,
+  writers: readonly (P | null)[],
+): readonly P[] {
+  const present = writers.filter((writer) => writer !== null);
+  return eachUsernameOnce([...(row === null ? [] : peopleOnRow(row)), ...present]);
+}
+
+function matchOf(person: Person, query: string): "starts" | "contains" | null {
+  const nameTerm = person.name.replace(/\s+/gu, "").toLowerCase();
+  const usernameTerm = person.username.toLowerCase();
+  if (nameTerm.startsWith(query) || usernameTerm.startsWith(query)) {
+    return "starts";
+  }
+  return `${nameTerm} ${usernameTerm}`.includes(query) ? "contains" : null;
+}
+
+function matching<P extends Person>(people: readonly P[], query: string): readonly P[] {
+  return [
+    ...people.filter((person) => matchOf(person, query) === "starts"),
+    ...people.filter((person) => matchOf(person, query) === "contains"),
+  ];
+}
+
+/** Rule 2's lines: `known` matching `typed`, then `found` matching it; inside each, starts-with before contains (order
+ *  kept); each username once (the first wins); at most MENTION_LINES. A blank `typed`: every known person, no found. */
+export function mentionLines<P extends Person>(
+  known: readonly P[],
+  found: readonly P[],
+  typed: string,
+): readonly P[] {
+  const query = typed.toLowerCase();
+  const lines =
+    typed.trim() === "" ? known : [...matching(known, query), ...matching(found, query)];
+  return eachUsernameOnce(lines).slice(0, MENTION_LINES);
+}
+
+/** Rule 4: the edit that replaces `word` with "@<username> ". */
+export function mentionEdit(word: MentionWord, username: string): MentionEdit {
+  return { from: word.start, to: word.end, insert: `@${username} ` };
+}
