+pub(crate) fn later_page(
+    iid: MergeRequestIid,
+    page_info: PageInfo,
+    pages: u32,
+    fetch: &mut Fetch,
+) -> Result<Option<Connection<DiscussionNode>>, String> {
+    if !page_info.has_next_page {
+        return Ok(None);
