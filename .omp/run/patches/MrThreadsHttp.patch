+            posted_run(Ok(no_answer(b""))),
+            stop("glab printed no HTTP answer")
+        );
+        assert_eq!(posted_run(Ok(GlabRun::TimedOut)), stop(TIMED_OUT));
+        assert_eq!(posted_run(Err("gone".to_owned())), stop("gone"));
     }
 }
