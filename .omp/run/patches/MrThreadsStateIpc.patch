+  );
+  const pageless = { ...discussion().last, page: "http://gitlab.example/x" };
+  expect(() => toRowDiscussions(rowOf(discussion({ last: pageless })), 0, uploadedPicture)).toThrow(
+    "rows[0].answer.discussions[0].last.page must be an https address",
+  );
