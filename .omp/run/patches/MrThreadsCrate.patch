+/// What `glab api --paginate` prints for these pages: each page's array, one after the other.
+fn drafts(pages: &[&[Value]]) -> Vec<u8> {
+    let printed: String = pages.iter().map(|page| json!(page).to_string()).collect();
+    printed.into_bytes()
