+        "graphql".to_owned(),
+        "-f".to_owned(),
+        format!("query={}", discussions_query()),
+        "-f".to_owned(),
+        format!("fullPath={full_path}"),
+        "-F".to_owned(),
+        format!("iids={}", json!(numbers)),
+        "-F".to_owned(),
+        format!("first={}", iids.len()),
+    ];
+    if let Some(cursor) = after {
+        args.push("-f".to_owned());
+        args.push(format!("discussionsAfter={cursor}"));
+    }
+    args
+}
