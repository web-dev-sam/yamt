diff --git a/frontend/src/editor/internal/markJump.ts b/frontend/src/editor/internal/markJump.ts
new file mode 100644
index 0000000..a9bcb22
--- /dev/null
+++ b/frontend/src/editor/internal/markJump.ts
@@ -0,0 +1,77 @@
+import { forEachDiagnostic } from "@codemirror/lint";
+import type { EditorState, StateField } from "@codemirror/state";
+import type { EditorView } from "@codemirror/view";
+
+import type { ChunkSpan } from "./chunkField";
+import type { ChunkRow, Pane, PaneViews } from "./geometry";
+import type { MarkTarget } from "./marks";
+import type { SideFocus } from "./sideFocus";
+import { thirdScrollTop } from "./viewport";
+
+type JumpParts = {
+  readonly views: PaneViews;
+  readonly spans: StateField<readonly ChunkSpan[]>;
+  readonly focus: SideFocus;
+  readonly rows: readonly ChunkRow[];
+};
+
+function startOf(
+  state: EditorState,
+  spans: StateField<readonly ChunkSpan[]>,
+  target: MarkTarget,
+): number | null {
+  switch (target.kind) {
+    case "change":
+      return state.field(spans).find(({ chunk }) => chunk.id === target.id)?.from ?? null;
+    case "problem": {
+      let start: number | null = null;
+      forEachDiagnostic(state, (diagnostic, from) => {
+        if (diagnostic === target.diagnostic) {
+          start = from;
+        }
+      });
+      return start;
+    }
+    default: {
+      const _exhaustive: never = target;
+      return _exhaustive;
+    }
+  }
+}
+
+function scrollToThird(view: EditorView, top: number): void {
+  const { scrollDOM } = view;
+  scrollDOM.scrollTop = thirdScrollTop(top, {
+    clientHeight: scrollDOM.clientHeight,
+    scrollHeight: scrollDOM.scrollHeight,
+    paddingTop: view.documentPadding.top,
+  });
+}
+
+// WebStorm's stripe click puts the caret at the line's end first to open a fold around it, then at
+// the mark's start (intellij-community EditorMarkupModelImpl.kt doClick).
+function jumpInResult({ views, spans }: JumpParts, target: MarkTarget): void {
+  const view = views.center;
+  const start = startOf(view.state, spans, target);
+  if (start === null) {
+    return;
+  }
+  view.dispatch({ selection: { anchor: view.state.doc.lineAt(start).to } });
+  view.dispatch({ selection: { anchor: start } });
+  view.focus();
+  scrollToThird(view, view.lineBlockAt(start).top);
+}
+
+export function jumpTo(parts: JumpParts, pane: Pane, target: MarkTarget): void {
+  if (pane === "center") {
+    jumpInResult(parts, target);
+    return;
+  }
+  const row =
+    target.kind === "change" ? parts.rows.find(({ chunk }) => chunk.id === target.id) : undefined;
+  if (row === undefined) {
+    return;
+  }
+  parts.focus.focusChange(pane === "left" ? "local" : "remote", row.chunk.id);
+  scrollToThird(parts.views[pane], row[pane].top);
+}
diff --git a/frontend/src/editor/internal/markLanes.ts b/frontend/src/editor/internal/markLanes.ts
new file mode 100644
index 0000000..83d6c0f
--- /dev/null
+++ b/frontend/src/editor/internal/markLanes.ts
@@ -0,0 +1,120 @@
+import type { ViewUpdate } from "@codemirror/view";
+
+import type { ChunkRow, Pane, PaneViews } from "./geometry";
+import { PANES } from "./geometry";
+import { changePlaces, laneBox, problemPlaces, tickAt, ticks } from "./marks";
+import type { MarkTarget, Tick } from "./marks";
+import { linted } from "./problems";
+
+type Jump = (pane: Pane, target: MarkTarget) => void;
+
+function tickElement({ top, height, kind }: Tick): HTMLDivElement {
+  const element = document.createElement("div");
+  element.className = `change-mark change-mark-${kind}`;
+  element.style.top = `${top}px`;
+  element.style.height = `${height}px`;
+  return element;
+}
+
+export class MarkLanes {
+  readonly #views: PaneViews;
+  readonly #lanes: Readonly<Record<Pane, HTMLDivElement>>;
+  readonly #ticks: Record<Pane, readonly Tick[]> = { left: [], center: [], right: [] };
+  readonly #arrows = navigator.platform.startsWith("Win");
+  readonly #listeners = new AbortController();
+  #shown = false;
+  #dirty = true;
+
+  constructor(views: PaneViews, shown: boolean, jump: Jump) {
+    this.#views = views;
+    this.#lanes = {
+      left: this.#lane("left", jump),
+      center: this.#lane("center", jump),
+      right: this.#lane("right", jump),
+    };
+    this.show(shown);
+  }
+
+  changed(update: ViewUpdate, rowsMoved: boolean): boolean {
+    if (!this.#shown || !(rowsMoved || linted(update.transactions))) {
+      return false;
+    }
+    this.#dirty = true;
+    return true;
+  }
+
+  show(shown: boolean): void {
+    this.#shown = shown;
+    this.#dirty = true;
+    for (const pane of PANES) {
+      this.#lanes[pane].hidden = !shown;
+    }
+  }
+
+  paint(rows: readonly ChunkRow[]): void {
+    if (!this.#shown || !this.#dirty) {
+      return;
+    }
+    this.#dirty = false;
+    for (const pane of PANES) {
+      this.#ticks[pane] = this.#paintLane(pane, rows);
+    }
+  }
+
+  destroy(): void {
+    this.#listeners.abort();
+    for (const pane of PANES) {
+      this.#lanes[pane].remove();
+    }
+  }
+
+  #lane(pane: Pane, jump: Jump): HTMLDivElement {
+    const lane = document.createElement("div");
+    lane.className = "change-marks";
+    lane.setAttribute("aria-hidden", "true");
+    const signal = this.#listeners.signal;
+    lane.addEventListener(
+      "mousedown",
+      (event) => {
+        if (event.button === 0) {
+          event.preventDefault();
+          event.stopPropagation();
+        }
+      },
+      { signal },
+    );
+    lane.addEventListener(
+      "click",
+      (event) => {
+        event.stopPropagation();
+        const tick = tickAt(this.#ticks[pane], event.clientY - lane.getBoundingClientRect().top);
+        if (tick !== null) {
+          jump(pane, tick.target);
+        }
+      },
+      { signal },
+    );
+    this.#views[pane].dom.append(lane);
+    return lane;
+  }
+
+  #paintLane(pane: Pane, rows: readonly ChunkRow[]): readonly Tick[] {
+    const view = this.#views[pane];
+    const { scrollHeight, clientHeight, offsetWidth, clientWidth } = view.scrollDOM;
+    const paddingTop = view.documentPadding.top;
+    const box = laneBox(
+      { scrollHeight, clientHeight, offsetWidth, clientWidth, paddingTop },
+      this.#arrows,
+    );
+    const places = changePlaces(rows, pane);
+    if (pane === "center") {
+      places.push(...problemPlaces(view.state, (pos) => view.lineBlockAt(pos)));
+    }
+    const shown = ticks(places, box);
+    const lane = this.#lanes[pane];
+    lane.style.width = `${box.width}px`;
+    lane.style.height = `${box.height}px`;
+    lane.replaceChildren(...shown.map(tickElement));
+    return shown;
+  }
+}
diff --git a/frontend/src/editor/internal/marks.test.ts b/frontend/src/editor/internal/marks.test.ts
new file mode 100644
index 0000000..5bc81f9
--- /dev/null
+++ b/frontend/src/editor/internal/marks.test.ts
@@ -0,0 +1,239 @@
+import { setDiagnostics, type Diagnostic } from "@codemirror/lint";
+import { EditorState } from "@codemirror/state";
+import { expect, test } from "vitest";
+
+import { loadFixture, type Chunk } from "../../ipc";
+import type { ChunkRow } from "./geometry";
+import { changePlaces, laneBox, problemPlaces, tickAt, ticks, type MarkPlace } from "./marks";
+import type { MarkKind, Tick } from "./marks";
+import { PENDING, type ChunkStatus } from "./status";
+
+const LINE_PX = 20;
+const FIND_SPACE_PX = 29;
+const SCROLLBAR_PX = 15;
+const TALL = { scrollHeight: 4000, clientHeight: 800, offsetWidth: 600, clientWidth: 600 };
+const OVERLAY = laneBox({ ...TALL, paddingTop: 0 }, false);
+const TARGET: MarkPlace["target"] = {
+  kind: "problem",
+  diagnostic: { from: 0, to: 0, severity: "info", message: "" },
+};
+
+function place(top: number, bottom: number, kind: MarkKind = "modified"): MarkPlace {
+  return { top, bottom, kind, target: TARGET };
+}
+
+function rowOf(chunk: Chunk, status: ChunkStatus): ChunkRow {
+  function span(range: { start: number; len: number }): { top: number; bottom: number } {
+    return { top: range.start * LINE_PX, bottom: (range.start + range.len) * LINE_PX };
+  }
+  return {
+    chunk,
+    status,
+    left: span(chunk.local),
+    center: span(chunk.middle),
+    right: span(chunk.remote),
+  };
+}
+
+const LOCAL_APPLIED = 5;
+const CONFLICT = 8;
+
+async function magicRows(): Promise<ChunkRow[]> {
+  const data = await loadFixture("vueuse-use-magic-keys.ts");
+  return data.chunks.map((chunk) => {
+    if (chunk.id === LOCAL_APPLIED) {
+      return rowOf(chunk, { local: "applied", remote: "pending" });
+    }
+    return rowOf(chunk, chunk.id === CONFLICT ? { local: "ignored", remote: "pending" } : PENDING);
+  });
+}
+
+function marked(places: readonly MarkPlace[]): (string | number)[][] {
+  return places.map(({ kind, target, top }) => [
+    target.kind === "change" ? target.id : "problem",
+    kind,
+    top,
+  ]);
+}
+
+test("rule 4: a place's top over the scrollable height, scaled to the track", () => {
+  const [tick] = ticks([place(2000, 2100)], OVERLAY);
+
+  expect(tick).toMatchObject({ top: 400, height: 20 });
+});
+
+test("rule 4: never thinner than 2 px; an insertion point is 2 px", () => {
+  const [thin, point] = ticks([place(2000, 2005), place(3000, 3000)], OVERLAY);
+
+  expect(thin).toMatchObject({ top: 400, height: 2 });
+  expect(point).toMatchObject({ top: 600, height: 2 });
+});
+
+test("rule 4: a document no taller than its pane maps 1:1", () => {
+  const short = laneBox({ ...TALL, scrollHeight: 800, paddingTop: 0 }, false);
+  const shortWithArrows = laneBox(
+    { ...TALL, scrollHeight: 800, clientWidth: 600 - SCROLLBAR_PX, paddingTop: 0 },
+    true,
+  );
+
+  expect(ticks([place(300, 340)], short)).toMatchObject([{ top: 300, height: 40 }]);
+  expect(ticks([place(300, 340)], shortWithArrows)).toMatchObject([
+    { top: SCROLLBAR_PX + 300, height: 40 },
+  ]);
+});
+
+test("rule 4: the find space moves ticks by its share", () => {
+  const withFind = laneBox({ ...TALL, paddingTop: FIND_SPACE_PX }, false);
+
+  expect(ticks([place(2000, 2100)], withFind)[0]?.top).toBeCloseTo((2000 + FIND_SPACE_PX) / 5);
+});
+
+test("rule 4: an overlay scrollbar gets the 14 px lane, a classic one its width; on Windows the track leaves out both arrows", () => {
+  const classic = { ...TALL, clientWidth: 600 - SCROLLBAR_PX, paddingTop: 0 };
+
+  expect(OVERLAY).toMatchObject({ width: 14, height: 800, track: { top: 0, bottom: 800 } });
+  expect(laneBox(classic, false)).toMatchObject({
+    width: SCROLLBAR_PX,
+    track: { top: 0, bottom: 800 },
+  });
+  const windows = laneBox(classic, true);
+  expect(windows).toMatchObject({
+    width: SCROLLBAR_PX,
+    track: { top: SCROLLBAR_PX, bottom: 800 - SCROLLBAR_PX },
+  });
+  const trackPx = 800 - 2 * SCROLLBAR_PX;
+  expect(ticks([place(2000, 2100)], windows)[0]?.top).toBeCloseTo(
+    SCROLLBAR_PX + (2000 * trackPx) / 4000,
+  );
+});
+
+test("rule 4: a tick at the end stays in the track", () => {
+  const [last] = ticks([place(3995, 4000)], OVERLAY);
+  const windows = laneBox({ ...TALL, clientWidth: 600 - SCROLLBAR_PX, paddingTop: 0 }, true);
+  const [lastWithArrows] = ticks([place(3995, 4000)], windows);
+
+  expect(last).toMatchObject({ top: 798, height: 2 });
+  expect(lastWithArrows).toMatchObject({ top: 800 - SCROLLBAR_PX - 2, height: 2 });
+});
+
+const DOC = Array.from({ length: 60 }, (_, index) => `line ${index + 1}`).join("\n");
+const WAVE = { first: 11, last: 40 };
+
+function foldedBlockAt(state: EditorState): (pos: number) => { top: number; bottom: number } {
+  return (pos) => {
+    const line = state.doc.lineAt(pos).number;
+    if (line < WAVE.first) {
+      return { top: (line - 1) * LINE_PX, bottom: line * LINE_PX };
+    }
+    if (line <= WAVE.last) {
+      return { top: (WAVE.first - 1) * LINE_PX, bottom: WAVE.first * LINE_PX };
+    }
+    const shown = line - (WAVE.last - WAVE.first);
+    return { top: (shown - 1) * LINE_PX, bottom: shown * LINE_PX };
+  };
+}
+
+function withProblems(
+  problems: readonly { line: number; severity: Diagnostic["severity"] }[],
+): EditorState {
+  const state = EditorState.create({ doc: DOC });
+  const diagnostics = problems.map(({ line, severity }) => {
+    const from = state.doc.line(line).from;
+    return { from, to: from + 4, severity, message: "problem" };
+  });
+  return state.update(setDiagnostics(state, diagnostics)).state;
+}
+
+test("rule 4: a problem inside collapsed lines takes the wave line's place", () => {
+  const state = withProblems([
+    { line: 25, severity: "error" },
+    { line: 45, severity: "warning" },
+  ]);
+
+  expect(problemPlaces(state, foldedBlockAt(state))).toMatchObject([
