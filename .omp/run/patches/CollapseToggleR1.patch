diff --git a/frontend/src/ui/windowStorage.test.ts b/frontend/src/ui/windowStorage.test.ts
new file mode 100644
index 0000000..8db46e1
--- /dev/null
+++ b/frontend/src/ui/windowStorage.test.ts
@@ -0,0 +1,91 @@
+import type { StorageLike } from "@vueuse/core";
+import { afterEach, expect, test, vi } from "vitest";
+
+import { storedValue } from "./windowStorage";
+
+const KEY = "yamt.test.value";
+const EVENT = "test.storage_failed";
+const UPPER = {
+  read: (raw: string) => raw.toUpperCase(),
+  write: (value: string) => value.toLowerCase(),
+};
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+function memoryStorage(initial: Record<string, string> = {}): StorageLike & {
+  readonly items: Map<string, string>;
+} {
+  const items = new Map(Object.entries(initial));
+  return {
+    items,
+    getItem: (key) => items.get(key) ?? null,
+    setItem: (key, value) => {
+      items.set(key, value);
+    },
+    removeItem: (key) => {
+      items.delete(key);
+    },
+  };
+}
+
+function spyWarnings(): string[] {
+  const lines: string[] = [];
+  vi.spyOn(console, "warn").mockImplementation((line: string) => {
+    lines.push(line);
+  });
+  return lines;
+}
+
+test("a missing key gives the fallback and writes nothing", () => {
+  const storage = memoryStorage({ other: "x" });
+
+  const value = storedValue(KEY, "FALLBACK", UPPER, EVENT, storage);
+
+  expect(value.value).toBe("FALLBACK");
+  expect([...storage.items.entries()]).toEqual([["other", "x"]]);
+});
+
+test("a stored value is read through the caller's read", () => {
+  expect(storedValue(KEY, "FALLBACK", UPPER, EVENT, memoryStorage({ [KEY]: "tree" })).value).toBe(
+    "TREE",
+  );
+});
+
+test("a change is written through the caller's write before the assignment returns", () => {
+  const storage = memoryStorage();
+  const value = storedValue(KEY, "FALLBACK", UPPER, EVENT, storage);
+
+  value.value = "Tree";
+
+  expect(storage.items.get(KEY)).toBe("tree");
+});
+
+test("a storage that throws gives the fallback and logs under the caller's event name", () => {
+  const warnings = spyWarnings();
+  const failing: StorageLike = {
+    getItem: () => {
+      throw new Error("storage disabled");
+    },
+    setItem: () => {
+      throw new Error("quota exceeded");
+    },
+    removeItem: () => {
+      throw new Error("storage disabled");
+    },
+  };
+
+  const value = storedValue(KEY, "FALLBACK", UPPER, EVENT, failing);
+  expect(value.value).toBe("FALLBACK");
+  expect(warnings).toEqual([
+    '[warn] test.storage_failed {kind: "Unexpected", message: "storage disabled"}',
+  ]);
+
+  value.value = "Tree";
+  expect(value.value).toBe("Tree");
+  expect(warnings).toEqual([
+    '[warn] test.storage_failed {kind: "Unexpected", message: "storage disabled"}',
+    '[warn] test.storage_failed {kind: "Unexpected", message: "storage disabled"}',
+  ]);
+});
diff --git a/frontend/src/ui/windowStorage.ts b/frontend/src/ui/windowStorage.ts
new file mode 100644
index 0000000..0c68d5c
--- /dev/null
+++ b/frontend/src/ui/windowStorage.ts
@@ -0,0 +1,22 @@
+import { useStorage, type Serializer, type StorageLike } from "@vueuse/core";
+import type { Ref } from "vue";
+
+import { log } from "../ipc";
+import { unexpected } from "./problem";
+
+export function storedValue<T>(
+  key: string,
+  fallback: T,
+  serializer: Serializer<T>,
+  warnEvent: string,
+  storage?: StorageLike,
+): Ref<T> {
+  return useStorage<T>(key, fallback, storage, {
+    serializer,
+    flush: "sync",
+    writeDefaults: false,
+    onError: (error) => {
+      log.warn(warnEvent, { ...unexpected(error) });
+    },
+  });
+}
