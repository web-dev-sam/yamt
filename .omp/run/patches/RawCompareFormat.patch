diff --git a/frontend/src/editor/internal/detectLanguage.test.ts b/frontend/src/editor/internal/detectLanguage.test.ts
new file mode 100644
index 0000000..a1a6d6a
--- /dev/null
+++ b/frontend/src/editor/internal/detectLanguage.test.ts
@@ -0,0 +1,89 @@
+import { LanguageDescription } from "@codemirror/language";
+import { languages } from "@codemirror/language-data";
+import { expect, test } from "vitest";
+
+import { detectLanguage } from "./detectLanguage";
+
+test("detectLanguage: a '{' opens JSON only before a string or '}' (catches any '{' accepted)", () => {
+  expect(detectLanguage('{"a":1}', "")).toBe("JSON");
+  expect(detectLanguage("{\n  }", "")).toBe("JSON");
+  expect(detectLanguage("{ foo }", "")).toBeNull();
+});
+
+test("detectLanguage: a '[' opens JSON only before a value or ']', so an INI section is plain text (catches any '[' accepted)", () => {
+  expect(detectLanguage("[section]\nkey=value", "")).toBeNull();
+  expect(detectLanguage("[1, 2]", "")).toBe("JSON");
+  for (const opening of [
+    "[]",
+    '[ {"a":1}]',
+    "[[",
+    '["x"]',
+    "[-1]",
+    "[true]",
+    "[false]",
+    "[null]",
+  ]) {
+    expect(detectLanguage(opening, "")).toBe("JSON");
+  }
+});
+
+test("detectLanguage: an HTML doctype or <html> is HTML before the tag rule (catches the XML rule placed before HTML)", () => {
+  expect(detectLanguage("<!DOCTYPE html>\n<html>", "")).toBe("HTML");
+  expect(detectLanguage("<!doctype HTML>", "")).toBe("HTML");
+  expect(detectLanguage('<HTML lang="en">', "")).toBe("HTML");
+  expect(detectLanguage("<htmlx/>", "")).toBe("XML");
+});
+
+test("detectLanguage: PHP, an XML declaration, a comment or a tag", () => {
+  expect(detectLanguage("<?php echo 1;", "")).toBe("PHP");
+  expect(detectLanguage('<?xml version="1.0"?><html/>', "")).toBe("XML");
+  expect(detectLanguage("<!-- note -->", "")).toBe("XML");
+  expect(detectLanguage("<note/>", "")).toBe("XML");
+  expect(detectLanguage("< note", "")).toBeNull();
+  expect(detectLanguage("a < b", "")).toBeNull();
+});
+
+test("detectLanguage: '#!' names the interpreter with its version stripped (catches the version not stripped)", () => {
+  expect(detectLanguage("#!/usr/bin/env python3\nprint(1)", "")).toBe("Python");
+  expect(detectLanguage("#!/usr/bin/python3.11", "")).toBe("Python");
+  expect(detectLanguage("#!/usr/bin/sqlite3 -init\n.tables", "")).toBe("SQLite");
+  expect(detectLanguage("#! /usr/bin/env -S node --no-warnings\n", "")).toBe("JavaScript");
+  expect(detectLanguage("#!/bin/bash\necho", "")).toBe("Shell");
+  expect(detectLanguage("#!/usr/bin/awk -f", '{"a":1}')).toBe("JSON");
+  expect(detectLanguage("#!", "")).toBeNull();
+});
+
+test("detectLanguage: leading whitespace and a BOM are skipped (catches no trim)", () => {
+  expect(detectLanguage(' \n\t\uFEFF {"a":1}', "")).toBe("JSON");
+  expect(detectLanguage("\uFEFF<?xml?>", "")).toBe("XML");
+});
+
+test("detectLanguage: the left wins, the right is read when the left finds nothing (catches the columns swapped)", () => {
+  expect(detectLanguage("<a/>", '{"a":1}')).toBe("XML");
+  expect(detectLanguage("plain words", '{"a":1}')).toBe("JSON");
+  expect(detectLanguage("   ", "<a/>")).toBe("XML");
+  expect(detectLanguage("plain", "words")).toBeNull();
+});
+
+test("detectLanguage: only the first 4,096 characters after the whitespace are read (catches the whole text read)", () => {
+  expect(detectLanguage(`  {${" ".repeat(4094)}"a": 1}`, "")).toBe("JSON");
+  expect(detectLanguage(`  {${" ".repeat(4095)}"a": 1}`, "")).toBeNull();
+});
+
+test("detectLanguage: every name it returns is a language-data name (catches a name spelled unlike language-data's)", () => {
+  const openings = [
+    '{"a":1}',
+    "<a/>",
+    "<html>",
+    "<?php",
+    "#!/bin/sh",
+    "#!/usr/bin/env ruby",
+    "#!/usr/bin/perl",
+  ];
+  for (const opening of openings) {
+    const name = detectLanguage(opening, "");
+
+    expect(name).not.toBeNull();
+    expect(LanguageDescription.matchLanguageName(languages, name ?? "")?.name).toBe(name);
+  }
+});
diff --git a/frontend/src/editor/internal/detectLanguage.ts b/frontend/src/editor/internal/detectLanguage.ts
new file mode 100644
index 0000000..09eecd1
--- /dev/null
+++ b/frontend/src/editor/internal/detectLanguage.ts
@@ -0,0 +1,52 @@
+import { LanguageDescription } from "@codemirror/language";
+import { languages } from "@codemirror/language-data";
+
+const OPENING_CHARS = 4096;
+const HTML = /^<(?:!doctype\s+html|html)(?![\w:.-])/i;
+const TAG = /^<(?:!--|[A-Za-z])/;
+const JSON_OBJECT = /^\{\s*["}]/;
+const JSON_ARRAY = /^\[\s*(?:[{["\]\d-]|true|false|null)/;
+const VERSION = /[\d.]+$/;
+
+export function detectLanguage(left: string, right: string): string | null {
+  return languageOf(left) ?? languageOf(right);
+}
+
+function languageOf(text: string): string | null {
+  const start = text.search(/\S/);
+  if (start === -1) {
+    return null;
+  }
+  const opening = text.slice(start, start + OPENING_CHARS);
+  if (opening.startsWith("#!")) {
+    return interpreterLanguage(opening);
+  }
+  if (opening.startsWith("<?php")) {
+    return "PHP";
+  }
+  if (opening.startsWith("<?xml")) {
+    return "XML";
+  }
+  if (HTML.test(opening)) {
+    return "HTML";
+  }
+  if (TAG.test(opening)) {
+    return "XML";
+  }
+  if (JSON_OBJECT.test(opening) || JSON_ARRAY.test(opening)) {
+    return "JSON";
+  }
+  return null;
+}
+
+function interpreterLanguage(opening: string): string | null {
+  const firstLine = opening.slice("#!".length).split("\n", 1).join("");
+  const [program = "", ...rest] = firstLine.trim().split(/\s+/);
+  const command = program.slice(program.lastIndexOf("/") + 1);
+  const interpreter =
+    command === "env" ? (rest.find((word) => !word.startsWith("-")) ?? "") : command;
+  const name = interpreter.replace(VERSION, "");
+  return name === ""
+    ? null
+    : (LanguageDescription.matchLanguageName(languages, name, true)?.name ?? null);
+}
diff --git a/frontend/src/editor/internal/formatJson.test.ts b/frontend/src/editor/internal/formatJson.test.ts
new file mode 100644
index 0000000..2df448b
--- /dev/null
+++ b/frontend/src/editor/internal/formatJson.test.ts
@@ -0,0 +1,158 @@
+import { expect, test } from "vitest";
+
+import { formatJson } from "./formatJson";
+
+const PRETTY = `{
+  "name": "yamt",
+  "tags": [
+    "merge",
+    true,
+    null
+  ],
+  "empty": {},
+  "none": [],
+  "nested": {
+    "deep": [
+      -1.5e3,
+      {
+        "x": "y"
+      }
+    ]
+  }
+}
+`;
+
+test("formatJson: the same data minified and in an odd layout formats to the same text (catches ':' written without its space)", () => {
+  const minified =
+    '{"name":"yamt","tags":["merge",true,null],"empty":{},"none":[],"nested":{"deep":[-1.5e3,{"x":"y"}]}}\n';
+  const odd = `  {"name"  :"yamt",
+"tags":[ "merge" ,
+ true,null   ],"empty":{
+ },  "none" : [
+ ],
+     "nested":{"deep":[-1.5e3,{"x"
+ :"y"}]}}
+
+`;
+
+  expect(formatJson(minified)).toEqual({ kind: "formatted", text: PRETTY });
+  expect(formatJson(odd)).toEqual({ kind: "formatted", text: PRETTY });
+});
+
+test("formatJson: keys keep their order and numbers keep their text (catches JSON.stringify(JSON.parse(text), null, 2))", () => {
+  expect(formatJson('{"b":1,"2":0,"big":12345678901234567890,"e":1.0e+10}')).toEqual({
+    kind: "formatted",
+    text: '{\n  "b": 1,\n  "2": 0,\n  "big": 12345678901234567890,\n  "e": 1.0e+10\n}',
+  });
+});
+
+test("formatJson: a missing comma names the line of the token after it (catches line breaks before the token not counted)", () => {
+  expect(formatJson('{\n  "a": 1\n  "b": 2\n}\n')).toEqual({
+    kind: "failed",
+    message: "Expected ',' or '}'",
+    line: 3,
+  });
+  expect(formatJson("[\n\n  1\n  2]")).toEqual({
+    kind: "failed",
+    message: "Expected ',' or ']'",
+    line: 4,
+  });
+});
+
+test("formatJson: the final line break is kept, and so is its absence (catches always appending one)", () => {
+  expect(formatJson("[1,2]\n")).toEqual({ kind: "formatted", text: "[\n  1,\n  2\n]\n" });
+  expect(formatJson("[1,2]  \n \n")).toEqual({ kind: "formatted", text: "[\n  1,\n  2\n]\n" });
+  expect(formatJson("[1,2]")).toEqual({ kind: "formatted", text: "[\n  1,\n  2\n]" });
+  expect(formatJson("[1,2]  ")).toEqual({ kind: "formatted", text: "[\n  1,\n  2\n]" });
+});
+
+test("formatJson: empty blocks stay compact, also with whitespace inside (catches a line break inside them)", () => {
+  expect(formatJson('{ "a": { }, "b": [\n] }')).toEqual({
+    kind: "formatted",
+    text: '{\n  "a": {},\n  "b": []\n}',
+  });
+  expect(formatJson("[]")).toEqual({ kind: "unchanged" });
+});
+
+test("formatJson: a string with escapes is one token, kept as written (catches the string scan ignoring backslashes)", () => {
+  expect(formatJson('{"a\\"b":"c\\\\","u":"\\u00e9\\/"}')).toEqual({
+    kind: "formatted",
+    text: '{\n  "a\\"b": "c\\\\",\n  "u": "\\u00e9\\/"\n}',
+  });
+});
+
+test("formatJson: strings with a raw control character, a bad escape, or no end fail", () => {
+  expect(formatJson('["a\tb"]')).toEqual({
+    kind: "failed",
+    message: "Control character in a string",
+    line: 1,
+  });
+  expect(formatJson('\n["a\\x"]')).toEqual({
+    kind: "failed",
+    message: "Invalid escape in a string",
+    line: 2,
+  });
+  expect(formatJson('["a\\u12"]')).toEqual({
+    kind: "failed",
+    message: "Invalid escape in a string",
+    line: 1,
+  });
+  expect(formatJson('["abc')).toEqual({ kind: "failed", message: "Unterminated string", line: 1 });
+});
+
+test("formatJson: numbers follow the JSON grammar", () => {
+  expect(formatJson("[-0, 0.5, 1E-7]")).toEqual({
+    kind: "formatted",
+    text: "[\n  -0,\n  0.5,\n  1E-7\n]",
+  });
+  expect(formatJson("[01]")).toEqual({ kind: "failed", message: "Expected ',' or ']'", line: 1 });
+  expect(formatJson("[1.]")).toEqual({ kind: "failed", message: "Expected ',' or ']'", line: 1 });
+  expect(formatJson("[-]")).toEqual({ kind: "failed", message: "Expected a value", line: 1 });
+  expect(formatJson("[+1]")).toEqual({ kind: "failed", message: "Expected a value", line: 1 });
+});
+
+test("formatJson: objects need string keys and a colon, arrays need values", () => {
+  expect(formatJson("{a:1}")).toEqual({
+    kind: "failed",
+    message: "Expected a string key",
+    line: 1,
+  });
+  expect(formatJson('{"a" 1}')).toEqual({ kind: "failed", message: "Expected ':'", line: 1 });
+  expect(formatJson('{"a":1,}')).toEqual({
+    kind: "failed",
+    message: "Expected a string key",
+    line: 1,
+  });
+  expect(formatJson("[1,]")).toEqual({ kind: "failed", message: "Expected a value", line: 1 });
+  expect(formatJson("[1")).toEqual({ kind: "failed", message: "Expected ',' or ']'", line: 1 });
+});
+
+test("formatJson: text after the root value fails (catches stopping after the root)", () => {
+  expect(formatJson('{"a":1}\n{"b":2}')).toEqual({
+    kind: "failed",
+    message: "Unexpected text after the JSON value",
+    line: 2,
+  });
+  expect(formatJson("1 2")).toEqual({
+    kind: "failed",
+    message: "Unexpected text after the JSON value",
+    line: 1,
+  });
+});
+
+test("formatJson: already formatted text is unchanged (catches always answering formatted)", () => {
+  expect(formatJson(PRETTY)).toEqual({ kind: "unchanged" });
+  expect(formatJson('"text"')).toEqual({ kind: "unchanged" });
+});
+
+test("formatJson: empty and whitespace-only text is unchanged", () => {
+  expect(formatJson("")).toEqual({ kind: "unchanged" });
+  expect(formatJson(" \n\t\n ")).toEqual({ kind: "unchanged" });
+});
+
+test("formatJson: 100,000 nested arrays are scanned without throwing (catches a recursive descent)", () => {
+  const depth = 100_000;
+  const unclosed = "[".repeat(depth) + "]".repeat(depth - 1);
+
+  expect(formatJson(unclosed)).toEqual({ kind: "failed", message: "Expected ',' or ']'", line: 1 });
+});
diff --git a/frontend/src/editor/internal/formatJson.ts b/frontend/src/editor/internal/formatJson.ts
new file mode 100644
index 0000000..97f338c
--- /dev/null
+++ b/frontend/src/editor/internal/formatJson.ts
@@ -0,0 +1,154 @@
+import { FormatFailure, type FormatResult, formatWith, type Layout, SPACE } from "./formatResult";
+
+type Close = "}" | "]";
+
+const NUMBER = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/y;
+const ESCAPE = /\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4})/y;
+const LITERALS = ["true", "false", "null"];
+const FIRST_PRINTABLE = 0x20;
+
+export function formatJson(text: string): FormatResult {
+  return formatWith(text, (layout) => {
+    new JsonScan(text, layout).run();
+  });
+}
+
+class JsonScan {
+  readonly #text: string;
+  readonly #layout: Layout;
+  readonly #open: Close[] = [];
+  #at = 0;
+
+  constructor(text: string, layout: Layout) {
+    this.#text = text;
+    this.#layout = layout;
+  }
+
+  run(): void {
+    this.#value();
+    for (let close = this.#open.at(-1); close !== undefined; close = this.#open.at(-1)) {
+      this.#skipSpace();
+      const next = this.#text[this.#at];
+      if (next === ",") {
+        this.#at += 1;
+        this.#layout.text(",");
+        this.#layout.lineAt(this.#open.length);
+        if (close === "}") {
+          this.#key();
+        }
+        this.#value();
+      } else if (next === close) {
+        this.#at += 1;
+        this.#open.pop();
+        this.#layout.lineAt(this.#open.length);
+        this.#layout.text(close);
+      } else {
+        this.#fail(`Expected ',' or '${close}'`);
+      }
+    }
+    this.#skipSpace();
+    if (this.#at < this.#text.length) {
+      this.#fail("Unexpected text after the JSON value");
+    }
+  }
+
+  #value(): void {
+    for (;;) {
+      this.#skipSpace();
+      const opened = this.#text[this.#at];
+      if (opened !== "{" && opened !== "[") {
+        this.#scalar();
+        return;
+      }
+      const close = opened === "{" ? "}" : "]";
+      this.#at += 1;
+      this.#skipSpace();
+      if (this.#text[this.#at] === close) {
+        this.#at += 1;
+        this.#layout.text(opened + close);
+        return;
+      }
+      this.#layout.text(opened);
+      this.#open.push(close);
+      this.#layout.lineAt(this.#open.length);
+      if (close === "}") {
+        this.#key();
+      }
+    }
+  }
+
+  #key(): void {
+    this.#skipSpace();
+    if (this.#text[this.#at] !== '"') {
+      this.#fail("Expected a string key");
+    }
+    this.#string();
+    this.#skipSpace();
+    if (this.#text[this.#at] !== ":") {
+      this.#fail("Expected ':'");
+    }
+    this.#at += 1;
+    this.#layout.text(": ");
+  }
+
+  #scalar(): void {
+    const first = this.#text[this.#at];
+    if (first === '"') {
+      this.#string();
+      return;
+    }
+    const literal = LITERALS.find((word) => this.#text.startsWith(word, this.#at));
+    if (literal !== undefined) {
+      this.#token(literal);
+      return;
+    }
+    NUMBER.lastIndex = this.#at;
+    const number = NUMBER.exec(this.#text);
+    if (number === null) {
+      this.#fail("Expected a value");
+    }
+    this.#token(number[0]);
+  }
+
+  #string(): void {
+    const from = this.#at;
+    let at = from + 1;
+    for (;;) {
+      const code = this.#text.charCodeAt(at);
+      if (Number.isNaN(code)) {
+        this.#fail("Unterminated string", from);
+      } else if (code < FIRST_PRINTABLE) {
+        this.#fail("Control character in a string", at);
+      }
+      const char = this.#text.charAt(at);
+      if (char === '"') {
+        break;
+      }
+      at = char === "\\" ? this.#escapeEnd(at) : at + 1;
+    }
+    this.#token(this.#text.slice(from, at + 1));
+  }
+
+  #escapeEnd(backslash: number): number {
+    ESCAPE.lastIndex = backslash;
+    if (ESCAPE.test(this.#text)) {
+      return ESCAPE.lastIndex;
+    }
+    return this.#fail("Invalid escape in a string", backslash);
+  }
+
+  #token(token: string): void {
+    this.#layout.text(token);
+    this.#at += token.length;
+  }
+
+  #skipSpace(): void {
+    while (SPACE[this.#text.charAt(this.#at)] === true) {
+      this.#at += 1;
+    }
+  }
+
+  #fail(message: string, at = this.#at): never {
+    throw new FormatFailure(message, at);
+  }
+}
diff --git a/frontend/src/editor/internal/formatResult.ts b/frontend/src/editor/internal/formatResult.ts
new file mode 100644
index 0000000..c570d8b
--- /dev/null
+++ b/frontend/src/editor/internal/formatResult.ts
@@ -0,0 +1,78 @@
+export type FormatResult =
+  | { readonly kind: "formatted"; readonly text: string }
+  | { readonly kind: "unchanged" }
+  | { readonly kind: "failed"; readonly message: string; readonly line: number };
+
+const INDENT = "  ";
+
+export const SPACE: Readonly<Record<string, true>> = {
+  " ": true,
+  "\t": true,
+  "\n": true,
+  "\r": true,
+};
+
+export class FormatFailure extends Error {
+  readonly at: number;
+
+  constructor(message: string, at: number) {
+    super(message);
+    this.at = at;
+  }
+}
+
+export class Layout {
+  readonly #pieces: (string | number)[] = [];
+
+  text(piece: string): void {
+    this.#pieces.push(piece);
+  }
+
+  lineAt(depth: number): void {
+    this.#pieces.push(depth);
+  }
+
+  toString(): string {
+    return this.#pieces
+      .map((piece) => (typeof piece === "number" ? `\n${INDENT.repeat(piece)}` : piece))
+      .join("");
+  }
+}
+
+export function formatWith(input: string, lay: (layout: Layout) => void): FormatResult {
+  const end = textEnd(input);
+  if (end === 0) {
+    return { kind: "unchanged" };
+  }
+  const layout = new Layout();
+  try {
+    lay(layout);
+  } catch (error) {
+    if (error instanceof FormatFailure) {
+      return { kind: "failed", message: error.message, line: lineOf(input, error.at) };
+    }
+    throw error;
+  }
+  const text = layout.toString() + (input.includes("\n", end) ? "\n" : "");
+  return text === input ? { kind: "unchanged" } : { kind: "formatted", text };
+}
+
+function textEnd(input: string): number {
+  let end = input.length;
+  while (end > 0 && SPACE[input.charAt(end - 1)] === true) {
+    end -= 1;
+  }
+  return end;
+}
+
+function lineOf(input: string, at: number): number {
+  let line = 1;
+  for (
+    let found = input.indexOf("\n");
+    found !== -1 && found < at;
+    found = input.indexOf("\n", found + 1)
+  ) {
+    line += 1;
+  }
+  return line;
+}
diff --git a/frontend/src/editor/internal/formatXml.test.ts b/frontend/src/editor/internal/formatXml.test.ts
