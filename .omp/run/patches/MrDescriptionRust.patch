+
+/// glab missing → `GlabMissing`; `logged_in_project`; `fetch_description`; then `described`. `pages` and `uploads`
+/// once each, in document order; both empty unless `Read`. One `tracing::info!`: iid, outcome kind, blocks, pages,
+/// uploads, web images; never text or an address.
+pub fn read_description(
+    repository: &GitLabRepository,
+    glab: Option<&Glab>,
+    iid: MergeRequestIid,
+) -> ReadDescription {
+    let read = read(repository, glab, iid);
+    let (blocks, web_images) = read.as_ref().map_or((0, 0), |read| {
+        (read.description.blocks.len(), read.web_images)
+    });
+    let (reply, pages, uploads) = match read {
+        Ok(read) => {
+            let description = read.description;
+            (
+                DescriptionReply::Read { description },
+                read.pages,
+                read.uploads,
+            )
+        }
+        Err(reply) => (reply, Vec::new(), Vec::new()),
+    };
+    tracing::info!(
+        iid = iid.0,
+        outcome = outcome(&reply),
+        blocks,
+        pages = pages.len(),
+        uploads = uploads.len(),
+        web_images,
+        "read a merge request's description"
+    );
+    ReadDescription {
+        reply,
+        pages,
+        uploads,
+    }
+}
+
+fn read(
+    repository: &GitLabRepository,
+    glab: Option<&Glab>,
+    iid: MergeRequestIid,
+) -> Result<Described, DescriptionReply> {
+    let Some(glab) = glab else {
+        return Err(DescriptionReply::GlabMissing);
+    };
+    let root = repository.root();
+    let project = logged_in_project(glab, root)?;
+    let html = fetch_description(glab, root, &project, iid)?;
+    let base = project
+        .web_origin
+        .as_deref()
+        .and_then(|origin| WebPage::merge_request(origin, &project.web_path, iid));
+    Ok(described(&html, base.as_ref()))
+}
+
+/// The one request for a description (request-mr-links reuses it): one `Glab::get` of `description_args`.
+pub(crate) fn fetch_description(
+    glab: &Glab,
+    root: &Path,
+    project: &Project,
+    iid: MergeRequestIid,
+) -> Result<String, DescriptionReply> {
+    let args = description_args(&project.full_path, iid);
+    let args: Vec<&str> = args.iter().map(String::as_str).collect();
+    html_of(glab.get(root, &args))
+}
+
+/// `Err(line)` or a GraphQL error → `Failed` in those words; `project: null` → `Failed(NO_PROJECT)`; `mergeRequest:
+/// null` → `Failed(NO_MERGE_REQUEST)`; `descriptionHtml: null` → "".
+fn html_of(printed: Result<Vec<u8>, String>) -> Result<String, DescriptionReply> {
+    let failed = |message: &str| DescriptionReply::Failed {
+        message: message.to_owned(),
+    };
+    let data: DescriptionData = printed
+        .and_then(|json| graphql_data(&json))
+        .map_err(|message| failed(&message))?;
+    let project = data.project.ok_or_else(|| failed(NO_PROJECT))?;
+    let merge_request = project
+        .merge_request
+        .ok_or_else(|| failed(NO_MERGE_REQUEST))?;
+    Ok(merge_request.description_html.unwrap_or_default())
+}
+
+/// The reply's kind, as the log names it: never the description's text or an address.
+fn outcome(reply: &DescriptionReply) -> &'static str {
+    match reply {
+        DescriptionReply::Read { .. } => "read",
+        DescriptionReply::GlabMissing => "glabMissing",
+        DescriptionReply::NotLoggedIn { .. } => "notLoggedIn",
+        DescriptionReply::Failed { .. } => "failed",
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/merge-requests/src/description/address.rs b/crates/merge-requests/src/description/address.rs
new file mode 100644
index 0000000..7613e39
--- /dev/null
+++ b/crates/merge-requests/src/description/address.rs
@@ -0,0 +1,117 @@
+use serde::Serialize;
+use specta::Type;
+use url::Url;
+
+use super::{DescriptionImage, DescriptionLink, OfferedUpload};
+use crate::job_log::ESCAPED_SLASH;
+use crate::web_page::{MERGE_REQUESTS_SEGMENT, PARENT_SEGMENT, is_number, is_web_path};
+use crate::{PictureAddress, WebPage};
+
+const HTTP_SCHEME: &str = "http";
+const HTTPS_SCHEME: &str = "https";
+const UPLOADS_SEGMENT: &str = "/uploads/";
+const PROJECT_SEGMENT: &str = "/-/project/";
+const SECRET_HEX_DIGITS: usize = 32;
+const UPLOAD_KEY_PREFIX: &str = "upload~";
+
+/// `upload~<the upload's 32 hex digit secret>`; `~` is in no username, so it never names an avatar. Only
+/// `description/address.rs` makes one.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Type)]
+#[serde(transparent)]
+pub struct UploadKey(String);
+
+impl UploadKey {
+    /// The key as the window asks the picture scheme for it.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl WebPage {
+    /// An http or https `url` as `url` serialises it.
+    pub(crate) fn linked(url: &Url) -> Option<WebPage> {
+        let is_web = matches!(url.scheme(), HTTP_SCHEME | HTTPS_SCHEME);
+        is_web.then(|| WebPage(url.as_str().to_owned()))
+    }
+}
+
+/// `address` when absolute, else resolved against `base`; None when `url` cannot read it or it is relative without
+/// `base`.
+fn resolved(base: Option<&Url>, address: &str) -> Option<Url> {
+    Url::options().base_url(base).parse(address).ok()
+}
+
+/// An http or https address, absolute or resolved against `base` → `Page`; anything else → `Refused` as written.
+pub(crate) fn link_of(base: Option<&Url>, href: &str) -> DescriptionLink {
+    match resolved(base, href).as_ref().and_then(WebPage::linked) {
+        Some(page) => DescriptionLink::Page { page },
+        None => DescriptionLink::Refused {
+            address: href.to_owned(),
+        },
+    }
+}
+
+/// The image and, for an upload, what to offer: an https upload on `base`'s origin → `Uploaded`; any other https
+/// address → `Web`; anything else, or no address → `Refused`.
+pub(crate) fn image_of(base: Option<&Url>, src: &str) -> (DescriptionImage, Option<OfferedUpload>) {
+    if src.trim().is_empty() {
+        return (DescriptionImage::Refused, None);
+    }
+    let https = resolved(base, src).filter(|url| url.scheme() == HTTPS_SCHEME);
+    let Some(url) = https else {
+        return (DescriptionImage::Refused, None);
+    };
+    if let Some(upload) = base.and_then(|base| upload_of(base, &url)) {
+        let key = upload.key.clone();
+        return (DescriptionImage::Uploaded { key }, Some(upload));
+    }
+    let address = url.as_str().to_owned();
+    (DescriptionImage::Web { address }, None)
+}
+
+/// An upload on `base`'s origin: the path `[<segments>]/-/project/<digits>/uploads/<secret>/<file>` or `<the
+/// project's web path>/uploads/<secret>/<file>`, its query and fragment dropped.
+fn upload_of(base: &Url, url: &Url) -> Option<OfferedUpload> {
+    if url.origin() != base.origin() {
+        return None;
+    }
+    let (before, upload) = url.path().rsplit_once(UPLOADS_SEGMENT)?;
+    let (secret, file) = upload.split_once('/')?;
+    if !is_secret(secret) || !is_upload_file(file) {
+        return None;
+    }
+    let project = project_of(base, before)?;
+    let route = format!("projects/{project}/uploads/{secret}/{file}");
+    let mut web = url.clone();
+    web.set_query(None);
+    web.set_fragment(None);
+    Some(OfferedUpload {
+        key: UploadKey(format!("{UPLOAD_KEY_PREFIX}{secret}")),
+        address: PictureAddress::upload(route, web.as_str().to_owned()),
+    })
+}
+
+/// The project in an upload's path before `/uploads/`, as the uploads API names it: `[<segments>]/-/project/<id>` →
+/// the id; the merge request's project web path (`base` before `/-/merge_requests/`) → that path, "/" as "%2F".
+fn project_of(base: &Url, before: &str) -> Option<String> {
+    if let Some((root, id)) = before.rsplit_once(PROJECT_SEGMENT) {
+        let is_root = root.is_empty() || is_web_path(root);
+        return (is_root && is_number(id)).then(|| id.to_owned());
+    }
+    let (project, _) = base.path().rsplit_once(MERGE_REQUESTS_SEGMENT)?;
+    let path = project.strip_prefix('/')?;
+    (before == project).then(|| path.replace('/', ESCAPED_SLASH))
+}
+
+fn is_secret(secret: &str) -> bool {
+    let is_lower_hex = |c: char| c.is_ascii_digit() || ('a'..='f').contains(&c);
+    secret.len() == SECRET_HEX_DIGITS && secret.chars().all(is_lower_hex)
+}
+
+/// One segment of `[A-Za-z0-9._~%+-]`, not `..`.
+fn is_upload_file(file: &str) -> bool {
+    let is_file_char =
+        |c: char| c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | '~' | '%' | '+' | '-');
+    !file.is_empty() && file != PARENT_SEGMENT && file.chars().all(is_file_char)
+}
diff --git a/crates/merge-requests/src/description/element.rs b/crates/merge-requests/src/description/element.rs
new file mode 100644
index 0000000..50d2c7a
--- /dev/null
+++ b/crates/merge-requests/src/description/element.rs
@@ -0,0 +1,77 @@
+use dom_query::NodeRef;
+
+use super::{CellAlign, DescriptionBlock, HeadingLevel, ListNumbering, TaskBox};
+
+const TASK_BOX_CLASS: &str = "task-list-item-checkbox";
+const LANGUAGE_ATTRIBUTES: [&str; 2] = ["data-canonical-lang", "lang"];
+
+/// A `<pre>`'s code block: its language from GitLab's `data-canonical-lang`, else `lang`; its text, one final "\n"
+/// removed.
+pub(super) fn code(text: &str, pre: &NodeRef) -> DescriptionBlock {
+    let language = LANGUAGE_ATTRIBUTES
+        .iter()
+        .find_map(|name| pre.attr(name).filter(|value| !value.is_empty()));
+    DescriptionBlock::Code {
+        language: language.map(|language| language.to_string()),
+        text: text.strip_suffix('\n').unwrap_or(text).to_owned(),
+    }
+}
+
+/// `<ol start>`, else 1.
+pub(super) fn numbers(list: &NodeRef) -> ListNumbering {
+    let start = list
+        .attr("start")
+        .and_then(|start| start.trim().parse().ok());
+    ListNumbering::Numbers {
+        start: start.unwrap_or(1),
+    }
+}
+
+pub(super) fn heading_level(name: &str) -> Option<HeadingLevel> {
+    match name {
+        "h1" => Some(HeadingLevel::H1),
+        "h2" => Some(HeadingLevel::H2),
+        "h3" => Some(HeadingLevel::H3),
+        "h4" => Some(HeadingLevel::H4),
+        "h5" => Some(HeadingLevel::H5),
+        "h6" => Some(HeadingLevel::H6),
+        _ => None,
+    }
+}
+
+/// GitLab's task box: the item's first element or text (or its first paragraph's, in a loose list) when it is
+/// `input.task-list-item-checkbox`.
+pub(super) fn task_box(item: &NodeRef) -> TaskBox {
+    let input = match first_content(item) {
+        Some(paragraph) if paragraph.has_name("p") => first_content(&paragraph),
+        first => first,
+    };
+    let Some(input) =
+        input.filter(|input| input.has_name("input") && input.has_class(TASK_BOX_CLASS))
+    else {
+        return TaskBox::None;
+    };
+    if input.has_attr("data-inapplicable") {
+        TaskBox::Inapplicable
+    } else if input.has_attr("checked") {
+        TaskBox::Done
+    } else {
+        TaskBox::Open
+    }
+}
+
+/// The first element or text that is not only white space among `parent`'s children.
+fn first_content<'a>(parent: &NodeRef<'a>) -> Option<NodeRef<'a>> {
+    let is_content =
+        |node: &NodeRef| node.is_element() || (node.is_text() && !node.text().trim().is_empty());
+    parent.children().into_iter().find(is_content)
+}
+
+/// The only style GitLab keeps on a cell (`sanitization_filter.rb` `TABLE_ALIGNMENT_PATTERN`).
+pub(super) fn align(cell: &NodeRef) -> CellAlign {
+    match cell.attr("style").as_deref() {
+        Some("text-align: center") => CellAlign::Center,
+        Some("text-align: right") => CellAlign::End,
+        _ => CellAlign::Start,
+    }
+}
diff --git a/crates/merge-requests/src/description/html.rs b/crates/merge-requests/src/description/html.rs
new file mode 100644
index 0000000..a63a437
--- /dev/null
+++ b/crates/merge-requests/src/description/html.rs
@@ -0,0 +1,379 @@
+use std::mem;
+
+use dom_query::{Document, NodeRef};
+use url::Url;
+
+use super::address::{image_of, link_of};
+use super::element::{align, code, heading_level, numbers, task_box};
+use super::{
+    Description, DescriptionBlock, DescriptionCell, DescriptionImage, DescriptionInline,
+    DescriptionItem, DescriptionLink, DescriptionRow, ListNumbering, OfferedUpload,
+};
+use crate::WebPage;
+
+/// The deepest element of a description yamt shows; deeper content is left out, so a planted nesting cannot
+/// exhaust the walk's stack.
+pub(crate) const MAX_NESTING: usize = 32;
+
+/// Elements left out with their text: what runs, loads, submits or takes input, and what only a page's head holds
+/// (rule 6, RK66). The task box `input` is read by its list item.
+const LEFT_OUT: [&str; 27] = [
+    "script", "style", "template", "noscript", "iframe", "frame", "frameset", "object", "embed",
+    "applet", "video", "audio", "source", "track", "canvas", "svg", "math", "link", "meta", "base",
+    "head", "title", "button", "select", "textarea", "option", "input",
+];
+const CAPTION_ATTRIBUTES: [&str; 2] = ["alt", "title"];
+
+/// What a description's HTML gives: the tree, and every page and upload it names.
+pub(crate) struct Described {
+    pub description: Description,
+    pub pages: Vec<WebPage>,
+    pub uploads: Vec<OfferedUpload>,
+    /// Its images from other sites, for the log.
+    pub web_images: usize,
+}
+
+/// A node the walk looks at: text, or an element neither left out nor too deep, with its name and depth.
+enum Child<'a> {
+    Text(String),
+    Element {
+        node: NodeRef<'a>,
+        name: String,
+        depth: usize,
+    },
+}
+
+/// The walk's findings so far.
+struct Walk {
+    base: Option<Url>,
+    pages: Vec<WebPage>,
+    uploads: Vec<OfferedUpload>,
+    web_images: usize,
+    /// Inside a link, images go to `lifted` and follow the link.
+    in_link: bool,
+    lifted: Vec<DescriptionInline>,
+    too_deep: bool,
+}
+
+/// `base`: the merge request's GitLab page (`WebPage::merge_request`), None off https.
+pub(crate) fn described(html: &str, base: Option<&WebPage>) -> Described {
+    let mut walk = Walk {
+        base: base.and_then(|page| Url::parse(page.as_str()).ok()),
+        pages: Vec::new(),
+        uploads: Vec::new(),
+        web_images: 0,
+        in_link: false,
+        lifted: Vec::new(),
+        too_deep: false,
+    };
+    let document = Document::fragment(html);
+    let top = document.root().first_element_child();
+    let blocks = top.map_or_else(Vec::new, |top| walk.blocks(&top, 0));
+    if walk.too_deep {
+        tracing::warn!(
+            MAX_NESTING,
+            "a description nests deeper than yamt shows; the deeper part is left out"
+        );
+    }
+    Described {
+        description: Description { blocks },
+        pages: walk.pages,
+        uploads: walk.uploads,
+        web_images: walk.web_images,
+    }
+}
+
+impl Walk {
+    /// `parent`'s children the walk looks at; `depth` is `parent`'s, the top's 0. Comments, left-out elements and
+    /// elements deeper than `MAX_NESTING` are not among them.
+    fn children<'a>(&mut self, parent: &NodeRef<'a>, depth: usize) -> Vec<Child<'a>> {
+        let mut children = Vec::new();
+        for node in parent.children() {
+            if node.is_text() {
+                children.push(Child::Text(node.text().to_string()));
+                continue;
+            }
+            let Some(name) = node.node_name() else {
+                continue;
+            };
+            let name = name.to_string();
+            if LEFT_OUT.contains(&name.as_str()) {
+                continue;
+            }
+            if depth >= MAX_NESTING {
+                self.too_deep = true;
+                continue;
+            }
+            children.push(Child::Element {
+                node,
+                name,
+                depth: depth + 1,
+            });
+        }
+        children
+    }
+
+    fn blocks(&mut self, parent: &NodeRef, depth: usize) -> Vec<DescriptionBlock> {
+        let mut blocks = Vec::new();
+        let mut run = Vec::new();
+        self.blocks_into(parent, depth, &mut blocks, &mut run);
+        push_paragraph(&mut blocks, run);
+        blocks
+    }
+
+    /// `parent`'s blocks into `blocks`; inline content gathers in `run` until a block ends it as a paragraph. An
+    /// element neither block nor inline gives its content in place.
+    fn blocks_into(
+        &mut self,
+        parent: &NodeRef,
+        depth: usize,
+        blocks: &mut Vec<DescriptionBlock>,
+        run: &mut Vec<DescriptionInline>,
+    ) {
+        for child in self.children(parent, depth) {
+            let (node, name, depth) = match child {
+                Child::Text(text) => {
+                    run.push(DescriptionInline::Text { text });
+                    continue;
+                }
+                Child::Element { node, name, depth } => (node, name, depth),
+            };
+            if let Some(inlines) = self.inline(&node, &name, depth) {
+                run.extend(inlines);
+            } else if let Some(found) = self.block(&node, &name, depth) {
+                push_paragraph(blocks, mem::take(run));
+                blocks.extend(found);
+            } else {
+                self.blocks_into(&node, depth, blocks, run);
+            }
+        }
+    }
+
+    /// The blocks a block element makes; None for any other element.
+    fn block(&mut self, node: &NodeRef, name: &str, depth: usize) -> Option<Vec<DescriptionBlock>> {
+        let block = match name {
+            "p" => {
+                let mut paragraph = Vec::new();
+                push_paragraph(&mut paragraph, self.inlines(node, depth));
+                return Some(paragraph);
+            }
+            "div" => return Some(self.blocks(node, depth)),
+            "summary" => return Some(Vec::new()),
+            "pre" => code(&self.plain_text(node, depth), node),
+            "ul" => self.list(node, ListNumbering::Bullets, depth),
+            "ol" => self.list(node, numbers(node), depth),
+            "blockquote" => DescriptionBlock::Quote {
+                blocks: self.blocks(node, depth),
+            },
+            "hr" => DescriptionBlock::Rule,
+            "table" => self.table(node, depth),
+            "details" => self.details(node, depth),
+            _ => {
+                let level = heading_level(name)?;
+                let inlines = self.inlines(node, depth);
+                DescriptionBlock::Heading { level, inlines }
+            }
+        };
+        Some(vec![block])
+    }
+
+    /// `parent`'s inline content; a block element in it gives its content.
+    fn inlines(&mut self, parent: &NodeRef, depth: usize) -> Vec<DescriptionInline> {
+        let mut inlines = Vec::new();
+        for child in self.children(parent, depth) {
+            match child {
+                Child::Text(text) => inlines.push(DescriptionInline::Text { text }),
+                Child::Element { node, name, depth } => match self.inline(&node, &name, depth) {
+                    Some(found) => inlines.extend(found),
+                    None => inlines.extend(self.inlines(&node, depth)),
+                },
+            }
+        }
+        inlines
+    }
+
+    /// What an inline element makes; None for any other element.
+    fn inline(
+        &mut self,
+        node: &NodeRef,
+        name: &str,
+        depth: usize,
+    ) -> Option<Vec<DescriptionInline>> {
+        let inline = match name {
+            "em" | "i" => DescriptionInline::Emphasis {
+                inlines: self.inlines(node, depth),
+            },
+            "strong" | "b" => DescriptionInline::Strong {
+                inlines: self.inlines(node, depth),
+            },
+            "del" | "s" | "strike" => DescriptionInline::Strike {
+                inlines: self.inlines(node, depth),
+            },
+            "code" => DescriptionInline::Code {
+                text: self.plain_text(node, depth),
+            },
+            "br" => DescriptionInline::LineBreak,
+            "a" => return Some(self.link(node, depth)),
+            "img" => return Some(self.image(node)),
+            _ => return None,
+        };
+        Some(vec![inline])
+    }
+
+    /// The link, then the images lifted out of it; a link with an empty content, without `href` or inside another
+    /// link gives its content only.
+    fn link(&mut self, node: &NodeRef, depth: usize) -> Vec<DescriptionInline> {
+        let href = node.attr("href").filter(|_| !self.in_link);
+        let Some(href) = href else {
+            return self.inlines(node, depth);
+        };
+        self.in_link = true;
+        let inlines = self.inlines(node, depth);
+        self.in_link = false;
+        let mut found = Vec::new();
+        if !is_blank(&inlines) {
+            let link = link_of(self.base.as_ref(), &href);
+            if let DescriptionLink::Page { page } = &link
+                && !self.pages.contains(page)
+            {
+                self.pages.push(page.clone());
+            }
+            found.push(DescriptionInline::Link { link, inlines });
+        }
+        found.append(&mut self.lifted);
+        found
+    }
+
+    /// The image from `data-src` (GitLab's lazy images), else `src`; inside a link it waits in `lifted`.
+    fn image(&mut self, node: &NodeRef) -> Vec<DescriptionInline> {
+        let address = node.attr("data-src").or_else(|| node.attr("src"));
+        let written = address.as_deref().unwrap_or_default();
+        let (image, upload) = image_of(self.base.as_ref(), written);
+        if let Some(upload) = upload
+            && !self.uploads.iter().any(|offered| offered.key == upload.key)
+        {
+            self.uploads.push(upload);
+        }
+        if let DescriptionImage::Web { .. } = image {
+            self.web_images += 1;
+        }
+        let caption = CAPTION_ATTRIBUTES
+            .iter()
+            .find_map(|name| node.attr(name).filter(|value| !value.is_empty()))
+            .map_or_else(|| written.to_owned(), |caption| caption.to_string());
+        let image = DescriptionInline::Image { image, caption };
+        if self.in_link {
+            self.lifted.push(image);
+            return Vec::new();
+        }
+        vec![image]
+    }
+
+    /// The text of `parent`'s children, elements' text included.
+    fn plain_text(&mut self, parent: &NodeRef, depth: usize) -> String {
+        let mut text = String::new();
+        for child in self.children(parent, depth) {
+            match child {
+                Child::Text(piece) => text.push_str(&piece),
+                Child::Element { node, depth, .. } => text.push_str(&self.plain_text(&node, depth)),
+            }
+        }
+        text
+    }
+
+    /// `parent`'s child elements named one of `names`, each with its name and depth.
+    fn elements<'a>(
+        &mut self,
+        parent: &NodeRef<'a>,
+        depth: usize,
+        names: &[&str],
+    ) -> Vec<(NodeRef<'a>, String, usize)> {
+        let mut elements = Vec::new();
+        for child in self.children(parent, depth) {
+            if let Child::Element { node, name, depth } = child
+                && names.contains(&name.as_str())
+            {
+                elements.push((node, name, depth));
+            }
+        }
+        elements
+    }
+
+    /// Its `li` children as items; anything else in a list is left out.
+    fn list(&mut self, node: &NodeRef, numbering: ListNumbering, depth: usize) -> DescriptionBlock {
+        let mut items = Vec::new();
+        for (item, _, depth) in self.elements(node, depth, &["li"]) {
+            let task = task_box(&item);
+            let blocks = self.blocks(&item, depth);
+            items.push(DescriptionItem { task, blocks });
+        }
+        DescriptionBlock::List { numbering, items }
+    }
+
+    /// `thead`'s rows as the head, `tbody`'s and `tfoot`'s as the body (the parser puts every bare `tr` in a
+    /// `tbody`).
+    fn table(&mut self, node: &NodeRef, depth: usize) -> DescriptionBlock {
+        let mut head = Vec::new();
+        let mut body = Vec::new();
+        for (section, name, depth) in self.elements(node, depth, &["thead", "tbody", "tfoot"]) {
+            let rows = self.rows(&section, depth);
+            if name == "thead" {
+                head.extend(rows);
+            } else {
+                body.extend(rows);
+            }
+        }
+        DescriptionBlock::Table { head, body }
+    }
+
+    fn rows(&mut self, section: &NodeRef, depth: usize) -> Vec<DescriptionRow> {
+        let mut rows = Vec::new();
+        for (row, _, depth) in self.elements(section, depth, &["tr"]) {
+            let cells = self.cells(&row, depth);
+            rows.push(DescriptionRow { cells });
+        }
+        rows
+    }
+
+    fn cells(&mut self, row: &NodeRef, depth: usize) -> Vec<DescriptionCell> {
+        let mut cells = Vec::new();
+        for (cell, name, depth) in self.elements(row, depth, &["th", "td"]) {
+            let inlines = self.inlines(&cell, depth);
+            let align = align(&cell);
+            cells.push(DescriptionCell {
+                header: name == "th",
+                align,
+                inlines,
+            });
+        }
+        cells
+    }
+
+    /// Its first `summary` child as the summary, the rest as its blocks.
+    fn details(&mut self, node: &NodeRef, depth: usize) -> DescriptionBlock {
+        let summaries = self.elements(node, depth, &["summary"]);
+        let summary = match summaries.first() {
+            Some((summary, _, inner)) => self.inlines(summary, *inner),
+            None => Vec::new(),
+        };
+        DescriptionBlock::Details {
+            open: node.has_attr("open"),
+            summary,
+            blocks: self.blocks(node, depth),
+        }
+    }
+}
+
+/// A paragraph of `inlines` at the end of `blocks`, unless they are only white space.
+fn push_paragraph(blocks: &mut Vec<DescriptionBlock>, inlines: Vec<DescriptionInline>) {
+    if !is_blank(&inlines) {
+        blocks.push(DescriptionBlock::Paragraph { inlines });
+    }
+}
+
+/// Nothing, or only white-space text.
+fn is_blank(inlines: &[DescriptionInline]) -> bool {
+    inlines
+        .iter()
+        .all(|inline| matches!(inline, DescriptionInline::Text { text } if text.trim().is_empty()))
+}
