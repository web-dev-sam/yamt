+++ 2/crates/merge-core/src/chunk.rs
@@ -0,0 +1,52 @@
+use serde::Serialize;
+use specta::Type;
+
+use crate::line::{BaseLine, LineRange, LocalLine, RemoteLine};
+
+/// Which side changed a chunk, and whether two changes agree.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+pub enum ChunkKind {
+    /// Only local changed these base lines.
+    LocalOnly,
+    /// Only remote changed these base lines.
+    RemoteOnly,
+    /// Local and remote made the identical change.
+    BothSame,
+    /// Local and remote changed these base lines differently.
+    Conflict,
+}
+
+/// Index of a chunk in the `Vec` returned by `compute_chunks`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Type)]
+pub struct ChunkId(pub u32);
+
+/// One region where local or remote differs from base, located in all three texts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct Chunk {
+    /// Index of this chunk in its file's chunk list.
+    pub id: ChunkId,
+    /// Which side changed the region.
+    pub kind: ChunkKind,
+    /// The region in base; empty for a pure insertion.
+    pub base: LineRange<BaseLine>,
+    /// The region in local.
+    pub local: LineRange<LocalLine>,
+    /// The region in remote.
+    pub remote: LineRange<RemoteLine>,
+}
+
+/// Default for `Options::gap`.
+pub const DEFAULT_GAP: u32 = 1;
+
+/// Tuning for `compute_chunks`.
+#[derive(Clone, Copy, Debug)]
+pub struct Options {
+    /// Changes separated by at most this many unchanged base lines form one chunk.
+    pub gap: u32,
+}
+
+impl Default for Options {
+    fn default() -> Self {
+        Options { gap: DEFAULT_GAP }
+    }
+}
diff --git 1/crates/merge-core/src/compute.rs 2/crates/merge-core/src/compute.rs
new file mode 100644
index 0000000..3d0b70c
--- /dev/null
+++ 2/crates/merge-core/src/compute.rs
@@ -0,0 +1,157 @@
+use std::ops::Range;
+
+use imara_diff::{Algorithm, Diff, Hunk, InternedInput};
+
+use crate::chunk::{Chunk, ChunkId, ChunkKind, Options};
+use crate::line::{BaseLine, LineRange, LocalLine, RemoteLine, lines_in, split_lines};
+
+#[derive(Clone, Copy)]
+enum Side {
+    Local,
+    Remote,
+}
+
+#[derive(Clone, Copy)]
+enum Touched {
+    Local,
+    Remote,
+    Both,
+}
+
+impl Touched {
+    fn by(side: Side) -> Touched {
+        match side {
+            Side::Local => Touched::Local,
+            Side::Remote => Touched::Remote,
+        }
+    }
+
+    fn and(self, side: Side) -> Touched {
+        match (self, side) {
+            (Touched::Local, Side::Local) => Touched::Local,
+            (Touched::Remote, Side::Remote) => Touched::Remote,
+            (Touched::Local, Side::Remote)
+            | (Touched::Remote, Side::Local)
+            | (Touched::Both, Side::Local | Side::Remote) => Touched::Both,
+        }
+    }
+}
+
+struct Region {
+    base: Range<u32>,
+    touched: Touched,
+}
+
+struct SideDiff<'a> {
+    hunks: Vec<Hunk>,
+    lines: Vec<&'a str>,
+}
+
+impl<'a> SideDiff<'a> {
+    fn new(base: &str, side: &'a str) -> SideDiff<'a> {
+        let input = InternedInput::new(base, side);
+        let mut diff = Diff::compute(Algorithm::Histogram, &input);
+        diff.postprocess_lines(&input);
+        SideDiff {
+            hunks: diff.hunks().collect(),
+            lines: split_lines(side),
+        }
+    }
+
+    fn map(&self, base: &Range<u32>) -> Range<u32> {
+        let starting_before = self
+            .hunks
+            .partition_point(|hunk| hunk.before.start < base.start);
+        let starting_within = self
+            .hunks
+            .partition_point(|hunk| hunk.before.start <= base.end);
+        self.side_line(starting_before, base.start)..self.side_line(starting_within, base.end)
+    }
+
+    fn side_line(&self, preceding_hunks: usize, base_line: u32) -> u32 {
+        let last_preceding = preceding_hunks
+            .checked_sub(1)
+            .and_then(|index| self.hunks.get(index));
+        match last_preceding {
+            Some(hunk) => hunk.after.end + (base_line - hunk.before.end),
+            None => base_line,
+        }
+    }
+
+    fn text(&self, range: &Range<u32>) -> &[&str] {
+        lines_in(&self.lines, range)
+    }
+}
+
+/// Splits three texts into the chunks where local or remote differs from base, in base order.
+#[must_use]
+pub fn compute_chunks(base: &str, local: &str, remote: &str, opts: &Options) -> Vec<Chunk> {
+    let local = SideDiff::new(base, local);
+    let remote = SideDiff::new(base, remote);
+    let regions = sweep(&local.hunks, &remote.hunks, opts.gap);
+    let mut chunks = Vec::with_capacity(regions.len());
+    for (id, region) in (0..).zip(regions) {
+        let local_range = local.map(&region.base);
+        let remote_range = remote.map(&region.base);
+        let kind = classify(
+            region.touched,
+            local.text(&local_range),
+            remote.text(&remote_range),
+        );
+        chunks.push(Chunk {
+            id: ChunkId(id),
+            kind,
+            base: LineRange {
+                start: BaseLine(region.base.start),
+                len: line_count(&region.base),
+            },
+            local: LineRange {
+                start: LocalLine(local_range.start),
+                len: line_count(&local_range),
+            },
+            remote: LineRange {
+                start: RemoteLine(remote_range.start),
+                len: line_count(&remote_range),
+            },
+        });
+    }
+    chunks
+}
+
+fn sweep(local: &[Hunk], remote: &[Hunk], gap: u32) -> Vec<Region> {
+    let mut tagged = Vec::with_capacity(local.len() + remote.len());
+    for hunk in local {
+        tagged.push((hunk.before.clone(), Side::Local));
+    }
+    for hunk in remote {
+        tagged.push((hunk.before.clone(), Side::Remote));
+    }
+    tagged.sort_by_key(|(base, _)| base.start);
+    let mut regions: Vec<Region> = Vec::new();
+    for (base, side) in tagged {
+        match regions.last_mut() {
+            Some(region) if base.start <= region.base.end.saturating_add(gap) => {
+                region.base.end = region.base.end.max(base.end);
+                region.touched = region.touched.and(side);
+            }
+            Some(_) | None => regions.push(Region {
+                base,
+                touched: Touched::by(side),
+            }),
+        }
+    }
+    regions
+}
+
+fn classify(touched: Touched, local_text: &[&str], remote_text: &[&str]) -> ChunkKind {
+    match touched {
+        Touched::Local => ChunkKind::LocalOnly,
+        Touched::Remote => ChunkKind::RemoteOnly,
+        Touched::Both if local_text == remote_text => ChunkKind::BothSame,
+        Touched::Both => ChunkKind::Conflict,
+    }
+}
+
+fn line_count(range: &Range<u32>) -> u32 {
+    range.end - range.start
+}
diff --git 1/crates/merge-core/src/line.rs 2/crates/merge-core/src/line.rs
new file mode 100644
index 0000000..69c5695
--- /dev/null
+++ 2/crates/merge-core/src/line.rs
@@ -0,0 +1,67 @@
+use std::ops::Range;
+
+use serde::Serialize;
+use specta::Type;
+
+/// 0-based line index in the base text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Type)]
+pub struct BaseLine(pub u32);
+
+/// 0-based line index in the local text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Type)]
+pub struct LocalLine(pub u32);
+
+/// 0-based line index in the remote text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Type)]
+pub struct RemoteLine(pub u32);
+
+/// The lines `start .. start + len` of one text; built from a length, so it cannot be inverted.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Type)]
+pub struct LineRange<L> {
+    /// First line of the range, or the insertion point when the range is empty.
+    pub start: L,
+    /// Number of lines in the range.
+    pub len: u32,
+}
+
+impl<L> LineRange<L> {
+    /// Whether the range holds no lines (a pure insertion point).
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+}
+
+impl LineRange<BaseLine> {
+    /// First line after the range.
+    #[must_use]
+    pub fn end(&self) -> BaseLine {
+        BaseLine(self.start.0 + self.len)
+    }
+}
+
+impl LineRange<LocalLine> {
+    /// First line after the range.
+    #[must_use]
+    pub fn end(&self) -> LocalLine {
+        LocalLine(self.start.0 + self.len)
+    }
+}
+
+impl LineRange<RemoteLine> {
+    /// First line after the range.
+    #[must_use]
+    pub fn end(&self) -> RemoteLine {
+        RemoteLine(self.start.0 + self.len)
+    }
+}
+
+pub(crate) fn split_lines(text: &str) -> Vec<&str> {
+    text.split_inclusive('\n').collect()
+}
+
+pub(crate) fn lines_in<'a>(lines: &'a [&'a str], range: &Range<u32>) -> &'a [&'a str] {
+    lines
+        .get(range.start as usize..range.end as usize)
+        .unwrap_or_default()
+}
diff --git 1/crates/merge-core/tests/invariants.rs 2/crates/merge-core/tests/invariants.rs
new file mode 100644
index 0000000..c97becd
--- /dev/null
+++ 2/crates/merge-core/tests/invariants.rs
@@ -0,0 +1,258 @@
+use proptest::collection::vec;
+use proptest::option;
+use proptest::prelude::*;
+use proptest::sample::{Index, select};
+use yamt_merge_core::{Chunk, ChunkId, ChunkKind, Options, apply_non_conflicting, compute_chunks};
+
+const LINES: [&str; 5] = ["x\n", "x\r\n", "\n", "y\n", "z\n"];
+const LAST_LINES: [&str; 3] = ["", "x", "y"];
+const MAX_LINES: usize = 10;
+const MAX_EDITS: usize = 4;
+const MAX_GAP: u32 = 3;
+const CASES: u32 = 512;
+
+#[derive(Clone, Debug)]
+enum Edit {
+    Insert(&'static str),
+    Delete,
+    Replace(&'static str),
+}
+
+#[derive(Clone, Debug)]
+struct Doc {
+    lines: Vec<&'static str>,
+    last: &'static str,
+}
+
+impl Doc {
+    fn text(&self) -> String {
+        let mut text = self.lines.concat();
+        text.push_str(self.last);
+        text
+    }
+
+    fn edited(&self, edits: &[(Index, Edit)], last: Option<&'static str>) -> Doc {
+        let mut lines = self.lines.clone();
+        for (at, edit) in edits {
+            match *edit {
+                Edit::Insert(line) => lines.insert(at.index(lines.len() + 1), line),
+                Edit::Delete if !lines.is_empty() => {
+                    lines.remove(at.index(lines.len()));
+                }
+                Edit::Replace(line) if !lines.is_empty() => {
+                    let replaced = at.index(lines.len());
+                    lines[replaced] = line;
+                }
+                Edit::Delete | Edit::Replace(_) => {}
+            }
+        }
+        Doc {
+            lines,
+            last: last.unwrap_or(self.last),
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct Triple {
+    base: String,
+    local: String,
+    remote: String,
+}
+
+fn line() -> impl Strategy<Value = &'static str> {
+    select(LINES.to_vec())
+}
+
+fn last_line() -> impl Strategy<Value = &'static str> {
+    select(LAST_LINES.to_vec())
+}
+
+fn doc() -> impl Strategy<Value = Doc> {
+    (vec(line(), 0..MAX_LINES), last_line()).prop_map(|(lines, last)| Doc { lines, last })
+}
+
+fn edits() -> impl Strategy<Value = Vec<(Index, Edit)>> {
+    let edit = prop_oneof![
+        line().prop_map(Edit::Insert),
+        Just(Edit::Delete),
+        line().prop_map(Edit::Replace),
+    ];
+    vec((any::<Index>(), edit), 0..MAX_EDITS)
+}
+
+fn triple() -> impl Strategy<Value = Triple> {
+    let derived = (
+        doc(),
+        edits(),
+        option::of(last_line()),
+        edits(),
+        option::of(last_line()),
+    )
+        .prop_map(
+            |(base, local_edits, local_last, remote_edits, remote_last)| Triple {
+                local: base.edited(&local_edits, local_last).text(),
+                remote: base.edited(&remote_edits, remote_last).text(),
+                base: base.text(),
+            },
+        );
+    let independent = (doc(), doc(), doc()).prop_map(|(base, local, remote)| Triple {
+        base: base.text(),
+        local: local.text(),
+        remote: remote.text(),
+    });
+    prop_oneof![4 => derived, 1 => independent]
+}
+
+struct Lines<'a> {
+    base: Vec<&'a str>,
+    local: Vec<&'a str>,
+    remote: Vec<&'a str>,
+}
+
+impl<'a> Lines<'a> {
+    fn of(triple: &'a Triple) -> Lines<'a> {
+        Lines {
+            base: triple.base.split_inclusive('\n').collect(),
+            local: triple.local.split_inclusive('\n').collect(),
+            remote: triple.remote.split_inclusive('\n').collect(),
+        }
+    }
+
+    fn base(&self, chunk: &Chunk) -> String {
+        slice(&self.base, chunk.base.start.0, chunk.base.len)
+    }
+
+    fn local(&self, chunk: &Chunk) -> String {
+        slice(&self.local, chunk.local.start.0, chunk.local.len)
+    }
+
+    fn remote(&self, chunk: &Chunk) -> String {
+        slice(&self.remote, chunk.remote.start.0, chunk.remote.len)
+    }
+
+    fn replace_chunks(&self, chunks: &[Chunk], replacement: impl Fn(&Chunk) -> String) -> String {
+        let mut rebuilt = String::new();
+        let mut next_base_line = 0;
+        for chunk in chunks {
+            rebuilt += &slice(
+                &self.base,
+                next_base_line,
+                chunk.base.start.0 - next_base_line,
+            );
+            rebuilt += &replacement(chunk);
+            next_base_line = chunk.base.end().0;
+        }
+        rebuilt + &self.base[next_base_line as usize..].concat()
+    }
+}
+
+fn slice(lines: &[&str], start: u32, len: u32) -> String {
+    lines[start as usize..(start + len) as usize].concat()
+}
+
+fn chunks_of(triple: &Triple, gap: u32) -> Vec<Chunk> {
+    compute_chunks(
+        &triple.base,
+        &triple.local,
+        &triple.remote,
+        &Options { gap },
+    )
+}
+
+fn kinds(base: &str, local: &str, remote: &str) -> Vec<ChunkKind> {
+    let chunks = compute_chunks(base, local, remote, &Options::default());
+    chunks.iter().map(|chunk| chunk.kind).collect()
+}
+
+fn line_count(text: &str) -> usize {
+    text.split_inclusive('\n').count()
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig::with_cases(CASES))]
+
+    #[test]
+    fn chunks_are_indexed_sorted_and_separated_in_all_three_texts(triple in triple(), gap in 0..MAX_GAP) {
+        let chunks = chunks_of(&triple, gap);
+        for (index, chunk) in (0..).zip(&chunks) {
+            prop_assert_eq!(chunk.id, ChunkId(index));
+        }
+        for pair in chunks.windows(2) {
+            prop_assert!(pair[0].base.end() < pair[1].base.start, "{:?}", pair);
+            prop_assert!(pair[0].local.end() < pair[1].local.start, "{:?}", pair);
+            prop_assert!(pair[0].remote.end() < pair[1].remote.start, "{:?}", pair);
+        }
+        if let Some(last) = chunks.last() {
+            prop_assert!(last.base.end().0 as usize <= line_count(&triple.base));
+            prop_assert!(last.local.end().0 as usize <= line_count(&triple.local));
+            prop_assert!(last.remote.end().0 as usize <= line_count(&triple.remote));
+        }
+    }
+
+    #[test]
+    fn replacing_base_ranges_with_side_lines_rebuilds_each_side(triple in triple(), gap in 0..MAX_GAP) {
+        let chunks = chunks_of(&triple, gap);
+        let lines = Lines::of(&triple);
+        prop_assert_eq!(lines.replace_chunks(&chunks, |chunk| lines.local(chunk)), triple.local.clone());
+        prop_assert_eq!(lines.replace_chunks(&chunks, |chunk| lines.remote(chunk)), triple.remote.clone());
+    }
+
+    #[test]
+    fn non_conflict_chunks_leave_the_other_side_equal(triple in triple(), gap in 0..MAX_GAP) {
+        let lines = Lines::of(&triple);
+        for chunk in chunks_of(&triple, gap) {
+            match chunk.kind {
+                ChunkKind::LocalOnly => prop_assert_eq!(lines.remote(&chunk), lines.base(&chunk)),
+                ChunkKind::RemoteOnly => prop_assert_eq!(lines.local(&chunk), lines.base(&chunk)),
+                ChunkKind::BothSame => prop_assert_eq!(lines.local(&chunk), lines.remote(&chunk)),
+                ChunkKind::Conflict => {}
+            }
+        }
+    }
+
+    #[test]
+    fn an_unchanged_side_yields_only_the_other_sides_kind(triple in triple()) {
+        let Triple { base, local, remote } = &triple;
+        prop_assert!(kinds(base, base, remote).iter().all(|kind| *kind == ChunkKind::RemoteOnly));
+        prop_assert!(kinds(base, local, base).iter().all(|kind| *kind == ChunkKind::LocalOnly));
+        prop_assert!(!kinds(base, local, local).contains(&ChunkKind::Conflict));
+    }
+
+    #[test]
+    fn apply_non_conflicting_takes_the_only_changed_side(triple in triple()) {
+        let Triple { base, local, remote } = &triple;
+        let apply = |local: &str, remote: &str| {
+            apply_non_conflicting(base, local, remote, &compute_chunks(base, local, remote, &Options::default()))
+        };
+        prop_assert_eq!(&apply(base, remote), remote);
+        prop_assert_eq!(&apply(local, base), local);
+        prop_assert_eq!(&apply(local, local), local);
+    }
+
+    #[test]
+    fn add_add_yields_one_chunk_at_line_zero(local in doc(), remote in doc(), gap in 0..MAX_GAP) {
+        let (local, remote) = (local.text(), remote.text());
+        prop_assume!(!local.is_empty() && !remote.is_empty());
+        for remote in [&remote, &local] {
+            let chunks = compute_chunks("", &local, remote, &Options { gap });
+            prop_assert_eq!(chunks.len(), 1);
+            prop_assert_eq!(chunks[0].base.start.0, 0);
+            prop_assert!(chunks[0].base.is_empty());
+            let expected = if &local == remote { ChunkKind::BothSame } else { ChunkKind::Conflict };
+            prop_assert_eq!(chunks[0].kind, expected);
+        }
+    }
+
+    #[test]
+    fn every_chunk_is_a_real_change(triple in triple(), gap in 0..MAX_GAP) {
+        let lines = Lines::of(&triple);
+        for chunk in chunks_of(&triple, gap) {
+            match chunk.kind {
+                ChunkKind::LocalOnly | ChunkKind::BothSame => prop_assert_ne!(lines.local(&chunk), lines.base(&chunk)),
+                ChunkKind::RemoteOnly => prop_assert_ne!(lines.remote(&chunk), lines.base(&chunk)),
+                ChunkKind::Conflict => prop_assert_ne!(lines.local(&chunk), lines.remote(&chunk)),
+            }
+        }
+    }
+}
diff --git 1/crates/merge-core/tests/triples.rs 2/crates/merge-core/tests/triples.rs
new file mode 100644
index 0000000..8d16dac
--- /dev/null
+++ 2/crates/merge-core/tests/triples.rs
@@ -0,0 +1,112 @@
+use yamt_merge_core::{
+    BaseLine, Chunk, ChunkId, ChunkKind, DEFAULT_GAP, LineRange, LocalLine, Options, RemoteLine,
+    apply_non_conflicting, compute_chunks,
+};
+
+fn chunk(
+    id: u32,
+    kind: ChunkKind,
+    base: (u32, u32),
+    local: (u32, u32),
+    remote: (u32, u32),
+) -> Chunk {
+    Chunk {
+        id: ChunkId(id),
+        kind,
+        base: LineRange {
+            start: BaseLine(base.0),
+            len: base.1,
+        },
+        local: LineRange {
+            start: LocalLine(local.0),
+            len: local.1,
+        },
+        remote: LineRange {
+            start: RemoteLine(remote.0),
+            len: remote.1,
+        },
+    }
+}
+
+fn assert_merge(base: &str, local: &str, remote: &str, expected: &[Chunk], expected_text: &str) {
+    let chunks = compute_chunks(base, local, remote, &Options { gap: DEFAULT_GAP });
+    assert_eq!(chunks, expected);
+    assert_eq!(
+        apply_non_conflicting(base, local, remote, &chunks),
+        expected_text
+    );
+}
+
+#[test]
+fn far_apart_edits_yield_local_only_then_remote_only() {
+    assert_merge(
+        "a\nb\nc\nd\ne\nf\n",
+        "a\nB1\nB2\nc\nd\ne\nf\n",
+        "a\nb\nc\nd\nE\nf\n",
+        &[
+            chunk(0, ChunkKind::LocalOnly, (1, 1), (1, 2), (1, 1)),
+            chunk(1, ChunkKind::RemoteOnly, (4, 1), (5, 1), (4, 1)),
+        ],
+        "a\nB1\nB2\nc\nd\nE\nf\n",
+    );
+}
+
+#[test]
+fn identical_edit_on_both_sides_yields_both_same() {
+    assert_merge(
+        "a\nb\nc\n",
+        "a\nX\nY\nc\n",
+        "a\nX\nY\nc\n",
+        &[chunk(0, ChunkKind::BothSame, (1, 1), (1, 2), (1, 2))],
+        "a\nX\nY\nc\n",
+    );
+}
+
+#[test]
+fn overlapping_different_edits_yield_one_conflict_with_three_lengths() {
+    assert_merge(
+        "a\nb\nc\nd\ne\n",
+        "a\nL\nd\ne\n",
+        "a\nb\nR1\nR2\nR3\ne\n",
+        &[chunk(0, ChunkKind::Conflict, (1, 3), (1, 2), (1, 4))],
+        "a\nb\nc\nd\ne\n",
+    );
+}
+
+#[test]
+fn add_add_with_different_text_yields_one_conflict_at_line_zero() {
+    assert_merge(
+        "",
+        "x\ny\n",
+        "z\n",
+        &[chunk(0, ChunkKind::Conflict, (0, 0), (0, 2), (0, 1))],
+        "",
+    );
+}
+
+#[test]
+fn edits_within_gap_group_and_beyond_gap_split_with_eof_insertion() {
+    assert_merge(
+        "a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\n",
+        "a\nB\nc\nd\ne\nf\nG\nh\ni\nj\nk\nl\nm\n",
+        "a\nb\nc\nD\ne\nf\ng\nh\ni\nJ\nk\nl\n",
+        &[
+            chunk(0, ChunkKind::Conflict, (1, 3), (1, 3), (1, 3)),
+            chunk(1, ChunkKind::LocalOnly, (6, 1), (6, 1), (6, 1)),
+            chunk(2, ChunkKind::RemoteOnly, (9, 1), (9, 1), (9, 1)),
+            chunk(3, ChunkKind::LocalOnly, (12, 0), (12, 1), (12, 0)),
+        ],
+        "a\nb\nc\nd\ne\nf\nG\nh\ni\nJ\nk\nl\nm\n",
+    );
+}
+
+#[test]
+fn missing_final_newline_alone_is_a_one_line_change() {
+    assert_merge(
+        "a\nb\n",
+        "a\nb",
+        "a\nb\n",
+        &[chunk(0, ChunkKind::LocalOnly, (1, 1), (1, 1), (1, 1))],
+        "a\nb",
+    );
+}
