diff --git a/src-tauri/src/args.rs b/src-tauri/src/args.rs
index 4c728b9..ad686d1 100644
--- a/src-tauri/src/args.rs
+++ b/src-tauri/src/args.rs
@@ -1,38 +1,75 @@
 use std::ffi::OsString;
 use std::path::PathBuf;
 
+use yamt_range::RangeSpec;
+
 pub(crate) const USAGE: &str = "\
