diff --git a/frontend/src/ui/useMarkdown.ts b/frontend/src/ui/useMarkdown.ts
index fda1553..369a533 100644
--- a/frontend/src/ui/useMarkdown.ts
+++ b/frontend/src/ui/useMarkdown.ts
@@ -26,3 +26,29 @@ export function useMarkdown(
     view = null;
   });
 }
+
+export function useMarkdownCode(
+  host: Readonly<ShallowRef<HTMLElement | null>>,
+  code: () => { readonly language: string | null; readonly text: string },
+): void {
+  let view: MarkdownView | null = null;
+
+  watch(
+    host,
+    (element) => {
+      view?.destroy();
+      view = element === null ? null : new MarkdownView(element);
+      const { language, text } = code();
+      view?.showCode(language, text);
+    },
+    { immediate: true, flush: "post" },
+  );
+  watch(code, ({ language, text }) => {
+    view?.showCode(language, text);
+  });
+
+  onScopeDispose(() => {
+    view?.destroy();
+    view = null;
+  });
+}
