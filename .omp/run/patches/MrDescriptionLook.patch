+      { kind: "code", info: language ?? "", code: text },
+      this.#paint,
+    );
+    this.#host.replaceChildren(node);
+    this.#shown = [{ source: null, node }];
+  }
+
   destroy(): void {
     this.#destroyed = true;
     this.#shown = [];
