+use std::path::Path;
+use std::sync::mpsc::Sender;
+
+use yamt_pipe::{Framing, HostEvent, ProgramFolders, Running, find};
+
+use crate::{AgentCommand, AgentStartReply};
+
+/// Starts the command's program in `checkout`, looked up in PATH, then in the command's home folders;
+/// `Err` is the reply that says why it did not start.
+pub(crate) fn start_in(
+    checkout: &Path,
+    command: &AgentCommand,
+    events: Sender<HostEvent>,
+) -> Result<Running, AgentStartReply> {
+    let folders = ProgramFolders {
+        project: Vec::new(),
+        home: command.home_folders.clone(),
+    };
+    let found = find(checkout, checkout, &command.program, &folders).map_err(|searched| {
+        AgentStartReply::NotFound {
+            program: command.program.clone(),
+            searched: searched
+                .iter()
+                .map(|folder| folder.to_string_lossy().into_owned())
+                .collect(),
+        }
+    })?;
+    Running::start(&found.path, &command.args, checkout, Framing::Lines, events).map_err(|error| {
+        AgentStartReply::SpawnFailed {
+            program: command.program.clone(),
+            message: error.to_string(),
+        }
+    })
+}
diff --git a/crates/agent/src/sweep.rs b/crates/agent/src/sweep.rs
new file mode 100644
index 0000000..2c10ddf
--- /dev/null
+++ b/crates/agent/src/sweep.rs
@@ -0,0 +1,42 @@
+use std::path::Path;
+
+use yamt_range::{PairLock, pair_folders};
+
+use crate::checkout;
+
+/// What crashes and kills left in `range_dir`'s pair folders: in every pair whose lock it takes, the partial and
+/// removing folders and a clean checkout are deleted; a changed or unreadable one is kept. In `own`, the
+/// window's own pair folder, only the partial and removing folders go: its checkout is reused.
+pub fn sweep_leftovers(range_dir: &Path, own: &Path) {
+    for folder in pair_folders(range_dir) {
+        if folder == own {
+            remove_leftovers(&folder);
+            continue;
+        }
+        match PairLock::try_hold(&folder) {
+            Ok(Some(_held)) => {
+                remove_leftovers(&folder);
+                if let Some(new_commit) = right_commit(&folder) {
+                    checkout::remove_when_clean(&folder, new_commit);
+                }
+            }
+            Ok(None) => {}
+            Err(error) => {
+                tracing::warn!(%error, folder = %folder.display(), "a pair's lock cannot be taken");
+            }
+        }
+    }
+}
+
+fn remove_leftovers(folder: &Path) {
+    if let Err(error) = checkout::remove_leftovers(folder) {
+        tracing::warn!(%error, "a leftover of the AI's checkout stays");
+    }
+}
+
+/// The right commit from the pair folder's name `<left id>-<right id>` (`yamt_range::PairLock::take`).
+fn right_commit(folder: &Path) -> Option<String> {
+    let name = folder.file_name()?.to_str()?;
+    let (_left, right) = name.split_once('-')?;
+    Some(right.to_owned())
+}
diff --git a/crates/agent/src/workspace.rs b/crates/agent/src/workspace.rs
new file mode 100644
index 0000000..66ce826
--- /dev/null
+++ b/crates/agent/src/workspace.rs
@@ -0,0 +1,124 @@
+use std::path::PathBuf;
+use std::sync::mpsc::Sender;
+
+use yamt_pipe::{HostEvent, Running};
+
+use crate::checkout;
+use crate::look::LookJob;
+use crate::process;
+use crate::{AgentCommand, AgentRun, AgentStartReply, CheckoutReply, Error};
+
+/// The range window's repository, its pair folder (held by its `PairLock`) and the right commit's full id.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Pair {
+    pub repo: PathBuf,
+    pub folder: PathBuf,
+    pub new_commit: String,
+}
+
+/// The AI's checkout and the agent running in it. Every removal stops and reaps the agent first.
+pub struct Workspace {
+    pair: Pair,
+    /// `Some` once `prepare` made or reused a complete checkout.
+    checkout: Option<PathBuf>,
+    agent: Option<(AgentRun, Running)>,
+    next_run: u32,
+}
+
+impl Workspace {
+    #[must_use]
+    pub fn new(pair: Pair) -> Workspace {
+        Workspace {
+            pair,
+            checkout: None,
+            agent: None,
+            next_run: 0,
+        }
+    }
+
+    /// Makes `<pair folder>/checkout` or reuses the one there, with whatever it holds. Blocks for as
+    /// long as git writes the work tree.
+    pub fn prepare(&mut self) -> CheckoutReply {
+        match checkout::made_or_reused(&self.pair.folder, &self.pair.repo, &self.pair.new_commit) {
+            Ok(folder) => {
+                let reply = CheckoutReply::Ready {
+                    folder: folder.to_string_lossy().into_owned(),
+                };
+                self.checkout = Some(folder);
+                reply
+            }
+            Err(error) => CheckoutReply::Failed {
+                message: error.to_string(),
+            },
+        }
+    }
+
+    /// Starts the agent in the checkout, after stopping and reaping one that runs.
+    pub fn start(&mut self, command: &AgentCommand, events: Sender<HostEvent>) -> AgentStartReply {
+        let Some(folder) = self.checkout.clone() else {
+            return AgentStartReply::NoCheckout;
+        };
+        self.stop_and_reap();
+        match process::start_in(&folder, command, events) {
+            Ok(running) => {
+                let run = AgentRun(self.next_run);
+                self.next_run += 1;
+                self.agent = Some((run, running));
+                AgentStartReply::Started { run }
+            }
+            Err(reply) => reply,
+        }
+    }
+
+    /// Sends one line to the agent of `run`; for an earlier run it is dropped.
+    pub fn send(&self, run: AgentRun, message: String) {
+        if let Some(running) = self.running(run) {
+            running.send(message);
+        }
+    }
+
+    /// Asks the agent of `run` to stop; `Exited` follows on its events.
+    pub fn stop(&self, run: AgentRun) {
+        if let Some(running) = self.running(run) {
+            running.stop();
+        }
+    }
+
+    pub fn stop_agent(&self) {
+        if let Some((_, running)) = &self.agent {
+            running.stop();
+        }
+    }
+
+    #[must_use]
+    pub fn look_job(&self) -> LookJob {
+        LookJob::in_pair(&self.pair.folder, self.pair.new_commit.clone())
+    }
+
+    /// Stops and reaps the agent, then removes the checkout, kept changes included.
+    pub fn discard(&mut self) -> Result<(), Error> {
+        self.stop_and_reap();
+        self.checkout = None;
+        checkout::remove(&self.pair.folder)
+    }
+
+    /// At exit: stops and reaps the agent, looks again, and removes the checkout only when it is clean.
+    pub fn end(mut self) {
+        self.stop_and_reap();
+        checkout::remove_when_clean(&self.pair.folder, self.pair.new_commit);
+    }
+
+    fn running(&self, run: AgentRun) -> Option<&Running> {
+        match &self.agent {
+            Some((current, running)) if *current == run => Some(running),
+            Some(_) | None => None,
+        }
+    }
+
+    fn stop_and_reap(&mut self) {
+        if let Some((_, running)) = self.agent.take() {
+            running.stop();
+            running.wait();
+        }
+    }
+}
diff --git a/crates/agent/tests/checkout.rs b/crates/agent/tests/checkout.rs
new file mode 100644
index 0000000..4806fee
