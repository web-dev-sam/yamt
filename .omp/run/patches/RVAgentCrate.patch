diff --git a/crates/agent/src/bin/agent-echo.rs b/crates/agent/src/bin/agent-echo.rs
new file mode 100644
index 0000000..a54ba1b
--- /dev/null
+++ b/crates/agent/src/bin/agent-echo.rs
@@ -0,0 +1,81 @@
+//! A line-framed test agent for this crate's tests: answers each line with the same line. `pwd` answers its
+//! working folder; `edit <file>` appends a line to that file and answers `edited <file>`; `stderr <text>` writes
+//! `text` on stderr; `exit <code>` exits with that code; `huge` writes one line over 64 MiB, then `after`;
+//! `hold <file>` keeps that file open, answers `holding <file>`, and once stdin closes waits a moment, writes
+//! `released` into it (making its folder again if it is gone) and exits.
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, BufRead, Write};
+use std::path::PathBuf;
+use std::time::Duration;
+use std::{env, process, thread};
+
+const HUGE_LINE_BYTES: usize = 64 * 1024 * 1024 + 1;
+const HOLD_RELEASE: Duration = Duration::from_millis(300);
+const EDITED_LINE: &[u8] = b"edited by agent-echo\n";
+const RELEASED: &[u8] = b"released\n";
+
+struct Held {
+    path: PathBuf,
+    _file: File,
+}
+
+fn main() -> io::Result<()> {
+    let mut held = None;
+    for line in io::stdin().lock().lines() {
+        let line = line?;
+        if let Some(file) = line.strip_prefix("hold ") {
+            held = Some(hold(file)?);
+        } else {
+            answer(&line)?;
+        }
+    }
+    if let Some(held) = held {
+        thread::sleep(HOLD_RELEASE);
+        if let Some(folder) = held.path.parent() {
+            fs::create_dir_all(folder)?;
+        }
+        fs::write(&held.path, RELEASED)?;
+    }
+    Ok(())
+}
+
+fn hold(file: &str) -> io::Result<Held> {
+    let path = env::current_dir()?.join(file);
+    let opened = OpenOptions::new().create(true).append(true).open(&path)?;
+    write_out(format!("holding {file}\n").as_bytes())?;
+    Ok(Held {
+        path,
+        _file: opened,
+    })
+}
+
+fn answer(line: &str) -> io::Result<()> {
+    if line == "pwd" {
+        let folder = env::current_dir()?;
+        write_out(format!("{}\n", folder.display()).as_bytes())
+    } else if let Some(file) = line.strip_prefix("edit ") {
+        OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(file)?
+            .write_all(EDITED_LINE)?;
+        write_out(format!("edited {file}\n").as_bytes())
+    } else if let Some(text) = line.strip_prefix("stderr ") {
+        eprintln!("{text}");
+        Ok(())
+    } else if let Some(code) = line.strip_prefix("exit ") {
+        process::exit(code.trim().parse().unwrap_or(1));
+    } else if line == "huge" {
+        let mut huge = vec![b'x'; HUGE_LINE_BYTES];
+        huge.extend_from_slice(b"\nafter\n");
+        write_out(&huge)
+    } else {
+        write_out(format!("{line}\n").as_bytes())
+    }
+}
+
+fn write_out(bytes: &[u8]) -> io::Result<()> {
+    let mut out = io::stdout().lock();
+    out.write_all(bytes)?;
+    out.flush()
+}
diff --git a/crates/agent/src/checkout.rs b/crates/agent/src/checkout.rs
new file mode 100644
index 0000000..9e254ef
--- /dev/null
+++ b/crates/agent/src/checkout.rs
@@ -0,0 +1,93 @@
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+use yamt_gitio::{Oid, Repo};
+
+use crate::look::LookJob;
+use crate::{CheckoutLook, Error};
+
+/// A `checkout` folder is always complete: it is made as `checkout.partial` and removed as
+/// `checkout.removing`, so a crash leaves only folders that are safe to delete (plan §2 #110).
+pub(crate) const CHECKOUT: &str = "checkout";
+const PARTIAL: &str = "checkout.partial";
+const REMOVING: &str = "checkout.removing";
+const ORIGIN: &str = "origin";
+
+/// `<pair folder>/checkout`, reused when it exists, otherwise made from `repo` at `commit`.
+pub(crate) fn made_or_reused(
+    pair_folder: &Path,
+    repo: &Path,
+    commit: &str,
+) -> Result<PathBuf, Error> {
+    let checkout = pair_folder.join(CHECKOUT);
+    if checkout.is_dir() {
+        return Ok(checkout);
+    }
+    remove_leftovers(pair_folder)?;
+    let partial = pair_folder.join(PARTIAL);
+    if let Err(error) = make(&partial, repo, commit) {
+        if let Err(leftover) = remove_if_present(&partial) {
+            tracing::warn!(%leftover, "a failed checkout's partial folder stays");
+        }
+        return Err(error);
+    }
+    fs::rename(&partial, &checkout).map_err(|source| Error::Rename {
+        from: partial,
+        to: checkout.clone(),
+        source,
+    })?;
+    Ok(checkout)
+}
+
+fn make(partial: &Path, repo: &Path, commit: &str) -> Result<(), Error> {
+    let commit = Oid::parse(commit)?;
+    let clone = Repo::discover(repo)?.clone_shared_into(partial)?;
+    clone.remove_remote(ORIGIN)?;
+    clone.checkout_detached(&commit)?;
+    Ok(())
+}
+
+/// Removes `<pair folder>/checkout` through `checkout.removing`; a missing one is already removed.
+pub(crate) fn remove(pair_folder: &Path) -> Result<(), Error> {
+    let removing = pair_folder.join(REMOVING);
+    remove_if_present(&removing)?;
+    let checkout = pair_folder.join(CHECKOUT);
+    match fs::rename(&checkout, &removing) {
+        Ok(()) => remove_if_present(&removing),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(source) => Err(Error::Remove {
+            folder: checkout,
+            source,
+        }),
+    }
+}
+
+/// Removes `<pair folder>/checkout` only when a look now finds it clean; a failed removal is logged.
+pub(crate) fn remove_when_clean(pair_folder: &Path, new_commit: String) {
+    match LookJob::in_pair(pair_folder, new_commit).look() {
+        CheckoutLook::Clean => {
+            if let Err(error) = remove(pair_folder) {
+                tracing::warn!(%error, "the AI's clean checkout stays");
+            }
+        }
+        CheckoutLook::Missing | CheckoutLook::Changed { .. } | CheckoutLook::Unreadable { .. } => {}
+    }
+}
+
+/// Deletes the `checkout.partial` and `checkout.removing` folders a crash or kill left.
+pub(crate) fn remove_leftovers(pair_folder: &Path) -> Result<(), Error> {
+    remove_if_present(&pair_folder.join(PARTIAL))?;
+    remove_if_present(&pair_folder.join(REMOVING))
+}
+
+fn remove_if_present(folder: &Path) -> Result<(), Error> {
+    match fs::remove_dir_all(folder) {
+        Ok(()) => Ok(()),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(source) => Err(Error::Remove {
+            folder: folder.to_owned(),
+            source,
+        }),
+    }
+}
