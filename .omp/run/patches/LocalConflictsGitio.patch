+fn missing_commits_names_unknown_ids_and_non_commits_in_order() {
+    let dir = diverged_repo(&SAME_LINE).unwrap();
+    let root = dir.path();
+    let tree = Oid::parse(text(root, &["rev-parse", "main^{tree}"]).trim_end()).unwrap();
