diff --git a/crates/gitio/src/ls_remote.rs b/crates/gitio/src/ls_remote.rs
new file mode 100644
index 0000000..c0aabb1
--- /dev/null
+++ b/crates/gitio/src/ls_remote.rs
@@ -0,0 +1,131 @@
+use std::time::Duration;
+
+use crate::entry::Oid;
+use crate::fetch::run_without_prompts;
+use crate::glab::first_line;
+use crate::repo::Repo;
+use crate::run::Access;
+
+const LS_REMOTE: [&str; 3] = ["ls-remote", "--refs", "--end-of-options"];
+
+/// One ref a remote advertises: its full name (git's bytes) and the object it names.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RemoteRef {
+    pub name: Vec<u8>,
+    pub id: Oid,
+}
+
+impl Repo {
+    /// `git ls-remote --refs --end-of-options <remote> <patterns>…`: every ref the remote advertises that matches a
+    /// pattern (git-ls-remote(1): a glob matched against the ref's tail), in git's order; no object is fetched and
+    /// nothing is written. Runs through `fetch.rs` `run_without_prompts` (the no-prompt environment, RK40), killed at
+    /// `timeout`. `Err` = git's first stderr line, else git's exit words (as `fetch_without_refs`).
+    pub fn remote_refs(
+        &self,
+        remote: &str,
+        patterns: &[&str],
+        timeout: Duration,
+    ) -> Result<Vec<RemoteRef>, String> {
+        let mut command = self.command(Access::Read, &LS_REMOTE);
+        command.arg(remote).args(patterns);
+        let finished = run_without_prompts(command, "ls-remote", timeout)?;
+        if !finished.status.success() {
+            return Err(first_line(&finished.stderr)
+                .unwrap_or_else(|| format!("git ls-remote failed: {}", finished.status)));
+        }
+        remote_refs_in(&finished.stdout)
+    }
+}
+
+/// git-ls-remote(1) output: one `<oid> TAB <refname>` line per ref.
+fn remote_refs_in(output: &[u8]) -> Result<Vec<RemoteRef>, String> {
+    output
+        .split(|&byte| byte == b'\n')
+        .filter(|line| !line.is_empty())
+        .map(remote_ref_in)
+        .collect()
+}
+
+fn remote_ref_in(line: &[u8]) -> Result<RemoteRef, String> {
+    let mut fields = line.splitn(2, |&byte| byte == b'\t');
+    let id = fields.next().and_then(|id| std::str::from_utf8(id).ok());
+    let id = id.and_then(|id| Oid::parse(id).ok());
+    match (id, fields.next()) {
+        (Some(id), Some(name)) if !name.is_empty() => Ok(RemoteRef {
+            name: name.to_vec(),
+            id,
+        }),
+        _ => Err(format!(
+            "git ls-remote printed {:?}",
+            String::from_utf8_lossy(line)
+        )),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MAIN_ID: &str = "1111111111111111111111111111111111111111";
+    const HEAD_ID: &str = "2222222222222222222222222222222222222222";
+
+    #[test]
+    fn each_tab_separated_line_is_one_ref_in_gits_order() {
+        let output = format!("{MAIN_ID}\trefs/heads/main\n{HEAD_ID}\trefs/merge-requests/7/head\n");
+
+        let refs = remote_refs_in(output.as_bytes());
+
+        assert_eq!(
+            refs,
+            Ok(vec![
+                RemoteRef {
+                    name: b"refs/heads/main".to_vec(),
+                    id: Oid::parse(MAIN_ID).unwrap(),
+                },
+                RemoteRef {
+                    name: b"refs/merge-requests/7/head".to_vec(),
+                    id: Oid::parse(HEAD_ID).unwrap(),
+                },
+            ])
+        );
+    }
+
+    #[test]
+    fn an_empty_answer_is_no_ref() {
+        assert_eq!(remote_refs_in(b""), Ok(Vec::new()));
+    }
+
+    #[test]
+    fn a_name_keeps_gits_bytes() {
+        let output = [MAIN_ID.as_bytes(), b"\trefs/heads/caf\xe9\n"].concat();
+
+        let refs = remote_refs_in(&output).unwrap();
+
+        assert_eq!(refs[0].name, b"refs/heads/caf\xe9".to_vec());
+    }
+
+    #[test]
+    fn a_line_without_an_id_and_a_name_is_unreadable() {
+        let no_tab = format!("{MAIN_ID} refs/heads/main\n");
+        let bad_id = "1234\trefs/heads/main\n";
+        let no_name = format!("{MAIN_ID}\t\n");
+
+        for output in [no_tab.as_str(), bad_id, no_name.as_str()] {
+            let line = output.trim_end_matches('\n');
+            assert_eq!(
+                remote_refs_in(output.as_bytes()),
+                Err(format!("git ls-remote printed {line:?}")),
+            );
+        }
+    }
+
+    #[test]
+    fn one_unreadable_line_fails_the_whole_answer() {
+        let output = format!("{MAIN_ID}\trefs/heads/main\nwarning: something\n");
+
+        assert_eq!(
+            remote_refs_in(output.as_bytes()),
+            Err("git ls-remote printed \"warning: something\"".to_owned())
+        );
+    }
+}
diff --git a/crates/gitio/src/merge_tree.rs b/crates/gitio/src/merge_tree.rs
new file mode 100644
index 0000000..33bf69c
--- /dev/null
+++ b/crates/gitio/src/merge_tree.rs
@@ -0,0 +1,107 @@
+use std::time::Duration;
+
+use crate::entry::Oid;
+use crate::repo::Repo;
+use crate::run::{Access, run};
+use crate::{Error, GitVersion, Result};
+
+const MERGE_TREE: &str = "merge-tree";
+const CONFLICTS_STATUS: i32 = 1;
+const FIRST_WITH_WRITE_TREE: GitVersion = GitVersion {
+    major: 2,
+    minor: 38,
+};
+const FIRST_WITH_QUIET: GitVersion = GitVersion {
+    major: 2,
+    minor: 50,
+};
+
+/// Whether git's merge of two commits is clean.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum MergeOutcome {
+    Clean,
+    Conflicts,
+}
+
+/// How `merge_tree` runs git, by what the installed git can do.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MergeTreeRun {
+    /// `--write-tree --quiet` (git 2.50+): no object is written, and git stops at the first conflict.
+    Quiet,
+    /// `--write-tree` (git 2.38–2.49): the merge's objects are left unreferenced in the object store.
+    Writing,
+}
+
+impl MergeTreeRun {
+    /// The run `version` can do; `None` before 2.38, which has no `--write-tree`.
+    #[must_use]
+    pub fn for_version(version: GitVersion) -> Option<MergeTreeRun> {
+        if version >= FIRST_WITH_QUIET {
+            Some(MergeTreeRun::Quiet)
+        } else if version >= FIRST_WITH_WRITE_TREE {
+            Some(MergeTreeRun::Writing)
+        } else {
+            None
+        }
+    }
+}
+
+impl Repo {
+    /// `git merge-tree --write-tree [--quiet] <first> <second>` (`Quiet` adds `--quiet`): exit 0 → `Clean`,
+    /// exit 1 with nothing on stderr → `Conflicts`, any other exit → `Error::GitFailed`; killed at `timeout` →
+    /// `Error::Timeout`. Never reads or writes the index, the working tree or a ref (git-merge-tree(1)).
+    pub fn merge_tree(
+        &self,
+        first: &Oid,
+        second: &Oid,
+        run_kind: MergeTreeRun,
+        timeout: Duration,
+    ) -> Result<MergeOutcome> {
+        let (access, options): (Access, &[&str]) = match run_kind {
+            MergeTreeRun::Quiet => (Access::Read, &["--write-tree", "--quiet"]),
+            MergeTreeRun::Writing => (Access::Write, &["--write-tree"]),
+        };
+        let mut command = self.command(access, &[MERGE_TREE]);
+        command
+            .args(options)
+            .args([first.as_str(), second.as_str()]);
+        // git also exits 1 for a commit it cannot find, printing "merge-tree: <id> - not something we can merge"
+        // (measured with git 2.56, both forms); a conflict leaves stderr empty.
+        match run(command, None, timeout) {
+            Ok(_) => Ok(MergeOutcome::Clean),
+            Err(Error::GitFailed {
+                status: Some(CONFLICTS_STATUS),
+                stderr,
+                ..
+            }) if stderr.is_empty() => Ok(MergeOutcome::Conflicts),
+            Err(error) => Err(error),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn run_for(major: u32, minor: u32) -> Option<MergeTreeRun> {
+        MergeTreeRun::for_version(GitVersion { major, minor })
+    }
+
+    #[test]
+    fn git_before_2_38_cannot_merge_without_a_worktree() {
+        assert_eq!(run_for(2, 37), None);
+        assert_eq!(run_for(1, 99), None);
+    }
+
+    #[test]
+    fn git_2_38_to_2_49_writes_the_merge_objects() {
+        assert_eq!(run_for(2, 38), Some(MergeTreeRun::Writing));
+        assert_eq!(run_for(2, 49), Some(MergeTreeRun::Writing));
+    }
+
+    #[test]
+    fn git_2_50_and_later_merges_quietly() {
+        assert_eq!(run_for(2, 50), Some(MergeTreeRun::Quiet));
+        assert_eq!(run_for(3, 0), Some(MergeTreeRun::Quiet));
+    }
+}
diff --git a/crates/gitio/src/objects.rs b/crates/gitio/src/objects.rs
new file mode 100644
index 0000000..229135d
--- /dev/null
+++ b/crates/gitio/src/objects.rs
@@ -0,0 +1,99 @@
+use crate::blob::CAT_FILE;
+use crate::entry::Oid;
+use crate::repo::Repo;
+use crate::run::{Access, GIT_TIMEOUT, run};
+use crate::{Error, Result};
+
+const BATCH_CHECK: &str = "--batch-check=%(objectname) %(objecttype)";
+const COMMIT: &str = "commit";
+
+impl Repo {
+    /// Which of `ids` name no commit in the repository's object store, in the order given: one
+    /// `git cat-file --batch-check` reading the ids on stdin (a missing id and one that is not a commit both count).
+    pub fn missing_commits(&self, ids: &[Oid]) -> Result<Vec<Oid>> {
+        let mut input = Vec::new();
+        for id in ids {
+            input.extend_from_slice(id.as_str().as_bytes());
+            input.push(b'\n');
+        }
+        let command = self.command(Access::Read, &[CAT_FILE, BATCH_CHECK]);
+        let output = run(command, Some(input), GIT_TIMEOUT)?;
+        missing_commits_in(ids, &output)
+    }
+}
+
+/// git-cat-file(1) `--batch-check`: one line per id in input order, `<id> <type>` for an object that exists and
+/// `<id> missing` for one that does not.
+fn missing_commits_in(ids: &[Oid], output: &[u8]) -> Result<Vec<Oid>> {
+    let text = String::from_utf8_lossy(output);
+    let lines: Vec<&str> = text.lines().collect();
+    if lines.len() != ids.len() {
+        return Err(unexpected(&text));
+    }
+    let mut missing = Vec::new();
+    for (id, line) in ids.iter().zip(lines) {
+        let kind = line
+            .strip_prefix(id.as_str())
+            .and_then(|rest| rest.strip_prefix(' '))
+            .ok_or_else(|| unexpected(&text))?;
+        if kind != COMMIT {
+            missing.push(id.clone());
+        }
+    }
+    Ok(missing)
+}
+
+fn unexpected(text: &str) -> Error {
+    Error::UnexpectedOutput {
+        command: CAT_FILE,
+        output: text.to_owned(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn oid(digit: char) -> Oid {
+        Oid::parse(&digit.to_string().repeat(40)).unwrap()
+    }
+
+    #[test]
+    fn missing_ids_and_non_commits_are_named_in_the_order_given() {
+        let ids = [oid('1'), oid('2'), oid('3'), oid('4')];
+        let output = format!(
+            "{} commit\n{} missing\n{} tree\n{} commit\n",
+            ids[0].as_str(),
+            ids[1].as_str(),
+            ids[2].as_str(),
+            ids[3].as_str()
+        );
+
+        let missing = missing_commits_in(&ids, output.as_bytes()).unwrap();
+
+        assert_eq!(missing, vec![oid('2'), oid('3')]);
+    }
+
+    #[test]
+    fn no_ids_give_no_missing_commit() {
+        assert_eq!(missing_commits_in(&[], b"").unwrap(), Vec::<Oid>::new());
+    }
+
+    #[test]
+    fn a_line_for_another_id_or_a_line_too_few_is_unexpected() {
+        let ids = [oid('1'), oid('2')];
+        let swapped = format!("{} commit\n{} commit\n", ids[1].as_str(), ids[0].as_str());
+        let short = format!("{} commit\n", ids[0].as_str());
+        let glued = format!("{}commit\n{} commit\n", ids[0].as_str(), ids[1].as_str());
+
+        for output in [swapped, short, glued] {
+            assert!(matches!(
+                missing_commits_in(&ids, output.as_bytes()),
+                Err(Error::UnexpectedOutput {
+                    command: CAT_FILE,
+                    ..
+                })
+            ));
+        }
+    }
+}
diff --git a/crates/gitio/tests/local_check.rs b/crates/gitio/tests/local_check.rs
