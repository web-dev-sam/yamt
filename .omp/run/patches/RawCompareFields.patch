+++ b/frontend/src/editor/internal/columnBytes.test.ts
@@ -0,0 +1,50 @@
+import { EditorState } from "@codemirror/state";
+import { expect, test, vi } from "vitest";
+
+import { columnLimit, utf8Length } from "./columnBytes";
+
+const EURO = "€";
+
+function column(doc: string, limit: number): { state: EditorState; refused: () => void } {
+  const refused = vi.fn<() => void>();
+  return { state: EditorState.create({ doc, extensions: columnLimit(limit, refused) }), refused };
+}
+
+test("utf8Length counts what TextEncoder writes, for one- to four-byte characters and a lone surrogate", () => {
+  const encoder = new TextEncoder();
+  for (const text of ["", "abc", "é", EURO, "😀", "a😀é€\n", "\ud800", "x\udc00y"]) {
+    expect(utf8Length(text)).toBe(encoder.encode(text).length);
+  }
+});
+
+test("a three-byte character that passes the limit is refused and reported", () => {
+  const { state, refused } = column("ab", 4);
+
+  const after = state.update({ changes: { from: 2, insert: EURO } }).state;
+
+  expect(after.doc.toString()).toBe("ab");
+  expect(refused).toHaveBeenCalledOnce();
+});
+
+test("an edit that reaches the limit exactly is accepted; one byte more is refused", () => {
+  const { state, refused } = column("ab", 5);
+
+  const full = state.update({ changes: { from: 2, insert: EURO } }).state;
+  const over = full.update({ changes: { from: 0, insert: "x" } }).state;
+
+  expect(full.doc.toString()).toBe(`ab${EURO}`);
+  expect(over.doc.toString()).toBe(`ab${EURO}`);
+  expect(refused).toHaveBeenCalledOnce();
+});
+
+test("the count follows each change: removed bytes make room, line breaks count one", () => {
+  const { state, refused } = column(`${EURO}\n${EURO}`, 7);
+
+  const replaced = state.update({ changes: { from: 0, to: 1, insert: "ab" } }).state;
+  const filled = replaced.update({ changes: { from: 0, insert: "c" } }).state;
+  const over = filled.update({ changes: { from: 0, insert: "d" } }).state;
+
+  expect(filled.doc.toString()).toBe(`cab\n${EURO}`);
+  expect(over.doc.toString()).toBe(`cab\n${EURO}`);
+  expect(refused).toHaveBeenCalledOnce();
+});
diff --git a/frontend/src/editor/internal/columnBytes.ts b/frontend/src/editor/internal/columnBytes.ts
new file mode 100644
index 0000000..8fe7d5e
--- /dev/null
+++ b/frontend/src/editor/internal/columnBytes.ts
@@ -0,0 +1,75 @@
+import {
+  EditorState,
+  StateField,
+  type Extension,
+  type Text,
+  type Transaction,
+} from "@codemirror/state";
+
+const ONE_BYTE_BELOW = 0x80;
+const TWO_BYTES_BELOW = 0x800;
+const HIGH_SURROGATE_FIRST = 0xd800;
+const HIGH_SURROGATE_LAST = 0xdbff;
+const LOW_SURROGATE_FIRST = 0xdc00;
+const LOW_SURROGATE_LAST = 0xdfff;
+const TWO_BYTES = 2;
+const PAIR_BYTES = 4;
+const WIDE_BYTES = 3;
+
+export function utf8Length(text: string): number {
+  let bytes = 0;
+  for (let index = 0; index < text.length; index++) {
+    const code = text.charCodeAt(index);
+    if (code < ONE_BYTE_BELOW) {
+      bytes += 1;
+    } else if (code < TWO_BYTES_BELOW) {
+      bytes += TWO_BYTES;
+    } else if (
+      code >= HIGH_SURROGATE_FIRST &&
+      code <= HIGH_SURROGATE_LAST &&
+      text.charCodeAt(index + 1) >= LOW_SURROGATE_FIRST &&
+      text.charCodeAt(index + 1) <= LOW_SURROGATE_LAST
+    ) {
+      bytes += PAIR_BYTES;
+      index++;
+    } else {
+      bytes += WIDE_BYTES;
+    }
+  }
+  return bytes;
+}
+
+function textBytes(text: Text, from: number, to: number): number {
+  let bytes = 0;
+  for (const iter = text.iterRange(from, to); !iter.next().done;) {
+    bytes += utf8Length(iter.value);
+  }
+  return bytes;
+}
+
+function addedBytes(tr: Transaction): number {
+  let added = 0;
+  tr.changes.iterChanges((fromA, toA, _fromB, _toB, inserted) => {
+    added += textBytes(inserted, 0, inserted.length) - textBytes(tr.startState.doc, fromA, toA);
+  });
+  return added;
+}
+
+export function columnLimit(limit: number, refused: () => void): Extension {
+  const count = StateField.define<number>({
+    create: (state) => textBytes(state.doc, 0, state.doc.length),
+    update: (bytes, tr) => (tr.docChanged ? bytes + addedBytes(tr) : bytes),
+  });
+  const filter = EditorState.transactionFilter.of((tr) => {
+    if (!tr.docChanged) {
+      return tr;
+    }
+    const added = addedBytes(tr);
+    if (added > 0 && tr.startState.field(count) + added > limit) {
+      refused();
+      return [];
+    }
+    return tr;
+  });
+  return [count, filter];
+}
diff --git a/frontend/src/editor/internal/compareFields.test.ts b/frontend/src/editor/internal/compareFields.test.ts
