diff --git a/frontend/src/ipc/fixtureMergeRequestDescriptions.test.ts b/frontend/src/ipc/fixtureMergeRequestDescriptions.test.ts
new file mode 100644
index 0000000..3c98972
--- /dev/null
+++ b/frontend/src/ipc/fixtureMergeRequestDescriptions.test.ts
@@ -0,0 +1,289 @@
+import { afterEach, expect, test, vi } from "vitest";
+
+import type * as Generated from "./bindings";
+import { isMergeRequestIid } from "./domain";
+import { fixtureRows } from "./fixtureMergeRequestData";
+import {
+  descriptionScript,
+  fixtureDescription,
+  fixtureUploadedImage,
+} from "./fixtureMergeRequestDescriptions";
+import type { Log } from "./log";
+import type { MergeRequestSource } from "./MergeRequestSource";
+import { branded } from "./validate";
+
+const LISTED_ROWS = 500;
+const PAUSE_MS = 400;
+const LOADING_UPLOAD = "upload~00000000000000000000000000000001";
+const BROKEN_UPLOAD = "upload~00000000000000000000000000000002";
+const SCRIPTED: ReadonlySet<number> = new Set([640, 639, 637, 636, 635]);
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+function listed(): Generated.MergeRequestRow[] {
+  return fixtureRows(0, LISTED_ROWS);
+}
+
+function quietLog(lines: string[]): Log {
+  function keep(event: string, fields: Record<string, string | number | boolean> = {}): void {
+    lines.push(`${event} ${JSON.stringify(fields)}`);
+  }
+  return { debug: keep, info: keep, warn: keep, error: keep };
+}
+
+function target(link: Generated.DescriptionLink): string {
+  switch (link.kind) {
+    case "page":
+      return `page ${link.page}`;
+    case "refused":
+      return `refused ${link.address}`;
+  }
+}
+
+function source(image: Generated.DescriptionImage): string {
+  switch (image.kind) {
+    case "uploaded":
+      return `uploaded ${image.key}`;
+    case "web":
+      return image.address.startsWith("data:image/png;base64,iVBOR") ? "web png" : "web other";
+    case "refused":
+      return "refused";
+  }
+}
+
+function inlineMarks(inline: Generated.DescriptionInline): string[] {
+  switch (inline.kind) {
+    case "text":
+      return [`"${inline.text}"`];
+    case "emphasis":
+    case "strong":
+    case "strike":
+      return [inline.kind, ...inline.inlines.flatMap(inlineMarks)];
+    case "code":
+      return [`code ${inline.text}`];
+    case "lineBreak":
+      return ["lineBreak"];
+    case "link":
+      return [`link ${target(inline.link)}`, ...inline.inlines.flatMap(inlineMarks)];
+    case "image":
+      return [`image ${source(inline.image)} ${inline.caption}`];
+  }
+}
+
+function itemMarks(item: Generated.DescriptionItem): string[] {
+  const task = item.task === "none" ? [] : [`task ${item.task}`];
+  return [...task, ...item.blocks.flatMap(blockMarks)];
+}
+
+function rowMarks(row: Generated.DescriptionRow): string[] {
+  return row.cells.flatMap((cell) => [
+    `${cell.header ? "th" : "td"} ${cell.align}`,
+    ...cell.inlines.flatMap(inlineMarks),
+  ]);
+}
+
+function blockMarks(block: Generated.DescriptionBlock): string[] {
+  switch (block.kind) {
+    case "paragraph":
+      return block.inlines.flatMap(inlineMarks);
+    case "heading":
+      return [block.level, ...block.inlines.flatMap(inlineMarks)];
+    case "code":
+      return [`code block ${block.language ?? "none"}: ${block.text}`];
+    case "list": {
+      const numbering = block.numbering;
+      const kind =
+        numbering.kind === "numbers" ? `numbers from ${numbering.start}` : numbering.kind;
+      return [kind, ...block.items.flatMap(itemMarks)];
+    }
+    case "quote":
+      return ["quote", ...block.blocks.flatMap(blockMarks)];
+    case "rule":
+      return ["rule"];
+    case "table":
+      return ["table", ...block.head.flatMap(rowMarks), "body", ...block.body.flatMap(rowMarks)];
+    case "details":
+      return [
+        `details ${block.open ? "open" : "closed"}`,
+        ...block.summary.flatMap(inlineMarks),
+        ...block.blocks.flatMap(blockMarks),
+      ];
+  }
+}
+
+function blocksOf(reply: Generated.DescriptionReply): readonly Generated.DescriptionBlock[] {
+  if (reply.kind !== "read") {
+    throw new Error(`not read: ${reply.kind}`);
+  }
+  return reply.description.blocks;
+}
+
+function marksOf(reply: Generated.DescriptionReply): string[] {
+  return blocksOf(reply).flatMap(blockMarks);
+}
+
+function script(lines: string[] = []): Pick<MergeRequestSource, "readDescription"> {
+  return descriptionScript(quietLog(lines), LISTED_ROWS);
+}
+
+async function asked(
+  described: Pick<MergeRequestSource, "readDescription">,
+  iid: number,
+): Promise<unknown> {
+  const answer = described.readDescription(branded(iid, isMergeRequestIid, "iid"));
+  await vi.advanceTimersByTimeAsync(PAUSE_MS);
+  return answer;
+}
+
+test("the_rich_description_holds_every_element_of_rule_3", () => {
+  expect(marksOf(fixtureDescription(640, true, listed()))).toEqual([
+    "h1",
+    '"Snooze a reminder"',
+    "h2",
+    '"What changes"',
+    "h3",
+    '"Details"',
+    '"Plain, "',
+    "emphasis",
+    '"emphasis"',
+    '", "',
+    "strong",
+    '"strong"',
+    '", "',
+    "strike",
+    '"struck"',
+    '" and "',
+    "code snooze(card)",
+    "lineBreak",
+    '"after a line break."',
+    "code block ruby: def snooze(card)\n  card.update!(due: 1.day.from_now)\nend",
+    "code block none: plain text\n  indented",
+    "code block mermaid: graph TD\n  A --> B",
+    "bullets",
+    '"One"',
+    '"Two"',
+    "numbers from 3",
+    '"Third"',
+    '"Fourth"',
+    "bullets",
+    "task done",
+    '"Done task"',
+    "task open",
+    '"Open task"',
+    "task inapplicable",
+    '"Dropped task"',
+    "table",
+    "th start",
+    '"Card"',
+    "th center",
+    '"State"',
+    "th end",
+    '"Days"',
+    "body",
+    "td start",
+    '"Login"',
+    "td center",
+    '"open"',
+    "td end",
+    '"3"',
+    "td start",
+    '"Board"',
+    "td center",
+    '"done"',
+    "td end",
+    '"12"',
+    "quote",
+    '"A quoted line."',
+    "rule",
+    "details closed",
+    '"More"',
+    '"Hidden until opened."',
+    "link page https://gitlab.example/taskboard/taskboard/-/issues/12",
+    '"#12"',
+    '" "',
+    "link page https://docs.example/x",
+    '"the docs"',
+    '" "',
+    "link refused mailto:anna@example.com",
+    '"mail Anna"',
+    '" "',
+    "link refused javascript:window.yamtPlanted=true",
+    '"planted"',
+    `image uploaded ${LOADING_UPLOAD} screenshot`,
+    `image uploaded ${BROKEN_UPLOAD} broken screenshot`,
+    "image web png outside picture",
+    "image refused refused picture",
+  ]);
+  expect(fixtureUploadedImage(LOADING_UPLOAD)).toMatch(/^data:image\/png;base64,iVBOR.{40}/u);
+  expect(fixtureUploadedImage(BROKEN_UPLOAD)).toBe("data:image/png;base64,AAAA");
+});
+
+test("the_long_empty_and_planted_rows_answer_as_scripted", () => {
+  const long = marksOf(fixtureDescription(639, true, listed()));
+
+  expect(long).toHaveLength(120);
+  expect([long[0], long[119]]).toEqual(['"Paragraph 1."', '"Paragraph 120."']);
+  expect(blocksOf(fixtureDescription(637, true, listed()))).toEqual([]);
+  expect(marksOf(fixtureDescription(635, true, listed()))).toEqual([
+    '"<script>window.yamtPlanted = true</script>"',
+    '"<img src=x onerror="window.yamtPlanted = true">"',
+    '"<iframe src="https://evil.example/">"',
+  ]);
+});
+
+test("the_failing_row_fails_once_then_reads", async () => {
+  vi.useFakeTimers();
+  const described = script();
+
+  expect(await asked(described, 636)).toEqual({
+    ok: true,
+    value: { kind: "failed", message: "glab timed out" },
+  });
+  const rich = { ok: true, value: fixtureDescription(640, true, listed()) };
+  expect(await asked(described, 636)).toEqual(rich);
+  expect(await asked(described, 636)).toEqual(rich);
+  expect(await asked(described, 640)).toEqual(rich);
+  expect(await asked(script(), 636)).toMatchObject({ value: { kind: "failed" } });
+});
+
+test("an_ask_is_logged_at_once_and_answered_after_400_ms", async () => {
+  vi.useFakeTimers();
+  const lines: string[] = [];
+  let answer: unknown = null;
+  void script(lines)
+    .readDescription(branded(637, isMergeRequestIid, "iid"))
+    .then((result) => {
+      answer = result;
+    });
+
+  expect(lines).toEqual(['mergeRequests.fixture_description {"iid":637}']);
+  await vi.advanceTimersByTimeAsync(PAUSE_MS - 1);
+  expect(answer).toBeNull();
+  await vi.advanceTimersByTimeAsync(1);
+  expect(answer).toEqual({ ok: true, value: { kind: "read", description: { blocks: [] } } });
+});
+
+test("every_listed_row_with_a_description_answers", () => {
+  const rows = listed();
+  const described = rows.filter((row) => row.hasDescription && !SCRIPTED.has(row.iid));
+
+  expect(described.length).toBeGreaterThan(LISTED_ROWS / 2);
+  for (const row of described) {
+    expect(marksOf(fixtureDescription(row.iid, true, rows))).toEqual([
+      `"Description of !${row.iid}."`,
+    ]);
+  }
+});
+
+test("a_row_without_a_description_is_scripted_as_such", () => {
+  const rows = listed();
+  const withoutOne = rows.filter((row) => !row.hasDescription).map((row) => row.iid);
+
+  expect(withoutOne.slice(0, 3)).toEqual([638, 631, 624]);
+  for (const iid of withoutOne) {
+    expect(blocksOf(fixtureDescription(iid, true, rows))).toEqual([]);
+  }
+  expect(marksOf(fixtureDescription(1, true, rows))).toEqual(['"Description of !1."']);
+});
diff --git a/frontend/src/ipc/fixtureMergeRequestDescriptions.ts b/frontend/src/ipc/fixtureMergeRequestDescriptions.ts
new file mode 100644
index 0000000..658a6bc
--- /dev/null
+++ b/frontend/src/ipc/fixtureMergeRequestDescriptions.ts
@@ -0,0 +1,231 @@
+import type * as Generated from "./bindings";
+import { pause } from "./fixture";
+import { TIMED_OUT } from "./fixtureGitLab";
+import { BROKEN_PICTURE, fixtureRows, ORIGIN } from "./fixtureMergeRequestData";
+import type { Log } from "./log";
+import type { MergeRequestSource } from "./MergeRequestSource";
+
+type Block = Generated.DescriptionBlock;
+type Inline = Generated.DescriptionInline;
+
+const RICH_DESCRIPTION_IID = 640;
+const LONG_DESCRIPTION_IID = 639;
+const EMPTY_DESCRIPTION_IID = 637;
+const FAILS_ONCE_IID = 636;
+const PLANTED_IID = 635;
+const LOADING_UPLOAD = "upload~00000000000000000000000000000001";
+const BROKEN_UPLOAD = "upload~00000000000000000000000000000002";
+const PLANTED_TEXTS = [
+  "<script>window.yamtPlanted = true</script>",
+  '<img src=x onerror="window.yamtPlanted = true">',
+  '<iframe src="https://evil.example/">',
+];
+
+const DESCRIPTION_PAUSE_MS = 400;
+const LONG_PARAGRAPHS = 120;
+const FIRST_NUMBER = 3;
+const BLUE_SQUARE =
+  "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAGUlEQVQoz2O0bvrGQApgIkn1qIZRDUNKAwBkagHTBOkobgAAAABJRU5ErkJggg==";
+// Stands in for another site's https image: a `data:` address keeps the fixture offline.
+const GREEN_BANNER =
+  "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAADAAAAAYCAIAAAAzn+mLAAAAMklEQVRIx+3OQQEAIAwEIGcUg9l2vWyx8wEJqNN3/WSnA0JCQkLpgJCQkFA6ICQkNO0BlBgBdWb1BiAAAAAASUVORK5CYII=";
+
+function text(words: string): Inline {
+  return { kind: "text", text: words };
+}
+
+function paragraph(...inlines: Inline[]): Block {
+  return { kind: "paragraph", inlines };
+}
+
+function item(task: Generated.TaskBox, words: string): Generated.DescriptionItem {
+  return { task, blocks: [paragraph(text(words))] };
+}
+
+function cell(
+  header: boolean,
+  align: Generated.CellAlign,
+  words: string,
+): Generated.DescriptionCell {
+  return { header, align, inlines: [text(words)] };
+}
+
+function headingsAndText(): Block[] {
+  return [
+    { kind: "heading", level: "h1", inlines: [text("Snooze a reminder")] },
+    { kind: "heading", level: "h2", inlines: [text("What changes")] },
+    { kind: "heading", level: "h3", inlines: [text("Details")] },
+    paragraph(
+      text("Plain, "),
+      { kind: "emphasis", inlines: [text("emphasis")] },
+      text(", "),
+      { kind: "strong", inlines: [text("strong")] },
+      text(", "),
+      { kind: "strike", inlines: [text("struck")] },
+      text(" and "),
+      { kind: "code", text: "snooze(card)" },
+      { kind: "lineBreak" },
+      text("after a line break."),
+    ),
+  ];
+}
+
+function codeAndLists(): Block[] {
+  return [
+    {
+      kind: "code",
+      language: "ruby",
+      text: "def snooze(card)\n  card.update!(due: 1.day.from_now)\nend",
+    },
+    { kind: "code", language: null, text: "plain text\n  indented" },
+    { kind: "code", language: "mermaid", text: "graph TD\n  A --> B" },
+    {
+      kind: "list",
+      numbering: { kind: "bullets" },
+      items: [item("none", "One"), item("none", "Two")],
+    },
+    {
+      kind: "list",
+      numbering: { kind: "numbers", start: FIRST_NUMBER },
+      items: [item("none", "Third"), item("none", "Fourth")],
+    },
+    {
+      kind: "list",
+      numbering: { kind: "bullets" },
+      items: [
+        item("done", "Done task"),
+        item("open", "Open task"),
+        item("inapplicable", "Dropped task"),
+      ],
+    },
+  ];
+}
+
+function tableAndContainers(): Block[] {
+  return [
+    {
+      kind: "table",
+      head: [
+        {
+          cells: [
+            cell(true, "start", "Card"),
+            cell(true, "center", "State"),
+            cell(true, "end", "Days"),
+          ],
+        },
+      ],
+      body: [
+        {
+          cells: [
+            cell(false, "start", "Login"),
+            cell(false, "center", "open"),
+            cell(false, "end", "3"),
+          ],
+        },
+        {
+          cells: [
+            cell(false, "start", "Board"),
+            cell(false, "center", "done"),
+            cell(false, "end", "12"),
+          ],
+        },
+      ],
+    },
+    { kind: "quote", blocks: [paragraph(text("A quoted line."))] },
+    { kind: "rule" },
+    {
+      kind: "details",
+      open: false,
+      summary: [text("More")],
+      blocks: [paragraph(text("Hidden until opened."))],
+    },
+  ];
+}
+
+function linksAndImages(): Block[] {
+  function link(target: Generated.DescriptionLink, words: string): Inline {
+    return { kind: "link", link: target, inlines: [text(words)] };
+  }
+  function image(source: Generated.DescriptionImage, caption: string): Inline {
+    return { kind: "image", image: source, caption };
+  }
+  return [
+    paragraph(
+      link({ kind: "page", page: `${ORIGIN}/-/issues/12` }, "#12"),
+      text(" "),
+      link({ kind: "page", page: "https://docs.example/x" }, "the docs"),
+      text(" "),
+      link({ kind: "refused", address: "mailto:anna@example.com" }, "mail Anna"),
+      text(" "),
+      link({ kind: "refused", address: "javascript:window.yamtPlanted=true" }, "planted"),
+    ),
+    paragraph(
+      image({ kind: "uploaded", key: LOADING_UPLOAD }, "screenshot"),
+      image({ kind: "uploaded", key: BROKEN_UPLOAD }, "broken screenshot"),
+      image({ kind: "web", address: GREEN_BANNER }, "outside picture"),
+      image({ kind: "refused" }, "refused picture"),
+    ),
+  ];
+}
+
+function read(blocks: Block[]): Generated.DescriptionReply {
+  return { kind: "read", description: { blocks } };
+}
+
+function rich(): Generated.DescriptionReply {
+  return read([
+    ...headingsAndText(),
+    ...codeAndLists(),
+    ...tableAndContainers(),
+    ...linksAndImages(),
+  ]);
+}
+
+/** The fixture's answer for `iid`, `firstAsk` when this window never asked it before; a listed row without a
+ *  description reads empty. */
+export function fixtureDescription(
+  iid: number,
+  firstAsk: boolean,
+  listed: readonly Generated.MergeRequestRow[],
+): Generated.DescriptionReply {
+  switch (iid) {
+    case RICH_DESCRIPTION_IID:
+      return rich();
+    case LONG_DESCRIPTION_IID:
+      return read(
+        Array.from({ length: LONG_PARAGRAPHS }, (_, at) => paragraph(text(`Paragraph ${at + 1}.`))),
+      );
+    case EMPTY_DESCRIPTION_IID:
+      return read([]);
+    case FAILS_ONCE_IID:
+      return firstAsk ? { kind: "failed", message: TIMED_OUT } : rich();
+    case PLANTED_IID:
+      return read(PLANTED_TEXTS.map((words) => paragraph(text(words))));
+    default:
+      return listed.find((row) => row.iid === iid)?.hasDescription === false
+        ? read([])
+        : read([paragraph(text(`Description of !${iid}.`))]);
+  }
+}
+
+/** Stands in for `convertFileSrc` over the picture scheme: the first upload loads, any other does not (Rust's 404). */
+export function fixtureUploadedImage(key: string): string {
+  return key === LOADING_UPLOAD ? BLUE_SQUARE : BROKEN_PICTURE;
+}
+
+export function descriptionScript(
+  log: Log,
+  listedRows: number,
+): Pick<MergeRequestSource, "readDescription" | "uploadedImage"> {
+  const asked = new Set<number>();
+  return {
+    async readDescription(iid) {
+      log.info("mergeRequests.fixture_description", { iid });
+      const firstAsk = !asked.has(iid);
+      asked.add(iid);
+      await pause(DESCRIPTION_PAUSE_MS);
+      return { ok: true, value: fixtureDescription(iid, firstAsk, fixtureRows(0, listedRows)) };
+    },
+    uploadedImage: fixtureUploadedImage,
+  };
+}
