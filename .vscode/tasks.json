{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "yamt: run the merge window",
      "detail": "Start the merge window (just dev-web), then open http://localhost:5173 in GNOME Web. Stop it with Ctrl+C in its terminal.",
      "type": "shell",
      "command": "just dev-web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(?!x)x$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE v\\d",
          "endsPattern": "Local:\\s+http"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "options": {
        "statusbar": {
          "label": "$(play)",
          "running": { "label": "$(radio-tower)" }
        }
      }
    },
    {
      "label": "golden: build conflict repo",
      "detail": "Rebuild one of the 10 real conflicts as a git repo in /tmp/yamt-<case>, to open it in WebStorm/PhpStorm.",
      "type": "shell",
      "command": "just golden-repo ${input:goldenCase} /tmp/yamt-${input:goldenCase}",
      "problemMatcher": [],
      "presentation": { "panel": "shared", "reveal": "always" },
      "options": {
        "statusbar": { "label": "$(git-merge)" }
      }
    }
  ],
  "inputs": [
    {
      "id": "goldenCase",
      "type": "pickString",
      "description": "Real conflict to rebuild in /tmp for PhpStorm",
      "options": [
        "language-tools-script-setup",
        "nuxt-island-test",
        "tanstack-query-persist-provider",
        "tanstack-query-svelte-base-query",
        "vite-modulepreload-polyfill",
        "vue-core-compiler-von",
        "vue-core-playground-app",
        "vue-core-script-context",
        "vue-router-playground-app",
        "vueuse-use-magic-keys"
      ]
    }
  ]
}
